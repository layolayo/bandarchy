#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [[ ! -f "${ROOT_DIR}/App.qml" ]]; then
    if [[ -f "${HOME}/Projects/bandarchy/App.qml" ]]; then
        ROOT_DIR="${HOME}/Projects/bandarchy"
    elif [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/io.github.layolayo.bandarchy/App.qml" ]]; then
        ROOT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/io.github.layolayo.bandarchy"
    fi
fi

kill_bandarchy_ui() {
    pkill -f "(quickshell|bandarchy) -p .*/bandarchy/App\.qml" 2>/dev/null || true
    pkill -f "(quickshell|bandarchy) -p .*io\.github\.layolayo\.bandarchy/App\.qml" 2>/dev/null || true
    pkill -x bandarchy 2>/dev/null || true
    pkill -9 -f "/tmp/bandarchy_test_.*bandarchy\.sock" 2>/dev/null || true
}

if [[ "${1:-}" == "--kill" || "${1:-}" == "kill" ]]; then
    kill_bandarchy_ui
    pkill -f "bandarchy\.sock" 2>/dev/null || true
    pkill -f "bandarchy.*cava" 2>/dev/null || true
    echo "Stopped all Bandarchy processes."
    exit 0
fi

RESTART_MODE=0
if [[ "${1:-}" == "--restart" || "${1:-}" == "restart" ]]; then
    RESTART_MODE=1
    shift
fi

kill_bandarchy_ui

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/bandarchy-runtime"
mkdir -p "${RUNTIME_DIR}"
QS_BIN="$(command -v quickshell)"
ln -sf "${QS_BIN}" "${RUNTIME_DIR}/bandarchy"

if [[ "${RESTART_MODE}" -eq 1 ]]; then
    setsid -f "${RUNTIME_DIR}/bandarchy" -p "${ROOT_DIR}/App.qml" "$@" >/dev/null 2>&1 </dev/null
    echo "Restarted Bandarchy standalone player."
    exit 0
fi

exec "${RUNTIME_DIR}/bandarchy" -p "${ROOT_DIR}/App.qml" "$@"

