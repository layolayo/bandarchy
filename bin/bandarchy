_quiet = False
_sync_lock_fd = None
_download_lock_fd = None


class BandarchyError(ValueError):
    """Expected operational error reported cleanly as JSON."""


class quiet:
    """Suppress stdout exit inside background helper calls."""

    def __enter__(self):
        global _quiet
        self.was = _quiet
        _quiet = True
        return self

    def __exit__(self, *exc):
        global _quiet
        _quiet = self.was
        return False


def redact(text: str) -> str:
    return SECRET_PATTERN.sub(r"\1=<redacted>", str(text or ""))


def bounded_text(val, limit: int = MAX_FIELD_CHARS) -> str:
    if val is None:
        return ""
    s = str(val).strip()
    s = "".join(ch for ch in s if ch == "\n" or ch == "\t" or ord(ch) >= 32)
    return s[:limit]


def bounded_int(val, default: int = 0, minimum: int = 0, maximum: int = 2_000_000_000) -> int:
    try:
        n = int(float(val))
        return max(minimum, min(maximum, n))
    except (ValueError, TypeError):
        return default


def bounded_float(val, default: float = 0.0, minimum: float = 0.0, maximum: float = 1e9) -> float:
    try:
        n = float(val)
        if n != n:
            return default
        return max(minimum, min(maximum, n))
    except (ValueError, TypeError):
        return default


def fold(text: str) -> str:
    norm = unicodedata.normalize("NFKD", str(text or ""))
    clean = "".join(c for c in norm if not unicodedata.combining(c)).casefold()
    return re.sub(r"[^a-z0-9]+", " ", clean).strip()


def slugify(text: str) -> str:
    s = fold(text).replace(" ", "-")
    return re.sub(r"-+", "-", s).strip("-") or "unknown"


def ensure_private_dir(path: str) -> str:
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise BandarchyError(f"refusing symlinked or non-directory path: {path}")
    if st.st_uid != os.getuid():
        raise BandarchyError(f"refusing foreign-owned directory: {path}")
    if (st.st_mode & 0o777) != 0o700:
        try:
            os.chmod(path, 0o700)
        except OSError:
            pass
    return path


def _make_private_temp_file(prefix: str = "ba_", suffix: str = ".tmp") -> str:
    """Create a 0o600 temporary file with O_CREAT | O_EXCL | O_NOFOLLOW inside RUNTIME_DIR (never /tmp)."""
    rt_dir = ensure_private_dir(RUNTIME_DIR)
    tmp_path = os.path.join(rt_dir, f"{prefix}{secrets.token_hex(8)}{suffix}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(tmp_path, flags, 0o600)
    try:
        os.fchmod(fd, 0o600)
    finally:
        os.close(fd)
    return tmp_path


def safe_write_bytes(path: str, data: bytes, mode: int = 0o600, fatal: bool = True) -> None:
    """Atomically write bytes to `path` via mkstemp(dir=target_dir) + fchmod(0o600) + fsync + os.replace."""
    abs_path = os.path.abspath(path)
    target_dir = os.path.dirname(abs_path)
    tmp_path = ""
    try:
        ensure_private_dir(target_dir)
        if os.path.lexists(abs_path):
            st = os.lstat(abs_path)
            if stat.S_ISLNK(st.st_mode):
                raise BandarchyError(f"refusing symlinked file: {abs_path}")
            if st.st_uid != os.getuid():
                raise BandarchyError(f"refusing foreign-owned file: {abs_path}")
        fd, tmp_path = tempfile.mkstemp(
            prefix=f".{os.path.basename(abs_path)}.",
            suffix=".tmp",
            dir=target_dir,
        )
        try:
            os.fchmod(fd, mode)
            os.write(fd, data)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp_path, abs_path)
        tmp_path = ""
    except Exception as exc:
        if tmp_path and os.path.lexists(tmp_path):
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        if fatal:
            die(f"failed to write {os.path.basename(abs_path)}: {exc}")


def safe_write_text(path: str, text: str, mode: int = 0o600, fatal: bool = True) -> None:
    safe_write_bytes(path, str(text).encode("utf-8"), mode=mode, fatal=fatal)


def safe_read_bytes(path: str, max_bytes: int = MAX_HTTP_BYTES) -> bytes | None:
    """Read up to `max_bytes` from a regular file owned by current user or root with O_NOFOLLOW and hardlink check."""
    uid = os.getuid()
    try:
        st_l = os.lstat(path)
        if stat.S_ISLNK(st_l.st_mode) or not stat.S_ISREG(st_l.st_mode):
            return None
        if st_l.st_uid not in (uid, 0):
            return None
        if st_l.st_uid != 0 and st_l.st_nlink > 1:
            return None
        flags = os.O_RDONLY
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(path, flags)
        try:
            st_f = os.fstat(fd)
            if (
                not stat.S_ISREG(st_f.st_mode)
                or st_f.st_uid not in (uid, 0)
                or (st_f.st_uid != 0 and st_f.st_nlink > 1)
                or st_f.st_ino != st_l.st_ino
                or st_f.st_dev != st_l.st_dev
            ):
                return None
            chunks: list[bytes] = []
            total = 0
            while total < max_bytes:
                chunk = os.read(fd, min(65536, max_bytes - total))
                if not chunk:
                    break
                chunks.append(chunk)
                total += len(chunk)
            return b"".join(chunks)
        finally:
            os.close(fd)
    except OSError:
        return None


def safe_read_text(path: str, max_bytes: int = MAX_HTTP_BYTES) -> str | None:
    raw = safe_read_bytes(path, max_bytes=max_bytes)
    if raw is None:
        return None
    return raw.decode("utf-8", errors="replace")


def safe_load_json(path: str, default=None, max_bytes: int = MAX_HTTP_BYTES):
    try:
        st = os.lstat(path)
        if st.st_size > max_bytes:
            return default
    except OSError:
        return default
    raw_text = safe_read_text(path, max_bytes=max_bytes)
    if raw_text is None:
        return default
    try:
        return json.loads(raw_text)
    except Exception:
        return default


def atomic_write(path: str, data: bytes, mode: int = 0o600, fatal: bool = True) -> None:
    safe_write_bytes(path, data, mode=mode, fatal=fatal)


def read_json(path: str, default=None):
    return safe_load_json(path, default=default, max_bytes=MAX_HTTP_BYTES)


def write_json(path: str, payload, mode: int = 0o600) -> None:
    raw = (json.dumps(payload, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
    safe_write_bytes(path, raw, mode=mode)


def log_failure(message: str) -> None:
    try:
        ensure_private_dir(CACHE_DIR)
        line = redact(message).replace("\n", " ")[:1000]
        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
        existing = []
        prev_txt = safe_read_text(LOG_FILE, max_bytes=512 * 1024)
        if prev_txt:
            existing = [l.rstrip("\n") for l in prev_txt.splitlines()[-LOG_LINES:]]
        existing.append(f"{stamp} {line}")
        existing = existing[-LOG_LINES:]
        safe_write_bytes(LOG_FILE, ("\n".join(existing) + "\n").encode("utf-8"), 0o600, fatal=False)
    except Exception:
        pass


def die(message: str, code: int = 1):
    if _quiet:
        raise BandarchyError(message)
    log_failure(message)
    json.dump({"ok": False, "error": bounded_text(redact(message), 512)}, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    sys.exit(code)


def emit(payload: dict) -> None:
    if _quiet:
        return
    payload.setdefault("ok", True)
    json.dump(payload, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def take_lock(lock_path: str) -> int | None:
    ensure_private_dir(os.path.dirname(lock_path))
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(lock_path, flags, 0o600)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink > 1:
            os.close(fd)
            return None
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        os.ftruncate(fd, 0)
        os.write(fd, f"{os.getpid()}\n".encode("ascii"))
        return fd
    except OSError:
        os.close(fd)
        return None


def is_locked(lock_path: str) -> bool:
    if not os.path.exists(lock_path):
        return False
    flags = os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(lock_path, flags)
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink > 1:
            return False
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


