def _resolve_runtime_dir() -> str:
    """Resolve a private, non-symlinked, user-owned 0o700 runtime directory (never /tmp)."""
    uid = os.getuid()
    candidates = []
    xdg_rt = (os.environ.get("XDG_RUNTIME_DIR") or "").strip()
    if xdg_rt:
        candidates.append(os.path.join(xdg_rt, "bandarchy"))
    candidates.append(f"/run/user/{uid}/bandarchy")
    candidates.append(os.path.join(CACHE_DIR, "runtime"))
    for cand in candidates:
        parent = os.path.dirname(os.path.abspath(cand))
        try:
            if os.path.lexists(parent):
                pst = os.lstat(parent)
                if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode) or pst.st_uid != uid:
                    continue
            os.makedirs(cand, mode=0o700, exist_ok=True)
            pst = os.lstat(parent)
            st = os.lstat(cand)
            if (
                stat.S_ISLNK(pst.st_mode)
                or not stat.S_ISDIR(pst.st_mode)
                or pst.st_uid != uid
                or stat.S_ISLNK(st.st_mode)
                or not stat.S_ISDIR(st.st_mode)
                or st.st_uid != uid
            ):
                continue
            os.chmod(cand, 0o700)
            return cand
        except OSError:
            continue
    fallback = os.path.join(CACHE_DIR, "runtime")
    fb_parent = os.path.dirname(os.path.abspath(fallback))
    if os.path.lexists(fb_parent):
        pst = os.lstat(fb_parent)
        if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode) or pst.st_uid != uid:
            raise RuntimeError("unsafe runtime directory")
    os.makedirs(fallback, mode=0o700, exist_ok=True)
    pst = os.lstat(fb_parent)
    st = os.lstat(fallback)
    if (
        stat.S_ISLNK(pst.st_mode)
        or not stat.S_ISDIR(pst.st_mode)
        or pst.st_uid != uid
        or stat.S_ISLNK(st.st_mode)
        or not stat.S_ISDIR(st.st_mode)
        or st.st_uid != uid
    ):
        raise RuntimeError("unsafe runtime directory")
    os.chmod(fallback, 0o700)
    return fallback


