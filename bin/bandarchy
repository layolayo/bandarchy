    "/usr/bin",
    "/bin",
    OMARCHY_BIN_DIR,
)


def resolve_bin(name: str, extra_dirs: tuple[str, ...] = (), required: bool = False) -> str:
    """Resolve an executable from trusted system/Omarchy directories with ownership & mode checks."""
    uid = os.getuid()
    for d in (*TRUSTED_BIN_DIRS, *extra_dirs):
        if not d:
            continue
        cand = os.path.join(d, name)
        try:
            st = os.stat(cand)
            if (
                stat.S_ISREG(st.st_mode)
                and (st.st_mode & 0o111)
                and not (st.st_mode & stat.S_IWOTH)
                and st.st_uid in (0, uid)
            ):
                return cand
        except OSError:
            continue
    if required:
        raise BandarchyError(f"required trusted binary not found: {name}")
    return ""


