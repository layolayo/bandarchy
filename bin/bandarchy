def _default_statements_seed_text() -> str:
    seed_txt = safe_read_text(DEFAULT_STATEMENTS_FILE, max_bytes=256 * 1024)
    if not seed_txt:
        seed_txt = (
            "# Bandarchy — 6: Typography Statements & Words Collection\n"
            "# One statement or word per line ('#' comments are ignored).\n\n"
            + "\n".join(DEFAULT_STATEMENTS_FALLBACK)
            + "\n"
        )
    return seed_txt


def load_statements() -> list[str]:
    """Load user-customisable statements from ~/.config/bandarchy/statements.txt (seeding from share/statements.txt if absent)."""
    ensure_private_dir(CONFIG_DIR)
    if not os.path.exists(STATEMENTS_FILE):
        seed_txt = _default_statements_seed_text()
        safe_write_bytes(STATEMENTS_FILE, seed_txt.encode("utf-8"), mode=0o600, fatal=False)
    raw = safe_read_text(STATEMENTS_FILE, max_bytes=256 * 1024)
    if not raw:
        raw = safe_read_text(DEFAULT_STATEMENTS_FILE, max_bytes=256 * 1024) or ""
    lines: list[str] = []
    for raw_line in raw.splitlines():
        s = raw_line.strip()
        if not s or s.startswith("#"):
            continue
        lines.append(bounded_text(s, 160))
        if len(lines) >= 500:
            break
    return lines if lines else list(DEFAULT_STATEMENTS_FALLBACK)


def save_statements(raw_items: list[str] | str) -> list[str]:
    """Persist user-edited statements list directly to ~/.config/bandarchy/statements.txt and return the cleaned list."""
    ensure_private_dir(CONFIG_DIR)
    if isinstance(raw_items, str):
        candidate_lines = raw_items.splitlines()
    elif isinstance(raw_items, list):
        candidate_lines = []
        for item in raw_items:
            if isinstance(item, str):
                candidate_lines.extend(item.splitlines())
    else:
        candidate_lines = []

    cleaned: list[str] = []
    for raw_line in candidate_lines:
        s = raw_line.strip()
        if not s or s.startswith("#"):
            continue
        cleaned.append(bounded_text(s, 160))
        if len(cleaned) >= 500:
            break

    if not cleaned:
        cleaned = list(DEFAULT_STATEMENTS_FALLBACK)

    header = (
        "# Bandarchy — 6: Typography Statements & Words Collection\n"
        "# Add, edit, or remove any statements or words below (one statement per line).\n"
        "# Lines starting with '#' and blank lines are ignored.\n"
        "# Your personal copy lives at: ~/.config/bandarchy/statements.txt\n\n"
    )
    body = "\n".join(cleaned) + "\n"
    safe_write_bytes(STATEMENTS_FILE, (header + body).encode("utf-8"), mode=0o600, fatal=False)
    return load_statements()


def reset_statements() -> list[str]:
    """Reset ~/.config/bandarchy/statements.txt back to the default statements seed file."""
    ensure_private_dir(CONFIG_DIR)
    seed_txt = _default_statements_seed_text()
    safe_write_bytes(STATEMENTS_FILE, seed_txt.encode("utf-8"), mode=0o600, fatal=False)
    return load_statements()


def cmd_visualiser_config(args) -> None:
    if getattr(args, "reset_statements", False):
        statements_list = reset_statements()
    elif getattr(args, "save_statements", None) is not None:
        raw_arg = args.save_statements
        try:
            parsed_arg = json.loads(raw_arg)
            if isinstance(parsed_arg, (list, str)):
                statements_list = save_statements(parsed_arg)
            else:
                statements_list = save_statements(str(raw_arg))
        except Exception:
            statements_list = save_statements(str(raw_arg))
    else:
        statements_list = load_statements()

    if getattr(args, "open_statements", False):
        xdg_open = resolve_bin("xdg-open")
        if xdg_open:
            subprocess.Popen(
                [xdg_open, STATEMENTS_FILE],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
    existing = read_json(VISUALISER_CONFIG_FILE, {})
    if not isinstance(existing, dict):
        existing = {}
    if getattr(args, "set", None) is not None:
        try:
            incoming = json.loads(args.set)
        except Exception as exc:
            die(f"invalid --set JSON payload: {exc}")
        if not isinstance(incoming, dict):
            die("--set payload must be a JSON object")
        if "saveStatements" in incoming and isinstance(incoming["saveStatements"], (list, str)):
            statements_list = save_statements(incoming["saveStatements"])
        incoming_clean = {k: v for k, v in incoming.items() if k not in ("statements", "statementsPath", "saveStatements")}
        existing.update(incoming_clean)
        existing["updatedAt"] = int(time.time())
        write_json(VISUALISER_CONFIG_FILE, existing, mode=0o600)
    emit({
        "status": "ok",
        "config": existing,
        "statements": statements_list,
        "statementsPath": STATEMENTS_FILE,
        "path": VISUALISER_CONFIG_FILE,
    })


def _kill_bandarchy_processes(kill_mpv: bool = True) -> None:
    if kill_mpv:
        try:
            mpv_stop()
        except Exception:
            pass
    import signal

    uid = os.getuid()
    my_pid = os.getpid()
    allowed_exes = ("mpv", "cava", "quickshell", "bandarchy", "bandarchy-player", "python", "python3")
    try:
        proc_entries = os.listdir("/proc")
    except OSError:
        proc_entries = []
    killed_pids = []
    for entry in proc_entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == my_pid:
            continue
        proc_dir = f"/proc/{pid}"
        try:
            st = os.lstat(proc_dir)
            if st.st_uid != uid:
                continue
            raw_cmd = safe_read_bytes(f"{proc_dir}/cmdline", max_bytes=65536)
            if not raw_cmd:
                continue
            parts = [p.decode("utf-8", errors="replace") for p in raw_cmd.split(b"\x00") if p]
            if not parts:
                continue
            exe_name = os.path.basename(parts[0])
            if exe_name not in allowed_exes:
                continue
            is_bandarchy_ui = (
                exe_name in ("quickshell", "bandarchy", "bandarchy-player")
                and "-p" in parts
                and any(p.endswith("/App.qml") and ("bandarchy" in p or "io.github.layolayo.bandarchy" in p) for p in parts)
            )
            is_bandarchy_cava = (
                exe_name == "cava"
                and "-p" in parts
                and any(("bandarchy" in p or "io.github.layolayo.bandarchy" in p) and p.endswith("cava.conf") for p in parts)
            )
            is_bandarchy_mpv = (
                kill_mpv
                and exe_name == "mpv"
                and ("--audio-client-name=Bandarchy" in parts or any("bandarchy.sock" in p for p in parts))
            )
            if is_bandarchy_ui or is_bandarchy_cava or is_bandarchy_mpv:
                os.kill(pid, signal.SIGTERM)
                killed_pids.append(pid)
        except OSError:
            continue
    if killed_pids:
        for _ in range(8):
            alive = [p for p in killed_pids if os.path.exists(f"/proc/{p}")]
            if not alive:
                break
            time.sleep(0.05)
        for p in killed_pids:
            if os.path.exists(f"/proc/{p}"):
                try:
                    os.kill(p, signal.SIGKILL)
                except OSError:
                    pass


def cmd_kill(args) -> None:
    _kill_bandarchy_processes(kill_mpv=True)
    emit({"action": "kill", "status": "stopped"})


def _resolve_plugin_root() -> str:
    base = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if os.path.isfile(os.path.join(base, "App.qml")):
        return base
    xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    plugin_cand = os.path.join(xdg_cfg, "omarchy", "plugins", "io.github.layolayo.bandarchy")
    if os.path.isfile(os.path.join(plugin_cand, "App.qml")):
        return plugin_cand
    repo_cand = os.path.join(HOME, "Projects", "bandarchy")
    if os.path.isfile(os.path.join(repo_cand, "App.qml")):
        return repo_cand
    return base


def cmd_restart(args) -> None:
    _kill_bandarchy_processes(kill_mpv=False)
    time.sleep(0.2)
    root_dir = _resolve_plugin_root()
    app_qml = os.path.join(root_dir, "App.qml")
    qs_bin = resolve_bin("quickshell")
    if os.path.isfile(app_qml) and qs_bin:
        ensure_private_dir(RUNTIME_DIR)
        bandarchy_bin = os.path.join(RUNTIME_DIR, "bandarchy")
        try:
            if os.path.islink(bandarchy_bin) or os.path.exists(bandarchy_bin):
                os.unlink(bandarchy_bin)
            os.symlink(qs_bin, bandarchy_bin)
        except Exception:
            bandarchy_bin = qs_bin
        subprocess.Popen(
            [bandarchy_bin, "-p", app_qml],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    emit({"action": "restart", "status": "restarted"})


def _resolve_photo_import_script() -> str:
    root_dir = _resolve_plugin_root()
    candidates = (
        os.path.join(root_dir, "share", "photo_engine", "bandarchy_photo_import.py"),
        "/usr/share/bandarchy/photo_engine/bandarchy_photo_import.py",
        "/usr/share/omarchy/plugins/io.github.layolayo.bandarchy/share/photo_engine/bandarchy_photo_import.py",
        os.path.join(HOME, "Pictures", "bandarchy", "bandarchy_photo_import.py"),
    )
    for cand in candidates:
        if os.path.isfile(cand) and not os.path.islink(cand):
            return cand
    die("bandarchy_photo_import.py not found in share/photo_engine/")
    return ""


def _load_photo_import_module():
    script_path = _resolve_photo_import_script()
    script_dir = os.path.dirname(script_path)
    if script_dir not in sys.path:
        sys.path.insert(0, script_dir)
    import bandarchy_photo_import as bpi

    return bpi


def _emit_photo_pipeline_payload(parsed: dict) -> None:
    if not parsed.get("ok", True):
        die(str(parsed.get("error") or "photo pipeline command failed"))
    parsed.setdefault("status", "ok")
    cats_dict = (
        parsed.get("categories")
        if isinstance(parsed.get("categories"), dict)
        else (
            parsed.get("categories_summary")
            if isinstance(parsed.get("categories_summary"), dict)
            else None
        )
    )
    if isinstance(cats_dict, dict):
        tot_imp = int(
            parsed.get(
                "total_imported_sources",
                sum(int(v.get("imported_count", 0)) for v in cats_dict.values() if isinstance(v, dict)),
            )
        )
        tot_proc = int(
            parsed.get(
                "total_processed_outputs",
                sum(int(v.get("processed_count", 0)) for v in cats_dict.values() if isinstance(v, dict)),
            )
        )
        cat_counts: dict[str, int] = {"all": tot_imp}
        cat_labels: dict[str, str] = {"all": "All Categories"}
        for k, v in cats_dict.items():
            if isinstance(v, dict):
                cat_counts[k] = int(v.get("imported_count", 0))
                if v.get("label"):
                    cat_labels[k] = str(v["label"])
                else:
                    cat_labels[k] = " ".join(w.capitalize() for w in re.split(r"[_\s-]+", str(k)) if w) or str(k).title()
        parsed["categoryCounts"] = cat_counts
        if "category_labels" in parsed and isinstance(parsed["category_labels"], dict):
            cat_labels.update({str(k): str(v) for k, v in parsed["category_labels"].items()})
        parsed["categoryLabels"] = cat_labels
        discovered = parsed.get("discovered_categories")
        if not isinstance(discovered, list) or not discovered:
            discovered = sorted(cats_dict.keys())
        parsed["discoveredCategories"] = [str(c) for c in discovered]
        parsed["standard_categories"] = [str(c) for c in discovered]
        parsed["totalOriginals"] = tot_imp
        parsed["totalProcessed"] = tot_proc
        custom_info = cats_dict.get("custom") if isinstance(cats_dict.get("custom"), dict) else {}
        root_dir = str(parsed.get("root_dir") or _resolve_photo_base_dir())
        parsed["customDir"] = str(
            custom_info.get("drop_in_dir") or os.path.join(root_dir, "categories", "custom")
        )
    if "imported_sources_count" in parsed:
        parsed["importedOriginals"] = int(parsed.get("imported_sources_count", 0))
    if "generated_outputs_count" in parsed:
        parsed["generatedVariants"] = int(parsed.get("generated_outputs_count", 0))
    if "source_stem" in parsed:
        parsed["sourceStem"] = str(parsed.get("source_stem") or "")
    if "activeVariants" not in parsed:
        if isinstance(parsed.get("variants"), dict) and parsed["variants"]:
            parsed["activeVariants"] = parsed["variants"]
        else:
            imp_list = parsed.get("imported") or parsed.get("deduplicated")
            if isinstance(imp_list, list) and imp_list:
                first_imp = imp_list[0]
                if isinstance(first_imp, dict) and isinstance(first_imp.get("outputs"), list):
                    av_map: dict[str, str] = {}
                    for out_item in first_imp["outputs"]:
                        if isinstance(out_item, dict):
                            eff_key = out_item.get("effect")
                            p_val = out_item.get("output_path") or out_item.get("path")
                            if eff_key and p_val:
                                av_map[str(eff_key)] = str(p_val)
                    parsed["activeVariants"] = av_map
    emit(parsed)


def _run_photo_import_cli(extra_args: list[str], timeout_sec: int = 180) -> None:
    script_path = _resolve_photo_import_script()
    cmd = [sys.executable, script_path, *extra_args, "--json"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout_sec)
    except subprocess.TimeoutExpired:
        die("photo pipeline timed out")
        return
    raw_out = (r.stdout or "").strip()
    if raw_out:
        last_line = raw_out.splitlines()[-1].strip()
        try:
            parsed = json.loads(last_line)
            if isinstance(parsed, dict):
                _emit_photo_pipeline_payload(parsed)
                return
        except Exception:
            pass
    if r.returncode != 0:
        err_msg = (r.stderr or raw_out or "photo pipeline failed").strip()
        die(err_msg)
    emit({"status": "ok"})


def _pick_existing_or_default_bandarchy_subdir(pics_dir: str) -> str:
    lower_cand = os.path.join(pics_dir, "bandarchy")
    if os.path.exists(lower_cand):
        return lower_cand
    upper_cand = os.path.join(pics_dir, "Bandarchy")
    if os.path.exists(upper_cand):
        return upper_cand
    try:
        for entry in os.listdir(pics_dir):
            if entry.lower() == "bandarchy":
                full = os.path.join(pics_dir, entry)
                if os.path.isdir(full):
                    return full
    except OSError:
        pass
    return lower_cand


def _resolve_photo_base_dir(explicit_base_dir: str | None = None) -> str:
    if explicit_base_dir:
        return os.path.abspath(os.path.expanduser(str(explicit_base_dir)))
    env_override = (os.environ.get("BANDARCHY_PICTURES_DIR") or "").strip()
    if env_override:
        return os.path.abspath(os.path.expanduser(env_override))
    xdg_pics = (os.environ.get("XDG_PICTURES_DIR") or "").strip()
    if xdg_pics:
        return _pick_existing_or_default_bandarchy_subdir(os.path.abspath(os.path.expanduser(xdg_pics)))
    return _pick_existing_or_default_bandarchy_subdir(os.path.join(HOME, "Pictures"))


def cmd_photo_status(args) -> None:
    base_dir = _resolve_photo_base_dir(getattr(args, "base_dir", None))
    bpi = _load_photo_import_module()
    try:
        if getattr(args, "init_dirs", False):
            bpi.ensure_directory_structure(base_dir, include_defaults=True)
        parsed = bpi.rebuild_manifests(base_dir)
    except Exception as exc:
        die(str(exc))
        return
    _emit_photo_pipeline_payload(parsed)


def cmd_photo_import(args) -> None:
    base_dir = _resolve_photo_base_dir(getattr(args, "base_dir", None))
    src_dir = getattr(args, "source_dir", None) or getattr(args, "source_dir_opt", None)
    if src_dir and str(src_dir).strip().lower() not in ("", "all"):
        src_dir_abs = os.path.abspath(os.path.expanduser(str(src_dir).strip()))
        base_abs = os.path.abspath(base_dir)
        cats_abs = os.path.abspath(os.path.join(base_dir, "categories"))
        raw_abs = os.path.abspath(os.path.join(base_dir, "raw"))
        # Only copy into categories/custom if src_dir_abs is an external folder outside the photo library root
        if (
            os.path.isdir(src_dir_abs)
            and not os.path.islink(src_dir_abs)
            and src_dir_abs not in (base_abs, cats_abs, raw_abs)
            and not src_dir_abs.startswith(base_abs + os.sep)
        ):
            custom_drop = os.path.join(base_dir, "categories", "custom")
            os.makedirs(custom_drop, mode=0o755, exist_ok=True)
            if os.path.abspath(custom_drop) != src_dir_abs:
                for entry in sorted(os.listdir(src_dir_abs)):
                    if entry.startswith("."):
                        continue
                    ext = os.path.splitext(entry)[1].lower()
                    if ext not in (".jpg", ".jpeg", ".png", ".webp", ".jxl", ".avif", ".bmp", ".tiff", ".tif"):
                        continue
                    s_file = os.path.join(src_dir_abs, entry)
                    if os.path.isfile(s_file) and not os.path.islink(s_file):
                        shutil.copy2(s_file, os.path.join(custom_drop, entry))
    extra: list[str] = ["--import", "--base-dir", base_dir]
    if getattr(args, "category", None):
        extra.extend(["--category", str(args.category)])
    if getattr(args, "effects", None):
        extra.extend(["--effects", str(args.effects)])
    max_dim = getattr(args, "max_size", None) or getattr(args, "max_dim", None)
    if max_dim is not None:
        extra.extend(["--max-dim", str(int(max_dim))])
    if getattr(args, "force", False):
        extra.append("--force")
    sources_dir = os.path.join(base_dir, "sources")
    if getattr(args, "seed_from_sources", False) or (getattr(args, "ensure_demo", False) and os.path.isdir(sources_dir)):
        extra.append("--seed-from-sources")
    if getattr(args, "force_seed", False):
        extra.append("--force-seed")
    _run_photo_import_cli(extra, timeout_sec=240)


def cmd_photo_pick(args) -> None:
    base_dir = _resolve_photo_base_dir(getattr(args, "base_dir", None))
    bpi = _load_photo_import_module()
    try:
        parsed = bpi.pick_category_photo(
            base_dir,
            category=str(getattr(args, "category", None) or "all"),
            effect=str(args.effect) if getattr(args, "effect", None) else None,
            stem=str(args.stem) if getattr(args, "stem", None) else None,
            exclude_stem=str(args.exclude_stem) if getattr(args, "exclude_stem", None) else None,
            seed=int(args.seed) if getattr(args, "seed", None) is not None else None,
        )
    except Exception as exc:
        die(str(exc))
        return
    _emit_photo_pipeline_payload(parsed)


def main() -> None:
    if len(sys.argv) == 1:
        sys.argv.append("restart")
    elif len(sys.argv) == 2 and sys.argv[1] in ("--kill", "-k", "stop", "--stop"):
        sys.argv[1] = "kill"
    elif len(sys.argv) == 2 and sys.argv[1] in ("--restart", "-r", "start", "--start", "gui", "--gui"):
        sys.argv[1] = "restart"
    parser = argparse.ArgumentParser(prog="bandarchy", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("kill", help="stop all Bandarchy UI, cava, and mpv processes").set_defaults(func=cmd_kill)
    sub.add_parser("restart", help="restart standalone Bandarchy player window").set_defaults(func=cmd_restart)

    p = sub.add_parser("photo-status", help="rebuild photo category manifests from processed/ folders and return counts")
    p.add_argument("--base-dir", help="override ~/Pictures/bandarchy root directory")
    p.add_argument("--init-dirs", action="store_true", help="ensure category directories exist")
    p.set_defaults(func=cmd_photo_status)

    p = sub.add_parser("photo-import", help="scan all source folders in ~/Pictures/bandarchy/ and translate new photos across all 16 Stark effects")
    p.add_argument("source_dir", nargs="?", default=None, help="optional external folder of raw images to copy into categories/custom/")
    p.add_argument("--source-dir", dest="source_dir_opt", default=None, help="optional external folder of raw images to copy into categories/custom/")
    p.add_argument("--ensure-demo", action="store_true", help="seed categories from sources/ if available")
    p.add_argument("--category", default="all", help="category folder name inside processed/ (or all)")
    p.add_argument("--effects", help="comma-separated list of effect IDs (defaults to all 16)")
    p.add_argument("--max-dim", type=int, default=480, help="maximum dimension in pixels for translated PNGs (default: 480)")
    p.add_argument("--max-size", type=int, default=None, help="alias for --max-dim")
    p.add_argument("--force", action="store_true", help="re-process source images even if all 16 processed variants exist")
    p.add_argument("--seed-from-sources", action="store_true", help="seed categories from sources/ before importing")
    p.add_argument("--force-seed", action="store_true", help="force re-seeding from sources/")
    p.add_argument("--base-dir", help="override ~/Pictures/bandarchy root directory")
    p.set_defaults(func=cmd_photo_import)

    p = sub.add_parser("photo-pick", help="pick a translated Stark photograph from processed/<category>/ and return its 16 variant paths")
    p.add_argument("--category", default="all", help="category folder name inside processed/ or all")
    p.add_argument("--effect", help="specific Stark effect ID (01..16)")
    p.add_argument("--stem", help="specific source_stem")
    p.add_argument("--exclude-stem", help="exclude a specific source_stem when picking randomly")
    p.add_argument("--seed", type=int, help="deterministic RNG seed")
    p.add_argument("--base-dir", help="override ~/Pictures/bandarchy root directory")
    p.set_defaults(func=cmd_photo_pick)

    p = sub.add_parser("visualiser-config", help="get or atomically persist visualiser configuration and saved L1/L2/L3 layer items")
    p.add_argument("--get", action="store_true", help="read ~/.config/bandarchy/visualiser.json")
    p.add_argument("--set", help="atomically write JSON object to ~/.config/bandarchy/visualiser.json")
    p.add_argument("--open-statements", action="store_true", help="open ~/.config/bandarchy/statements.txt in default editor")
    p.add_argument("--save-statements", help="persist JSON array or newline-separated text to ~/.config/bandarchy/statements.txt")
    p.add_argument("--reset-statements", action="store_true", help="reset ~/.config/bandarchy/statements.txt to default collection")
    p.set_defaults(func=cmd_visualiser_config)

    p = sub.add_parser("collection", help="list collection items filtered by scope and query")
    p.add_argument("--scope", choices=["all", "purchased", "local", "cloud"], default="all")
    p.add_argument("--query", default="")
    p.set_defaults(func=cmd_collection)

    p = sub.add_parser("album", help="resolve and return full tracklist for an album")
    p.add_argument("--id", required=True, help="album id or URL")
    p.set_defaults(func=cmd_album)

    p = sub.add_parser("search", help="search across albums and tracks")
    p.add_argument("query", nargs="?", default="")
    p.add_argument("--scope", choices=["all", "purchased", "local", "cloud"], default="all")
    p.add_argument("--limit", type=int, default=100)
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("sync", help="synchronise Bandcamp purchases and local music folders")
    p.add_argument("--username", help="Bandcamp fan username")
    p.add_argument("--api-base", help="Bandcamp base URL override (for testing)")
    p.add_argument("--local-only", action="store_true", help="only scan local folders and browser history")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("auth", help="configure Bandcamp username, session cookie, login/logout, or visualiser options")
    p.add_argument("--username")
    p.add_argument("--identity", help="Bandcamp identity cookie value")
    p.add_argument("--logout", action="store_true", help="log out of Bandcamp and clear saved identity")
    p.add_argument("--detect-browser", action="store_true", help="auto-detect Bandcamp username and identity cookie from browser")
    p.add_argument("--open-browser", action="store_true", help="open Bandcamp login page in default browser")
    p.add_argument("--download-dir")
    p.add_argument("--format", choices=["flac", "mp3-320", "mp3-v0", "wav", "ogg"])
    p.add_argument("--use-album-art", choices=["0", "1"], help="whether visualiser translates album cover art")
    p.add_argument("--ascii-mode", choices=["braille", "block", "banner", "text"], help="omarchy-transcode-ascii or banner mode")
    p.add_argument("--stage-mode", choices=["off", "art", "turntable", "visualiser"], help="active visualiser stage mode")
    p.add_argument("--top-bar-led", choices=["0", "1", "true", "false"], help="enable or disable the Omarchy top status bar LED equaliser")
    p.add_argument("--set-json", help="JSON object of visualiser/turntable settings to update")
    p.add_argument("--add-url", help="add a Bandcamp album or track URL to the purchased collection")
    p.set_defaults(func=cmd_auth)

    p = sub.add_parser("login", help="log into Bandcamp (from browser or explicit credentials) and sync")
    p.add_argument("--username", help="Bandcamp fan username")
    p.add_argument("--identity", help="Bandcamp identity cookie")
    p.add_argument("--detect-browser", action="store_true", help="detect credentials from browser")
    p.add_argument("--open-browser", action="store_true", help="open Bandcamp login page in browser")
    p.add_argument("--no-sync", action="store_true", help="skip remote sync after logging in")
    p.set_defaults(func=cmd_login)

    p = sub.add_parser("logout", help="log out of Bandcamp and clear stored session")
    p.set_defaults(func=cmd_logout)

    p = sub.add_parser("ascii-art", help="transcode album cover art into Omarchy screensaver ASCII/Unicode")
    p.add_argument("--album", help="album id or URL")
    p.add_argument("--image", help="explicit image path")
    p.add_argument("--text", help="fallback banner text for omarchy-ascii")
    p.add_argument("--mode", choices=["braille", "block", "banner", "text"], default=None)
    p.add_argument("--width", type=int, default=72)
    p.add_argument("--height", type=int, default=32)
    p.add_argument("--threshold", type=int, default=50)
    p.add_argument("--invert", action="store_true")
    p.add_argument("--use-album-art", choices=["0", "1"], default=None)
    p.add_argument("--effect", default="random", help="ttfx effect to extract keyframes for (defaults to random)")
    p.set_defaults(func=cmd_ascii_art)

    p = sub.add_parser("screensaver", help="launch Omarchy ttfx screensaver with transcoded album art")
    p.add_argument("--album", help="album id")
    p.add_argument("--image", help="image path")
    p.add_argument("--text", help="fallback text")
    p.add_argument("--mode", choices=["braille", "block", "banner"], default="braille")
    p.add_argument("--width", type=int, default=72)
    p.add_argument("--height", type=int, default=32)
    p.add_argument("--threshold", type=int, default=50)
    p.add_argument("--invert", action="store_true")
    p.add_argument("--use-album-art", choices=["0", "1"], default="1")
    p.add_argument("--effect", default="random", help="ttfx effect name or random")
    p.add_argument("--tty-loop", action="store_true", help="internal flag: run ttfx fullscreen loop directly in terminal")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_screensaver)

    p = sub.add_parser("smart-playlist", help="build intelligent playlist from last track played")
    p.add_argument("--seed-track", help="seed track id (defaults to last played track)")
    p.add_argument("--seed-album", help="seed album id")
    p.add_argument("--preset", choices=["radio", "kindred", "journey", "purchased"], default="radio")
    p.add_argument("--limit", type=int, default=25)
    p.add_argument("--track-index", type=int, default=0, help="0-based track index to start from when --play is used")
    p.add_argument("--play", action="store_true", help="start playing immediately")
    p.add_argument("--loop", action="store_true")
    p.add_argument("--save-as", help="save generated intelligent playlist as a user playlist")
    p.set_defaults(func=cmd_smart_playlist)

    p = sub.add_parser("playlists", help="create and manage custom user playlists")
    p.add_argument("action", choices=["list", "create", "add", "remove-track", "rename", "delete"])
    p.add_argument("--id", help="playlist id")
    p.add_argument("--title", help="playlist title")
    p.add_argument("--description", help="playlist description")
    p.add_argument("--tracks", help="comma-separated track ids")
    p.add_argument("--album", help="album id to add all tracks from")
    p.add_argument("--track-id", help="track id to remove")
    p.add_argument("--index", type=int, help="0-based track index to remove")
    p.add_argument("--from-smart", choices=["radio", "kindred", "journey", "purchased"])
    p.add_argument("--seed-track", help="seed track id for --from-smart")
    p.set_defaults(func=cmd_playlists)

    p = sub.add_parser("play", help="play an album, playlist, or collection scope through mpv")
    p.add_argument("--album", help="album id or URL")
    p.add_argument("--playlist", help="user playlist id")
    p.add_argument("--track-id", help="track id to start from")
    p.add_argument("--track-index", type=int, default=0, help="0-based track index to start from")
    p.add_argument("--scope", choices=["all", "purchased", "local"], help="play entire scope")
    p.add_argument("--mode", choices=["auto", "local", "stream"], default="auto")
    p.add_argument("--shuffle", action="store_true")
    p.add_argument("--loop", action="store_true")
    p.set_defaults(func=cmd_play)

    p = sub.add_parser("download", help="download a purchased Bandcamp album for local playback")
    p.add_argument("--album", required=True, help="album id or URL")
    p.add_argument("--format", choices=["flac", "mp3-320", "mp3-v0", "wav", "ogg"])
    p.set_defaults(func=cmd_download)

    p = sub.add_parser("import-zip", help="extract and import Bandcamp ZIP archives from ~/Downloads")
    p.add_argument("--zip-path", help="specific ZIP archive path")
    p.set_defaults(func=cmd_import_zip)

    p = sub.add_parser("favourites", help="manage favourite albums")
    p.add_argument("action", choices=["list", "add", "remove", "toggle"])
    p.add_argument("--id")
    p.add_argument("--title")
    p.set_defaults(func=cmd_favourites)

    p = sub.add_parser("cmd", help="control running mpv player")
    p.add_argument(
        "action",
        choices=["play-pause", "play", "pause", "next", "prev", "stop", "volume", "mute", "seek", "loop", "jump"],
    )
    p.add_argument("pos_value", nargs="?", default=None, help="optional positional value (e.g. bandarchy cmd volume 80)")
    p.add_argument("--value", type=float)
    p.set_defaults(func=cmd_cmd)

    p = sub.add_parser("volume", help="get or set playback volume (0..100, +N, -N, or mute)")
    p.add_argument("level", nargs="?", default=None, help="volume level 0..100, +N, -N, or mute")
    p.set_defaults(func=cmd_volume)

    sub.add_parser("now", help="current playback state").set_defaults(func=cmd_now)

    args = parser.parse_args()
    try:
        args.func(args)
    except BandarchyError as exc:
        die(str(exc))
    except Exception as exc:
        die(f"unexpected error: {exc}")


if __name__ == "__main__":
    main()
