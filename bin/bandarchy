# Safety ceilings on untrusted network/disk data
MAX_HTTP_BYTES = 32 * 1024 * 1024
MAX_ART_BYTES = 16 * 1024 * 1024
MAX_DOWNLOAD_BYTES = 2 * 1024 * 1024 * 1024  # 2 GiB archive ceiling
MAX_COLLECTION_ITEMS = 50_000
MAX_FIELD_CHARS = 512
MAX_URL_CHARS = 2048
MAX_IPC_BYTES = 1024 * 1024
LOG_LINES = 200

