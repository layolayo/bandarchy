def load_settings() -> dict:
    defaults = {
        "username": "",
        "loggedOut": False,
        "downloadDir": DEFAULT_DOWNLOAD_DIR,
        "localDirs": DEFAULT_LOCAL_DIRS,
        "preferredFormat": "flac",
        "autoImportZips": True,
        "top_bar_led": True,
        "topBarLedEnabled": True,
        "bgEnabled": True,
        "bgMode": 0,
        "bgTrail": 0.26,
        "bgSpeed": 1.0,
        "bgDensity": 1.0,
        "vizEnabled": True,
        "useAlbumArt": False,
        "asciiMode": "braille",
        "dismantleMode": 0,
        "dismantleForce": 1.15,
        "rebuildCohesion": 0.65,
        "evolutionRate": 0.55,
        "glyphScale": 1.0,
        "apiBase": os.environ.get("BANDARCHY_API_BASE") or os.environ.get("BANDCAMP_API_BASE") or "https://bandcamp.com",
    }
    cfg_saved = read_json(CONFIG_FILE, {})
    if isinstance(cfg_saved, dict):
        defaults.update({k: v for k, v in cfg_saved.items() if v is not None})
    saved = read_json(SETTINGS_FILE, {})
    if isinstance(saved, dict):
        defaults.update({k: v for k, v in saved.items() if v is not None})
    if "top_bar_led" in saved and "topBarLedEnabled" not in saved:
        defaults["topBarLedEnabled"] = bool(saved["top_bar_led"])
    elif "topBarLedEnabled" in saved and "top_bar_led" not in saved:
        defaults["top_bar_led"] = bool(saved["topBarLedEnabled"])
    elif "top_bar_led" in cfg_saved and "topBarLedEnabled" not in cfg_saved:
        defaults["topBarLedEnabled"] = bool(cfg_saved["top_bar_led"])
    env_base = os.environ.get("BANDARCHY_API_BASE") or os.environ.get("BANDCAMP_API_BASE")
    if env_base:
        defaults["apiBase"] = env_base
    return defaults


_keyring_cache: dict[str, bytes] = {}


def _aes_128_cbc_decrypt_inprocess(ct: bytes, key: bytes, iv: bytes) -> bytes:
    """Decrypt AES-128-CBC ciphertext in-process via ctypes libcrypto.so.3 without exposing keys in argv."""
    if not ct or len(ct) % 16 != 0 or len(key) != 16 or len(iv) != 16:
        return b""
    import ctypes
    libcrypto = None
    for lib_name in ("libcrypto.so.3", "libcrypto.so.1.1", "libcrypto.so"):
        try:
            libcrypto = ctypes.CDLL(lib_name)
            break
        except OSError:
            continue
    if libcrypto is None:
        return b""
    libcrypto.EVP_CIPHER_CTX_new.restype = ctypes.c_void_p
    libcrypto.EVP_CIPHER_CTX_free.argtypes = [ctypes.c_void_p]
    libcrypto.EVP_aes_128_cbc.restype = ctypes.c_void_p
    libcrypto.EVP_DecryptInit_ex.argtypes = [
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_char_p, ctypes.c_char_p
    ]
    libcrypto.EVP_DecryptInit_ex.restype = ctypes.c_int
    libcrypto.EVP_DecryptUpdate.argtypes = [
        ctypes.c_void_p, ctypes.c_char_p, ctypes.POINTER(ctypes.c_int), ctypes.c_char_p, ctypes.c_int
    ]
    libcrypto.EVP_DecryptUpdate.restype = ctypes.c_int
    libcrypto.EVP_DecryptFinal_ex.argtypes = [
        ctypes.c_void_p, ctypes.c_char_p, ctypes.POINTER(ctypes.c_int)
    ]
    libcrypto.EVP_DecryptFinal_ex.restype = ctypes.c_int

    ctx = libcrypto.EVP_CIPHER_CTX_new()
    if not ctx:
        return b""
    try:
        out_buf = ctypes.create_string_buffer(len(ct) + 32)
        out_len = ctypes.c_int(0)
        final_len = ctypes.c_int(0)
        if libcrypto.EVP_DecryptInit_ex(ctx, libcrypto.EVP_aes_128_cbc(), None, key, iv) != 1:
            return b""
        if libcrypto.EVP_DecryptUpdate(ctx, out_buf, ctypes.byref(out_len), ct, len(ct)) != 1:
            return b""
        tail_ptr = ctypes.cast(ctypes.addressof(out_buf) + out_len.value, ctypes.c_char_p)
        if libcrypto.EVP_DecryptFinal_ex(ctx, tail_ptr, ctypes.byref(final_len)) != 1:
            return b""
        return out_buf.raw[: out_len.value + final_len.value]
    finally:
        libcrypto.EVP_CIPHER_CTX_free(ctx)


def decrypt_chromium_cookie_value(enc: bytes, app_name: str = "chrome") -> str:
    """Decrypt Linux Chrome/Chromium/Brave v10/v11 AES-128-CBC SQLite cookie values in-process."""
    if not enc or not isinstance(enc, (bytes, bytearray)):
        return ""
    raw_enc = bytes(enc)
    if not raw_enc.startswith((b"v10", b"v11")):
        try:
            return raw_enc.decode("utf-8")
        except Exception:
            return ""

    pw = b"peanuts"
    if raw_enc.startswith(b"v11"):
        if app_name not in _keyring_cache:
            secret_pw = b""
            secret_tool_bin = resolve_bin("secret-tool")
            if secret_tool_bin:
                for cand_app in (app_name, "chrome", "chromium", "brave"):
                    try:
                        r = subprocess.run(
                            [secret_tool_bin, "lookup", "application", cand_app],
                            capture_output=True,
                            timeout=1.5,
                        )
                        if r.returncode == 0 and r.stdout.strip():
                            secret_pw = r.stdout.strip()
                            break
                    except Exception:
                        continue
            _keyring_cache[app_name] = secret_pw or b"peanuts"
        pw = _keyring_cache[app_name]

    key = hashlib.pbkdf2_hmac("sha1", pw, b"saltysalt", 1, 16)
    iv = b" " * 16
    ct = raw_enc[3:]
    if not ct or len(ct) % 16 != 0:
        return ""
    try:
        pt = _aes_128_cbc_decrypt_inprocess(ct, key, iv)
        if not pt:
            return ""
        # Chromium >= 130 prepends a 32-byte SHA-256 domain digest before the plaintext cookie value
        if len(pt) > 32:
            tail = pt[32:]
            try:
                s = tail.decode("utf-8")
                if s and all(32 <= ord(ch) < 127 or ch == "\t" for ch in s):
                    return s.strip()
            except Exception:
                pass
        s_full = pt.decode("utf-8", errors="ignore").strip()
        return "".join(ch for ch in s_full if 32 <= ord(ch) < 127 or ch == "\t")
    except Exception:
        return ""


def discover_from_browsers() -> dict:
    """Scan local Chrome/Chromium/Brave/Firefox/Zen SQLite history & cookies safely via RUNTIME_DIR temp copy."""
    username = ""
    identity_cookie = ""
    albums_by_url: dict[str, dict] = {}
    download_urls: list[str] = []
    cookie_subdomains: set[str] = set()

    if os.environ.get("BANDARCHY_DISABLE_BROWSER_SCAN") == "1" or os.environ.get("BANDCAMP_DISABLE_BROWSER_SCAN") == "1":
        return {
            "username": "",
            "identityCookie": "",
            "hasBrowserSession": False,
            "albums": [],
            "downloads": [],
            "subdomains": [],
        }

    history_globs = [
        os.path.join(HOME, ".config", "google-chrome", "*", "History"),
        os.path.join(HOME, ".config", "chromium", "*", "History"),
        os.path.join(HOME, ".config", "BraveSoftware", "Brave-Browser", "*", "History"),
    ]

    reserved_paths = {
        "discover", "login", "login_confirmed", "cart", "download", "article",
        "tag", "search", "settings", "fans", "artists", "labels", "about",
        "help", "terms_of_use", "privacy", "copyright", "api", "EmbeddedPlayer",
    }

    for pat in history_globs:
        for db_path in glob.glob(pat):
            if not os.path.isfile(db_path) or os.path.islink(db_path):
                continue
            tmp_path = _make_private_temp_file(prefix="ba_hist_", suffix=".sqlite")
            try:
                raw_db = safe_read_bytes(db_path, max_bytes=128 * 1024 * 1024)
                if not raw_db:
                    continue
                safe_write_bytes(tmp_path, raw_db, mode=0o600, fatal=False)
                conn = sqlite3.connect(tmp_path)
                cur = conn.cursor()
                rows = cur.execute(
                    "SELECT url, title FROM urls WHERE url LIKE '%bandcamp.com%' "
                    "ORDER BY last_visit_time DESC LIMIT 500"
                ).fetchall()
                for raw_url, raw_title in rows:
                    try:
                        parsed = urllib.parse.urlparse(raw_url)
                    except Exception:
                        continue
                    host = (parsed.netloc or "").lower()
                    path = parsed.path or ""

                    if host in ("bandcamp.com", "www.bandcamp.com"):
                        parts = [p for p in path.split("/") if p]
                        if len(parts) >= 1 and parts[0] not in reserved_paths:
                            cand = parts[0].strip()
                            if re.match(r"^[a-zA-Z0-9_-]{2,40}$", cand):
                                if len(parts) >= 2 and parts[1] in ("purchases", "wishlist", "following"):
                                    if not username:
                                        username = cand
                                elif not username and " | Bandcamp" in (raw_title or ""):
                                    username = cand
                        if path == "/download" and parsed.query:
                            if raw_url not in download_urls:
                                download_urls.append(bounded_text(raw_url, MAX_URL_CHARS))

                    elif host.endswith(".bandcamp.com") and host != "daily.bandcamp.com":
                        sub = host[: -len(".bandcamp.com")]
                        m = re.match(r"^/(album|track)/([a-zA-Z0-9_-]+)", path)
                        if m:
                            item_type = m.group(1)
                            slug = m.group(2)
                            clean_url = f"https://{host}/{item_type}/{slug}"
                            title_str = bounded_text(raw_title or "")
                            t_parts = [p.strip() for p in title_str.split("|") if p.strip()]
                            item_title = ""
                            artist_name = ""
                            if len(t_parts) >= 2:
                                item_title = t_parts[0]
                                artist_name = t_parts[1]
                            elif len(t_parts) == 1:
                                item_title = t_parts[0]
                            if not item_title or item_title.lower() in ("music", "merch", "bandcamp"):
                                item_title = slug.replace("-", " ").title()
                            if not artist_name or artist_name.lower() == "bandcamp":
                                artist_name = sub.replace("-", " ").title()

                            existing = albums_by_url.get(clean_url)
                            if not existing or (existing["title"] == slug.replace("-", " ").title() and item_title):
                                albums_by_url[clean_url] = {
                                    "url": clean_url,
                                    "title": item_title,
                                    "artist": artist_name,
                                    "subdomain": sub,
                                    "slug": slug,
                                    "itemType": item_type,
                                }
                conn.close()
            except Exception:
                pass
            finally:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass

    cookie_globs = [
        ("chrome", os.path.join(HOME, ".config", "google-chrome", "*", "Cookies")),
        ("chromium", os.path.join(HOME, ".config", "chromium", "*", "Cookies")),
        ("brave", os.path.join(HOME, ".config", "BraveSoftware", "Brave-Browser", "*", "Cookies")),
    ]
    has_identity_cookie = False
    for app_name, pat in cookie_globs:
        for db_path in glob.glob(pat):
            if not os.path.isfile(db_path) or os.path.islink(db_path):
                continue
            tmp_path = _make_private_temp_file(prefix="ba_cook_", suffix=".sqlite")
            try:
                raw_db = safe_read_bytes(db_path, max_bytes=64 * 1024 * 1024)
                if not raw_db:
                    continue
                safe_write_bytes(tmp_path, raw_db, mode=0o600, fatal=False)
                conn = sqlite3.connect(tmp_path)
                rows = conn.execute(
                    "SELECT host_key, name, value, encrypted_value FROM cookies WHERE host_key LIKE '%bandcamp.com'"
                ).fetchall()
                for host_key, name, val, enc_val in rows:
                    hk = (host_key or "").lstrip(".").lower()
                    if name == "identity" and hk == "bandcamp.com":
                        has_identity_cookie = True
                        if not identity_cookie:
                            dec = (val or "").strip() or decrypt_chromium_cookie_value(enc_val, app_name)
                            if dec:
                                identity_cookie = dec
                    if hk.endswith(".bandcamp.com") and hk != "daily.bandcamp.com":
                        cookie_subdomains.add(hk[: -len(".bandcamp.com")])
                conn.close()
            except Exception:
                pass
            finally:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass

    # Also check Firefox / Zen cookies if present
    moz_globs = [
        os.path.join(HOME, ".mozilla", "firefox", "*", "cookies.sqlite"),
        os.path.join(HOME, ".zen", "*", "cookies.sqlite"),
    ]
    for pat in moz_globs:
        for db_path in glob.glob(pat):
            if not os.path.isfile(db_path) or os.path.islink(db_path):
                continue
            tmp_path = _make_private_temp_file(prefix="ba_moz_", suffix=".sqlite")
            try:
                raw_db = safe_read_bytes(db_path, max_bytes=64 * 1024 * 1024)
                if not raw_db:
                    continue
                safe_write_bytes(tmp_path, raw_db, mode=0o600, fatal=False)
                conn = sqlite3.connect(tmp_path)
                rows = conn.execute(
                    "SELECT host, name, value FROM moz_cookies WHERE host LIKE '%bandcamp.com'"
                ).fetchall()
                for host_key, name, val in rows:
                    hk = (host_key or "").lstrip(".").lower()
                    if name == "identity" and hk == "bandcamp.com" and val:
                        has_identity_cookie = True
                        if not identity_cookie:
                            identity_cookie = str(val).strip()
                conn.close()
            except Exception:
                pass
            finally:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass

    return {
        "username": username,
        "identityCookie": identity_cookie,
        "hasBrowserSession": has_identity_cookie or bool(identity_cookie) or bool(username),
        "albums": list(albums_by_url.values()),
        "downloads": download_urls,
        "subdomains": sorted(cookie_subdomains),
    }


# --------------------------------------------------------------------------- #
# HTTP & Bandcamp Scraping / API Client
# --------------------------------------------------------------------------- #

def _is_bandcamp_cookie_host(host: str) -> bool:
    h = (host or "").lower().strip(".")
    return h in ("bandcamp.com", "127.0.0.1", "localhost", "::1") or h.endswith(".bandcamp.com")


def _is_allowed_remote_host(host: str) -> bool:
    h = (host or "").lower().strip(".")
    return (
        h in ("bandcamp.com", "bcbits.com")
        or h.endswith(".bandcamp.com")
        or h.endswith(".bcbits.com")
    )


def validate_remote_url(url: str) -> urllib.parse.ParseResult:
    """Validate that `url` targets an allowed Bandcamp/bcbits HTTPS endpoint (or localhost test server)."""
    if not url or not isinstance(url, str):
        raise BandarchyError("empty or invalid URL")
    if any(ch in url for ch in ("\r", "\n", "\x00")) or url.startswith("-"):
        raise BandarchyError("refusing URL with control characters or leading hyphen")
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https"):
        raise BandarchyError(f"unsupported URL scheme: {parsed.scheme}")
    host = (parsed.hostname or "").lower()
    if not host:
        raise BandarchyError("missing URL hostname")
    if parsed.scheme == "http":
        if host not in ("127.0.0.1", "localhost", "::1"):
            raise BandarchyError("plain HTTP is only permitted for localhost test servers")
        return parsed
    if not _is_allowed_remote_host(host):
        raise BandarchyError(f"refusing untrusted remote host: {host}")
    return parsed


def _check_resolved_ip_public(ip_str: str) -> None:
    """Reject private, loopback, link-local, or cloud-metadata IP addresses for HTTPS requests."""
    import ipaddress as _ipa
    addr = _ipa.ip_address(ip_str)
    if (
        addr.is_private
        or addr.is_loopback
        or addr.is_link_local
        or addr.is_multicast
        or addr.is_unspecified
        or addr.is_reserved
    ):
        raise BandarchyError(f"refusing private or non-global IP address: {ip_str}")


def build_cookie_header(host: str = "bandcamp.com") -> str:
    """Return Bandcamp session Cookie header strictly for bandcamp.com / *.bandcamp.com."""
    if not _is_bandcamp_cookie_host(host):
        return ""
    settings = load_settings()
    if settings.get("loggedOut"):
        return ""
    auth = read_json(AUTH_FILE, {}) or {}
    parts = []
    if auth.get("identity"):
        val = str(auth["identity"]).strip()
        val = "".join(ch for ch in val if 32 <= ord(ch) < 127 and ch not in ("\r", "\n", ";"))
        if val:
            if val.startswith("identity="):
                parts.append(val)
            else:
                parts.append(f"identity={val}")
    if auth.get("cookies"):
        c_val = "".join(ch for ch in str(auth["cookies"]).strip() if 32 <= ord(ch) < 127 and ch not in ("\r", "\n"))
        if c_val:
            parts.append(c_val)
    return "; ".join(p for p in parts if p)


def _decode_chunked(body_bytes: bytes) -> bytes:
    out = []
    pos = 0
    n = len(body_bytes)
    while pos < n:
        le = body_bytes.find(b"\r\n", pos)
        if le < 0:
            break
        line = body_bytes[pos:le].split(b";", 1)[0].strip()
        if not line:
            pos = le + 2
            continue
        try:
            sz = int(line, 16)
        except ValueError:
            break
        if sz == 0:
            break
        pos = le + 2
        out.append(body_bytes[pos : pos + sz])
        pos += sz + 2
    return b"".join(out)


def _fastly_https_exchange(
    url: str,
    method: str = "GET",
    body_bytes: bytes | None = None,
    cookie_hdr: str = "",
    timeout: float = 8.0,
    max_bytes: int = MAX_HTTP_BYTES,
    headers_only: bool = False,
) -> tuple[int, dict[str, str], bytes]:
    """Perform an HTTPS request to bandcamp.com / *.bandcamp.com / *.bcbits.com over
    Fastly's edge TLS (`server_hostname='f4.bcbits.com'` when *.bandcamp.com SNI is
    reset by middleboxes) with full CA certificate and SSRF IP verification.
    """
    parsed = validate_remote_url(url)
    host = (parsed.hostname or "").lower()
    port = parsed.port or 443
    path = (parsed.path or "/") + (("?" + parsed.query) if parsed.query else "")

    is_bc = host == "bandcamp.com" or host.endswith(".bandcamp.com")
    tls_sni = "f4.bcbits.com" if is_bc else host

    addrs = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM)
    if not addrs:
        raise BandarchyError(f"cannot resolve host: {host}")
    target_ip = addrs[0][4][0]
    _check_resolved_ip_public(target_ip)

    effective_cookie = cookie_hdr if _is_bandcamp_cookie_host(host) else ""

    ctx = ssl.create_default_context()
    with socket.create_connection((target_ip, port), timeout=timeout) as raw_sock:
        with ctx.wrap_socket(raw_sock, server_hostname=tls_sni) as ss:
            req_lines = [
                f"{method} {path} HTTP/1.1",
                f"Host: {host}",
                f"User-Agent: {USER_AGENT}",
                "Accept: text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
                "Accept-Language: en-GB,en;q=0.9",
                "Accept-Encoding: identity",
                "Connection: close",
            ]
            if effective_cookie:
                req_lines.append(f"Cookie: {effective_cookie}")
            if body_bytes is not None:
                req_lines.append("Content-Type: application/json")
                req_lines.append(f"Content-Length: {len(body_bytes)}")
            payload = ("\r\n".join(req_lines) + "\r\n\r\n").encode("utf-8") + (body_bytes or b"")
            ss.sendall(payload)

            chunks: list[bytes] = []
            total = 0
            hdr_found = False
            while True:
                chunk = ss.recv(min(65536, max_bytes + 16384 - total))
                if not chunk:
                    break
                chunks.append(chunk)
                total += len(chunk)
                if headers_only and not hdr_found and b"\r\n\r\n" in b"".join(chunks):
                    break
                if total > max_bytes + 16384:
                    raise BandarchyError(f"HTTP response exceeded maximum size ({max_bytes} bytes)")

    raw_resp = b"".join(chunks)
    sep = raw_resp.find(b"\r\n\r\n")
    if sep < 0:
        raise BandarchyError(f"invalid HTTP response from {host}")
    hdr_block = raw_resp[:sep].decode("iso-8859-1", errors="replace")
    resp_body = raw_resp[sep + 4 :]

    hdr_lines = hdr_block.splitlines()
    status_code = 200
    if hdr_lines:
        parts = hdr_lines[0].split()
        if len(parts) >= 2 and parts[1].isdigit():
            status_code = int(parts[1])

    resp_headers: dict[str, str] = {}
    for line in hdr_lines[1:]:
        if ":" in line:
            k, v = line.split(":", 1)
            resp_headers[k.strip().lower()] = v.strip()

    if not headers_only and "chunked" in resp_headers.get("transfer-encoding", "").lower():
        resp_body = _decode_chunked(resp_body)

    if len(resp_body) > max_bytes:
        raise BandarchyError(f"HTTP response exceeded maximum size ({max_bytes} bytes)")

    return status_code, resp_headers, resp_body


def resolve_stream_redirect(url: str, timeout: float = 6.0) -> str:
    """If `url` is a Bandcamp `stream_redirect` or subdomain track URL, resolve its
    302 Location to the direct `https://t4.bcbits.com/stream/...` audio stream URL so
    mpv can stream directly without hitting SNI resets on `bandcamp.com`.
    """
    if not url or not url.startswith("https://"):
        return url
    try:
        parsed = validate_remote_url(url)
    except BandarchyError:
        return url
    host = (parsed.hostname or "").lower()
    if not (host == "bandcamp.com" or host.endswith(".bandcamp.com")):
        return url
    if "stream_redirect" not in (parsed.path or "") and "/download" not in (parsed.path or ""):
        return url
    try:
        cookie_hdr = build_cookie_header(host)
        status, hdrs, _ = _fastly_https_exchange(
            url,
            method="GET",
            cookie_hdr=cookie_hdr,
            timeout=timeout,
            headers_only=True,
        )
        if status in (301, 302, 303, 307, 308) and hdrs.get("location"):
            loc = hdrs["location"]
            if loc.startswith("//"):
                loc = "https:" + loc
            elif loc.startswith("/"):
                loc = f"https://{host}{loc}"
            validate_remote_url(loc)
            return bounded_text(loc, MAX_URL_CHARS)
    except Exception:
        pass
    return url


def http_request(
    url: str,
    method: str = "GET",
    json_body: dict | None = None,
    timeout: float = 8.0,
    max_bytes: int = MAX_HTTP_BYTES,
    on_chunk=None,
) -> bytes:
    parsed = validate_remote_url(url)
    host = (parsed.hostname or "").lower()
    cookie_hdr = build_cookie_header(host)
    body_bytes = None
    if json_body is not None:
        body_bytes = json.dumps(json_body).encode("utf-8")

    is_bandcamp_https = parsed.scheme == "https" and (
        host == "bandcamp.com" or host.endswith(".bandcamp.com")
    )

    # Use Fastly SNI transport first for live Bandcamp HTTPS hosts to avoid SNI TCP resets
    if is_bandcamp_https:
        cur_url = url
        cur_method = method
        cur_body = body_bytes
        for _ in range(6):
            try:
                p_cur = validate_remote_url(cur_url)
                cur_host = (p_cur.hostname or "").lower()
                status, hdrs, resp_body = _fastly_https_exchange(
                    cur_url,
                    method=cur_method,
                    body_bytes=cur_body,
                    cookie_hdr=build_cookie_header(cur_host),
                    timeout=timeout,
                    max_bytes=max_bytes,
                )
                if status in (301, 302, 303, 307, 308) and hdrs.get("location"):
                    loc = hdrs["location"]
                    if loc.startswith("//"):
                        loc = f"{p_cur.scheme}:{loc}"
                    elif loc.startswith("/"):
                        loc = f"{p_cur.scheme}://{p_cur.netloc}{loc}"
                    p_next = validate_remote_url(loc)
                    cur_url = loc
                    if status in (301, 302, 303):
                        cur_method = "GET"
                        cur_body = None
                    nhost = (p_next.hostname or "").lower()
                    if not (nhost == "bandcamp.com" or nhost.endswith(".bandcamp.com")):
                        url = cur_url
                        parsed = p_next
                        host = nhost
                        cookie_hdr = build_cookie_header(host)
                        method = cur_method
                        body_bytes = cur_body
                        break
                    continue
                if 200 <= status < 400 and resp_body is not None:
                    if on_chunk:
                        try:
                            on_chunk(len(resp_body), len(resp_body))
                        except Exception:
                            pass
                    return resp_body
                break
            except BandarchyError:
                raise
            except Exception:
                break

    if parsed.scheme == "https":
        addrs = socket.getaddrinfo(host, parsed.port or 443, socket.AF_INET, socket.SOCK_STREAM)
        if not addrs:
            raise BandarchyError(f"cannot resolve host: {host}")
        _check_resolved_ip_public(addrs[0][4][0])

    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-GB,en;q=0.9",
    }
    if cookie_hdr and _is_bandcamp_cookie_host(host):
        headers["Cookie"] = cookie_hdr
    if body_bytes is not None:
        headers["Content-Type"] = "application/json"

    class _SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, hdrs, newurl):
            p_new = validate_remote_url(newurl)
            new_host = (p_new.hostname or "").lower()
            if p_new.scheme == "https":
                r_addrs = socket.getaddrinfo(new_host, p_new.port or 443, socket.AF_INET, socket.SOCK_STREAM)
                if not r_addrs:
                    raise BandarchyError(f"cannot resolve redirect host: {new_host}")
                _check_resolved_ip_public(r_addrs[0][4][0])
            new_req = super().redirect_request(req, fp, code, msg, hdrs, newurl)
            if new_req is not None and not _is_bandcamp_cookie_host(new_host):
                new_req.headers.pop("Cookie", None)
                new_req.unredirected_hdrs.pop("Cookie", None)
            return new_req

    opener = urllib.request.build_opener(_SafeRedirectHandler)
    try:
        req = urllib.request.Request(url, data=body_bytes, headers=headers, method=method)
        with opener.open(req, timeout=timeout) as resp:
            content_len = 0
            try:
                content_len = int(resp.headers.get("Content-Length") or 0)
            except Exception:
                content_len = 0
            if content_len > max_bytes:
                raise BandarchyError("HTTP response exceeded maximum size")
            chunks = []
            total = 0
            last_report = 0.0
            while True:
                chunk = resp.read(min(65536, max_bytes + 1 - total))
                if not chunk:
                    break
                chunks.append(chunk)
                total += len(chunk)
                if total > max_bytes:
                    raise BandarchyError("HTTP response exceeded maximum size")
                if on_chunk:
                    now_t = time.monotonic()
                    if now_t - last_report >= 0.15 or (content_len and total >= content_len):
                        last_report = now_t
                        try:
                            on_chunk(total, content_len)
                        except Exception:
                            pass
            return b"".join(chunks)
    except BandarchyError:
        raise
    except urllib.error.HTTPError as err:
        try:
            _ = err.read(65536)
        except Exception:
            pass
        raise BandarchyError(f"HTTP {err.code} from {parsed.netloc}")
    except Exception as urllib_exc:
        raise BandarchyError(f"cannot reach {parsed.netloc}: {urllib_exc}")


def download_file(
    url: str,
    dest_path: str,
    timeout: float = 45.0,
    max_bytes: int = MAX_DOWNLOAD_BYTES,
    on_chunk=None,
) -> str:
    """Stream a remote URL to a private temporary file with strict `max_bytes` ceiling,
    unlinking the temporary file immediately if `total_read > max_bytes`, then atomically
    replacing `dest_path`.
    """
    parsed = validate_remote_url(url)
    host = (parsed.hostname or "").lower()
    if parsed.scheme == "https" and (host == "bandcamp.com" or host.endswith(".bandcamp.com")):
        url = resolve_stream_redirect(url, timeout=min(timeout, 8.0))
        parsed = validate_remote_url(url)
        host = (parsed.hostname or "").lower()

    if parsed.scheme == "https":
        addrs = socket.getaddrinfo(host, parsed.port or 443, socket.AF_INET, socket.SOCK_STREAM)
        if not addrs:
            raise BandarchyError(f"cannot resolve host: {host}")
        _check_resolved_ip_public(addrs[0][4][0])

    cookie_hdr = build_cookie_header(host)
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "*/*",
        "Accept-Language": "en-GB,en;q=0.9",
    }
    if cookie_hdr and _is_bandcamp_cookie_host(host):
        headers["Cookie"] = cookie_hdr

    class _SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, hdrs, newurl):
            p_new = validate_remote_url(newurl)
            new_host = (p_new.hostname or "").lower()
            if p_new.scheme == "https":
                r_addrs = socket.getaddrinfo(new_host, p_new.port or 443, socket.AF_INET, socket.SOCK_STREAM)
                if not r_addrs:
                    raise BandarchyError(f"cannot resolve redirect host: {new_host}")
                _check_resolved_ip_public(r_addrs[0][4][0])
            new_req = super().redirect_request(req, fp, code, msg, hdrs, newurl)
            if new_req is not None and not _is_bandcamp_cookie_host(new_host):
                new_req.headers.pop("Cookie", None)
                new_req.unredirected_hdrs.pop("Cookie", None)
            return new_req

    abs_dest = os.path.abspath(dest_path)
    target_dir = os.path.dirname(abs_dest)
    ensure_private_dir(target_dir)
    if os.path.lexists(abs_dest):
        st_existing = os.lstat(abs_dest)
        if stat.S_ISLNK(st_existing.st_mode) or st_existing.st_uid != os.getuid():
            raise BandarchyError(f"refusing unsafe destination file: {abs_dest}")

    fd, tmp_path = tempfile.mkstemp(
        prefix=f".{os.path.basename(abs_dest)}.",
        suffix=".part",
        dir=target_dir,
    )
    opener = urllib.request.build_opener(_SafeRedirectHandler)
    try:
        os.fchmod(fd, 0o600)
        req = urllib.request.Request(url, headers=headers, method="GET")
        with opener.open(req, timeout=timeout) as resp:
            content_len = 0
            try:
                content_len = int(resp.headers.get("Content-Length") or 0)
            except Exception:
                content_len = 0
            if content_len > max_bytes:
                raise BandarchyError("Download exceeded maximum size")
            total_read = 0
            last_report = 0.0
            while True:
                chunk = resp.read(min(65536, max_bytes + 1 - total_read))
                if not chunk:
                    break
                total_read += len(chunk)
                if total_read > max_bytes:
                    raise BandarchyError("Download exceeded maximum size")
                os.write(fd, chunk)
                if on_chunk:
                    now_t = time.monotonic()
                    if now_t - last_report >= 0.15 or (content_len and total_read >= content_len):
                        last_report = now_t
                        try:
                            on_chunk(total_read, content_len)
                        except Exception:
                            pass
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(tmp_path, abs_dest)
        tmp_path = ""
        return abs_dest
    except Exception as exc:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp_path and os.path.lexists(tmp_path):
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        if isinstance(exc, BandarchyError):
            raise
        raise BandarchyError(f"download failed for {parsed.netloc}: {exc}")


def extract_attr_json(page_html: str, attr_name: str) -> dict | None:
    for quote in ('"', "'"):
        pattern = rf'{re.escape(attr_name)}\s*=\s*{quote}([^{quote}]+){quote}'
        m = re.search(pattern, page_html)
        if m:
            raw = html.unescape(m.group(1))
            try:
                data = json.loads(raw)
                if isinstance(data, dict):
                    return data
            except Exception:
                continue
    return None


def art_url_from_id(art_id, size: int = 10, api_base: str = "https://bandcamp.com") -> str:
    if not art_id:
        return ""
    s = str(art_id).strip()
    if s.startswith(("http://", "https://")):
        return bounded_text(s, MAX_URL_CHARS)
    if not s.isdigit():
        return ""
    if api_base.startswith("http://127.0.0.1") or api_base.startswith("http://localhost"):
        return f"{api_base.rstrip('/')}/img/a{s.zfill(10)}_{size}.jpg"
    return f"https://f4.bcbits.com/img/a{s.zfill(10)}_{size}.jpg"


def fetch_fan_collection(username: str, api_base: str = "https://bandcamp.com") -> list[dict]:
    base = api_base.rstrip("/")
    profile_url = f"{base}/{urllib.parse.quote(username.strip())}" if username else base
    raw = http_request(profile_url, timeout=10.0)
    page = raw.decode("utf-8", errors="replace")
    blob = extract_attr_json(page, "data-blob")
    if not blob:
        return []

    fan_data = blob.get("fan_data") or {}
    fan_id = fan_data.get("fan_id")
    coll_data = blob.get("collection_data") or {}
    redownload_urls = dict(coll_data.get("redownload_urls") or {})
    item_cache = (blob.get("item_cache") or {}).get("collection") or {}
    tracklists = dict((blob.get("tracklists") or {}).get("collection") or {})

    raw_items: list[tuple[str, dict]] = []
    sequence = coll_data.get("sequence") or coll_data.get("small_collection") or list(item_cache.keys())
    seen_keys: set[str] = set()
    for key in sequence:
        item = item_cache.get(str(key))
        if isinstance(item, dict):
            seen_keys.add(str(key))
            raw_items.append((str(key), item))
    for k, item in item_cache.items():
        if str(k) not in seen_keys and isinstance(item, dict):
            seen_keys.add(str(k))
            raw_items.append((str(k), item))

    last_token = coll_data.get("last_token")
    more_available = bool(coll_data.get("more_available") or last_token)

    pages = 0
    while fan_id and last_token and more_available and pages < 35 and len(raw_items) < MAX_COLLECTION_ITEMS:
        pages += 1
        try:
            api_raw = http_request(
                f"{base}/api/fancollection/1/collection_items",
                method="POST",
                json_body={
                    "fan_id": fan_id,
                    "older_than_token": last_token,
                    "count": 100,
                },
                timeout=10.0,
            )
            api_data = json.loads(api_raw.decode("utf-8", errors="replace"))
        except Exception:
            break
        if not isinstance(api_data, dict):
            break
        redownload_urls.update(api_data.get("redownload_urls") or {})
        tracklists.update(api_data.get("tracklists") or {})
        batch = api_data.get("items") or []
        if not batch:
            break
        for b_item in batch:
            if not isinstance(b_item, dict):
                continue
            raw_t = str(b_item.get("item_type") or "a")
            prefix = "p" if raw_t == "package" else ("t" if raw_t in ("track", "t") else "a")
            b_key = f"{prefix}{b_item.get('item_id') or b_item.get('tralbum_id') or ''}"
            raw_items.append((b_key, b_item))
        more_available = bool(api_data.get("more_available"))
        last_token = api_data.get("last_token")

    parsed_by_dedup: dict[str, dict] = {}
    ordered_keys: list[str] = []

    for cache_key, item in raw_items[:MAX_COLLECTION_ITEMS]:
        if not isinstance(item, dict):
            continue
        raw_item_id = str(item.get("item_id") or "")
        tralbum_id = str(item.get("tralbum_id") or raw_item_id or "")
        item_id = raw_item_id or tralbum_id
        raw_type = str(item.get("item_type") or item.get("tralbum_type") or "album").lower()
        tralbum_type = str(item.get("tralbum_type") or "").lower()
        if raw_type in ("a", "album", "package", "p"):
            item_type = "track" if tralbum_type == "t" else "album"
        elif raw_type in ("t", "track"):
            item_type = "track"
        else:
            item_type = "album"

        title = bounded_text(item.get("item_title") or item.get("title") or "Untitled")
        artist = bounded_text(item.get("band_name") or item.get("artist") or "Unknown Artist")
        item_url = bounded_text(item.get("item_url") or "", MAX_URL_CHARS)
        art_id = item.get("item_art_id") or item.get("art_id") or ""
        sale_id = item.get("sale_item_id")
        sale_type = item.get("sale_item_type") or "p"
        dl_url = ""
        if sale_id:
            dl_url = (
                redownload_urls.get(f"{sale_type}{sale_id}")
                or redownload_urls.get(f"p{sale_id}")
                or redownload_urls.get(f"c{sale_id}")
                or ""
            )
        if not dl_url and raw_item_id:
            dl_url = redownload_urls.get(raw_item_id) or redownload_urls.get(f"p{raw_item_id}") or ""
        if not dl_url and item_id:
            dl_url = redownload_urls.get(item_id) or ""

        # Resolve full tracklist from blob/API tracklists map
        tl_entries = (
            tracklists.get(cache_key)
            or tracklists.get(f"p{raw_item_id}")
            or tracklists.get(f"a{tralbum_id}")
            or tracklists.get(f"a{raw_item_id}")
            or tracklists.get(f"t{tralbum_id}")
            or tracklists.get(f"t{raw_item_id}")
            or []
        )

        tracks: list[dict] = []
        if isinstance(tl_entries, list) and tl_entries:
            for idx_t, t_obj in enumerate(tl_entries, start=1):
                if not isinstance(t_obj, dict):
                    continue
                file_map = t_obj.get("file") or {}
                t_stream = ""
                if isinstance(file_map, dict):
                    t_stream = (
                        file_map.get("mp3-v0")
                        or file_map.get("mp3-128")
                        or next(iter(file_map.values()), "")
                    )
                if t_stream and t_stream.startswith("//"):
                    t_stream = "https:" + t_stream
                t_id = str(t_obj.get("id") or t_obj.get("track_id") or f"{item_id}-{idx_t}")
                tracks.append({
                    "id": f"bc-track-{t_id}",
                    "title": bounded_text(t_obj.get("title") or f"Track {idx_t}"),
                    "artist": bounded_text(t_obj.get("artist") or artist),
                    "album": title,
                    "index": bounded_int(t_obj.get("track_number") or idx_t, idx_t),
                    "duration": bounded_float(t_obj.get("duration") or 0.0),
                    "streamUrl": bounded_text(t_stream, MAX_URL_CHARS),
                    "localPath": "",
                    "itemUrl": item_url,
                })

        if not tracks:
            feat_title = bounded_text(item.get("featured_track_title") or "")
            stream_url = bounded_text(item.get("featured_track_url") or "", MAX_URL_CHARS)
            if feat_title or item_url:
                tracks.append({
                    "id": f"bc-track-{item.get('featured_track') or item_id or slugify(title)}-1",
                    "title": feat_title or title,
                    "artist": artist,
                    "album": title,
                    "index": bounded_int(item.get("featured_track_number") or 1, 1),
                    "duration": bounded_float(item.get("featured_track_duration") or 0),
                    "streamUrl": stream_url,
                    "localPath": "",
                    "itemUrl": item_url,
                })

        total_dur = round(sum(float(t.get("duration") or 0.0) for t in tracks), 1)
        album_entry = {
            "id": f"bc-{item_type}-{item_id}" if item_id else f"bc-{slugify(artist)}-{slugify(title)}",
            "itemId": item_id,
            "tralbumId": tralbum_id,
            "itemType": item_type,
            "title": title,
            "artist": artist,
            "url": item_url,
            "artUrl": art_url_from_id(art_id, api_base=api_base),
            "artPath": "",
            "redownloadUrl": bounded_text(dl_url, MAX_URL_CHARS),
            "purchased": True,
            "isLocal": False,
            "localPath": "",
            "audioFormat": "Bandcamp Stream",
            "totalDuration": total_dur,
            "numTracks": max(len(tracks), bounded_int(item.get("num_streamable_tracks") or len(tracks), len(tracks))),
            "tracks": tracks,
            "fold": fold(f"{artist} {title}"),
        }

        dedup_key = f"bc-{item_type}-{raw_item_id or tralbum_id}" if (raw_item_id or tralbum_id) else f"{fold(artist)}::{fold(title)}"
        if dedup_key in parsed_by_dedup:
            existing = parsed_by_dedup[dedup_key]
            if len(tracks) > len(existing.get("tracks") or []):
                existing["tracks"] = tracks
                existing["numTracks"] = max(existing["numTracks"], len(tracks))
                existing["totalDuration"] = total_dur
            if dl_url and not existing.get("redownloadUrl"):
                existing["redownloadUrl"] = bounded_text(dl_url, MAX_URL_CHARS)
            if album_entry["artUrl"] and not existing.get("artUrl"):
                existing["artUrl"] = album_entry["artUrl"]
        else:
            parsed_by_dedup[dedup_key] = album_entry
            ordered_keys.append(dedup_key)

    return [parsed_by_dedup[k] for k in ordered_keys]


def fetch_album_details(item_url: str, api_base: str = "https://bandcamp.com") -> dict | None:
    if not item_url:
        return None
    try:
        raw = http_request(item_url, timeout=8.0)
        page = raw.decode("utf-8", errors="replace")
    except Exception:
        return None

    tralbum = extract_attr_json(page, "data-tralbum")
    if not tralbum:
        return None

    current = tralbum.get("current") or {}
    title = bounded_text(current.get("title") or tralbum.get("album_title") or "Untitled")
    artist = bounded_text(tralbum.get("artist") or current.get("artist") or "Unknown Artist")
    art_id = tralbum.get("art_id") or current.get("art_id") or ""
    item_id = str(current.get("id") or tralbum.get("id") or "")
    item_type = str(tralbum.get("item_type") or "album")

    tracks = []
    for idx, t in enumerate(tralbum.get("trackinfo") or [], start=1):
        if not isinstance(t, dict):
            continue
        file_map = t.get("file") or {}
        stream = ""
        if isinstance(file_map, dict):
            stream = file_map.get("mp3-128") or file_map.get("mp3-v0") or next(iter(file_map.values()), "")
        if stream and stream.startswith("//"):
            stream = "https:" + stream
        t_title = bounded_text(t.get("title") or f"Track {idx}")
        t_link = t.get("title_link") or ""
        if t_link and t_link.startswith("/"):
            parsed_u = urllib.parse.urlparse(item_url)
            t_link = f"{parsed_u.scheme}://{parsed_u.netloc}{t_link}"
        tracks.append({
            "id": f"bc-track-{t.get('track_id') or t.get('id') or idx}",
            "title": t_title,
            "artist": bounded_text(t.get("artist") or artist),
            "album": title,
            "index": bounded_int(t.get("track_num") or idx, idx),
            "duration": bounded_float(t.get("duration") or 0.0),
            "streamUrl": bounded_text(stream, MAX_URL_CHARS),
            "localPath": "",
            "itemUrl": bounded_text(t_link or item_url, MAX_URL_CHARS),
        })

    return {
        "id": f"bc-{item_type}-{item_id}" if item_id else f"bc-{slugify(artist)}-{slugify(title)}",
        "itemId": item_id,
        "itemType": item_type,
        "title": title,
        "artist": artist,
        "url": bounded_text(item_url, MAX_URL_CHARS),
        "artUrl": art_url_from_id(art_id, api_base=api_base),
        "tracks": tracks,
        "numTracks": len(tracks),
    }


# --------------------------------------------------------------------------- #
# Artwork Generation, Caching & Omarchy ASCII Transcoding
# --------------------------------------------------------------------------- #

PsychedelicPalettes = [
    ("#ff007f", "#7928ca", "#00f0ff"),
    ("#00f5d4", "#7b2cbf", "#ff9e00"),
    ("#ffbe0b", "#fb5607", "#ff006e"),
    ("#8338ec", "#3a86ff", "#06d6a0"),
    ("#f72585", "#7209b7", "#4cc9f0"),
]


def ensure_cover_svg(album_id: str, artist: str, title: str) -> str:
    """Create a high-contrast geometric SVG sleeve that both looks great in QML
    and transcodes cleanly into Braille/Block art via omarchy-transcode-ascii.
    """
    ensure_private_dir(ART_DIR)
    digest = hashlib.sha256(f"{album_id}:{artist}:{title}".encode("utf-8")).hexdigest()
    target = os.path.join(ART_DIR, f"v2_{digest[:22]}.svg")
    if os.path.exists(target) and os.path.getsize(target) > 0:
        return target

    pal = PsychedelicPalettes[int(digest[:2], 16) % len(PsychedelicPalettes)]
    petals = 6 + (int(digest[2:4], 16) % 4) * 2
    rings = 3 + (int(digest[4:6], 16) % 3)

    shapes = []
    # High-contrast sacred geometry rays and concentric rings on transparent/dark canvas
    for p in range(petals):
        ang = (p / petals) * 360.0
        shapes.append(
            f'<ellipse cx="250" cy="250" rx="185" ry="52" fill="none" '
            f'stroke="{pal[p % 3]}" stroke-width="14" transform="rotate({ang:.1f} 250 250)"/>'
        )
    for r in range(rings):
        rad = 65 + r * 58
        shapes.append(
            f'<circle cx="250" cy="250" r="{rad}" fill="none" stroke="#ffffff" '
            f'stroke-width="12" stroke-dasharray="{24 + r * 10} {16 + r * 8}"/>'
        )
    svg = f"""<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <circle cx="250" cy="250" r="236" fill="none" stroke="{pal[0]}" stroke-width="16"/>
  {''.join(shapes)}
  <circle cx="250" cy="250" r="38" fill="{pal[2]}"/>
</svg>
"""
    atomic_write(target, svg.encode("utf-8"), 0o600, fatal=False)
    return target


def cache_remote_art(art_url: str, album_id: str, artist: str, title: str) -> str:
    ensure_private_dir(ART_DIR)
    if art_url:
        digest = hashlib.sha256(art_url.encode("utf-8")).hexdigest()[:24]
        ext = ".png" if ".png" in art_url.lower() else ".jpg"
        target = os.path.join(ART_DIR, f"art_{digest}{ext}")
        if os.path.exists(target) and os.path.getsize(target) > 0:
            return target
        try:
            download_file(art_url, target, timeout=5.0, max_bytes=MAX_ART_BYTES)
            if os.path.isfile(target) and os.path.getsize(target) > 64:
                return target
        except Exception:
            pass
    return ensure_cover_svg(album_id, artist, title)


def transcode_image_to_ascii(
    image_path: str,
    width: int = 72,
    height: int = 32,
    mode: str = "braille",
    threshold: int = 50,
    invert: bool = False,
) -> list[str]:
    """Use Omarchy's `omarchy-transcode-ascii` module to convert album cover art
    into screensaver-style Braille or Block Unicode text art.
    """
    ensure_private_dir(ASCII_DIR)
    width = bounded_int(width, 72, 20, 160)
    height = bounded_int(height, 32, 10, 80)
    mode = "block" if mode == "block" else "braille"
    threshold = bounded_int(threshold, 50, 10, 90)

    if not image_path or not os.path.isfile(image_path):
        return []

    abs_image = os.path.abspath(image_path)
    stat_sig = f"{abs_image}:{os.path.getmtime(abs_image):.0f}:{width}:{height}:{mode}:{threshold}:{invert}"
    cache_key = hashlib.sha256(stat_sig.encode("utf-8")).hexdigest()[:24]
    cached_txt = os.path.abspath(os.path.join(ASCII_DIR, f"art_{cache_key}.txt"))

    cached_content = safe_read_text(cached_txt, max_bytes=2 * 1024 * 1024)
    if cached_content:
        return [line.rstrip("\n") for line in cached_content.splitlines()]

    if TRANSCODE_ASCII_BIN and os.path.isfile(TRANSCODE_ASCII_BIN):
        cmd = [
            TRANSCODE_ASCII_BIN,
            abs_image,
            cached_txt,
            "--width",
            str(width),
            "--height",
            str(height),
            "--mode",
            mode,
            "--threshold",
            str(threshold),
        ]
        if invert:
            cmd.append("--invert")
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                out_txt = safe_read_text(cached_txt, max_bytes=2 * 1024 * 1024)
                if out_txt:
                    lines = [line.rstrip("\n") for line in out_txt.splitlines()]
                    if lines:
                        return lines
        except Exception:
            pass
    return []


def _compress_ascii_block(lines: list[str], max_width: int = 68) -> list[str]:
    """Horizontally compress an omarchy-ascii banner block so its width never exceeds
    `max_width`, preserving the first and last letters without left/right clipping.
    """
    lines = [l.rstrip("\r\n") for l in lines if l.strip()]
    if not lines:
        return []
    min_lead = min((len(l) - len(l.lstrip(" ")) for l in lines if l.strip()), default=0)
    if min_lead > 0:
        lines = [l[min_lead:].rstrip() for l in lines]
    w = max((len(l) for l in lines), default=0)
    if w <= max_width:
        return lines

    grid = [list(l.ljust(w)) for l in lines]
    h = len(grid)
    cols = [[grid[r][c] for r in range(h)] for c in range(w)]

    # Pass 1: collapse runs of >1 blank columns down to 1 blank column while wider than max_width
    i = 1
    while i < len(cols) and len(cols) > max_width:
        if all(ch == " " for ch in cols[i]) and all(ch == " " for ch in cols[i - 1]):
            cols.pop(i)
        else:
            i += 1

    # Pass 2: thin 3-in-a-row identical columns to 2, then 2-in-a-row to 1 uniformly
    for require_triple in (True, False):
        while len(cols) > max_width:
            dup_indices = [
                idx
                for idx in range(1, len(cols) - 1)
                if cols[idx] == cols[idx - 1] and (not require_triple or cols[idx] == cols[idx + 1])
            ]
            if not dup_indices:
                break
            cols.pop(dup_indices[len(dup_indices) // 2])

    # Pass 3: uniform column decimation if still wider than max_width
    if len(cols) > max_width:
        cols = [cols[int(round(idx * (len(cols) - 1) / (max_width - 1)))] for idx in range(max_width)]

    return ["".join(cols[c][r] for c in range(len(cols))).rstrip() for r in range(h)]


def _run_omarchy_ascii_raw(text_line: str) -> list[str]:
    if not OMARCHY_ASCII_BIN or not os.path.isfile(OMARCHY_ASCII_BIN):
        return []
    try:
        r = subprocess.run(
            [OMARCHY_ASCII_BIN, "--", text_line],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if r.returncode != 0 or not r.stdout.strip():
            r = subprocess.run(
                [OMARCHY_ASCII_BIN, text_line],
                capture_output=True,
                text=True,
                timeout=5,
            )
        if r.returncode == 0 and r.stdout.strip():
            return [l.rstrip("\r\n") for l in r.stdout.splitlines() if l.strip()]
    except Exception:
        pass
    return []


def render_omarchy_ascii_banner(text: str, max_width: int = 68) -> list[str]:
    """Render text in Omarchy's Delta Corps Priest 1 logo font via `omarchy-ascii`,
    automatically wrapping multi-word titles and compressing columns so long names
    (e.g. 'BASS COMMUNION') fit completely within `max_width` without clipping.
    """
    ensure_private_dir(ASCII_DIR)
    max_width = bounded_int(max_width, 68, 32, 140)
    clean_words = re.sub(r"[^a-zA-Z0-9 ]+", " ", str(text or "BANDARCHY")).strip().upper()
    clean_words = re.sub(r"\s+", " ", clean_words)[:36] or "BANDARCHY"

    cache_key = hashlib.sha256(f"v2:{max_width}:{clean_words}".encode("utf-8")).hexdigest()[:20]
    cached_txt = os.path.join(ASCII_DIR, f"banner_{cache_key}.txt")
    cached_content = safe_read_text(cached_txt, max_bytes=2 * 1024 * 1024)
    if cached_content:
        return [line.rstrip("\n") for line in cached_content.splitlines()]

    raw_single = _run_omarchy_ascii_raw(clean_words)
    if raw_single:
        single_w = max((len(l) for l in raw_single), default=0)
        words = clean_words.split(" ")
        if single_w > max_width and len(words) >= 2:
            # Split words into 2 balanced lines so each line stays crisp and legible
            best_split = 1
            best_diff = 9999
            for sp in range(1, len(words)):
                left_len = len(" ".join(words[:sp]))
                right_len = len(" ".join(words[sp:]))
                diff = abs(left_len - right_len)
                if diff < best_diff:
                    best_diff = diff
                    best_split = sp
            line1_str = " ".join(words[:best_split])
            line2_str = " ".join(words[best_split:])
            b1 = _compress_ascii_block(_run_omarchy_ascii_raw(line1_str), max_width=max_width)
            b2 = _compress_ascii_block(_run_omarchy_ascii_raw(line2_str), max_width=max_width)
            if b1 and b2:
                w1 = max((len(l) for l in b1), default=0)
                w2 = max((len(l) for l in b2), default=0)
                mw = max(w1, w2)
                pad1 = " " * max(0, (mw - w1) // 2)
                pad2 = " " * max(0, (mw - w2) // 2)
                lines = [pad1 + l for l in b1] + [""] + [pad2 + l for l in b2]
            else:
                lines = _compress_ascii_block(raw_single, max_width=max_width)
        else:
            lines = _compress_ascii_block(raw_single, max_width=max_width)

        if lines:
            atomic_write(cached_txt, ("\n".join(lines) + "\n").encode("utf-8"), 0o600, fatal=False)
            return lines

    # Fallback to Omarchy's screensaver.txt or logo.txt
    for candidate in (
        os.path.join(HOME, ".config", "omarchy", "branding", "screensaver.txt"),
        os.path.join(HOME, "omarchy", "logo.txt"),
        "/usr/share/omarchy/logo.txt",
    ):
        cand_txt = safe_read_text(candidate, max_bytes=512 * 1024)
        if cand_txt:
            raw_fb = [l.rstrip("\n") for l in cand_txt.splitlines()]
            return _compress_ascii_block(raw_fb, max_width=max_width) or raw_fb
    return [clean_words]


def extract_ttfx_frames(
    screensaver_txt_path: str,
    width: int = 68,
    height: int = 30,
    effect: str = "waves",
    max_frames: int = 28,
) -> list[list[str]]:
    """Run Omarchy's `/usr/bin/ttfx` screensaver engine in instant headless mode
    (`--frame-rate 0 --no-color --ignore-terminal-dimensions`) on the transcoded
    album cover art (or Omarchy banner) and sample keyframes across the effect
    lifecycle so the QML visualiser manipulates genuine `ttfx` frames as the song plays.
    """
    if not TTFX_BIN or not os.path.isfile(TTFX_BIN) or not os.path.isfile(screensaver_txt_path):
        return []

    effect = (effect or "random").lower()
    if effect not in TTFX_EFFECTS or effect == "random":
        non_random = [e for e in TTFX_EFFECTS if e != "random"]
        effect = secrets.choice(non_random) if non_random else "waves"

    width = bounded_int(width, 68, 20, 140)
    height = bounded_int(height, 30, 10, 70)
    max_frames = bounded_int(max_frames, 28, 6, 64)

    raw_ss = safe_read_bytes(screensaver_txt_path, max_bytes=2 * 1024 * 1024)
    if not raw_ss:
        return []
    txt_hash = hashlib.sha256(raw_ss).hexdigest()[:20]

    ensure_private_dir(ASCII_DIR)
    cache_key = hashlib.sha256(
        f"{txt_hash}:{width}:{height}:{effect}:{max_frames}".encode("utf-8")
    ).hexdigest()[:24]
    cache_path = os.path.join(ASCII_DIR, f"ttfx_{cache_key}.json")

    cached = read_json(cache_path, None)
    if isinstance(cached, list) and cached:
        return cached

    cmd = [
        TTFX_BIN,
        "-i",
        os.path.abspath(screensaver_txt_path),
        "--ignore-terminal-dimensions",
        "--canvas-width",
        str(width),
        "--canvas-height",
        str(height),
        "--frame-rate",
        "0",
        "--no-color",
        "--anchor-canvas",
        "c",
        "--anchor-text",
        "c",
        "--seed",
        "42",
        effect,
    ]
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=4)
        if r.returncode != 0 or not r.stdout:
            return []
        raw_text = r.stdout.decode("utf-8", errors="replace")
        chunks = re.split(r"\x1b\[\d+A", raw_text)
        ansi_re = re.compile(r"\x1b\[[?0-9;]*[a-zA-Z]|\x1b[78]")
        frames: list[list[str]] = []
        for ch in chunks:
            cleaned = ansi_re.sub("", ch)
            flines = [l.rstrip("\r") for l in cleaned.splitlines()[:height]]
            if any(l.strip() for l in flines):
                frames.append(flines)
        if not frames:
            return []
        if len(frames) <= max_frames:
            sampled = frames
        else:
            sampled = [
                frames[min(len(frames) - 1, int(round(i * (len(frames) - 1) / (max_frames - 1))))]
                for i in range(max_frames)
            ]
        write_json(cache_path, sampled, mode=0o600)
        return sampled
    except Exception:
        return []


# --------------------------------------------------------------------------- #
# Local Music & Bandcamp ZIP Scanner
# --------------------------------------------------------------------------- #

def parse_track_filename(filename: str, fallback_artist: str, fallback_album: str, default_idx: int) -> tuple[int, str, str]:
    stem = os.path.splitext(filename)[0].strip()
    m_bc = re.match(r"^(.+?)\s+-\s+(.+?)\s+-\s+(\d{1,3})[\s._-]+(.+)$", stem)
    if m_bc:
        return int(m_bc.group(3)), bounded_text(m_bc.group(4)), bounded_text(m_bc.group(1))

    m_num = re.match(r"^(\d{1,3})(?:\s*[-._]\s*|\s+)(.+)$", stem)
    if m_num:
        return int(m_num.group(1)), bounded_text(m_num.group(2)), fallback_artist

    return default_idx, bounded_text(stem), fallback_artist


def infer_artist_album(folder_path: str, root_dir: str) -> tuple[str, str]:
    rel = os.path.relpath(folder_path, root_dir)
    parts = [p for p in rel.split(os.sep) if p and p != "."]
    leaf = os.path.basename(folder_path)

    sub_stopwords = re.compile(
        r"^(cd\s*\d+|disk\s*\d+|disc\s*\d+|flac|mp3|wav|ogg|extended|youtubedl|deluxe)$",
        re.IGNORECASE,
    )

    suffix_parts: list[str] = []
    idx = len(parts) - 1
    while idx > 0 and sub_stopwords.match(parts[idx].strip()):
        suffix_parts.insert(0, parts[idx].strip())
        idx -= 1

    album_part = parts[idx] if idx >= 0 else leaf
    suffix_str = f" ({' · '.join(suffix_parts)})" if suffix_parts else ""

    if " - " in album_part:
        left, right = album_part.split(" - ", 1)
        left_s, right_s = left.strip(), right.strip()
        if re.match(r"^(19|20)\d{2}$", left_s):
            parent_artist = "Unknown Artist"
            if idx >= 1:
                parent_part = parts[idx - 1]
                parent_artist = parent_part.split(" - ", 1)[0].strip() if " - " in parent_part else parent_part.strip()
            return bounded_text(parent_artist), bounded_text(f"{right_s} ({left_s}){suffix_str}")
        if left_s and right_s:
            if left_s.isupper() and len(left_s) > 4:
                left_s = left_s.title()
            return bounded_text(left_s), bounded_text(f"{right_s}{suffix_str}")

    if "_" in album_part and idx == 0:
        left, right = album_part.split("_", 1)
        right_clean = re.sub(r"\.(wav|flac|mp3|ogg)$", "", right.strip(), flags=re.IGNORECASE)
        if left.strip() and right_clean and left.strip().lower() != "iem":
            return bounded_text(left.strip()), bounded_text(f"{right_clean}{suffix_str}")

    if idx >= 1:
        artist = parts[0]
        if " - " in artist:
            artist = artist.split(" - ", 1)[0].strip()
        artist = re.sub(r"_flac$", "", artist, flags=re.IGNORECASE).replace("_", " ").strip()
        if artist.isupper() and len(artist) > 4:
            artist = artist.title()
        return bounded_text(artist), bounded_text(f"{album_part}{suffix_str}")

    if len(parts) == 1:
        artist = re.sub(r"_flac$", "", parts[0], flags=re.IGNORECASE).replace("_", " ").strip()
        return bounded_text(artist), bounded_text(f"{artist} — Singles{suffix_str}")

    return "Local Artist", bounded_text(f"{leaf}{suffix_str}")


def probe_image_dimensions(path: str) -> tuple[int, int]:
    """Safely probe image dimensions from header bytes via safe_read_bytes(path, max_bytes=64)."""
    header = safe_read_bytes(path, max_bytes=64)
    if not header or len(header) < 10:
        return (0, 0)
    if header.startswith(b"\x89PNG\r\n\x1a\n") and len(header) >= 24:
        return (int.from_bytes(header[16:20], "big"), int.from_bytes(header[20:24], "big"))
    if header[:6] in (b"GIF87a", b"GIF89a"):
        return (int.from_bytes(header[6:8], "little"), int.from_bytes(header[8:10], "little"))
    if header.startswith(b"\xff\xd8"):
        return (500, 500)
    if header[:4] == b"RIFF" and header[8:12] == b"WEBP":
        return (500, 500)
    return (0, 0)


def is_valid_media_file(path: str) -> bool:
    """Safely verify a local media or artwork file header via safe_read_bytes(path, max_bytes=64)."""
    header = safe_read_bytes(path, max_bytes=64)
    if not header or len(header) < 4:
        return False
    if header.startswith((b"fLaC", b"RIFF", b"OggS", b"ID3", b"FORM", b"\x89PNG\r\n\x1a\n", b"\xff\xd8", b"<svg", b"<?xml")):
        return True
    if header[0] == 0xFF and (header[1] & 0xE0) == 0xE0:
        return True
    if len(header) >= 8 and header[4:8] == b"ftyp":
        return True
    return False


def scan_local_directories(local_dirs: list[str]) -> list[dict]:
    albums_by_dir: dict[str, dict] = {}
    seen_real_dirs: set[str] = set()

    for base_dir in local_dirs:
        base_dir = os.path.expanduser(base_dir)
        if not os.path.isdir(base_dir):
            continue
        for root, dirs, files in os.walk(base_dir):
            dirs[:] = sorted(
                d for d in dirs
                if d != "__MACOSX" and not d.startswith(".")
            )
            real_root = os.path.realpath(root)
            if real_root in seen_real_dirs:
                continue

            audio_files = sorted(
                f for f in files
                if not f.startswith(".")
                and not f.startswith("._")
                and f.lower().endswith(AUDIO_EXTENSIONS)
                and not os.path.islink(os.path.join(root, f))
            )
            if not audio_files:
                continue
            seen_real_dirs.add(real_root)

            image_files = sorted(
                f for f in files
                if not f.startswith(".")
                and not f.startswith("._")
                and f.lower().endswith(IMAGE_EXTENSIONS)
                and not os.path.islink(os.path.join(root, f))
            )
            cover_path = ""
            if image_files:
                preferred = [
                    f for f in image_files
                    if os.path.splitext(f)[0].lower() in ("cover", "front", "folder", "album")
                ]
                chosen = preferred[0] if preferred else image_files[0]
                cover_path = os.path.join(root, chosen)

            artist, album_title = infer_artist_album(root, base_dir)
            tracks = []
            for idx, fname in enumerate(audio_files, start=1):
                fpath = os.path.join(root, fname)
                t_num, t_title, t_artist = parse_track_filename(fname, artist, album_title, idx)
                if artist in ("Local Artist", "Unknown Artist") and t_artist not in ("Local Artist", "Unknown Artist"):
                    artist = t_artist
                # Estimate duration lightly from file size if not probed so intelligent playlists know epic vs short tracks
                est_dur = 0.0
                try:
                    fsize = os.path.getsize(fpath)
                    ext_l = os.path.splitext(fname)[1].lower()
                    if ext_l in (".flac", ".wav", ".aiff"):
                        est_dur = round(fsize / (176400 * 0.65), 1)
                    else:
                        est_dur = round(fsize / 28000, 1)
                except OSError:
                    pass
                tracks.append({
                    "id": f"local-track-{hashlib.sha1(fpath.encode('utf-8')).hexdigest()[:16]}",
                    "title": t_title,
                    "artist": t_artist,
                    "album": album_title,
                    "index": t_num,
                    "duration": est_dur,
                    "streamUrl": "",
                    "localPath": fpath,
                    "format": os.path.splitext(fname)[1].lstrip(".").upper(),
                })

            tracks.sort(key=lambda t: (t["index"], t["title"]))
            album_id = f"local-{hashlib.sha1(real_root.encode('utf-8')).hexdigest()[:16]}"
            if not cover_path:
                cover_path = ensure_cover_svg(album_id, artist, album_title)

            in_bandcamp_dir = "bandcamp" in real_root.lower()
            has_bc_naming = any(
                re.match(r"^.+?\s+-\s+.+?\s+-\s+\d{1,3}\s+", os.path.splitext(f)[0])
                for f in audio_files
            )

            formats = sorted({t.get("format", "") for t in tracks if t.get("format")})
            audio_fmt = " / ".join(formats) if formats else "Local Audio"
            total_dur = round(sum(float(t.get("duration") or 0.0) for t in tracks), 1)

            albums_by_dir[real_root] = {
                "id": album_id,
                "itemId": "",
                "itemType": "album",
                "title": album_title,
                "artist": artist,
                "url": "",
                "artUrl": "",
                "artPath": cover_path,
                "redownloadUrl": "",
                "purchased": bool(in_bandcamp_dir or has_bc_naming),
                "isLocal": True,
                "localPath": root,
                "audioFormat": audio_fmt,
                "totalDuration": total_dur,
                "numTracks": len(tracks),
                "tracks": tracks,
                "fold": fold(f"{artist} {album_title}"),
            }

    return list(albums_by_dir.values())


def safe_extract_zip(zip_path: str, dest_dir: str) -> list[str]:
    uid = os.getuid()
    try:
        zst = os.lstat(zip_path)
    except OSError as exc:
        raise BandarchyError(f"cannot stat archive: {exc}")
    if stat.S_ISLNK(zst.st_mode) or not stat.S_ISREG(zst.st_mode) or zst.st_uid != uid:
        raise BandarchyError(f"refusing symlinked, non-regular, or foreign-owned archive: {zip_path}")
    if zst.st_size > MAX_DOWNLOAD_BYTES:
        raise BandarchyError("archive file exceeds maximum size ceiling")

    os.makedirs(dest_dir, mode=0o700, exist_ok=True)
    abs_dest = os.path.abspath(dest_dir)
    cur = abs_dest
    while cur and cur != os.sep:
        st_d = os.lstat(cur)
        if stat.S_ISLNK(st_d.st_mode) or not stat.S_ISDIR(st_d.st_mode) or st_d.st_uid not in (uid, 0):
            raise BandarchyError(f"refusing unsafe destination directory component: {cur}")
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    st_dest = os.lstat(abs_dest)
    if stat.S_ISLNK(st_dest.st_mode) or not stat.S_ISDIR(st_dest.st_mode) or st_dest.st_uid != uid:
        raise BandarchyError(f"refusing unsafe destination directory: {abs_dest}")
    os.chmod(abs_dest, 0o700)
    real_dest = os.path.realpath(abs_dest)

    zflags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        zflags |= os.O_NOFOLLOW
    zfd = os.open(zip_path, zflags)
    try:
        zfst = os.fstat(zfd)
        if (
            not stat.S_ISREG(zfst.st_mode)
            or zfst.st_uid != uid
            or zfst.st_ino != zst.st_ino
            or zfst.st_dev != zst.st_dev
        ):
            os.close(zfd)
            raise BandarchyError(f"refusing modified or untrusted archive: {zip_path}")
        zfile_obj = os.fdopen(zfd, "rb")
    except Exception:
        try:
            os.close(zfd)
        except OSError:
            pass
        raise

    extracted: list[str] = []
    used_basenames: set[str] = set()
    with zfile_obj, zipfile.ZipFile(zfile_obj, "r") as zf:
        infos = zf.infolist()
        if len(infos) > MAX_ARCHIVE_FILES:
            raise BandarchyError("archive exceeds maximum member count ceiling")
        total_uncompressed = sum(info.file_size for info in infos)
        if total_uncompressed > MAX_DOWNLOAD_BYTES:
            raise BandarchyError("archive exceeds maximum uncompressed size ceiling")
        bytes_written = 0
        for info in infos:
            name = info.filename
            if not name or name.endswith("/") or "__MACOSX" in name:
                continue
            mode = (info.external_attr >> 16) & 0o170000
            if mode == stat.S_IFLNK:
                continue
            norm_parts = name.replace("\\", "/").split("/")
            if ".." in norm_parts or name.startswith(("/", "\\")):
                raise BandarchyError(f"refusing unsafe path in archive: {name}")
            base_name = os.path.basename(name)
            if base_name.startswith(".") or base_name.startswith("._"):
                continue
            if base_name in used_basenames:
                sub_prefix = "-".join(
                    re.sub(r"[^a-zA-Z0-9._ -]+", "_", p).strip(" .")
                    for p in norm_parts[:-1]
                    if p
                )
                cand_name = f"{sub_prefix} - {base_name}" if sub_prefix else base_name
                if cand_name in used_basenames:
                    stem, ext = os.path.splitext(cand_name)
                    dup_idx = 2
                    while f"{stem}_{dup_idx}{ext}" in used_basenames:
                        dup_idx += 1
                    cand_name = f"{stem}_{dup_idx}{ext}"
                base_name = cand_name
            used_basenames.add(base_name)
            target_path = os.path.join(real_dest, base_name)
            if os.path.lexists(target_path):
                st_t = os.lstat(target_path)
                if stat.S_ISLNK(st_t.st_mode) or not stat.S_ISREG(st_t.st_mode) or st_t.st_uid != uid:
                    raise BandarchyError(f"refusing symlink or unsafe target in archive destination: {base_name}")
                os.unlink(target_path)
            resolved_target = os.path.realpath(target_path)
            if not resolved_target.startswith(real_dest + os.sep):
                raise BandarchyError(f"refusing unsafe path in archive: {name}")
            out_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
            if hasattr(os, "O_NOFOLLOW"):
                out_flags |= os.O_NOFOLLOW
            with zf.open(info, "r") as src:
                fd = os.open(target_path, out_flags, 0o600)
                try:
                    with os.fdopen(fd, "wb") as dst:
                        while True:
                            chunk = src.read(65536)
                            if not chunk:
                                break
                            bytes_written += len(chunk)
                            if bytes_written > MAX_DOWNLOAD_BYTES:
                                raise BandarchyError("archive stream exceeded maximum uncompressed byte ceiling")
                            dst.write(chunk)
                except Exception:
                    try:
                        os.unlink(target_path)
                    except OSError:
                        pass
                    raise
            extracted.append(target_path)
    return extracted


def find_bandcamp_zips_in_downloads() -> list[dict]:
    dl_dir = os.path.join(HOME, "Downloads")
    if not os.path.isdir(dl_dir):
        return []
    uid = os.getuid()
    found = []
    for fname in sorted(os.listdir(dl_dir)):
        if not fname.lower().endswith(".zip") or fname.startswith("."):
            continue
        stem = os.path.splitext(fname)[0]
        if " - " not in stem:
            continue
        fpath = os.path.join(dl_dir, fname)
        try:
            st = os.lstat(fpath)
            if (
                stat.S_ISLNK(st.st_mode)
                or not stat.S_ISREG(st.st_mode)
                or st.st_uid != uid
                or st.st_size > MAX_DOWNLOAD_BYTES
            ):
                continue
            with zipfile.ZipFile(fpath, "r") as zf:
                names = [n for n in zf.namelist() if not n.startswith("__MACOSX")]
                has_audio = any(n.lower().endswith(AUDIO_EXTENSIONS) for n in names)
                if has_audio:
                    artist, album = stem.split(" - ", 1)
                    found.append({
                        "zipPath": fpath,
                        "artist": bounded_text(artist.strip()),
                        "album": bounded_text(album.strip()),
                        "trackCount": sum(1 for n in names if n.lower().endswith(AUDIO_EXTENSIONS)),
                    })
        except Exception:
            continue
    return found


# --------------------------------------------------------------------------- #
# Unified Collection Builder
# --------------------------------------------------------------------------- #

def build_unified_collection(
    settings: dict,
    on_progress=None,
    fetch_remote: bool = True,
    detect_browser: bool = False,
) -> dict:
    logged_out = bool(settings.get("loggedOut", False))
    if logged_out or not detect_browser:
        browser = {
            "username": "",
            "albums": [],
            "downloads": [],
            "hasBrowserSession": False,
            "identityCookie": "",
        }
        username = settings.get("username") or ""
    else:
        browser = discover_from_browsers()
        username = settings.get("username") or browser.get("username") or ""
        if username and not settings.get("username"):
            settings["username"] = username
            write_json(SETTINGS_FILE, settings)
        auth_data = read_json(AUTH_FILE, {}) or {}
        if browser.get("identityCookie") and not auth_data.get("identity"):
            auth_data["identity"] = browser["identityCookie"]
            write_json(AUTH_FILE, auth_data, mode=0o600)

    api_base = settings.get("apiBase") or "https://bandcamp.com"
    remote_items: list[dict] = []
    network_note = ""

    if on_progress:
        on_progress("discovering", 0, 0)

    def _merge_album_records(primary: dict, secondary: dict) -> dict:
        if not primary.get("url") and secondary.get("url"):
            primary["url"] = secondary["url"]
        if not primary.get("artUrl") and secondary.get("artUrl"):
            primary["artUrl"] = secondary["artUrl"]
        if (not primary.get("artPath") or str(primary.get("artPath", "")).endswith(".svg")) and secondary.get("artPath"):
            primary["artPath"] = secondary["artPath"]
        if not primary.get("redownloadUrl") and secondary.get("redownloadUrl"):
            primary["redownloadUrl"] = secondary["redownloadUrl"]
        if secondary.get("itemType") == "album" and primary.get("itemType") == "track":
            primary["itemType"] = "album"
        if secondary.get("isLocal") and not primary.get("isLocal"):
            primary["isLocal"] = True
            primary["localPath"] = secondary.get("localPath") or ""
            primary["audioFormat"] = secondary.get("audioFormat") or "Local Audio"
        sec_tracks = secondary.get("tracks") or []
        pri_tracks = primary.get("tracks") or []
        if len(sec_tracks) > len(pri_tracks) or (secondary.get("isLocal") and any(t.get("localPath") for t in sec_tracks)):
            pri_by_title = {fold(t.get("title", "")): t for t in pri_tracks}
            merged_tr = []
            for st in sec_tracks:
                pt = pri_by_title.get(fold(st.get("title", "")))
                m_t = dict(st)
                if pt:
                    if pt.get("streamUrl") and not m_t.get("streamUrl"):
                        m_t["streamUrl"] = pt["streamUrl"]
                    if pt.get("duration") and not m_t.get("duration"):
                        m_t["duration"] = pt["duration"]
                merged_tr.append(m_t)
            primary["tracks"] = merged_tr
            primary["numTracks"] = len(merged_tr)
            primary["totalDuration"] = round(sum(float(t.get("duration") or 0.0) for t in merged_tr), 1)
        return primary

    def _album_priority(alb: dict) -> tuple:
        aid = str(alb.get("id") or "")
        return (
            1 if aid.startswith("bc-album-") else (0 if aid.startswith("bc-browser-") else -1),
            1 if alb.get("itemType") == "album" else 0,
            len(alb.get("tracks") or []),
            1 if alb.get("redownloadUrl") else 0,
            1 if (alb.get("artPath") and not str(alb.get("artPath")).endswith(".svg")) else 0,
        )

    raw_remote_items: list[dict] = []
    if fetch_remote and username and not logged_out:
        try:
            raw_remote_items = fetch_fan_collection(username, api_base=api_base)
        except Exception as exc:
            network_note = bounded_text(str(exc), 240)
    elif not fetch_remote and not logged_out:
        existing_store = read_json(INDEX_FILE, None) or {}
        existing_albums = existing_store.get("albums") or []
        bc_album_keys = {
            f"{fold(a.get('artist', ''))}::{fold(a.get('title', ''))}"
            for a in existing_albums
            if str(a.get("id", "")).startswith("bc-album-")
        }
        for prev_alb in existing_albums:
            aid = str(prev_alb.get("id") or "")
            if aid.startswith("local-"):
                continue
            akey = f"{fold(prev_alb.get('artist', ''))}::{fold(prev_alb.get('title', ''))}"
            if aid.startswith("bc-browser-") and akey in bc_album_keys:
                continue
            if prev_alb.get("purchased"):
                copied = dict(prev_alb)
                copied["isLocal"] = False
                copied["localPath"] = ""
                copied["audioFormat"] = "Bandcamp Stream"
                copied["totalDuration"] = round(sum(float(t.get("duration") or 0.0) for t in (copied.get("tracks") or [])), 1)
                raw_remote_items.append(copied)

    remote_by_key: dict[str, dict] = {}
    for item in raw_remote_items:
        akey = f"{fold(item.get('artist', ''))}::{fold(item.get('title', ''))}"
        if akey in remote_by_key:
            existing = remote_by_key[akey]
            if _album_priority(item) > _album_priority(existing):
                remote_by_key[akey] = _merge_album_records(dict(item), existing)
            else:
                remote_by_key[akey] = _merge_album_records(existing, item)
        else:
            remote_by_key[akey] = dict(item)
    remote_items = list(remote_by_key.values())

    seen_urls = {item.get("url"): item for item in remote_items if item.get("url")}
    seen_ids = {item.get("id"): item for item in remote_items if item.get("id")}
    seen_artist_titles = {f"{fold(item.get('artist', ''))}::{fold(item.get('title', ''))}": item for item in remote_items}
    dl_urls = list(browser.get("downloads") or [])
    need_browser_detail_fetch = fetch_remote and len(remote_items) < 15
    for idx, b_item in enumerate(browser.get("albums") or []):
        u = b_item.get("url") or ""
        if not u or u in seen_urls:
            continue
        b_title_pre = b_item.get("title") or ""
        b_artist_pre = b_item.get("artist") or ""
        pre_key = f"{fold(b_artist_pre)}::{fold(b_title_pre)}"
        if b_artist_pre and b_title_pre and pre_key in seen_artist_titles:
            existing = seen_artist_titles[pre_key]
            if b_item.get("itemType") == "album" and existing.get("itemType") == "track":
                existing["url"] = u
                existing["itemType"] = "album"
            continue
        det = None
        if need_browser_detail_fetch:
            try:
                det = fetch_album_details(u, api_base=api_base)
            except Exception:
                det = None
        title = (det or {}).get("title") or b_item.get("title") or "Untitled"
        artist = (det or {}).get("artist") or b_item.get("artist") or "Unknown Artist"
        album_id = (det or {}).get("id") or f"bc-browser-{slugify(artist)}-{slugify(title)}"
        akey = f"{fold(artist)}::{fold(title)}"
        if album_id in seen_ids or akey in seen_artist_titles:
            target = seen_ids.get(album_id) or seen_artist_titles.get(akey)
            if target and b_item.get("itemType") == "album" and target.get("itemType") == "track":
                target["url"] = u
                target["itemType"] = "album"
            continue
        art_url = (det or {}).get("artUrl") or ""
        tracks = (det or {}).get("tracks") or [
            {
                "id": f"{album_id}-t1",
                "title": title,
                "artist": artist,
                "album": title,
                "index": 1,
                "duration": 240.0,
                "streamUrl": "",
                "localPath": "",
                "itemUrl": u,
            }
        ]
        new_rem = {
            "id": album_id,
            "itemId": (det or {}).get("itemId") or "",
            "itemType": b_item.get("itemType") or "album",
            "title": title,
            "artist": artist,
            "url": u,
            "artUrl": art_url,
            "artPath": "",
            "redownloadUrl": dl_urls[idx] if idx < len(dl_urls) else "",
            "purchased": True,
            "isLocal": False,
            "localPath": "",
            "audioFormat": "Bandcamp Stream",
            "totalDuration": round(sum(float(t.get("duration") or 0.0) for t in tracks), 1),
            "numTracks": len(tracks),
            "tracks": tracks,
            "fold": fold(f"{artist} {title}"),
        }
        remote_items.append(new_rem)
        seen_urls[u] = new_rem
        seen_ids[album_id] = new_rem
        seen_artist_titles[akey] = new_rem

    if on_progress:
        on_progress("scanning-local", len(remote_items), 0)
    local_dirs = settings.get("localDirs") or DEFAULT_LOCAL_DIRS
    raw_local_albums = scan_local_directories(local_dirs)

    # Deduplicate local folders that share the exact same (artist, title, audioFormat)
    dedup_local_map: dict[tuple[str, str, str], dict] = {}
    for loc in raw_local_albums:
        lkey = (fold(loc["artist"]), fold(loc["title"]), str(loc.get("audioFormat") or "Local Audio"))
        if lkey not in dedup_local_map or len(loc.get("tracks") or []) > len(dedup_local_map[lkey].get("tracks") or []):
            dedup_local_map[lkey] = loc
    local_albums = list(dedup_local_map.values())

    local_by_key: dict[str, dict] = {}
    local_by_title: dict[str, dict] = {}
    for loc in local_albums:
        k = f"{fold(loc['artist'])}::{fold(loc['title'])}"
        local_by_key[k] = loc
        local_by_title[fold(loc["title"])] = loc

    matched_local_ids: set[str] = set()
    unified: list[dict] = []
    art_to_fetch: list[dict] = []

    for rem in remote_items:
        k = f"{fold(rem['artist'])}::{fold(rem['title'])}"
        loc = local_by_key.get(k) or local_by_title.get(fold(rem["title"]))
        if loc:
            matched_local_ids.add(loc["id"])
            rem["isLocal"] = True
            rem["localPath"] = loc["localPath"]
            rem["audioFormat"] = loc.get("audioFormat") or "Local Audio"
            if loc.get("artPath") and not loc["artPath"].endswith(".svg"):
                rem["artPath"] = loc["artPath"]
            elif not rem.get("artPath"):
                art_to_fetch.append(rem)
            rem_tracks_by_title = {fold(t["title"]): t for t in (rem.get("tracks") or [])}
            merged_tracks = []
            for lt in loc.get("tracks") or []:
                rt = rem_tracks_by_title.get(fold(lt["title"]))
                merged = dict(lt)
                if rt and rt.get("streamUrl"):
                    merged["streamUrl"] = rt["streamUrl"]
                if rt and rt.get("duration") and not merged.get("duration"):
                    merged["duration"] = rt["duration"]
                merged["itemUrl"] = rem.get("url") or ""
                merged_tracks.append(merged)
            if merged_tracks:
                rem["tracks"] = merged_tracks
                rem["numTracks"] = len(merged_tracks)
                rem["totalDuration"] = round(sum(float(t.get("duration") or 0.0) for t in merged_tracks), 1)
        else:
            if not rem.get("artPath"):
                art_to_fetch.append(rem)
        unified.append(rem)

    if art_to_fetch:
        if fetch_remote:
            def _fetch_one_art(item: dict) -> None:
                item["artPath"] = cache_remote_art(
                    item.get("artUrl", ""),
                    item["id"],
                    item["artist"],
                    item["title"],
                )
            with concurrent.futures.ThreadPoolExecutor(max_workers=12) as pool:
                list(pool.map(_fetch_one_art, art_to_fetch))
        else:
            for item in art_to_fetch:
                item["artPath"] = ensure_cover_svg(item["id"], item["artist"], item["title"])

    for loc in local_albums:
        if logged_out or remote_items:
            loc["purchased"] = False
        if loc["id"] not in matched_local_ids:
            unified.append(loc)

    # Final canonical deduplication pass keyed by (fold(artist), fold(title), audioFormat if isLocal else "stream"),
    # always retaining the Bandcamp bc-album-* record as the primary entry.
    final_map: dict[tuple[str, str, str], dict] = {}
    for alb in unified:
        fmt_key = str(alb.get("audioFormat") or "Local Audio") if alb.get("isLocal") else "stream"
        ukey = (fold(alb.get("artist") or ""), fold(alb.get("title") or ""), fmt_key)
        if ukey in final_map:
            existing = final_map[ukey]
            if _album_priority(alb) > _album_priority(existing):
                final_map[ukey] = _merge_album_records(dict(alb), existing)
            else:
                final_map[ukey] = _merge_album_records(existing, alb)
        else:
            final_map[ukey] = alb
    unified = list(final_map.values())

    unified.sort(
        key=lambda a: (
            0 if (a.get("purchased") and a.get("isLocal")) else (1 if a.get("purchased") else 2),
            fold(a.get("artist") or ""),
            fold(a.get("title") or ""),
        )
    )

    if on_progress:
        on_progress("done", len(unified), sum(a.get("numTracks", 0) for a in unified))

    zips = find_bandcamp_zips_in_downloads()
    auth_now = read_json(AUTH_FILE, {}) or {}
    result = {
        "indexedAt": int(time.time()),
        "username": username,
        "loggedOut": logged_out,
        "hasIdentity": bool(auth_now.get("identity")),
        "hasBrowserSession": bool(browser.get("hasBrowserSession", False) or auth_now.get("identity")),
        "networkNote": network_note,
        "albumCount": len(unified),
        "purchasedCount": sum(1 for a in unified if a.get("purchased")),
        "localCount": sum(1 for a in unified if a.get("isLocal")),
        "trackCount": sum(len(a.get("tracks") or []) for a in unified),
        "availableZips": zips,
        "albums": unified[:MAX_COLLECTION_ITEMS],
    }
    write_json(INDEX_FILE, result)
    return result


def _extract_status_summary(idx: dict, mtime_ns: int = 0, size: int = 0) -> dict:
    albums = idx.get("albums") or []
    return {
        "indexMtimeNs": mtime_ns,
        "indexSize": size,
        "username": idx.get("username") or "",
        "hasBrowserSession": bool(idx.get("hasBrowserSession", False)),
        "networkNote": idx.get("networkNote") or "",
        "albumCount": len(albums),
        "purchasedCount": idx.get("purchasedCount") or 0,
        "localCount": idx.get("localCount") or 0,
        "trackCount": idx.get("trackCount") or 0,
        "indexedAt": idx.get("indexedAt") or 0,
        "availableZips": idx.get("availableZips") or [],
    }


def ensure_index() -> dict:
    idx = read_json(INDEX_FILE, None)
    if isinstance(idx, dict) and isinstance(idx.get("albums"), list) and len(idx["albums"]) > 0:
        return idx
    global concurrent, sqlite3, ssl, urllib, zipfile
    import concurrent.futures as _cf  # noqa: F401
    import sqlite3
    import ssl
    import urllib.error  # noqa: F401
    import urllib.parse  # noqa: F401
    import urllib.request as _ur  # noqa: F401
    import zipfile
    import concurrent
    import urllib
    return build_unified_collection(load_settings(), fetch_remote=False)


def ensure_status_summary() -> dict:
    """Fast-path status metadata reader that caches summary counts keyed by INDEX_FILE mtime/size."""
    try:
        if os.path.exists(INDEX_FILE) and not os.path.islink(INDEX_FILE):
            st = os.stat(INDEX_FILE)
            cached = read_json(STATUS_COUNTS_FILE, None)
            if (
                isinstance(cached, dict)
                and cached.get("indexMtimeNs") == st.st_mtime_ns
                and cached.get("indexSize") == st.st_size
                and cached.get("albumCount", 0) > 0
            ):
                return cached
            idx = ensure_index()
            st = os.stat(INDEX_FILE)
            summary = _extract_status_summary(idx, st.st_mtime_ns, st.st_size)
            write_json(STATUS_COUNTS_FILE, summary)
            return summary
    except Exception:
        pass
    idx = ensure_index()
    summary = _extract_status_summary(idx)
    try:
        if os.path.exists(INDEX_FILE):
            st = os.stat(INDEX_FILE)
            summary["indexMtimeNs"] = st.st_mtime_ns
            summary["indexSize"] = st.st_size
        write_json(STATUS_COUNTS_FILE, summary)
    except Exception:
        pass
    return summary


# --------------------------------------------------------------------------- #
# Playback History & Intelligent / User Playlists Engine
# --------------------------------------------------------------------------- #

def record_history(track: dict) -> None:
    """Record a played track in HISTORY_FILE so intelligent playlists can seed from it."""
    if not track or not track.get("title"):
        return
    hist = read_json(HISTORY_FILE, {"lastPlayedTrack": None, "recentTracks": []}) or {}
    recent = list(hist.get("recentTracks") or [])
    now_ts = int(time.time())
    track_id = bounded_text(track.get("id") or "")
    last_played = hist.get("lastPlayedTrack") or {}
    if (
        track_id
        and last_played.get("id") == track_id
        and recent
        and recent[0].get("id") == track_id
        and (now_ts - int(last_played.get("playedAt") or 0)) < 30
    ):
        return
    entry = {
        "id": track_id,
        "title": bounded_text(track.get("title") or ""),
        "artist": bounded_text(track.get("artist") or ""),
        "album": bounded_text(track.get("album") or ""),
        "albumId": bounded_text(track.get("albumId") or ""),
        "artPath": bounded_text(track.get("artPath") or "", MAX_URL_CHARS),
        "duration": bounded_float(track.get("duration") or 0.0),
        "playSource": bounded_text(track.get("playSource") or "local", 32),
        "purchased": bool(track.get("purchased", False)),
        "isLocal": bool(track.get("isLocal", True)),
        "playedAt": now_ts,
    }
    if recent and recent[0].get("id") == entry["id"] and entry["id"]:
        recent[0] = entry
    else:
        recent = [r for r in recent if r.get("id") != entry["id"]]
        recent.insert(0, entry)
    recent = recent[:200]
    write_json(HISTORY_FILE, {"lastPlayedTrack": entry, "recentTracks": recent})


def all_indexed_tracks(idx: dict) -> list[dict]:
    out = []
    for a in idx.get("albums") or []:
        for t in a.get("tracks") or []:
            entry = dict(t)
            entry["albumId"] = a.get("id") or ""
            entry["album"] = a.get("title") or t.get("album") or ""
            entry["artist"] = t.get("artist") or a.get("artist") or ""
            entry["artPath"] = a.get("artPath") or ""
            entry["albumUrl"] = a.get("url") or ""
            entry["purchased"] = bool(a.get("purchased", False))
            entry["isLocal"] = bool(a.get("isLocal", False))
            out.append(entry)
    return out


def are_kindred_artists(artist_a: str, artist_b: str) -> bool:
    fa, fb = fold(artist_a), fold(artist_b)
    if not fa or not fb:
        return False
    if fa == fb or fa in fb or fb in fa:
        return True
    for cluster in KINDRED_CLUSTERS:
        if any(c in fa for c in cluster) and any(c in fb for c in cluster):
            return True
    tokens_a = {w for w in fa.split() if len(w) > 3 and w not in ("the", "band", "music")}
    tokens_b = {w for w in fb.split() if len(w) > 3 and w not in ("the", "band", "music")}
    return bool(tokens_a & tokens_b)


def build_intelligent_playlist(
    idx: dict,
    seed_track_id: str = "",
    seed_album_id: str = "",
    preset: str = "radio",
    limit: int = 25,
) -> dict:
    """Build an intelligent playlist based on the last track played (or explicit seed)."""
    tracks = all_indexed_tracks(idx)
    if not tracks:
        return {"seed": None, "preset": preset, "title": "Intelligent Mix", "tracks": []}

    hist = read_json(HISTORY_FILE, {}) or {}
    recent_ids = [r.get("id") for r in (hist.get("recentTracks") or [])[:12] if r.get("id")]

    seed = None
    if seed_track_id:
        seed = next((t for t in tracks if t.get("id") == seed_track_id), None)
    if not seed and seed_album_id:
        seed = next((t for t in tracks if t.get("albumId") == seed_album_id), None)
    if not seed and hist.get("lastPlayedTrack"):
        last_id = hist["lastPlayedTrack"].get("id")
        last_title = fold(hist["lastPlayedTrack"].get("title") or "")
        seed = next(
            (t for t in tracks if (last_id and t.get("id") == last_id) or (last_title and fold(t.get("title")) == last_title)),
            None,
        )
    if not seed:
        # Default to first purchased+local or purchased track
        seed = next((t for t in tracks if t.get("purchased") and t.get("isLocal")), tracks[0])

    seed_artist = seed.get("artist") or ""
    seed_album_id = seed.get("albumId") or ""
    seed_dur = float(seed.get("duration") or 240.0)
    seed_words = {
        w for w in fold(f"{seed.get('title', '')} {seed.get('album', '')}").split()
        if len(w) >= 3 and not w.isdigit()
    }

    scored: list[tuple[float, dict]] = []
    for i, cand in enumerate(tracks):
        if cand.get("id") == seed.get("id"):
            continue
        if preset == "purchased" and not cand.get("purchased"):
            continue

        score = 10.0
        same_artist = fold(cand.get("artist")) == fold(seed_artist)
        kindred = are_kindred_artists(cand.get("artist", ""), seed_artist)
        same_album = cand.get("albumId") == seed_album_id
        cand_dur = float(cand.get("duration") or 240.0)

        # 1. Artist & kindred affinity
        if same_artist:
            score += 42.0 if preset != "purchased" else 28.0
        elif kindred:
            score += 34.0

        if same_album:
            score += 14.0 if preset == "kindred" else 6.0

        # 2. Duration / sonic form similarity
        dur_diff = abs(cand_dur - seed_dur)
        score += max(0.0, 18.0 - (dur_diff / 40.0))

        # 3. Preset-specific shaping
        if preset == "journey":
            # Favour extended / atmospheric / psychedelic suites
            if cand_dur >= 360:
                score += 30.0
            if any(k in fold(cand.get("title", "")) for k in ("phase", "part", "voyage", "sky", "drugged", "communion", "sleep", "live", "improvisation")):
                score += 22.0
        elif preset == "kindred":
            if not (same_artist or kindred):
                score -= 25.0
        elif preset == "purchased":
            if cand.get("purchased"):
                score += 35.0
            if cand.get("isLocal"):
                score += 10.0

        # 4. Lexical / thematic resonance
        cand_words = {w for w in fold(f"{cand.get('title', '')} {cand.get('album', '')}").split() if len(w) >= 3}
        overlap = len(seed_words & cand_words)
        score += min(18.0, overlap * 6.0)

        # 5. Collection quality & freshness
        if cand.get("purchased"):
            score += 12.0
        if cand.get("isLocal"):
            score += 8.0
        if cand.get("id") in recent_ids:
            score -= 16.0

        # Deterministic tie-breaker with slight variety per seed
        tie = ((hash(f"{seed.get('id')}:{cand.get('id')}:{preset}") & 0xFFFF) / 65535.0) * 7.5
        scored.append((score + tie, cand))

    scored.sort(key=lambda pair: pair[0], reverse=True)

    # Sequence tracks with album de-clumping (max 2 consecutive from same album)
    selected = [seed]
    pool = [pair[1] for pair in scored]
    while pool and len(selected) < limit:
        picked_idx = 0
        if len(selected) >= 2 and selected[-1].get("albumId") == selected[-2].get("albumId"):
            last_alb = selected[-1].get("albumId")
            alt = next(( idx_p for idx_p, item in enumerate(pool) if item.get("albumId") != last_alb ), None)
            if alt is not None:
                picked_idx = alt
        selected.append(pool.pop(picked_idx))

    preset_titles = {
        "radio": f"Sonic Radio · After {seed.get('title')}",
        "kindred": f"Kindred Spirits · {seed_artist}",
        "journey": f"Psychedelic Journey · {seed.get('title')}",
        "purchased": f"Purchased Mix · {seed_artist}",
    }
    preset_descs = {
        "radio": f"Intelligent flow seeded from '{seed.get('title')}' by {seed_artist}, blending kindred artists, sonic duration, and deep cuts.",
        "kindred": f"Focused constellation around {seed_artist} and related musical projects in your library.",
        "journey": f"Extended psychedelic and atmospheric suites resonant with '{seed.get('title')}'.",
        "purchased": f"Curated sequence across your Bandcamp purchases anchored by '{seed.get('title')}'.",
    }

    return {
        "seed": seed,
        "preset": preset,
        "title": preset_titles.get(preset) or f"Intelligent Mix · {seed.get('title')}",
        "description": preset_descs.get(preset) or f"Seeded from {seed.get('title')} by {seed_artist}",
        "trackCount": len(selected),
        "tracks": selected,
    }


def load_playlists() -> list[dict]:
    store = read_json(PLAYLISTS_FILE, {"playlists": []}) or {}
    pls = store.get("playlists")
    return list(pls) if isinstance(pls, list) else []


def save_playlists(playlists: list[dict]) -> None:
    write_json(PLAYLISTS_FILE, {"updatedAt": int(time.time()), "playlists": playlists[:500]})


# --------------------------------------------------------------------------- #
# mpv IPC & Playback
# --------------------------------------------------------------------------- #

LEGACY_IPC_SOCKET = os.path.join(os.path.dirname(RUNTIME_DIR), "bandarchy.sock")


def _active_ipc_socket() -> str | None:
    candidates = [IPC_SOCKET]
    if "BANDARCHY_MPV_SOCKET" not in os.environ and LEGACY_IPC_SOCKET != IPC_SOCKET:
        candidates.append(LEGACY_IPC_SOCKET)
    uid = os.getuid()
    for cand in candidates:
        try:
            st = os.lstat(cand)
            if stat.S_ISSOCK(st.st_mode) and st.st_uid == uid:
                return cand
        except OSError:
            continue
    return None


def mpv_request(command: list, timeout: float = 1.5):
    sock_path = _active_ipc_socket()
    if not sock_path:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(sock_path)
            sock.sendall((json.dumps({"command": command, "request_id": 77}) + "\n").encode("utf-8"))
            buffer = b""
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                chunk = sock.recv(min(65536, MAX_IPC_BYTES + 1 - len(buffer)))
                if not chunk:
                    break
                buffer += chunk
                if len(buffer) > MAX_IPC_BYTES:
                    return None
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    if not line.strip():
                        continue
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(msg, dict) and "error" in msg:
                        return msg
    except (OSError, socket.timeout):
        return None
    return None


def mpv_get(prop: str):
    reply = mpv_request(["get_property", prop])
    if reply and reply.get("error") == "success":
        return reply.get("data")
    return None


def mpv_running() -> bool:
    return mpv_get("idle-active") is not None or mpv_get("pid") is not None


def mpv_stop() -> None:
    sock_path = _active_ipc_socket()
    pid = mpv_get("pid")
    mpv_request(["quit"])
    for _ in range(10):
        if not _active_ipc_socket() and not mpv_running():
            break
        time.sleep(0.05)
    if isinstance(pid, int) and pid > 1:
        try:
            os.kill(pid, 0)
            import signal
            os.kill(pid, signal.SIGTERM)
            for _ in range(10):
                try:
                    os.kill(pid, 0)
                    time.sleep(0.05)
                except OSError:
                    break
        except OSError:
            pass
    for cand in {IPC_SOCKET, sock_path} - {None}:
        try:
            st = os.lstat(cand)
            if stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid():
                os.unlink(cand)
        except OSError:
            pass


def mpv_launch(playlist_path: str, shuffle: bool = False, start_index: int = 0, loop: bool = False) -> None:
    mpv_stop()
    ensure_private_dir(os.path.dirname(IPC_SOCKET))
    mpv_bin = resolve_bin("mpv", required=True)
    args = [
        mpv_bin,
        "--no-config",
        "--no-ytdl",
        "--no-load-scripts",
        "--no-video",
        "--ao=pipewire,pulse,alsa,null",
        "--audio-display=no",
        "--audio-client-name=Bandarchy",
        "--gapless-audio=yes",
        "--no-terminal",
        "--idle=no",
        "--force-window=no",
        f"--input-ipc-server={IPC_SOCKET}",
        f"--playlist={os.path.abspath(playlist_path)}",
        "--cache=yes",
        "--demuxer-max-bytes=64MiB",
        "--replaygain=track",
    ]
    if shuffle:
        args.append("--shuffle")
    if start_index > 0:
        args.append(f"--playlist-start={start_index}")
    if loop:
        args.append("--loop-playlist=inf")
    args.append("--")
    subprocess.Popen(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    for _ in range(40):
        if os.path.exists(IPC_SOCKET):
            try:
                os.chmod(IPC_SOCKET, 0o600)
            except OSError:
                pass
            if mpv_running():
                break
        time.sleep(0.05)


def sanitise_m3u_target(target: str) -> str:
    """Validate and sanitise a playlist entry before writing to playlist.m3u (CRIT-6)."""
    cleaned = re.sub(r"[\r\n\x00]+", "", str(target or "")).strip()
    if not cleaned:
        raise BandarchyError("refusing empty playlist target")
    if cleaned.startswith("#") or cleaned.startswith("-"):
        raise BandarchyError(f"refusing unsafe playlist directive or flag target: {cleaned[:40]}")
    if "://" in cleaned or cleaned.lower().startswith(("http:", "https:")):
        validate_remote_url(cleaned)
        return cleaned
    real_path = os.path.realpath(cleaned)
    if not os.path.isabs(cleaned) or os.path.islink(cleaned) or not os.path.isfile(real_path):
        raise BandarchyError(f"refusing non-regular local audio path: {cleaned}")
    if not real_path.lower().endswith(AUDIO_EXTENSIONS):
        raise BandarchyError(f"refusing unsupported local audio extension: {cleaned}")
    return real_path


def _resolve_direct_stream_targets(playable: list[dict], api_base: str = "https://bandcamp.com") -> list[dict]:
    """Resolve Bandcamp stream_redirect or album/track page URLs to direct bcbits.com MP3 URLs
    so mpv can stream without hitting Bandcamp SNI resets."""
    to_resolve = [
        entry for entry in playable
        if entry.get("playSource") == "stream"
        and str(entry.get("target") or "").startswith("https://")
        and "bcbits.com" not in str(entry.get("target") or "")
    ]
    if not to_resolve:
        return playable

    page_details_cache: dict[str, dict | None] = {}
    for entry in to_resolve:
        tgt = str(entry.get("target") or "")
        if "stream_redirect" not in tgt and ("/album/" in tgt or "/track/" in tgt):
            if tgt not in page_details_cache:
                page_details_cache[tgt] = fetch_album_details(tgt, api_base=api_base)
            det = page_details_cache.get(tgt)
            if det and det.get("tracks"):
                det_tracks = det["tracks"]
                matched = next(
                    (dt for dt in det_tracks if fold(dt.get("title")) == fold(entry.get("title")) and dt.get("streamUrl")),
                    None,
                )
                if not matched:
                    idx_1 = max(0, int(entry.get("index") or 1) - 1)
                    if idx_1 < len(det_tracks) and det_tracks[idx_1].get("streamUrl"):
                        matched = det_tracks[idx_1]
                    elif det_tracks[0].get("streamUrl"):
                        matched = det_tracks[0]
                if matched and matched.get("streamUrl"):
                    entry["streamUrl"] = matched["streamUrl"]
                    entry["target"] = matched["streamUrl"]

    def _resolve_one(entry: dict) -> None:
        tgt = str(entry.get("target") or "")
        if "stream_redirect" in tgt and "bandcamp.com" in tgt:
            entry["target"] = resolve_stream_redirect(tgt)

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(_resolve_one, to_resolve))
    return playable


def resolve_playable_tracks(album: dict, mode: str = "auto", api_base: str = "https://bandcamp.com") -> list[dict]:
    tracks = list(album.get("tracks") or [])
    need_remote = (mode == "stream") or not album.get("isLocal") or all(not t.get("localPath") for t in tracks)
    if need_remote and album.get("url"):
        if len(tracks) <= 1 or any(not t.get("streamUrl") for t in tracks):
            det = fetch_album_details(album["url"], api_base=api_base)
            if det and det.get("tracks"):
                tracks = det["tracks"]

    playable: list[dict] = []
    for idx, t in enumerate(tracks, start=1):
        target = ""
        play_source = "local"
        if mode == "stream":
            target = t.get("streamUrl") or t.get("itemUrl") or album.get("url") or t.get("localPath") or ""
            play_source = "stream" if not (target and os.path.exists(str(target))) else "local"
        else:
            if t.get("localPath") and os.path.exists(str(t["localPath"])):
                target = t["localPath"]
                play_source = "local"
            else:
                target = t.get("streamUrl") or t.get("itemUrl") or album.get("url") or ""
                play_source = "stream"
        if not target:
            continue
        entry = dict(t)
        entry["target"] = target
        entry["playSource"] = play_source
        entry["albumId"] = album.get("id") or t.get("albumId") or ""
        entry["album"] = album.get("title") or t.get("album") or ""
        entry["artist"] = t.get("artist") or album.get("artist") or ""
        entry["artPath"] = album.get("artPath") or t.get("artPath") or ""
        entry["purchased"] = bool(album.get("purchased", t.get("purchased", False)))
        entry["isLocal"] = bool(album.get("isLocal", t.get("isLocal", play_source == "local")))
        entry["index"] = t.get("index") or idx
        playable.append(entry)
    return _resolve_direct_stream_targets(playable, api_base=api_base)


def resolve_track_list(raw_tracks: list[dict], idx: dict, mode: str = "auto", api_base: str = "https://bandcamp.com") -> list[dict]:
    albums_by_id = {a.get("id"): a for a in (idx.get("albums") or []) if a.get("id")}
    playable: list[dict] = []
    for i, t in enumerate(raw_tracks, start=1):
        alb = albums_by_id.get(t.get("albumId") or "") or {}
        target = ""
        play_source = "local"
        lpath = t.get("localPath") or ""
        if mode != "stream" and lpath and os.path.exists(str(lpath)):
            target = lpath
            play_source = "local"
        else:
            target = t.get("streamUrl") or t.get("itemUrl") or alb.get("url") or lpath or ""
            play_source = "local" if (target and os.path.exists(str(target))) else "stream"
        if not target:
            continue
        entry = dict(t)
        entry["target"] = target
        entry["playSource"] = play_source
        entry["albumId"] = t.get("albumId") or alb.get("id") or ""
        entry["album"] = t.get("album") or alb.get("title") or ""
        entry["artist"] = t.get("artist") or alb.get("artist") or ""
        entry["artPath"] = t.get("artPath") or alb.get("artPath") or ""
        entry["index"] = i
        playable.append(entry)
    return _resolve_direct_stream_targets(playable, api_base=api_base)


def start_queue(tracks: list[dict], source: dict, shuffle: bool = False, start_index: int = 0, loop: bool = False) -> None:
    if not tracks:
        die("no playable tracks found for that selection")
    lines = ["#EXTM3U"]
    valid_tracks: list[dict] = []
    for t in tracks:
        safe_target = sanitise_m3u_target(str(t.get("target") or ""))
        secs = int(t.get("duration") or 0)
        label = re.sub(r"[\r\n\x00]+", " ", f"{t.get('artist', '')} - {t.get('title', '')}").strip(" -")
        lines.append(f"#EXTINF:{secs},{label}")
        lines.append(safe_target)
        tc = dict(t)
        tc["target"] = safe_target
        valid_tracks.append(tc)
    atomic_write(PLAYLIST_M3U_FILE, ("\n".join(lines) + "\n").encode("utf-8"), 0o600)
    write_json(
        QUEUE_FILE,
        {
            "startedAt": int(time.time()),
            "source": source,
            "shuffle": shuffle,
            "tracks": valid_tracks,
        },
    )
    actual_idx = min(max(0, start_index), len(valid_tracks) - 1)
    first = valid_tracks[actual_idx]
    record_history(first)
    mpv_launch(PLAYLIST_M3U_FILE, shuffle=shuffle, start_index=actual_idx, loop=loop)
    emit({
        "playing": True,
        "trackIndex": actual_idx,
        "trackCount": len(valid_tracks),
        "source": source,
        "shuffle": shuffle,
        "track": first,
        "artPath": first.get("artPath") or "",
    })


# --------------------------------------------------------------------------- #
# Downloading Purchased Albums / Tracks for Local Play
# --------------------------------------------------------------------------- #

def publish_download_progress(state: dict) -> None:
    state["updatedAt"] = int(time.time())
    try:
        write_json(DOWNLOAD_PROGRESS_FILE, state, mode=0o600)
    except Exception:
        pass


def _mark_album_downloaded_in_index(album_id: str, dest_dir: str) -> None:
    """Immediately mark a downloaded album as local in INDEX_FILE and attach local file paths."""
    idx = read_json(INDEX_FILE, None)
    if not isinstance(idx, dict) or not isinstance(idx.get("albums"), list):
        return
    audio_files = sorted(
        f for f in os.listdir(dest_dir)
        if not f.startswith(".") and not f.startswith("._") and f.lower().endswith(AUDIO_EXTENSIONS)
    ) if os.path.isdir(dest_dir) else []
    if not audio_files:
        return
    for alb in idx["albums"]:
        if alb.get("id") == album_id:
            alb["isLocal"] = True
            alb["localPath"] = dest_dir
            cov = os.path.join(dest_dir, "cover.jpg")
            if os.path.isfile(cov):
                alb["artPath"] = cov
            tracks = list(alb.get("tracks") or [])
            if len(tracks) == len(audio_files):
                for t, fname in zip(tracks, audio_files):
                    t["localPath"] = os.path.join(dest_dir, fname)
            else:
                new_tracks = []
                for i, fname in enumerate(audio_files, start=1):
                    fpath = os.path.join(dest_dir, fname)
                    t_num, t_title, t_artist = parse_track_filename(
                        fname,
                        alb.get("artist") or "Unknown Artist",
                        alb.get("title") or "Untitled",
                        i,
                    )
                    new_tracks.append({
                        "id": f"local-track-{hashlib.sha1(fpath.encode('utf-8')).hexdigest()[:16]}",
                        "title": t_title,
                        "artist": t_artist,
                        "album": alb.get("title") or "",
                        "index": t_num,
                        "duration": 240.0,
                        "streamUrl": "",
                        "localPath": fpath,
                        "format": os.path.splitext(fname)[1].lstrip(".").upper(),
                    })
                alb["tracks"] = new_tracks
                alb["numTracks"] = len(new_tracks)
            break
    idx["localCount"] = sum(1 for a in idx["albums"] if a.get("isLocal"))
    write_json(INDEX_FILE, idx)


def download_album_to_local(album: dict, preferred_format: str, settings: dict) -> dict:
    global _download_lock_fd
    _download_lock_fd = take_lock(DOWNLOAD_LOCK_FILE)
    if _download_lock_fd is None:
        die("another download is already in progress", code=5)

    artist = bounded_text(album.get("artist") or "Unknown Artist", 120)
    title = bounded_text(album.get("title") or "Untitled Album", 120)
    safe_folder = re.sub(r"[/\\:\*\?\"<>\|]+", "-", f"{artist} - {title}").strip(" .")
    dl_root = os.path.expanduser(settings.get("downloadDir") or DEFAULT_DOWNLOAD_DIR)
    dest_dir = os.path.join(dl_root, safe_folder)
    os.makedirs(dest_dir, mode=0o700, exist_ok=True)

    est_tracks = max(1, int(album.get("numTracks") or len(album.get("tracks") or []) or 1))
    state = {
        "running": True,
        "albumId": album.get("id") or "",
        "title": title,
        "artist": artist,
        "format": preferred_format,
        "trackIndex": 0,
        "trackTotal": est_tracks,
        "trackTitle": "",
        "stage": f"starting (0/{est_tracks})",
        "percent": 2,
        "destDir": dest_dir,
        "startedAt": int(time.time()),
    }
    publish_download_progress(state)

    api_base = settings.get("apiBase") or "https://bandcamp.com"

    for zinfo in find_bandcamp_zips_in_downloads():
        if fold(zinfo["album"]) == fold(title):
            state.update({
                "trackIndex": est_tracks,
                "trackTotal": est_tracks,
                "stage": f"extracting local ZIP ({est_tracks}/{est_tracks})",
                "percent": 60,
            })
            publish_download_progress(state)
            files = safe_extract_zip(zinfo["zipPath"], dest_dir)
            state.update({
                "running": False,
                "trackIndex": len(files) or est_tracks,
                "trackTotal": len(files) or est_tracks,
                "stage": "done",
                "percent": 100,
                "fileCount": len(files),
            })
            publish_download_progress(state)
            _mark_album_downloaded_in_index(album.get("id") or "", dest_dir)
            return {"albumId": album.get("id"), "destDir": dest_dir, "method": "local-zip", "fileCount": len(files)}

    redownload_url = album.get("redownloadUrl") or ""
    if redownload_url:
        try:
            state.update({
                "trackIndex": 1,
                "trackTotal": est_tracks,
                "stage": f"fetching download link (1/{est_tracks})",
                "percent": 10,
            })
            publish_download_progress(state)
            raw = http_request(redownload_url, timeout=12.0)
            if raw[:4] == b"PK\x03\x04":
                tmp_zip = _make_private_temp_file("ba_dl_", ".zip")
                try:
                    safe_write_bytes(tmp_zip, raw, mode=0o600)
                    state.update({
                        "trackIndex": est_tracks,
                        "trackTotal": est_tracks,
                        "stage": f"extracting {est_tracks}/{est_tracks}",
                        "percent": 90,
                    })
                    publish_download_progress(state)
                    files = safe_extract_zip(tmp_zip, dest_dir)
                finally:
                    if os.path.lexists(tmp_zip):
                        try:
                            os.unlink(tmp_zip)
                        except OSError:
                            pass
                final_count = len([f for f in files if f.lower().endswith(AUDIO_EXTENSIONS)]) or len(files) or est_tracks
                state.update({
                    "running": False,
                    "trackIndex": final_count,
                    "trackTotal": final_count,
                    "stage": "done",
                    "percent": 100,
                    "fileCount": len(files),
                })
                publish_download_progress(state)
                _mark_album_downloaded_in_index(album.get("id") or "", dest_dir)
                return {"downloaded": True, "albumId": album.get("id"), "destDir": dest_dir, "method": "redownload", "fileCount": len(files)}
            page = raw.decode("utf-8", errors="replace")
            blob = extract_attr_json(page, "data-blob") or {}
            d_items = blob.get("digital_items") or blob.get("download_items") or []
            archive_url = ""
            if d_items and isinstance(d_items[0], dict):
                dl_map = d_items[0].get("downloads") or {}
                if preferred_format in dl_map and isinstance(dl_map[preferred_format], dict):
                    archive_url = dl_map[preferred_format].get("url") or ""
                if not archive_url:
                    for fmt_key in ("flac", "mp3-320", "mp3-v0", "wav", "vorbis", "aac-hi"):
                        if fmt_key in dl_map and isinstance(dl_map[fmt_key], dict):
                            archive_url = dl_map[fmt_key].get("url") or ""
                            if archive_url:
                                break
            if archive_url:
                state.update({
                    "trackIndex": 1,
                    "trackTotal": est_tracks,
                    "stage": f"downloading 1/{est_tracks}",
                    "percent": 18,
                })
                publish_download_progress(state)

                def _on_archive_chunk(done_b: int, total_b: int) -> None:
                    denom = total_b if total_b > 0 else max(done_b * 2, 15 * 1024 * 1024)
                    frac = min(1.0, done_b / float(denom))
                    pct = min(84, 18 + int(frac * 66))
                    sim_idx = max(1, min(est_tracks, int(round(frac * est_tracks))))
                    state.update({
                        "trackIndex": sim_idx,
                        "trackTotal": est_tracks,
                        "stage": f"downloading {sim_idx}/{est_tracks}",
                        "percent": pct,
                        "bytesDone": done_b,
                        "bytesTotal": total_b,
                    })
                    publish_download_progress(state)

                tmp_dl = _make_private_temp_file("ba_dl_", ".bin")
                try:
                    download_file(
                        archive_url,
                        tmp_dl,
                        timeout=90.0,
                        max_bytes=MAX_DOWNLOAD_BYTES,
                        on_chunk=_on_archive_chunk,
                    )
                    magic = safe_read_bytes(tmp_dl, max_bytes=4) or b""
                    if magic == b"PK\x03\x04":
                        state.update({
                            "trackIndex": est_tracks,
                            "trackTotal": est_tracks,
                            "stage": f"extracting {est_tracks}/{est_tracks}",
                            "percent": 90,
                        })
                        publish_download_progress(state)
                        files = safe_extract_zip(tmp_dl, dest_dir)
                    else:
                        out_file = os.path.join(dest_dir, f"{artist} - {title} - 01 {title}.mp3")
                        os.replace(tmp_dl, out_file)
                        tmp_dl = ""
                        files = [out_file]
                finally:
                    if tmp_dl and os.path.lexists(tmp_dl):
                        try:
                            os.unlink(tmp_dl)
                        except OSError:
                            pass

                final_count = len([f for f in files if f.lower().endswith(AUDIO_EXTENSIONS)]) or len(files) or est_tracks
                state.update({
                    "running": False,
                    "trackIndex": final_count,
                    "trackTotal": final_count,
                    "stage": "done",
                    "percent": 100,
                    "fileCount": len(files),
                })
                publish_download_progress(state)
                _mark_album_downloaded_in_index(album.get("id") or "", dest_dir)
                return {"downloaded": True, "albumId": album.get("id"), "destDir": dest_dir, "method": "redownload", "fileCount": len(files)}
        except Exception as exc:
            log_failure(f"redownload failed for {title}: {exc}")

    item_url = album.get("url") or ""
    tracks = list(album.get("tracks") or [])
    det = None
    if item_url and (len(tracks) <= 1 or any(not t.get("streamUrl") for t in tracks)):
        det = fetch_album_details(item_url, api_base=api_base)
        if det and det.get("tracks"):
            tracks = det["tracks"]

    streamable = [t for t in tracks if t.get("streamUrl")]
    if streamable:
        saved_files = []
        art_url = (det or {}).get("artUrl") or album.get("artUrl") or ""
        if art_url:
            try:
                download_file(art_url, os.path.join(dest_dir, "cover.jpg"), timeout=8.0, max_bytes=MAX_ART_BYTES)
            except Exception:
                pass
        total = len(streamable)
        for idx, t in enumerate(streamable, start=1):
            base_pct = 8 + int(((idx - 1) / max(1, total)) * 88)
            span_pct = max(1, int(88 / max(1, total)))
            t_num = bounded_int(t.get("index") or idx, idx)
            t_title = re.sub(r"[/\\:\*\?\"<>\|]+", "-", t.get("title") or f"Track {t_num}").strip()
            state.update({
                "trackIndex": idx,
                "trackTotal": total,
                "trackTitle": t_title,
                "stage": f"downloading {idx}/{total}",
                "percent": base_pct,
            })
            publish_download_progress(state)
            fname = f"{artist} - {title} - {t_num:02d} {t_title}.mp3"
            out_path = os.path.join(dest_dir, fname)

            direct_url = resolve_stream_redirect(t["streamUrl"])

            def _on_track_chunk(done_b: int, total_b: int, _b=base_pct, _s=span_pct, _i=idx, _t=total, _tt=t_title) -> None:
                denom = total_b if total_b > 0 else max(done_b * 2, 6 * 1024 * 1024)
                frac = min(1.0, done_b / float(denom))
                pct = min(98, _b + int(frac * _s))
                state.update({
                    "trackIndex": _i,
                    "trackTotal": _t,
                    "trackTitle": _tt,
                    "stage": f"downloading {_i}/{_t}",
                    "percent": pct,
                    "bytesDone": done_b,
                    "bytesTotal": total_b,
                })
                publish_download_progress(state)

            download_file(
                direct_url,
                out_path,
                timeout=45.0,
                max_bytes=MAX_DOWNLOAD_BYTES,
                on_chunk=_on_track_chunk,
            )
            saved_files.append(out_path)

        state.update({
            "running": False,
            "trackIndex": total,
            "trackTotal": total,
            "stage": "done",
            "percent": 100,
            "fileCount": len(saved_files),
        })
        publish_download_progress(state)
        _mark_album_downloaded_in_index(album.get("id") or "", dest_dir)
        return {"downloaded": True, "albumId": album.get("id"), "destDir": dest_dir, "method": "stream-rip", "fileCount": len(saved_files)}

    state.update({"running": False, "stage": "error", "error": "could not download album — check network or Bandcamp session"})
    publish_download_progress(state)
    die("could not download album — check your network connection or Bandcamp session in Settings")


# --------------------------------------------------------------------------- #
# CLI Command Handlers
# --------------------------------------------------------------------------- #

def get_playback_state() -> dict:
    """Query running mpv IPC socket and return complete playback state dict."""
    if not mpv_running():
        return {
            "playing": False,
            "paused": False,
            "title": "",
            "artist": "",
            "album": "",
            "albumId": "",
            "trackId": "",
            "playSource": "local",
            "artPath": "",
            "position": 0.0,
            "duration": 0.0,
            "volume": 100.0,
            "playlistPos": 0,
            "playlistCount": 0,
            "shuffle": False,
            "loop": False,
            "queue": [],
        }

    pos = mpv_get("playlist-pos")
    path = mpv_get("path") or ""
    queue = read_json(QUEUE_FILE, {}) or {}
    tracks = queue.get("tracks") or []
    entry = {}
    if path:
        for t in tracks:
            if t.get("target") == path or (t.get("localPath") and t["localPath"] == path):
                entry = t
                break
    if not entry and isinstance(pos, int) and 0 <= pos < len(tracks):
        entry = tracks[pos]

    meta = mpv_get("metadata") or {}
    meta = {str(k).lower(): v for k, v in meta.items()} if isinstance(meta, dict) else {}

    title = bounded_text(entry.get("title") or meta.get("title") or mpv_get("media-title") or "")
    artist = bounded_text(entry.get("artist") or meta.get("artist") or "")
    album = bounded_text(entry.get("album") or meta.get("album") or "")
    art_path = entry.get("artPath") or ""
    if not art_path or not os.path.exists(art_path):
        art_path = ensure_cover_svg(entry.get("albumId") or "now", artist or "Bandarchy", album or title or "Music")

    if entry and entry.get("id"):
        record_history(entry)

    return {
        "playing": True,
        "paused": bool(mpv_get("pause")),
        "title": title,
        "artist": artist,
        "album": album,
        "albumId": entry.get("albumId") or "",
        "trackId": entry.get("id") or "",
        "playSource": entry.get("playSource") or ("local" if os.path.exists(path) else "stream"),
        "artPath": art_path,
        "position": bounded_float(mpv_get("time-pos") or 0.0),
        "duration": bounded_float(mpv_get("duration") or entry.get("duration") or 0.0),
        "volume": bounded_float(mpv_get("volume") or 100.0, 100.0, 0.0, 130.0),
        "playlistPos": bounded_int(pos, 0),
        "playlistCount": bounded_int(mpv_get("playlist-count") or len(tracks), len(tracks)),
        "shuffle": bool(queue.get("shuffle")),
        "loop": mpv_get("loop-playlist") in ("inf", "force", True),
        "queue": [
            {
                "id": t.get("id") or "",
                "title": t.get("title") or "",
                "artist": t.get("artist") or "",
                "album": t.get("album") or "",
                "albumId": t.get("albumId") or "",
                "duration": t.get("duration") or 0,
                "playSource": t.get("playSource") or "local",
            }
            for t in tracks[:200]
        ],
    }


def _visualiser_settings_payload(settings: dict) -> dict:
    top_led = bool(settings.get("top_bar_led", settings.get("topBarLedEnabled", True)))
    return {
        "top_bar_led": top_led,
        "topBarLedEnabled": top_led,
        "stageMode": settings.get("stageMode") or "visualiser",
        "backdropMode": bounded_int(settings.get("backdropMode"), 0, 0, 7),
        "layer1Enabled": bool(settings.get("layer1Enabled", True)),
        "layer1Mode": bounded_int(settings.get("layer1Mode"), 0, 0, 10),
        "layer1EqStyle": bounded_int(settings.get("layer1EqStyle"), 0, 0, 15),
        "layer1EqLayout": bounded_int(settings.get("layer1EqLayout"), 0, 0, 3),
        "layer1EqScale": bounded_float(settings.get("layer1EqScale"), 1.0, 0.35, 2.25),
        "layer1Speed": bounded_float(settings.get("layer1Speed"), 1.0, 0.1, 4.0),
        "layer1Density": bounded_float(settings.get("layer1Density"), 1.0, 0.1, 3.0),
        "layer1Trail": bounded_float(settings.get("layer1Trail"), 0.84, 0.1, 0.98),
        "layer1Dim": bounded_float(settings.get("layer1Dim"), 0.15, 0.0, 0.9),
        "layer2Enabled": bool(settings.get("layer2Enabled", True)),
        "layer2Mode": bounded_int(settings.get("layer2Mode"), 0, 0, 12),
        "layer2Facets": bounded_int(settings.get("layer2Facets"), 8, 1, 24),
        "layer2Complexity": bounded_float(settings.get("layer2Complexity"), 1.0, 0.2, 3.0),
        "layer2Speed": bounded_float(settings.get("layer2Speed"), 1.0, 0.1, 4.0),
        "layer2Reactivity": bounded_float(settings.get("layer2Reactivity"), 1.2, 0.1, 3.5),
        "layer2Zoom": bounded_float(settings.get("layer2Zoom"), 1.0, 0.3, 3.0),
        "layer2Chaos": bounded_float(settings.get("layer2Chaos"), 0.35, 0.0, 2.0),
        "layer3Enabled": bool(settings.get("layer3Enabled", True)),
        "layer3Mode": bounded_int(settings.get("layer3Mode"), 0, 0, 11),
        "layer3Dismantle": bounded_float(settings.get("layer3Dismantle"), 1.15, 0.0, 4.0),
        "layer3Rebuild": bounded_float(settings.get("layer3Rebuild"), 1.0, 0.05, 4.0),
        "layer3Evolution": bounded_float(settings.get("layer3Evolution"), 0.65, 0.0, 3.0),
        "layer3Scale": bounded_float(settings.get("layer3Scale"), 1.0, 0.5, 2.5),
        "layer3AsciiMode": settings.get("layer3AsciiMode") or settings.get("asciiMode") or "braille",
        "turntableRpm": bounded_float(settings.get("turntableRpm"), 33.3, 16.0, 78.0),
        "turntableStyle": bounded_int(settings.get("turntableStyle"), 0, 0, 4),
    }


def cmd_status(args) -> None:
    settings = load_settings()
    idx = ensure_status_summary()
    auth = read_json(AUTH_FILE, {}) or {}
    favs = read_json(FAVOURITES_FILE, {"items": []}) or {"items": []}
    pls = load_playlists()
    playback = get_playback_state()
    hist = read_json(HISTORY_FILE, {}) or {}
    sync_prog = dict(read_json(SYNC_PROGRESS_FILE, {}) or {})
    sync_prog["running"] = is_locked(SYNC_LOCK_FILE)
    dl_prog = dict(read_json(DOWNLOAD_PROGRESS_FILE, {}) or {})
    dl_prog["running"] = is_locked(DOWNLOAD_LOCK_FILE)
    logged_out = bool(settings.get("loggedOut", False))
    username = "" if logged_out else (settings.get("username") or idx.get("username") or "")
    has_identity = bool(auth.get("identity")) and not logged_out
    has_browser = bool(idx.get("hasBrowserSession") or has_identity) and not logged_out
    emit({
        "username": username,
        "loggedOut": logged_out,
        "hasIdentity": has_identity,
        "authenticated": bool((has_identity or has_browser or username) and not logged_out),
        "hasBrowserSession": has_browser,
        "downloadDir": settings.get("downloadDir") or DEFAULT_DOWNLOAD_DIR,
        "preferredFormat": settings.get("preferredFormat") or "flac",
        "useAlbumArt": bool(settings.get("useAlbumArt", True)),
        "asciiMode": settings.get("asciiMode") or "braille",
        **_visualiser_settings_payload(settings),
        "albumCount": idx.get("albumCount") or 0,
        "purchasedCount": idx.get("purchasedCount") or 0,
        "localCount": idx.get("localCount") or 0,
        "trackCount": idx.get("trackCount") or 0,
        "playlistCount": len(pls),
        "playlists": pls,
        "lastPlayedTrack": hist.get("lastPlayedTrack"),
        "recentTracks": (hist.get("recentTracks") or [])[:25],
        "indexedAt": idx.get("indexedAt") or 0,
        "favouritesCount": len(favs.get("items") or []),
        "favourites": favs.get("items") or [],
        "availableZips": idx.get("availableZips") or [],
        "playing": playback["playing"],
        "playback": playback,
        "sync": sync_prog,
        "downloading": dl_prog["running"],
        "downloadProgress": dl_prog,
        "download": dl_prog,
        "lastError": dl_prog.get("error") or idx.get("networkNote") or "",
    })


def cmd_collection(args) -> None:
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    scope = (args.scope or "all").lower()
    if scope == "purchased":
        albums = [a for a in albums if a.get("purchased")]
    elif scope == "local":
        albums = [a for a in albums if a.get("isLocal")]
    elif scope == "cloud":
        albums = [a for a in albums if a.get("purchased") and not a.get("isLocal")]

    if args.query:
        q = fold(args.query)
        if q:
            filtered = []
            for a in albums:
                hay = a.get("fold") or fold(f"{a.get('artist', '')} {a.get('title', '')}")
                track_match = any(q in fold(t.get("title") or "") for t in (a.get("tracks") or []))
                if q in hay or track_match:
                    filtered.append(a)
            albums = filtered

    emit({
        "scope": scope,
        "query": args.query or "",
        "count": len(albums),
        "albums": albums,
        "availableZips": idx.get("availableZips") or [],
    })


def cmd_search(args) -> None:
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    scope = (args.scope or "all").lower()
    if scope == "purchased":
        albums = [a for a in albums if a.get("purchased")]
    elif scope == "local":
        albums = [a for a in albums if a.get("isLocal")]
    elif scope == "cloud":
        albums = [a for a in albums if a.get("purchased") and not a.get("isLocal")]

    q = fold(args.query or "")
    matched_albums = []
    matched_tracks = []
    for a in albums:
        a_hay = a.get("fold") or fold(f"{a.get('artist', '')} {a.get('title', '')}")
        album_hit = (not q) or (q in a_hay)
        t_hits = []
        for t in a.get("tracks") or []:
            t_hay = fold(f"{t.get('title', '')} {t.get('artist', '')} {a.get('title', '')}")
            if (not q) or (q in t_hay):
                t_copy = dict(t)
                t_copy["albumId"] = a.get("id")
                t_copy["album"] = a.get("title")
                t_copy["artist"] = t.get("artist") or a.get("artist")
                t_copy["artPath"] = a.get("artPath") or ""
                t_copy["isLocal"] = a.get("isLocal", False)
                t_copy["purchased"] = a.get("purchased", False)
                t_hits.append(t_copy)
        if album_hit or t_hits:
            matched_albums.append(a)
        matched_tracks.extend(t_hits)

    emit({
        "query": args.query or "",
        "scope": scope,
        "albums": matched_albums[: args.limit],
        "tracks": matched_tracks[: args.limit * 2],
    })


def cmd_sync(args) -> None:
    global _sync_lock_fd
    _sync_lock_fd = take_lock(SYNC_LOCK_FILE)
    if _sync_lock_fd is None:
        die("a collection sync is already running", code=5)

    settings = load_settings()
    if args.username:
        settings["username"] = bounded_text(args.username, 64)
        settings["loggedOut"] = False
        write_json(SETTINGS_FILE, settings)
    if args.api_base:
        settings["apiBase"] = bounded_text(args.api_base, 256)

    def report(stage: str, albums_n: int, tracks_n: int) -> None:
        write_json(
            SYNC_PROGRESS_FILE,
            {
                "running": stage != "done",
                "stage": stage,
                "albums": albums_n,
                "tracks": tracks_n,
                "updatedAt": int(time.time()),
            },
        )

    result = build_unified_collection(settings, on_progress=report, fetch_remote=not args.local_only, detect_browser=False)
    emit({
        "synced": True,
        "username": result.get("username"),
        "loggedOut": bool(result.get("loggedOut", False)),
        "hasIdentity": bool(result.get("hasIdentity", False)),
        "hasBrowserSession": bool(result.get("hasBrowserSession", False)),
        "albumCount": result.get("albumCount"),
        "purchasedCount": result.get("purchasedCount"),
        "localCount": result.get("localCount"),
        "trackCount": result.get("trackCount"),
        "networkNote": result.get("networkNote") or "",
        "availableZips": result.get("availableZips") or [],
    })


def cmd_auth(args) -> None:
    settings = load_settings()
    auth = read_json(AUTH_FILE, {}) or {}

    if getattr(args, "open_browser", False):
        target_url = "https://bandcamp.com/login"
        xdg_bin = resolve_bin("xdg-open")
        if xdg_bin:
            try:
                subprocess.Popen(
                    [xdg_bin, "--", target_url],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except Exception:
                pass
        emit({"openedBrowser": True, "url": target_url})
        return

    if getattr(args, "logout", False):
        settings["username"] = ""
        settings["loggedOut"] = True
        write_json(SETTINGS_FILE, settings)
        write_json(AUTH_FILE, {"identity": ""}, mode=0o600)
        res = build_unified_collection(settings, fetch_remote=False, detect_browser=False)
        emit({
            "loggedOut": True,
            "authenticated": False,
            "username": "",
            "hasIdentity": False,
            "hasBrowserSession": False,
            "albumCount": res.get("albumCount", 0),
            "purchasedCount": res.get("purchasedCount", 0),
            "localCount": res.get("localCount", 0),
            **_visualiser_settings_payload(settings),
        })
        return

    if getattr(args, "detect_browser", False):
        settings["loggedOut"] = False
        browser = discover_from_browsers()
        if browser.get("username"):
            settings["username"] = browser["username"]
        write_json(SETTINGS_FILE, settings)
        if browser.get("identityCookie"):
            auth["identity"] = browser["identityCookie"]
            write_json(AUTH_FILE, auth, mode=0o600)

    if args.username is not None:
        uname = bounded_text(args.username, 64)
        settings["username"] = uname
        if uname:
            settings["loggedOut"] = False
        write_json(SETTINGS_FILE, settings)
    if args.identity is not None:
        ident = bounded_text(args.identity, 4096)
        auth["identity"] = ident
        if ident:
            settings["loggedOut"] = False
            write_json(SETTINGS_FILE, settings)
        write_json(AUTH_FILE, auth, mode=0o600)
    if args.download_dir:
        dpath = os.path.expanduser(args.download_dir)
        os.makedirs(dpath, mode=0o700, exist_ok=True)
        settings["downloadDir"] = dpath
        if dpath not in settings.get("localDirs", []):
            settings.setdefault("localDirs", list(DEFAULT_LOCAL_DIRS)).insert(0, dpath)
        write_json(SETTINGS_FILE, settings)
    if args.format:
        settings["preferredFormat"] = bounded_text(args.format, 32)
        write_json(SETTINGS_FILE, settings)
    if args.use_album_art is not None:
        settings["useAlbumArt"] = bool(int(args.use_album_art))
        settings["layer3Enabled"] = bool(int(args.use_album_art))
        write_json(SETTINGS_FILE, settings)
    if args.ascii_mode:
        settings["asciiMode"] = bounded_text(args.ascii_mode, 16)
        settings["layer3AsciiMode"] = bounded_text(args.ascii_mode, 16)
        write_json(SETTINGS_FILE, settings)
    if getattr(args, "stage_mode", None):
        sm = bounded_text(args.stage_mode, 32)
        if sm in ("off", "art", "turntable", "visualiser"):
            settings["stageMode"] = sm
            write_json(SETTINGS_FILE, settings)
    if getattr(args, "top_bar_led", None) is not None:
        raw_led = str(args.top_bar_led).strip().lower()
        led_val = raw_led in ("1", "true", "yes", "on")
        settings["top_bar_led"] = led_val
        settings["topBarLedEnabled"] = led_val
        write_json(SETTINGS_FILE, settings)
        cfg_obj = read_json(CONFIG_FILE, {})
        if not isinstance(cfg_obj, dict):
            cfg_obj = {}
        cfg_obj["top_bar_led"] = led_val
        cfg_obj["topBarLedEnabled"] = led_val
        write_json(CONFIG_FILE, cfg_obj)
    if getattr(args, "set_json", None):
        try:
            updates = json.loads(args.set_json)
            if isinstance(updates, dict):
                allowed_keys = set(_visualiser_settings_payload(settings).keys()) | {"useAlbumArt", "asciiMode", "top_bar_led", "topBarLedEnabled"}
                for k, v in updates.items():
                    if k in allowed_keys:
                        settings[k] = v
                if "top_bar_led" in updates or "topBarLedEnabled" in updates:
                    led_val = bool(updates.get("top_bar_led", updates.get("topBarLedEnabled", True)))
                    settings["top_bar_led"] = led_val
                    settings["topBarLedEnabled"] = led_val
                    cfg_obj = read_json(CONFIG_FILE, {})
                    if not isinstance(cfg_obj, dict):
                        cfg_obj = {}
                    cfg_obj["top_bar_led"] = led_val
                    cfg_obj["topBarLedEnabled"] = led_val
                    write_json(CONFIG_FILE, cfg_obj)
                if "layer3Enabled" in updates:
                    settings["useAlbumArt"] = bool(updates["layer3Enabled"])
                if "layer3AsciiMode" in updates:
                    settings["asciiMode"] = str(updates["layer3AsciiMode"])
                write_json(SETTINGS_FILE, settings)
        except Exception as exc:
            die(f"invalid --set-json payload: {exc}")
    if args.add_url:
        idx = ensure_index()
        albums = list(idx.get("albums") or [])
        u = bounded_text(args.add_url, MAX_URL_CHARS)
        det = fetch_album_details(u, api_base=settings.get("apiBase") or "https://bandcamp.com")
        if det:
            det["purchased"] = True
            det["isLocal"] = False
            det["localPath"] = ""
            det["artPath"] = cache_remote_art(det.get("artUrl", ""), det["id"], det["artist"], det["title"])
            det["fold"] = fold(f"{det['artist']} {det['title']}")
            albums = [a for a in albums if a.get("url") != u and a.get("id") != det["id"]]
            albums.insert(0, det)
            idx["albums"] = albums
            idx["albumCount"] = len(albums)
            idx["purchasedCount"] = sum(1 for a in albums if a.get("purchased"))
            write_json(INDEX_FILE, idx)

    logged_out = bool(settings.get("loggedOut", False))
    emit({
        "username": "" if logged_out else (settings.get("username") or ""),
        "loggedOut": logged_out,
        "hasIdentity": bool(auth.get("identity")) and not logged_out,
        "authenticated": bool((auth.get("identity") or settings.get("username")) and not logged_out),
        "downloadDir": settings.get("downloadDir") or DEFAULT_DOWNLOAD_DIR,
        "preferredFormat": settings.get("preferredFormat") or "flac",
        "useAlbumArt": bool(settings.get("useAlbumArt", True)),
        "asciiMode": settings.get("asciiMode") or "braille",
        **_visualiser_settings_payload(settings),
    })


def cmd_login(args) -> None:
    """Log into Bandcamp via explicit username/cookie, optional browser import (--detect-browser), or browser launch."""
    settings = load_settings()
    auth = read_json(AUTH_FILE, {}) or {}
    if getattr(args, "open_browser", False):
        args.logout = False
        args.detect_browser = False
        cmd_auth(args)
        return
    settings["loggedOut"] = False
    if getattr(args, "username", None):
        settings["username"] = bounded_text(args.username, 64)
    if getattr(args, "identity", None):
        auth["identity"] = bounded_text(args.identity, 4096)
        write_json(AUTH_FILE, auth, mode=0o600)
    want_detect = bool(getattr(args, "detect_browser", False))
    if want_detect:
        browser = discover_from_browsers()
        if browser.get("username") and not getattr(args, "username", None):
            settings["username"] = browser["username"]
        if browser.get("identityCookie") and not getattr(args, "identity", None):
            auth["identity"] = browser["identityCookie"]
            write_json(AUTH_FILE, auth, mode=0o600)
    write_json(SETTINGS_FILE, settings)
    res = build_unified_collection(
        settings,
        fetch_remote=not getattr(args, "no_sync", False),
        detect_browser=want_detect,
    )
    emit({
        "loggedIn": bool(res.get("username") or auth.get("identity")),
        "loggedOut": False,
        "username": res.get("username") or "",
        "hasIdentity": bool(auth.get("identity")),
        "hasBrowserSession": bool(res.get("hasBrowserSession")),
        "albumCount": res.get("albumCount", 0),
        "purchasedCount": res.get("purchasedCount", 0),
        "localCount": res.get("localCount", 0),
        "trackCount": res.get("trackCount", 0),
    })


def cmd_logout(args) -> None:
    """Log out of Bandcamp, clearing saved identity cookies and remote-only purchases from the active index."""
    args.open_browser = False
    args.logout = True
    args.detect_browser = False
    args.username = None
    args.identity = None
    args.download_dir = None
    args.format = None
    args.use_album_art = None
    args.ascii_mode = None
    args.stage_mode = None
    args.set_json = None
    args.add_url = None
    cmd_auth(args)


def cmd_album(args) -> None:
    """Resolve and return the full tracklist for an album (fetching Bandcamp tralbum details if needed)."""
    settings = load_settings()
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    target = next((a for a in albums if a.get("id") == args.id or a.get("url") == args.id), None)
    if not target:
        die(f"album not found: {args.id}")

    tracks = list(target.get("tracks") or [])
    api_base = settings.get("apiBase") or "https://bandcamp.com"
    if not target.get("isLocal") and target.get("url"):
        if len(tracks) <= 1 or any(not t.get("streamUrl") for t in tracks):
            det = fetch_album_details(target["url"], api_base=api_base)
            if det and det.get("tracks"):
                target["tracks"] = det["tracks"]
                target["numTracks"] = len(det["tracks"])
                idx["albums"] = albums
                idx["trackCount"] = sum(len(a.get("tracks") or []) for a in albums)
                write_json(INDEX_FILE, idx)

    emit({
        "album": target,
        "tracks": target.get("tracks") or [],
        "trackCount": len(target.get("tracks") or []),
        "albums": albums,
    })


def cmd_ascii_art(args) -> None:
    """Convert album cover art (via omarchy-transcode-ascii) or text (via omarchy-ascii)
    into a character matrix and extract real Omarchy `/usr/bin/ttfx` screensaver engine
    keyframes for the visualiser.
    """
    settings = load_settings()
    idx = ensure_index()
    albums = list(idx.get("albums") or [])

    use_album_art = bool(settings.get("useAlbumArt", True))
    if args.use_album_art is not None:
        use_album_art = bool(int(args.use_album_art))

    mode = args.mode or settings.get("layer3AsciiMode") or settings.get("asciiMode") or "braille"
    width = bounded_int(args.width, 72, 20, 160)
    height = bounded_int(args.height, 32, 10, 80)
    threshold = bounded_int(args.threshold, 50, 10, 90)
    effect = (getattr(args, "effect", None) or "random").lower()
    if effect not in TTFX_EFFECTS or effect == "random":
        non_random = [e for e in TTFX_EFFECTS if e != "random"]
        effect = secrets.choice(non_random) if non_random else "waves"

    image_path = args.image or ""
    banner_text = args.text or ""
    target_album = None

    if args.album:
        target_album = next((a for a in albums if a.get("id") == args.album or a.get("url") == args.album), None)
        if target_album:
            image_path = image_path or target_album.get("artPath") or ""
            banner_text = banner_text or target_album.get("artist") or target_album.get("title") or ""

    if not image_path and not banner_text:
        pb = get_playback_state()
        if pb.get("playing"):
            image_path = pb.get("artPath") or ""
            banner_text = pb.get("artist") or pb.get("title") or ""
        if not image_path and not banner_text:
            hist = read_json(HISTORY_FILE, {}) or {}
            last = hist.get("lastPlayedTrack") or {}
            image_path = last.get("artPath") or ""
            banner_text = last.get("artist") or last.get("title") or ""

    if not image_path and use_album_art and albums:
        first_art = next((a for a in albums if a.get("artPath") and os.path.isfile(str(a.get("artPath")))), albums[0])
        image_path = first_art.get("artPath") or ""
        banner_text = banner_text or first_art.get("artist") or first_art.get("title") or "BANDARCHY"

    banner_lines = render_omarchy_ascii_banner(banner_text or "BANDARCHY", max_width=min(width, 68))
    art_lines: list[str] = []
    if image_path and os.path.isfile(image_path):
        img_mode = "block" if mode == "block" else "braille"
        art_lines = transcode_image_to_ascii(
            image_path,
            width=width,
            height=height,
            mode=img_mode,
            threshold=threshold,
            invert=bool(args.invert),
        )

    lines: list[str] = []
    source_kind = "omarchy-ascii"
    if use_album_art and mode in ("braille", "block") and art_lines:
        lines = art_lines
        source_kind = "album-art"
    else:
        lines = banner_lines
        source_kind = "omarchy-ascii"

    max_cols = max((len(l) for l in lines), default=0)
    # Write to SCREENSAVER_TXT_FILE so `ttfx -i` can consume it directly
    atomic_write(SCREENSAVER_TXT_FILE, ("\n".join(lines) + "\n").encode("utf-8"), 0o600, fatal=False)

    ttfx_frames = extract_ttfx_frames(
        SCREENSAVER_TXT_FILE,
        width=max(max_cols, width),
        height=max(len(lines), height),
        effect=effect,
        max_frames=28,
    )

    emit({
        "source": source_kind,
        "useAlbumArt": use_album_art,
        "mode": mode,
        "bannerText": banner_text or "BANDARCHY",
        "imagePath": image_path if os.path.isfile(str(image_path)) else "",
        "rows": len(lines),
        "cols": max_cols,
        "lineCount": len(lines),
        "colCount": max_cols,
        "lines": lines,
        "bannerLines": banner_lines,
        "artLines": art_lines,
        "ttfxEffect": effect,
        "ttfxFrameCount": len(ttfx_frames),
        "ttfxFrames": ttfx_frames,
        "text": "\n".join(lines),
        "screensaverFile": SCREENSAVER_TXT_FILE,
    })


def _run_screensaver_tty_loop(self_bin: str, mode_flag: str, use_art_flag: str, effect: str) -> None:
    """Execute the fullscreen ttfx screensaver loop directly in Python without bash -c (CRIT-7)."""
    import select
    import termios
    import tty

    sys.stdout.write("\033]11;rgb:00/00/00\007")
    sys.stdout.flush()

    deadline = time.time() + 2.0
    while time.time() < deadline:
        try:
            sz = os.get_terminal_size()
            if (sz.lines, sz.columns) != (24, 80):
                break
        except OSError:
            break
        time.sleep(0.02)

    stdin_fd = sys.stdin.fileno() if sys.stdin and sys.stdin.isatty() else -1
    old_tty = None
    if stdin_fd >= 0:
        try:
            old_tty = termios.tcgetattr(stdin_fd)
            tty.setcbreak(stdin_fd)
        except Exception:
            old_tty = None

    effect_arg = "--random-effect" if effect == "random" else effect
    ttfx_argv = [
        TTFX_BIN,
        "-i",
        SCREENSAVER_TXT_FILE,
        "--frame-rate",
        "120",
        "--canvas-width",
        "0",
        "--canvas-height",
        "0",
        "--reuse-canvas",
        "--anchor-canvas",
        "c",
        "--anchor-text",
        "c",
        "--no-eol",
        "--no-restore-cursor",
        effect_arg,
    ]
    try:
        while True:
            subprocess.run(
                [self_bin, "ascii-art", "--mode", mode_flag, "--use-album-art", use_art_flag, "--effect", "random"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            child = subprocess.Popen(ttfx_argv)
            while child.poll() is None:
                if stdin_fd >= 0:
                    rlist, _, _ = select.select([stdin_fd], [], [], 0.25)
                    if rlist:
                        try:
                            os.read(stdin_fd, 1)
                        except OSError:
                            pass
                        child.terminate()
                        return
                else:
                    time.sleep(0.25)
    finally:
        if stdin_fd >= 0 and old_tty is not None:
            try:
                termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_tty)
            except Exception:
                pass


def cmd_screensaver(args) -> None:
    """Transcode the active album cover (or Omarchy banner) and launch `ttfx` in a visible fullscreen terminal."""
    settings = load_settings()
    if getattr(args, "use_album_art", None) is None:
        args.use_album_art = "1" if settings.get("useAlbumArt", False) and args.mode in ("braille", "block") else "0"

    effect = (args.effect or "random").lower()
    if effect not in TTFX_EFFECTS:
        effect = "random"
    effect_flag = "--random-effect" if effect == "random" else effect

    if not os.path.isfile(TTFX_BIN):
        die("ttfx is not installed on this system")

    self_bin = os.path.abspath(__file__)
    use_art_flag = "1" if str(args.use_album_art) == "1" else "0"
    mode_flag = args.mode if args.mode in ("braille", "block", "banner") else "banner"

    if getattr(args, "tty_loop", False):
        _run_screensaver_tty_loop(self_bin, mode_flag, use_art_flag, effect)
        return

    with quiet():
        cmd_ascii_art(args)

    ttfx_cmd_str = (
        f"{TTFX_BIN} -i {SCREENSAVER_TXT_FILE} "
        f"--frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas "
        f"--anchor-canvas c --anchor-text c --no-eol --no-restore-cursor {effect_flag}"
    )

    if args.dry_run:
        emit({
            "launched": False,
            "dryRun": True,
            "effect": effect,
            "ttfxCommand": ttfx_cmd_str,
            "screensaverFile": SCREENSAVER_TXT_FILE,
            "ttfxAvailable": os.path.isfile(TTFX_BIN),
        })
        return

    omarchy_dir = os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy"
    if not os.path.isdir(omarchy_dir):
        omarchy_dir = os.path.join(HOME, "omarchy")

    win_class = "org.bandarchy.tte"
    loop_argv = [
        self_bin,
        "screensaver",
        "--tty-loop",
        "--mode",
        mode_flag,
        "--use-album-art",
        use_art_flag,
        "--effect",
        effect,
    ]
    term_cmd = None
    ghostty_bin = resolve_bin("ghostty")
    alacritty_bin = resolve_bin("alacritty")
    foot_bin = resolve_bin("foot")
    kitty_bin = resolve_bin("kitty")

    if ghostty_bin:
        conf = os.path.join(omarchy_dir, "default", "ghostty", "screensaver")
        term_cmd = [ghostty_bin, f"--class={win_class}", "--fullscreen=true", "--font-size=18"]
        if os.path.isfile(conf):
            term_cmd.append(f"--config-file={conf}")
        term_cmd.extend(["-e", *loop_argv])
    elif alacritty_bin:
        conf = os.path.join(omarchy_dir, "default", "alacritty", "screensaver.toml")
        term_cmd = [alacritty_bin, f"--class={win_class}", "-o", 'window.startup_mode="Fullscreen"']
        if os.path.isfile(conf):
            term_cmd.extend(["--config-file", conf])
        term_cmd.extend(["-e", *loop_argv])
    elif foot_bin:
        conf = os.path.join(omarchy_dir, "default", "foot", "screensaver.ini")
        term_cmd = [foot_bin, f"--app-id={win_class}", "--fullscreen"]
        if os.path.isfile(conf):
            term_cmd.append(f"--config={conf}")
        term_cmd.extend(["-e", *loop_argv])
    elif kitty_bin:
        term_cmd = [
            kitty_bin,
            f"--class={win_class}",
            "--start-as=fullscreen",
            "--override",
            "font_size=18",
            "--override",
            "window_padding_width=0",
            "-e",
            *loop_argv,
        ]

    if not term_cmd:
        die("no supported terminal (ghostty, alacritty, foot, kitty) found for ttfx screensaver")

    subprocess.Popen(
        term_cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    emit({
        "launched": True,
        "effect": effect,
        "ttfxCommand": ttfx_cmd_str,
        "screensaverFile": SCREENSAVER_TXT_FILE,
    })


def cmd_smart_playlist(args) -> None:
    """Generate (and optionally play or save) an intelligent playlist based on last track played."""
    settings = load_settings()
    idx = ensure_index()
    smart = build_intelligent_playlist(
        idx,
        seed_track_id=args.seed_track or "",
        seed_album_id=args.seed_album or "",
        preset=args.preset or "radio",
        limit=bounded_int(args.limit, 25, 3, 100),
    )

    saved_playlist = None
    if args.save_as:
        pls = load_playlists()
        new_id = f"pl-{int(time.time())}-{secrets.token_hex(3)}"
        saved_playlist = {
            "id": new_id,
            "title": bounded_text(args.save_as, 120),
            "description": smart.get("description") or "",
            "isSmart": True,
            "preset": smart.get("preset") or "radio",
            "seedTrack": smart.get("seed"),
            "createdAt": int(time.time()),
            "updatedAt": int(time.time()),
            "trackCount": len(smart.get("tracks") or []),
            "tracks": smart.get("tracks") or [],
        }
        pls.insert(0, saved_playlist)
        save_playlists(pls)

    if args.play:
        playable = resolve_track_list(
            smart.get("tracks") or [],
            idx,
            mode="auto",
            api_base=settings.get("apiBase") or "https://bandcamp.com",
        )
        start_idx = bounded_int(getattr(args, "track_index", 0), 0, 0, max(0, len(playable) - 1))
        start_queue(
            playable,
            {
                "type": "smart-playlist",
                "preset": smart.get("preset"),
                "title": smart.get("title"),
                "seedTrackId": (smart.get("seed") or {}).get("id") or "",
            },
            shuffle=False,
            start_index=start_idx,
            loop=bool(args.loop),
        )
        return

    emit({
        **smart,
        "smartPlaylist": smart,
        "savedPlaylist": saved_playlist,
    })


def cmd_playlists(args) -> None:
    """Manage user-created custom playlists."""
    idx = ensure_index()
    pls = load_playlists()
    action = args.action

    if action == "list":
        hist = read_json(HISTORY_FILE, {}) or {}
        emit({
            "playlists": pls,
            "lastPlayedTrack": hist.get("lastPlayedTrack"),
            "recentTracks": (hist.get("recentTracks") or [])[:20],
        })
        return

    if action == "create":
        title = bounded_text(args.title or "New Playlist", 120)
        if not title:
            die("playlist create requires --title")
        initial_tracks: list[dict] = []
        if args.from_smart:
            smart = build_intelligent_playlist(
                idx,
                seed_track_id=args.seed_track or "",
                preset=args.from_smart,
                limit=25,
            )
            initial_tracks = list(smart.get("tracks") or [])
        elif args.album:
            alb = next((a for a in (idx.get("albums") or []) if a.get("id") == args.album), None)
            if alb:
                for t in alb.get("tracks") or []:
                    tc = dict(t)
                    tc["albumId"] = alb.get("id")
                    tc["album"] = alb.get("title")
                    tc["artist"] = t.get("artist") or alb.get("artist")
                    tc["artPath"] = alb.get("artPath") or ""
                    initial_tracks.append(tc)
        elif args.tracks:
            wanted = [tid.strip() for tid in args.tracks.split(",") if tid.strip()]
            by_id = {t["id"]: t for t in all_indexed_tracks(idx)}
            for tid in wanted:
                if tid in by_id:
                    initial_tracks.append(by_id[tid])

        new_pl = {
            "id": f"pl-{int(time.time())}-{secrets.token_hex(3)}",
            "title": title,
            "description": bounded_text(args.description or "", 240),
            "isSmart": bool(args.from_smart),
            "createdAt": int(time.time()),
            "updatedAt": int(time.time()),
            "trackCount": len(initial_tracks),
            "tracks": initial_tracks,
        }
        pls.insert(0, new_pl)
        save_playlists(pls)
        emit({"created": new_pl, "playlists": pls})
        return

    if action == "add":
        if not args.id:
            die("playlists add requires --id <playlist_id>")
        target = next((p for p in pls if p.get("id") == args.id), None)
        if not target:
            die(f"playlist not found: {args.id}")
        to_add: list[dict] = []
        if args.album:
            alb = next((a for a in (idx.get("albums") or []) if a.get("id") == args.album), None)
            if alb:
                for t in alb.get("tracks") or []:
                    tc = dict(t)
                    tc["albumId"] = alb.get("id")
                    tc["album"] = alb.get("title")
                    tc["artist"] = t.get("artist") or alb.get("artist")
                    tc["artPath"] = alb.get("artPath") or ""
                    to_add.append(tc)
        if args.tracks:
            wanted = [tid.strip() for tid in args.tracks.split(",") if tid.strip()]
            by_id = {t["id"]: t for t in all_indexed_tracks(idx)}
            for tid in wanted:
                if tid in by_id:
                    to_add.append(by_id[tid])
        existing_tracks = list(target.get("tracks") or [])
        existing_tracks.extend(to_add)
        target["tracks"] = existing_tracks[:1000]
        target["trackCount"] = len(target["tracks"])
        target["updatedAt"] = int(time.time())
        save_playlists(pls)
        emit({"added": len(to_add), "playlist": target, "playlists": pls})
        return

    if action == "remove-track":
        if not args.id:
            die("playlists remove-track requires --id <playlist_id>")
        target = next((p for p in pls if p.get("id") == args.id), None)
        if not target:
            die(f"playlist not found: {args.id}")
        existing_tracks = list(target.get("tracks") or [])
        if args.index is not None and 0 <= args.index < len(existing_tracks):
            existing_tracks.pop(args.index)
        elif args.track_id:
            existing_tracks = [t for t in existing_tracks if t.get("id") != args.track_id]
        target["tracks"] = existing_tracks
        target["trackCount"] = len(existing_tracks)
        target["updatedAt"] = int(time.time())
        save_playlists(pls)
        emit({"playlist": target, "playlists": pls})
        return

    if action == "rename":
        if not args.id or not args.title:
            die("playlists rename requires --id and --title")
        target = next((p for p in pls if p.get("id") == args.id), None)
        if not target:
            die(f"playlist not found: {args.id}")
        target["title"] = bounded_text(args.title, 120)
        target["updatedAt"] = int(time.time())
        save_playlists(pls)
        emit({"playlist": target, "playlists": pls})
        return

    if action == "delete":
        if not args.id:
            die("playlists delete requires --id")
        pls = [p for p in pls if p.get("id") != args.id]
        save_playlists(pls)
        emit({"deleted": args.id, "playlists": pls})
        return


def cmd_play(args) -> None:
    settings = load_settings()
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    mode = (args.mode or "auto").lower()
    api_base = settings.get("apiBase") or "https://bandcamp.com"

    if args.playlist:
        pls = load_playlists()
        pl = next((p for p in pls if p.get("id") == args.playlist), None)
        if not pl:
            die(f"playlist not found: {args.playlist}")
        tracks = resolve_track_list(pl.get("tracks") or [], idx, mode=mode, api_base=api_base)
        start_idx = max(0, int(args.track_index or 0))
        if args.track_id:
            for i, t in enumerate(tracks):
                if t.get("id") == args.track_id:
                    start_idx = i
                    break
        start_queue(
            tracks,
            {"type": "playlist", "playlistId": pl.get("id"), "title": pl.get("title"), "mode": mode},
            shuffle=bool(args.shuffle),
            start_index=start_idx,
            loop=bool(args.loop),
        )
        return

    target_album = None
    if args.album:
        target_album = next((a for a in albums if a.get("id") == args.album or a.get("url") == args.album), None)
        if not target_album:
            die(f"album not found in collection: {args.album}")
    elif args.track_id:
        for a in albums:
            if any(t.get("id") == args.track_id for t in (a.get("tracks") or [])):
                target_album = a
                break
        if not target_album:
            die(f"track not found in collection: {args.track_id}")

    if target_album:
        tracks = resolve_playable_tracks(target_album, mode=mode, api_base=api_base)
        start_idx = max(0, int(args.track_index or 0))
        if args.track_id:
            for i, t in enumerate(tracks):
                if t.get("id") == args.track_id:
                    start_idx = i
                    break
        start_queue(
            tracks,
            {"type": "album", "albumId": target_album.get("id"), "title": target_album.get("title"), "mode": mode},
            shuffle=bool(args.shuffle),
            start_index=start_idx,
            loop=bool(args.loop),
        )
        return

    if args.scope:
        scope = args.scope.lower()
        pool_albums = albums
        if scope == "purchased":
            pool_albums = [a for a in albums if a.get("purchased")]
        elif scope == "local":
            pool_albums = [a for a in albums if a.get("isLocal")]
        tracks = []
        for a in pool_albums:
            tracks.extend(resolve_playable_tracks(a, mode=mode, api_base=api_base))
        start_queue(
            tracks,
            {"type": "collection", "scope": scope, "mode": mode},
            shuffle=bool(args.shuffle),
            start_index=0,
            loop=bool(args.loop),
        )
        return

    die("play requires --album <id>, --track-id <id>, --playlist <id>, or --scope all|purchased|local")


def cmd_download(args) -> None:
    settings = load_settings()
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    target = next((a for a in albums if a.get("id") == args.album or a.get("url") == args.album), None)
    if not target:
        die(f"album not found: {args.album}")
    fmt = args.format or settings.get("preferredFormat") or "flac"
    res = download_album_to_local(target, preferred_format=fmt, settings=settings)
    emit(res)


def cmd_import_zip(args) -> None:
    settings = load_settings()
    dl_root = os.path.expanduser(settings.get("downloadDir") or DEFAULT_DOWNLOAD_DIR)
    zips = find_bandcamp_zips_in_downloads()
    if args.zip_path:
        zpath = os.path.expanduser(args.zip_path)
        if not os.path.isfile(zpath):
            die(f"ZIP file not found: {zpath}")
        stem = os.path.splitext(os.path.basename(zpath))[0]
        dest = os.path.join(dl_root, re.sub(r"[/\\:\*\?\"<>\|]+", "-", stem).strip())
        files = safe_extract_zip(zpath, dest)
        res = build_unified_collection(settings, fetch_remote=False, detect_browser=False)
        emit({"imported": 1, "fileCount": len(files), "destDir": dest, "albumCount": res.get("albumCount")})
        return

    imported = 0
    total_files = 0
    for z in zips:
        folder = re.sub(r"[/\\:\*\?\"<>\|]+", "-", f"{z['artist']} - {z['album']}").strip()
        dest = os.path.join(dl_root, folder)
        files = safe_extract_zip(z["zipPath"], dest)
        imported += 1
        total_files += len(files)
    res = build_unified_collection(settings, fetch_remote=False, detect_browser=False)
    emit({"imported": imported, "fileCount": total_files, "albumCount": res.get("albumCount")})


def cmd_favourites(args) -> None:
    store = read_json(FAVOURITES_FILE, {"items": []}) or {"items": []}
    items = list(store.get("items") or [])
    if args.action == "list":
        emit({"items": items})
        return
    if not args.id:
        die("favourites add/remove/toggle requires --id")
    exists = any(i.get("id") == args.id for i in items)
    if args.action == "add" or (args.action == "toggle" and not exists):
        if not exists:
            items.append({"id": args.id, "title": bounded_text(args.title or args.id), "addedAt": int(time.time())})
            write_json(FAVOURITES_FILE, {"items": items})
        emit({"items": items, "favourited": True})
        return
    if args.action == "remove" or (args.action == "toggle" and exists):
        items = [i for i in items if i.get("id") != args.id]
        write_json(FAVOURITES_FILE, {"items": items})
        emit({"items": items, "favourited": False})
        return


def cmd_cmd(args) -> None:
    action = args.action
    if action == "play-pause":
        mpv_request(["cycle", "pause"])
    elif action == "play":
        mpv_request(["set_property", "pause", False])
    elif action == "pause":
        mpv_request(["set_property", "pause", True])
    elif action == "next":
        mpv_request(["playlist-next", "force"])
    elif action == "prev":
        pos = mpv_get("playlist-pos") or 0
        elapsed = mpv_get("time-pos") or 0
        if pos <= 0 or elapsed > 4:
            mpv_request(["seek", 0, "absolute"])
        else:
            mpv_request(["playlist-prev"])
    elif action == "stop":
        mpv_stop()
    elif action == "volume":
        if args.value is None:
            die("volume requires --value 0-130")
        mpv_request(["set_property", "volume", float(args.value)])
    elif action == "seek":
        if args.value is None:
            die("seek requires --value SECONDS")
        mpv_request(["seek", float(args.value), "absolute"])
    elif action == "loop":
        hist = read_json(HISTORY_FILE, {}) or {}
        if args.value is None:
            cur = mpv_get("loop-playlist")
            if cur is None:
                is_looping = bool(hist.get("loopPlaylist", False))
            else:
                is_looping = cur in ("inf", "force", True)
            target_loop = "no" if is_looping else "inf"
        else:
            target_loop = "inf" if args.value > 0 else "no"
        mpv_request(["set_property", "loop-playlist", target_loop])
        hist["loopPlaylist"] = target_loop == "inf"
        write_json(HISTORY_FILE, hist)
        emit({"action": action, "loop": target_loop == "inf"})
        return
    elif action == "jump":
        if args.value is None:
            die("jump requires --value PLAYLIST_INDEX")
        mpv_request(["set_property", "playlist-pos", int(args.value)])
    else:
        die(f"unknown transport command: {action}")
    emit({"action": action})


def cmd_now(args) -> None:
    playback = get_playback_state()
    hist = read_json(HISTORY_FILE, {}) or {}
    emit({
        **playback,
        "lastPlayedTrack": hist.get("lastPlayedTrack"),
    })


def cmd_visualiser_config(args) -> None:
    existing = read_json(VISUALISER_CONFIG_FILE, {})
    if not isinstance(existing, dict):
        existing = {}
    if getattr(args, "set", None) is not None:
        try:
            incoming = json.loads(args.set)
        except Exception as exc:
            die(f"invalid --set JSON payload: {exc}")
        if not isinstance(incoming, dict):
            die("--set payload must be a JSON object")
        existing.update(incoming)
        existing["updatedAt"] = int(time.time())
        write_json(VISUALISER_CONFIG_FILE, existing, mode=0o600)
    emit({
        "status": "ok",
        "config": existing,
        "path": VISUALISER_CONFIG_FILE,
    })


def _kill_bandarchy_processes() -> None:
    try:
        mpv_stop()
    except Exception:
        pass
    import signal

    uid = os.getuid()
    my_pid = os.getpid()
    allowed_exes = ("mpv", "cava", "quickshell", "bandarchy", "bandarchy-player", "python", "python3")
    try:
        proc_entries = os.listdir("/proc")
    except OSError:
        proc_entries = []
    for entry in proc_entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == my_pid:
            continue
        proc_dir = f"/proc/{pid}"
        try:
            st = os.lstat(proc_dir)
            if st.st_uid != uid:
                continue
            raw_cmd = safe_read_bytes(f"{proc_dir}/cmdline", max_bytes=65536)
            if not raw_cmd:
                continue
            parts = [p.decode("utf-8", errors="replace") for p in raw_cmd.split(b"\x00") if p]
            if not parts:
                continue
            exe_name = os.path.basename(parts[0])
            if exe_name not in allowed_exes:
                continue
            is_bandarchy_ui = (
                exe_name in ("quickshell", "bandarchy", "bandarchy-player")
                and "-p" in parts
                and any(p.endswith("/App.qml") and ("bandarchy" in p or "io.github.layolayo.bandarchy" in p) for p in parts)
            )
            is_bandarchy_cava = (
                exe_name == "cava"
                and "-p" in parts
                and any(("bandarchy" in p or "io.github.layolayo.bandarchy" in p) and p.endswith("cava.conf") for p in parts)
            )
            is_bandarchy_mpv = (
                exe_name == "mpv"
                and ("--audio-client-name=Bandarchy" in parts or any("bandarchy.sock" in p for p in parts))
            )
            if is_bandarchy_ui or is_bandarchy_cava or is_bandarchy_mpv:
                os.kill(pid, signal.SIGTERM)
        except OSError:
            continue


def cmd_kill(args) -> None:
    _kill_bandarchy_processes()
    emit({"action": "kill", "status": "stopped"})


def cmd_restart(args) -> None:
    _kill_bandarchy_processes()
    time.sleep(0.2)
    root_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    app_qml = os.path.join(root_dir, "App.qml")
    qs_bin = resolve_bin("quickshell")
    if os.path.isfile(app_qml) and qs_bin:
        ensure_private_dir(RUNTIME_DIR)
        bandarchy_bin = os.path.join(RUNTIME_DIR, "bandarchy")
        try:
            if os.path.islink(bandarchy_bin) or os.path.exists(bandarchy_bin):
                os.unlink(bandarchy_bin)
            os.symlink(qs_bin, bandarchy_bin)
        except Exception:
            bandarchy_bin = qs_bin
        subprocess.Popen(
            [bandarchy_bin, "-p", app_qml],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    emit({"action": "restart", "status": "restarted"})


def main() -> None:
    if len(sys.argv) == 2 and sys.argv[1] in ("--kill", "-k", "stop", "--stop"):
        sys.argv[1] = "kill"
    elif len(sys.argv) == 2 and sys.argv[1] in ("--restart", "-r"):
        sys.argv[1] = "restart"
    parser = argparse.ArgumentParser(prog="bandarchy", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("kill", help="stop all Bandarchy UI, cava, and mpv processes").set_defaults(func=cmd_kill)
    sub.add_parser("restart", help="restart standalone Bandarchy player window").set_defaults(func=cmd_restart)

    p = sub.add_parser("visualiser-config", help="get or atomically persist visualiser configuration and saved L1/L2/L3 layer items")
    p.add_argument("--get", action="store_true", help="read ~/.config/bandarchy/visualiser.json")
    p.add_argument("--set", help="atomically write JSON object to ~/.config/bandarchy/visualiser.json")
    p.set_defaults(func=cmd_visualiser_config)

    p = sub.add_parser("collection", help="list collection items filtered by scope and query")
    p.add_argument("--scope", choices=["all", "purchased", "local", "cloud"], default="all")
    p.add_argument("--query", default="")
    p.set_defaults(func=cmd_collection)

    p = sub.add_parser("album", help="resolve and return full tracklist for an album")
    p.add_argument("--id", required=True, help="album id or URL")
    p.set_defaults(func=cmd_album)

    p = sub.add_parser("search", help="search across albums and tracks")
    p.add_argument("query", nargs="?", default="")
    p.add_argument("--scope", choices=["all", "purchased", "local", "cloud"], default="all")
    p.add_argument("--limit", type=int, default=100)
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("sync", help="synchronise Bandcamp purchases and local music folders")
    p.add_argument("--username", help="Bandcamp fan username")
    p.add_argument("--api-base", help="Bandcamp base URL override (for testing)")
    p.add_argument("--local-only", action="store_true", help="only scan local folders and browser history")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("auth", help="configure Bandcamp username, session cookie, login/logout, or visualiser options")
    p.add_argument("--username")
    p.add_argument("--identity", help="Bandcamp identity cookie value")
    p.add_argument("--logout", action="store_true", help="log out of Bandcamp and clear saved identity")
    p.add_argument("--detect-browser", action="store_true", help="auto-detect Bandcamp username and identity cookie from browser")
    p.add_argument("--open-browser", action="store_true", help="open Bandcamp login page in default browser")
    p.add_argument("--download-dir")
    p.add_argument("--format", choices=["flac", "mp3-320", "mp3-v0", "wav", "ogg"])
    p.add_argument("--use-album-art", choices=["0", "1"], help="whether visualiser translates album cover art")
    p.add_argument("--ascii-mode", choices=["braille", "block", "banner", "text"], help="omarchy-transcode-ascii or banner mode")
    p.add_argument("--stage-mode", choices=["off", "art", "turntable", "visualiser"], help="active visualiser stage mode")
    p.add_argument("--top-bar-led", choices=["0", "1", "true", "false"], help="enable or disable the Omarchy top status bar LED equaliser")
    p.add_argument("--set-json", help="JSON object of visualiser/turntable settings to update")
    p.add_argument("--add-url", help="add a Bandcamp album or track URL to the purchased collection")
    p.set_defaults(func=cmd_auth)

    p = sub.add_parser("login", help="log into Bandcamp (from browser or explicit credentials) and sync")
    p.add_argument("--username", help="Bandcamp fan username")
    p.add_argument("--identity", help="Bandcamp identity cookie")
    p.add_argument("--detect-browser", action="store_true", help="detect credentials from browser")
    p.add_argument("--open-browser", action="store_true", help="open Bandcamp login page in browser")
    p.add_argument("--no-sync", action="store_true", help="skip remote sync after logging in")
    p.set_defaults(func=cmd_login)

    p = sub.add_parser("logout", help="log out of Bandcamp and clear stored session")
    p.set_defaults(func=cmd_logout)

    p = sub.add_parser("ascii-art", help="transcode album cover art into Omarchy screensaver ASCII/Unicode")
    p.add_argument("--album", help="album id or URL")
    p.add_argument("--image", help="explicit image path")
    p.add_argument("--text", help="fallback banner text for omarchy-ascii")
    p.add_argument("--mode", choices=["braille", "block", "banner", "text"], default=None)
    p.add_argument("--width", type=int, default=72)
    p.add_argument("--height", type=int, default=32)
    p.add_argument("--threshold", type=int, default=50)
    p.add_argument("--invert", action="store_true")
    p.add_argument("--use-album-art", choices=["0", "1"], default=None)
    p.add_argument("--effect", default="random", help="ttfx effect to extract keyframes for (defaults to random)")
    p.set_defaults(func=cmd_ascii_art)

    p = sub.add_parser("screensaver", help="launch Omarchy ttfx screensaver with transcoded album art")
    p.add_argument("--album", help="album id")
    p.add_argument("--image", help="image path")
    p.add_argument("--text", help="fallback text")
    p.add_argument("--mode", choices=["braille", "block", "banner"], default="braille")
    p.add_argument("--width", type=int, default=72)
    p.add_argument("--height", type=int, default=32)
    p.add_argument("--threshold", type=int, default=50)
    p.add_argument("--invert", action="store_true")
    p.add_argument("--use-album-art", choices=["0", "1"], default="1")
    p.add_argument("--effect", default="random", help="ttfx effect name or random")
    p.add_argument("--tty-loop", action="store_true", help="internal flag: run ttfx fullscreen loop directly in terminal")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_screensaver)

    p = sub.add_parser("smart-playlist", help="build intelligent playlist from last track played")
    p.add_argument("--seed-track", help="seed track id (defaults to last played track)")
    p.add_argument("--seed-album", help="seed album id")
    p.add_argument("--preset", choices=["radio", "kindred", "journey", "purchased"], default="radio")
    p.add_argument("--limit", type=int, default=25)
    p.add_argument("--track-index", type=int, default=0, help="0-based track index to start from when --play is used")
    p.add_argument("--play", action="store_true", help="start playing immediately")
    p.add_argument("--loop", action="store_true")
    p.add_argument("--save-as", help="save generated intelligent playlist as a user playlist")
    p.set_defaults(func=cmd_smart_playlist)

    p = sub.add_parser("playlists", help="create and manage custom user playlists")
    p.add_argument("action", choices=["list", "create", "add", "remove-track", "rename", "delete"])
    p.add_argument("--id", help="playlist id")
    p.add_argument("--title", help="playlist title")
    p.add_argument("--description", help="playlist description")
    p.add_argument("--tracks", help="comma-separated track ids")
    p.add_argument("--album", help="album id to add all tracks from")
    p.add_argument("--track-id", help="track id to remove")
    p.add_argument("--index", type=int, help="0-based track index to remove")
    p.add_argument("--from-smart", choices=["radio", "kindred", "journey", "purchased"])
    p.add_argument("--seed-track", help="seed track id for --from-smart")
    p.set_defaults(func=cmd_playlists)

    p = sub.add_parser("play", help="play an album, playlist, or collection scope through mpv")
    p.add_argument("--album", help="album id or URL")
    p.add_argument("--playlist", help="user playlist id")
    p.add_argument("--track-id", help="track id to start from")
    p.add_argument("--track-index", type=int, default=0, help="0-based track index to start from")
    p.add_argument("--scope", choices=["all", "purchased", "local"], help="play entire scope")
    p.add_argument("--mode", choices=["auto", "local", "stream"], default="auto")
    p.add_argument("--shuffle", action="store_true")
    p.add_argument("--loop", action="store_true")
    p.set_defaults(func=cmd_play)

    p = sub.add_parser("download", help="download a purchased Bandcamp album for local playback")
    p.add_argument("--album", required=True, help="album id or URL")
    p.add_argument("--format", choices=["flac", "mp3-320", "mp3-v0", "wav", "ogg"])
    p.set_defaults(func=cmd_download)

    p = sub.add_parser("import-zip", help="extract and import Bandcamp ZIP archives from ~/Downloads")
    p.add_argument("--zip-path", help="specific ZIP archive path")
    p.set_defaults(func=cmd_import_zip)

    p = sub.add_parser("favourites", help="manage favourite albums")
    p.add_argument("action", choices=["list", "add", "remove", "toggle"])
    p.add_argument("--id")
    p.add_argument("--title")
    p.set_defaults(func=cmd_favourites)

    p = sub.add_parser("cmd", help="control running mpv player")
    p.add_argument(
        "action",
        choices=["play-pause", "play", "pause", "next", "prev", "stop", "volume", "seek", "loop", "jump"],
    )
    p.add_argument("--value", type=float)
    p.set_defaults(func=cmd_cmd)

    sub.add_parser("now", help="current playback state").set_defaults(func=cmd_now)

    args = parser.parse_args()
    try:
        args.func(args)
    except BandarchyError as exc:
        die(str(exc))
    except Exception as exc:
        die(f"unexpected error: {exc}")


if __name__ == "__main__":
    main()
