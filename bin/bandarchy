def _parse_track_int(val: str) -> int:
    if not val:
        return 0
    m = re.match(r"^\s*(\d{1,4})", str(val))
    return int(m.group(1)) if m else 0


def _parse_year_str(val: str) -> str:
    if not val:
        return ""
    m = re.search(r"\b(19\d{2}|20\d{2})\b", str(val))
    return m.group(1) if m else ""


def _parse_genre_str(val: str) -> str:
    if not val:
        return ""
    s = str(val).strip()
    m_paren = re.match(r"^\((\d{1,3})\)(.*)$", s)
    if m_paren:
        idx = int(m_paren.group(1))
        rest = m_paren.group(2).strip()
        if rest:
            return bounded_text(rest, 120)
        if 0 <= idx < len(_ID3V1_GENRES):
            return _ID3V1_GENRES[idx]
        return ""
    if s.isdigit():
        idx = int(s)
        if 0 <= idx < len(_ID3V1_GENRES):
            return _ID3V1_GENRES[idx]
        return ""
    return bounded_text(s, 120)


def _decode_id3_text(fdata: bytes) -> str:
    if not fdata:
        return ""
    enc = fdata[0]
    raw = fdata[1:]
    if not raw:
        return ""
    if enc == 0:
        parts = raw.split(b"\x00")
        for p in parts:
            s = p.decode("latin-1", errors="replace").strip()
            if s:
                return bounded_text(s)
        return ""
    if enc == 1:
        # UTF-16 with BOM
        if len(raw) % 2 == 1:
            raw = raw[:-1]
        try:
            txt = raw.decode("utf-16", errors="replace")
        except Exception:
            txt = raw.decode("utf-16-le", errors="replace")
        for p in txt.split("\x00"):
            s = p.strip("\ufeff \t\r\n")
            if s:
                return bounded_text(s)
        return ""
    if enc == 2:
        if len(raw) % 2 == 1:
            raw = raw[:-1]
        txt = raw.decode("utf-16-be", errors="replace")
        for p in txt.split("\x00"):
            s = p.strip("\ufeff \t\r\n")
            if s:
                return bounded_text(s)
        return ""
    if enc == 3:
        for p in raw.split(b"\x00"):
            s = p.decode("utf-8", errors="replace").strip("\ufeff \t\r\n")
            if s:
                return bounded_text(s)
        return ""
    return bounded_text(fdata.decode("utf-8", errors="replace").split("\x00")[0].strip())


def _save_embedded_art(img_bytes: bytes, hint_ext: str = ".jpg") -> str:
    if not img_bytes or len(img_bytes) < 32 or len(img_bytes) > MAX_ART_BYTES:
        return ""
    # Trim any stray leading alignment bytes before image signature
    if not img_bytes.startswith((b"\xff\xd8\xff", b"\x89PNG\r\n\x1a\n", b"RIFF", b"GIF8")):
        for sig in (b"\xff\xd8\xff", b"\x89PNG\r\n\x1a\n"):
            idx = img_bytes.find(sig, 0, 128)
            if idx > 0:
                img_bytes = img_bytes[idx:]
                break
    if img_bytes.startswith(b"\x89PNG\r\n\x1a\n"):
        ext = ".png"
    elif img_bytes.startswith(b"\xff\xd8\xff"):
        ext = ".jpg"
    elif img_bytes[:4] == b"RIFF" and img_bytes[8:12] == b"WEBP":
        ext = ".webp"
    elif img_bytes[:6] in (b"GIF87a", b"GIF89a"):
        ext = ".gif"
    else:
        return ""
    ensure_private_dir(ART_CACHE_DIR)
    digest = hashlib.sha256(img_bytes).hexdigest()[:24]
    target = os.path.join(ART_CACHE_DIR, f"embedded_{digest}{ext}")
    if os.path.isfile(target) and os.path.getsize(target) >= 32:
        return target
    safe_write_bytes(target, img_bytes, mode=0o600, fatal=False)
    return target if os.path.isfile(target) else ""


def _extract_id3_apic(fdata: bytes, is_v22: bool = False) -> tuple[int, bytes, str]:
    if not fdata or len(fdata) < 16:
        return (0, b"", "")
    enc = fdata[0]
    if is_v22:
        fmt = fdata[1:4].decode("latin-1", errors="ignore").strip().lower()
        if fmt == "-->":
            return (0, b"", "")
        pic_type = fdata[4]
        desc_start = 5
        ext = ".png" if fmt == "png" else ".jpg"
    else:
        mime_end = fdata.find(b"\x00", 1)
        if mime_end == -1 or mime_end + 2 >= len(fdata):
            return (0, b"", "")
        mime = fdata[1:mime_end].decode("latin-1", errors="ignore").strip().lower()
        if mime == "-->":
            return (0, b"", "")
        pic_type = fdata[mime_end + 1]
        desc_start = mime_end + 2
        ext = ".png" if "png" in mime else (".webp" if "webp" in mime else ".jpg")

    if enc in (0, 3):
        desc_end = fdata.find(b"\x00", desc_start)
        img_start = desc_end + 1 if desc_end != -1 else desc_start
    else:
        i = desc_start
        while i + 1 < len(fdata) and fdata[i : i + 2] != b"\x00\x00":
            i += 2
        img_start = i + 2 if i + 1 < len(fdata) else desc_start

    img_bytes = fdata[img_start:]
    return (pic_type, img_bytes, ext)


def _parse_id3v2_tag(hdr: bytes, body: bytes, extract_art: bool = True) -> dict:
    out: dict = {}
    if len(hdr) < 10 or hdr[:3] != b"ID3":
        return out
    ver = hdr[3]
    flags = hdr[5]
    if ver not in (2, 3, 4) or not body:
        return out

    if (flags & 0x80) and ver in (2, 3):
        body = body.replace(b"\xff\x00", b"\xff")

    pos = 0
    if (flags & 0x40) and ver in (3, 4) and len(body) >= 4:
        if ver == 4:
            ext_sz = (
                ((body[0] & 0x7F) << 21)
                | ((body[1] & 0x7F) << 14)
                | ((body[2] & 0x7F) << 7)
                | (body[3] & 0x7F)
            )
            pos = max(4, ext_sz)
        else:
            ext_sz = int.from_bytes(body[:4], "big")
            pos = 4 + ext_sz if ext_sz >= 6 else 4

    best_apic: tuple[int, bytes, str] | None = None

    while pos < len(body):
        if ver == 2:
            if pos + 6 > len(body):
                break
            fid_b = body[pos : pos + 3]
            if fid_b == b"\x00\x00\x00" or not all(48 <= b <= 57 or 65 <= b <= 90 for b in fid_b):
                break
            fsz = int.from_bytes(body[pos + 3 : pos + 6], "big")
            if fsz <= 0 or pos + 6 + fsz > len(body):
                break
            fdata = body[pos + 6 : pos + 6 + fsz]
            pos += 6 + fsz
            fid = fid_b.decode("ascii")
        else:
            if pos + 10 > len(body):
                break
            fid_b = body[pos : pos + 4]
            if fid_b == b"\x00\x00\x00\x00" or not all(48 <= b <= 57 or 65 <= b <= 90 for b in fid_b):
                break
            raw_sz = body[pos + 4 : pos + 8]
            fflags0 = body[pos + 8]
            fflags1 = body[pos + 9]
            if ver == 4:
                fsz_sync = (
                    ((raw_sz[0] & 0x7F) << 21)
                    | ((raw_sz[1] & 0x7F) << 14)
                    | ((raw_sz[2] & 0x7F) << 7)
                    | (raw_sz[3] & 0x7F)
                )
                fsz_be = int.from_bytes(raw_sz, "big")
                if any(b & 0x80 for b in raw_sz):
                    fsz = fsz_be
                elif fsz_sync != fsz_be and pos + 10 + fsz_be <= len(body):
                    nxt_sync = body[pos + 10 + fsz_sync : pos + 14 + fsz_sync]
                    nxt_be = body[pos + 10 + fsz_be : pos + 14 + fsz_be]
                    sync_ok = not nxt_sync or nxt_sync == b"\x00\x00\x00\x00" or all(48 <= b <= 57 or 65 <= b <= 90 for b in nxt_sync)
                    be_ok = not nxt_be or nxt_be == b"\x00\x00\x00\x00" or all(48 <= b <= 57 or 65 <= b <= 90 for b in nxt_be)
                    fsz = fsz_be if (be_ok and not sync_ok) else fsz_sync
                else:
                    fsz = fsz_sync
            else:
                fsz = int.from_bytes(raw_sz, "big")

            if fsz <= 0 or pos + 10 + fsz > len(body):
                break
            fdata = body[pos + 10 : pos + 10 + fsz]
            pos += 10 + fsz
            fid = fid_b.decode("ascii")

            if ver == 3:
                if fflags1 & 0x40:  # encrypted
                    continue
                if fflags1 & 0x20 and len(fdata) >= 1:  # grouping identity
                    fdata = fdata[1:]
                if fflags1 & 0x80:  # zlib compressed across 4-byte decompressed length prefix
                    try:
                        fdata = zlib.decompress(fdata[4:])
                    except Exception:
                        continue
            elif ver == 4:
                if fflags1 & 0x04:  # encrypted
                    continue
                if fflags1 & 0x40 and len(fdata) >= 1:  # grouping identity
                    fdata = fdata[1:]
                if (fflags1 & 0x02) or (flags & 0x80):  # unsynchronised
                    fdata = fdata.replace(b"\xff\x00", b"\xff")
                if fflags1 & 0x01 and len(fdata) >= 4:  # data length indicator
                    fdata = fdata[4:]
                if fflags1 & 0x08:  # compressed
                    try:
                        fdata = zlib.decompress(fdata)
                    except Exception:
                        continue

        if fid in ("TIT2", "TT2") and "title" not in out:
            val = _decode_id3_text(fdata)
            if val:
                out["title"] = val
        elif fid in ("TPE1", "TP1") and "artist" not in out:
            val = _decode_id3_text(fdata)
            if val:
                out["artist"] = val
        elif fid in ("TPE2", "TP2") and "albumArtist" not in out:
            val = _decode_id3_text(fdata)
            if val:
                out["albumArtist"] = val
        elif fid in ("TALB", "TAL") and "album" not in out:
            val = _decode_id3_text(fdata)
            if val:
                out["album"] = val
        elif fid in ("TRCK", "TRK") and "track" not in out:
            t_int = _parse_track_int(_decode_id3_text(fdata))
            if t_int > 0:
                out["track"] = t_int
        elif fid in ("TPOS", "TPA") and "disc" not in out:
            d_int = _parse_track_int(_decode_id3_text(fdata))
            if d_int > 0:
                out["disc"] = d_int
        elif fid in ("TDRC", "TYER", "TYE", "TDOR", "TOR") and "year" not in out:
            yr = _parse_year_str(_decode_id3_text(fdata))
            if yr:
                out["year"] = yr
        elif fid in ("TCON", "TCO") and "genre" not in out:
            gn = _parse_genre_str(_decode_id3_text(fdata))
            if gn:
                out["genre"] = gn
        elif fid in ("TLEN", "TLE") and "duration" not in out:
            ms_str = _decode_id3_text(fdata)
            if ms_str.isdigit() and int(ms_str) > 0:
                out["duration"] = round(int(ms_str) / 1000.0, 1)
        elif fid in ("COMM", "COM") and "comment" not in out and len(fdata) > 4:
            c_txt = _decode_id3_text(fdata[:1] + fdata[4:])
            if c_txt:
                out["comment"] = c_txt
        elif fid in ("APIC", "PIC") and extract_art:
            ptype, img_bytes, ext = _extract_id3_apic(fdata, is_v22=(ver == 2))
            if img_bytes and len(img_bytes) >= 32:
                if best_apic is None or (ptype == 3 and best_apic[0] != 3):
                    best_apic = (ptype, img_bytes, ext)

    if best_apic is not None:
        art_p = _save_embedded_art(best_apic[1], best_apic[2])
        if art_p:
            out["artPath"] = art_p
    return out


def _probe_mp3_duration(fd: int, fsize: int, audio_offset: int) -> float:
    if fsize <= audio_offset + 128:
        return 0.0
    try:
        os.lseek(fd, audio_offset, os.SEEK_SET)
        buf = os.read(fd, 16384)
    except OSError:
        return 0.0
    idx = 0
    while idx + 4 <= len(buf):
        if buf[idx] == 0xFF and (buf[idx + 1] & 0xE0) == 0xE0:
            b1, b2 = buf[idx + 1], buf[idx + 2]
            ver_bits = (b1 >> 3) & 0x03
            layer_bits = (b1 >> 1) & 0x03
            br_idx = (b2 >> 4) & 0x0F
            sr_idx = (b2 >> 2) & 0x03
            if ver_bits != 1 and layer_bits in (1, 2, 3) and 0 < br_idx < 15 and sr_idx < 3:
                sr = _MPEG_SAMPLERATES[sr_idx]
                if ver_bits == 2:
                    sr //= 2
                elif ver_bits == 0:
                    sr //= 4
                br = (
                    _MPEG_BITRATES_V1_L3[br_idx] if ver_bits == 3 else _MPEG_BITRATES_V2_L3[br_idx]
                ) * 1000
                samples_per_frame = 1152 if (ver_bits == 3 or layer_bits == 2) else 576
                frame_win = buf[idx : idx + 256]
                for xtag in (b"Xing", b"Info"):
                    xpos = frame_win.find(xtag)
                    if xpos != -1 and xpos + 12 <= len(frame_win):
                        xflags = int.from_bytes(frame_win[xpos + 4 : xpos + 8], "big")
                        if xflags & 0x01:
                            tot_frames = int.from_bytes(frame_win[xpos + 8 : xpos + 12], "big")
                            if tot_frames > 0 and sr > 0:
                                return round(tot_frames * samples_per_frame / sr, 1)
                vpos = frame_win.find(b"VBRI")
                if vpos != -1 and vpos + 18 <= len(frame_win):
                    tot_frames = int.from_bytes(frame_win[vpos + 14 : vpos + 18], "big")
                    if tot_frames > 0 and sr > 0:
                        return round(tot_frames * samples_per_frame / sr, 1)
                if br > 0:
                    return round(max(0, fsize - audio_offset) * 8.0 / br, 1)
        idx += 1
    return 0.0


def _parse_flac_picture_block(pbuf: bytes) -> tuple[int, bytes, str]:
    if len(pbuf) < 32:
        return (0, b"", "")
    ptype = int.from_bytes(pbuf[:4], "big")
    mlen = int.from_bytes(pbuf[4:8], "big")
    if mlen < 0 or 8 + mlen + 4 > len(pbuf):
        return (0, b"", "")
    mime = pbuf[8 : 8 + mlen].decode("latin-1", errors="ignore").strip().lower()
    dpos = 8 + mlen
    dlen = int.from_bytes(pbuf[dpos : dpos + 4], "big")
    ipos = dpos + 4 + dlen + 16
    if dlen < 0 or ipos + 4 > len(pbuf):
        return (0, b"", "")
    ilen = int.from_bytes(pbuf[ipos : ipos + 4], "big")
    if ilen <= 0 or ipos + 4 + ilen > len(pbuf):
        return (0, b"", "")
    img = pbuf[ipos + 4 : ipos + 4 + ilen]
    ext = ".png" if "png" in mime else (".webp" if "webp" in mime else ".jpg")
    return (ptype, img, ext)


def _parse_vorbis_comments_to_meta(data: bytes, extract_art: bool = True) -> dict:
    out: dict = {}
    if len(data) < 8:
        return out
    vlen = int.from_bytes(data[:4], "little")
    pos = 4 + vlen
    if vlen < 0 or pos + 4 > len(data):
        return out
    count = int.from_bytes(data[pos : pos + 4], "little")
    pos += 4
    best_pic: tuple[int, bytes, str] | None = None
    for _ in range(min(count, 500)):
        if pos + 4 > len(data):
            break
        clen = int.from_bytes(data[pos : pos + 4], "little")
        pos += 4
        if clen < 0 or pos + clen > len(data):
            break
        raw_c = data[pos : pos + clen]
        pos += clen
        eq_idx = raw_c.find(b"=")
        if eq_idx <= 0:
            continue
        k = raw_c[:eq_idx].decode("ascii", errors="ignore").strip().upper()
        if k == "METADATA_BLOCK_PICTURE":
            if extract_art:
                try:
                    pbuf = base64.b64decode(raw_c[eq_idx + 1 :])
                    ptype, img_b, ext = _parse_flac_picture_block(pbuf)
                    if img_b and (best_pic is None or (ptype == 3 and best_pic[0] != 3)):
                        best_pic = (ptype, img_b, ext)
                except Exception:
                    pass
            continue
        v = raw_c[eq_idx + 1 :].decode("utf-8", errors="replace").strip()
        if not v:
            continue
        if k == "TITLE" and "title" not in out:
            out["title"] = bounded_text(v)
        elif k == "ARTIST" and "artist" not in out:
            out["artist"] = bounded_text(v)
        elif k in ("ALBUMARTIST", "ALBUM_ARTIST", "ALBUM ARTIST") and "albumArtist" not in out:
            out["albumArtist"] = bounded_text(v)
        elif k == "ALBUM" and "album" not in out:
            out["album"] = bounded_text(v)
        elif k in ("TRACKNUMBER", "TRACK") and "track" not in out:
            t_int = _parse_track_int(v)
            if t_int > 0:
                out["track"] = t_int
        elif k in ("DISCNUMBER", "DISC") and "disc" not in out:
            d_int = _parse_track_int(v)
            if d_int > 0:
                out["disc"] = d_int
        elif k in ("DATE", "YEAR", "ORIGINALDATE") and "year" not in out:
            yr = _parse_year_str(v)
            if yr:
                out["year"] = yr
        elif k == "GENRE" and "genre" not in out:
            gn = _parse_genre_str(v)
            if gn:
                out["genre"] = gn
        elif k in ("COMMENT", "DESCRIPTION") and "comment" not in out:
            out["comment"] = bounded_text(v, 240)
    if best_pic is not None:
        art_p = _save_embedded_art(best_pic[1], best_pic[2])
        if art_p:
            out["artPath"] = art_p
    return out


def _parse_mp4_metadata(fd: int, fsize: int, extract_art: bool = True) -> dict:
    out: dict = {}

    def _read_at(offset: int, length: int) -> bytes:
        try:
            os.lseek(fd, offset, os.SEEK_SET)
            return os.read(fd, length)
        except OSError:
            return b""

    def _iter_boxes(start: int, end: int):
        cur = start
        while cur + 8 <= end:
            bh = _read_at(cur, 16)
            if len(bh) < 8:
                break
            bsz = int.from_bytes(bh[:4], "big")
            btype = bh[4:8]
            hdr_len = 8
            if bsz == 1 and len(bh) >= 16:
                bsz = int.from_bytes(bh[8:16], "big")
                hdr_len = 16
            elif bsz == 0:
                bsz = end - cur
            if bsz < hdr_len or cur + bsz > end:
                break
            yield btype, cur + hdr_len, cur + bsz
            cur += bsz

    for btype, bstart, bend in _iter_boxes(0, fsize):
        if btype == b"moov":
            for mtype, mstart, mend in _iter_boxes(bstart, bend):
                if mtype == b"mvhd" and mend - mstart >= 24:
                    mvhd = _read_at(mstart, 32)
                    if len(mvhd) >= 24:
                        ver = mvhd[0]
                        if ver == 0:
                            ts = int.from_bytes(mvhd[12:16], "big")
                            dur = int.from_bytes(mvhd[16:20], "big")
                        elif len(mvhd) >= 32:
                            ts = int.from_bytes(mvhd[20:24], "big")
                            dur = int.from_bytes(mvhd[24:32], "big")
                        else:
                            ts, dur = 0, 0
                        if ts > 0 and dur > 0:
                            out["duration"] = round(dur / ts, 1)
                elif mtype == b"udta":
                    for utype, ustart, uend in _iter_boxes(mstart, mend):
                        if utype == b"meta" and uend - ustart > 4:
                            for itype, istart, iend in _iter_boxes(ustart + 4, uend):
                                if itype == b"ilst":
                                    for atype, astart, aend in _iter_boxes(istart, iend):
                                        for dtype, dstart, dend in _iter_boxes(astart, aend):
                                            if dtype != b"data" or dend - dstart <= 8:
                                                continue
                                            dlen = dend - dstart
                                            if dlen > MAX_ART_BYTES:
                                                continue
                                            dbuf = _read_at(dstart, dlen)
                                            if len(dbuf) <= 8:
                                                continue
                                            dpayload = dbuf[8:]
                                            if atype == b"\xa9nam" and "title" not in out:
                                                out["title"] = bounded_text(dpayload.decode("utf-8", errors="replace").strip())
                                            elif atype == b"\xa9ART" and "artist" not in out:
                                                out["artist"] = bounded_text(dpayload.decode("utf-8", errors="replace").strip())
                                            elif atype == b"aART" and "albumArtist" not in out:
                                                out["albumArtist"] = bounded_text(dpayload.decode("utf-8", errors="replace").strip())
                                            elif atype == b"\xa9alb" and "album" not in out:
                                                out["album"] = bounded_text(dpayload.decode("utf-8", errors="replace").strip())
                                            elif atype == b"\xa9day" and "year" not in out:
                                                yr = _parse_year_str(dpayload.decode("utf-8", errors="replace"))
                                                if yr:
                                                    out["year"] = yr
                                            elif atype in (b"\xa9gen", b"gnre") and "genre" not in out:
                                                if atype == b"gnre" and len(dpayload) >= 2:
                                                    g_idx = int.from_bytes(dpayload[:2], "big") - 1
                                                    if 0 <= g_idx < len(_ID3V1_GENRES):
                                                        out["genre"] = _ID3V1_GENRES[g_idx]
                                                else:
                                                    gn = _parse_genre_str(dpayload.decode("utf-8", errors="replace"))
                                                    if gn:
                                                        out["genre"] = gn
                                            elif atype == b"trkn" and len(dpayload) >= 4 and "track" not in out:
                                                t_int = int.from_bytes(dpayload[2:4], "big")
                                                if t_int > 0:
                                                    out["track"] = t_int
                                            elif atype == b"disk" and len(dpayload) >= 4 and "disc" not in out:
                                                d_int = int.from_bytes(dpayload[2:4], "big")
                                                if d_int > 0:
                                                    out["disc"] = d_int
                                            elif atype == b"covr" and extract_art and "artPath" not in out:
                                                art_p = _save_embedded_art(dpayload)
                                                if art_p:
                                                    out["artPath"] = art_p
            break
    return out


def read_audio_metadata(
    path: str,
    extract_art: bool = True,
    _cache: dict | None = None,
    _cache_dirty: list[bool] | None = None,
) -> dict:
    """Read embedded metadata and cover art from MP3 (ID3v2.2/2.3/2.4 + ID3v1),
    FLAC, Ogg Vorbis/Opus, WAV/AIFF, and M4A/MP4 files in pure Python.
    """
    uid = os.getuid()
    try:
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or st.st_uid not in (uid, 0):
            return {}
        mtime_ns = st.st_mtime_ns
        fsize = st.st_size
    except OSError:
        return {}

    if _cache is not None:
        cached_entry = _cache.get(path)
        if (
            isinstance(cached_entry, dict)
            and cached_entry.get("m") == mtime_ns
            and cached_entry.get("s") == fsize
            and isinstance(cached_entry.get("d"), dict)
        ):
            cached_meta = cached_entry["d"]
            cached_art = cached_meta.get("artPath") or ""
            if not extract_art or not cached_Entry_needs_art(cached_meta, cached_art):
                return dict(cached_meta)

    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
    except OSError:
        return {}

    meta: dict = {}
    try:
        st_f = os.fstat(fd)
        if not stat.S_ISREG(st_f.st_mode) or st_f.st_ino != st.st_ino:
            return {}
        head = os.read(fd, 16384)
        if len(head) < 4:
            return {}

        # 1. ID3v2 header at start of file (MP3, or ID3-prefixed FLAC/WAV/AAC)
        audio_offset = 0
        if head[:3] == b"ID3" and len(head) >= 10:
            hdr = head[:10]
            tag_sz = (
                ((hdr[6] & 0x7F) << 21)
                | ((hdr[7] & 0x7F) << 14)
                | ((hdr[8] & 0x7F) << 7)
                | (hdr[9] & 0x7F)
            )
            audio_offset = 10 + tag_sz
            read_sz = min(tag_sz, MAX_ART_BYTES)
            if 10 + read_sz <= len(head):
                body = head[10 : 10 + read_sz]
            else:
                chunks = [head[10:]]
                rem = (10 + read_sz) - len(head)
                while rem > 0:
                    ch = os.read(fd, min(65536, rem))
                    if not ch:
                        break
                    chunks.append(ch)
                    rem -= len(ch)
                body = b"".join(chunks)
            meta.update(_parse_id3v2_tag(hdr, body, extract_art=extract_art))
            if "artPath" in meta:
                meta["hasArt"] = True

        ext_l = os.path.splitext(path)[1].lower()

        # 2. MP3 duration & ID3v1 fallback
        if ext_l == ".mp3" or head[:3] == b"ID3" or (head[0] == 0xFF and (head[1] & 0xE0) == 0xE0):
            if not meta.get("duration"):
                dur = _probe_mp3_duration(fd, fsize, audio_offset)
                if dur > 0:
                    meta["duration"] = dur
            if fsize >= 128 and not (meta.get("title") and meta.get("artist") and meta.get("album")):
                try:
                    os.lseek(fd, fsize - 128, os.SEEK_SET)
                    v1 = os.read(fd, 128)
                    if len(v1) == 128 and v1[:3] == b"TAG":
                        if not meta.get("title"):
                            t_s = v1[3:33].rstrip(b"\x00 ").decode("latin-1", errors="replace").strip()
                            if t_s:
                                meta["title"] = bounded_text(t_s)
                        if not meta.get("artist"):
                            a_s = v1[33:63].rstrip(b"\x00 ").decode("latin-1", errors="replace").strip()
                            if a_s:
                                meta["artist"] = bounded_text(a_s)
                        if not meta.get("album"):
                            al_s = v1[63:93].rstrip(b"\x00 ").decode("latin-1", errors="replace").strip()
                            if al_s:
                                meta["album"] = bounded_text(al_s)
                        if not meta.get("year"):
                            y_s = _parse_year_str(v1[93:97].decode("latin-1", errors="replace"))
                            if y_s:
                                meta["year"] = y_s
                        if not meta.get("track") and v1[125] == 0 and v1[126] != 0:
                            meta["track"] = int(v1[126])
                        if not meta.get("genre") and v1[127] < len(_ID3V1_GENRES):
                            meta["genre"] = _ID3V1_GENRES[v1[127]]
                except OSError:
                    pass

        # 3. FLAC metadata blocks (STREAMINFO, VORBIS_COMMENT, PICTURE)
        elif head[:4] == b"fLaC":
            os.lseek(fd, 4, os.SEEK_SET)
            best_pic: tuple[int, bytes, str] | None = None
            for _ in range(64):
                bh = os.read(fd, 4)
                if len(bh) < 4:
                    break
                is_last = (bh[0] & 0x80) != 0
                btype = bh[0] & 0x7F
                blen = int.from_bytes(bh[1:4], "big")
                if blen < 0 or blen > MAX_ART_BYTES:
                    break
                if btype == 0 and blen >= 18:
                    sinfo = os.read(fd, blen)
                    if len(sinfo) >= 18:
                        sr = (sinfo[10] << 12) | (sinfo[11] << 4) | (sinfo[12] >> 4)
                        tot_samples = ((sinfo[13] & 0x0F) << 32) | int.from_bytes(sinfo[14:18], "big")
                        if sr > 0 and tot_samples > 0:
                            meta["duration"] = round(tot_samples / sr, 1)
                elif btype == 4 and blen > 0:
                    vbuf = os.read(fd, blen)
                    vmeta = _parse_vorbis_comments_to_meta(vbuf, extract_art=extract_art)
                    for k, v in vmeta.items():
                        if k not in meta:
                            meta[k] = v
                elif btype == 6 and blen > 32:
                    meta["hasArt"] = True
                    if extract_art:
                        pbuf = os.read(fd, blen)
                        ptype, img_b, ext = _parse_flac_picture_block(pbuf)
                        if img_b and (best_pic is None or (ptype == 3 and best_pic[0] != 3)):
                            best_pic = (ptype, img_b, ext)
                    else:
                        os.lseek(fd, blen, os.SEEK_CUR)
                else:
                    os.lseek(fd, blen, os.SEEK_CUR)
                if is_last:
                    break
            if best_pic is not None and "artPath" not in meta:
                art_p = _save_embedded_art(best_pic[1], best_pic[2])
                if art_p:
                    meta["artPath"] = art_p

        # 4. Ogg Vorbis / Ogg Opus
        elif head[:4] == b"OggS":
            os.lseek(fd, 0, os.SEEK_SET)
            ogg_buf = os.read(fd, 262144 if extract_art else 65536)
            pos = 0
            payload = bytearray()
            while pos + 27 <= len(ogg_buf):
                if ogg_buf[pos : pos + 4] != b"OggS":
                    break
                n_segs = ogg_buf[pos + 26]
                if pos + 27 + n_segs > len(ogg_buf):
                    break
                seg_tbl = ogg_buf[pos + 27 : pos + 27 + n_segs]
                body_len = sum(seg_tbl)
                body_start = pos + 27 + n_segs
                payload.extend(ogg_buf[body_start : body_start + body_len])
                pos = body_start + body_len
                if len(payload) >= 16384 and (b"\x03vorbis" in payload or b"OpusTags" in payload):
                    if not extract_art or b"METADATA_BLOCK_PICTURE" not in payload.upper():
                        break
            for marker in (b"\x03vorbis", b"OpusTags"):
                m_idx = payload.find(marker)
                if m_idx != -1:
                    vmeta = _parse_vorbis_comments_to_meta(
                        bytes(payload[m_idx + len(marker) :]),
                        extract_art=extract_art,
                    )
                    meta.update(vmeta)
                    if "artPath" in vmeta:
                        meta["hasArt"] = True
                    break

        # 5. RIFF WAVE (`fmt `, `data`, `ID3 ` / `id3 `)
        elif head[:4] == b"RIFF" and head[8:12] == b"WAVE":
            pos = 12
            byte_rate = 0
            data_bytes = 0
            while pos + 8 <= fsize:
                os.lseek(fd, pos, os.SEEK_SET)
                chdr = os.read(fd, 8)
                if len(chdr) < 8:
                    break
                cid = chdr[:4]
                csz = int.from_bytes(chdr[4:8], "little")
                if csz < 0:
                    break
                if cid == b"fmt " and csz >= 12:
                    fmt_b = os.read(fd, min(csz, 32))
                    if len(fmt_b) >= 12:
                        byte_rate = int.from_bytes(fmt_b[8:12], "little")
                elif cid == b"data":
                    data_bytes = csz
                elif cid in (b"ID3 ", b"id3 ") and 10 <= csz <= MAX_ART_BYTES:
                    id3_buf = os.read(fd, csz)
                    if id3_buf[:3] == b"ID3" and len(id3_buf) >= 10:
                        meta.update(_parse_id3v2_tag(id3_buf[:10], id3_buf[10:], extract_art=extract_art))
                        if "artPath" in meta:
                            meta["hasArt"] = True
                pos += 8 + csz + (csz & 1)
            if byte_rate > 0 and data_bytes > 0 and not meta.get("duration"):
                meta["duration"] = round(data_bytes / byte_rate, 1)

        # 6. MP4 / M4A / ALAC (`ftyp`)
        elif len(head) >= 8 and head[4:8] == b"ftyp":
            meta.update(_parse_mp4_metadata(fd, fsize, extract_art=extract_art))
            if "artPath" in meta:
                meta["hasArt"] = True
    except Exception:
        pass
    finally:
        try:
            os.close(fd)
        except OSError:
            pass

    if _cache is not None:
        _cache[path] = {"m": mtime_ns, "s": fsize, "d": dict(meta)}
        if _cache_dirty is not None:
            _cache_dirty[0] = True
    return meta


def cached_Entry_needs_art(cached_meta: dict, cached_art: str) -> bool:
    if cached_art:
        return not os.path.isfile(cached_art)
    return bool(cached_meta.get("hasArt"))


def _infer_folder_suffix(folder_path: str, root_dir: str) -> str:
    rel = os.path.relpath(folder_path, root_dir)
    parts = [p for p in rel.split(os.sep) if p and p != "."]
    sub_stopwords = re.compile(
        r"^(cd\s*\d+|disk\s*\d+|disc\s*\d+|flac|mp3|wav|ogg|extended|youtubedl|deluxe)$",
        re.IGNORECASE,
    )
    suffix_parts: list[str] = []
    idx = len(parts) - 1
    while idx > 0 and sub_stopwords.match(parts[idx].strip()):
        suffix_parts.insert(0, parts[idx].strip())
        idx -= 1
    return f" ({' · '.join(suffix_parts)})" if suffix_parts else ""


def _most_common_tag(values: list[str]) -> str:
    if not values:
        return ""
    counts: dict[str, int] = {}
    first_seen: dict[str, str] = {}
    for v in values:
        fv = fold(v)
        if not fv:
            continue
        counts[fv] = counts.get(fv, 0) + 1
        if fv not in first_seen:
            first_seen[fv] = v
    if not counts:
        return ""
    best_fold = max(counts, key=lambda k: counts[k])
    return first_seen[best_fold]


def scan_local_directories(local_dirs: list[str]) -> list[dict]:
    albums_by_dir: dict[str, dict] = {}
    seen_real_dirs: set[str] = set()

    raw_cache = read_json(TAGS_CACHE_FILE, None)
    tags_cache: dict = raw_cache if isinstance(raw_cache, dict) else {}
    cache_dirty = [False]

    for base_dir in local_dirs:
        base_dir = os.path.expanduser(base_dir)
        if not os.path.isdir(base_dir):
            continue
        for root, dirs, files in os.walk(base_dir):
            dirs[:] = sorted(
                d for d in dirs
                if d not in _IGNORED_SCAN_DIRS and not d.startswith(".")
            )
            real_root = os.path.realpath(root)
            if real_root in seen_real_dirs:
                continue

            audio_files = sorted(
                f for f in files
                if not f.startswith(".")
                and not f.startswith("._")
                and f.lower().endswith(AUDIO_EXTENSIONS)
                and not os.path.islink(os.path.join(root, f))
            )
            if not audio_files:
                continue
            seen_real_dirs.add(real_root)

            image_files = sorted(
                f for f in files
                if not f.startswith(".")
                and not f.startswith("._")
                and f.lower().endswith(IMAGE_EXTENSIONS)
                and not os.path.islink(os.path.join(root, f))
            )
            cover_path = ""
            if image_files:
                preferred = [
                    f for f in image_files
                    if os.path.splitext(f)[0].lower() in ("cover", "front", "folder", "album")
                ]
                chosen = preferred[0] if preferred else image_files[0]
                cover_path = os.path.join(root, chosen)

            fallback_artist, fallback_album = infer_artist_album(root, base_dir)
            folder_suffix = _infer_folder_suffix(root, base_dir)

            file_metas: list[tuple[int, str, str, dict]] = []
            for idx, fname in enumerate(audio_files, start=1):
                fpath = os.path.join(root, fname)
                meta = read_audio_metadata(
                    fpath,
                    extract_art=not bool(cover_path),
                    _cache=tags_cache,
                    _cache_dirty=cache_dirty,
                )
                if not cover_path and meta.get("artPath") and os.path.isfile(meta["artPath"]):
                    cover_path = meta["artPath"]
                file_metas.append((idx, fname, fpath, meta))

            # Resolve album-level artist and title from embedded tags first, falling back to folder heuristics
            tag_album_artists = [m["albumArtist"] for _, _, _, m in file_metas if m.get("albumArtist")]
            tag_artists = [m["artist"] for _, _, _, m in file_metas if m.get("artist")]
            tag_albums = [m["album"] for _, _, _, m in file_metas if m.get("album")]
            tag_years = [m["year"] for _, _, _, m in file_metas if m.get("year")]
            tag_genres = [m["genre"] for _, _, _, m in file_metas if m.get("genre")]

            dominant_album_artist = _most_common_tag(tag_album_artists)
            dominant_track_artist = _most_common_tag(tag_artists)
            dominant_album = _most_common_tag(tag_albums)

            if dominant_album_artist:
                artist = dominant_album_artist
            elif dominant_track_artist:
                artist = dominant_track_artist
            else:
                artist = fallback_artist

            if dominant_album:
                # Preserve subfolder edition/disc qualifiers (e.g. "Deadwing B-Sides", "(CD1)", "(Extended)")
                if (
                    not fallback_album.endswith(" — Singles")
                    and fold(fallback_album).startswith(fold(dominant_album) + " ")
                ):
                    album_title = fallback_album
                elif folder_suffix and folder_suffix.lower() not in dominant_album.lower():
                    album_title = bounded_text(f"{dominant_album}{folder_suffix}")
                else:
                    album_title = dominant_album
            elif fallback_album.endswith(" — Singles") and artist != fallback_artist:
                album_title = bounded_text(f"{artist} — Singles{folder_suffix}")
            else:
                album_title = fallback_album

            raw_track_records: list[tuple[bool, int, dict]] = []
            explicit_nums: set[int] = set()

            for idx, fname, fpath, meta in file_metas:
                fn_num, fn_title, fn_artist = parse_track_filename(fname, artist, album_title, idx)
                stem = os.path.splitext(fname)[0].strip()
                fn_has_explicit_num = bool(
                    re.match(r"^(.+?)\s+-\s+(.+?)\s+-\s+(\d{1,3})[\s._-]+(.+)$", stem)
                    or re.match(r"^(\d{1,3})(?:\s*[-._]\s*|\s+)(.+)$", stem)
                )

                tag_num = bounded_int(meta.get("track") or 0, 0)
                if tag_num > 0:
                    t_num = tag_num
                    is_explicit = True
                elif fn_has_explicit_num:
                    t_num = fn_num
                    is_explicit = True
                else:
                    t_num = idx
                    is_explicit = False

                if is_explicit:
                    explicit_nums.add(t_num)

                t_title = bounded_text(meta.get("title") or fn_title)
                t_artist = bounded_text(meta.get("artist") or meta.get("albumArtist") or fn_artist or artist)
                t_album = bounded_text(meta.get("album") or album_title)
                if artist in ("Local Artist", "Unknown Artist") and t_artist not in ("Local Artist", "Unknown Artist"):
                    artist = t_artist

                est_dur = bounded_float(meta.get("duration") or 0.0, 0.0)
                if est_dur <= 0.0:
                    try:
                        fsize = os.path.getsize(fpath)
                        ext_l = os.path.splitext(fname)[1].lower()
                        if ext_l in (".flac", ".wav", ".aiff"):
                            est_dur = round(fsize / (176400 * 0.65), 1)
                        else:
                            est_dur = round(fsize / 28000, 1)
                    except OSError:
                        pass

                tr_entry: dict = {
                    "id": f"local-track-{hashlib.sha1(fpath.encode('utf-8')).hexdigest()[:16]}",
                    "title": t_title,
                    "artist": t_artist,
                    "album": album_title if dominant_album else t_album,
                    "index": t_num,
                    "duration": est_dur,
                    "streamUrl": "",
                    "localPath": fpath,
                    "format": os.path.splitext(fname)[1].lstrip(".").upper(),
                }
                if meta.get("disc"):
                    tr_entry["disc"] = int(meta["disc"])
                if meta.get("year"):
                    tr_entry["year"] = str(meta["year"])
                if meta.get("genre"):
                    tr_entry["genre"] = str(meta["genre"])
                raw_track_records.append((is_explicit, idx, tr_entry))

            # Ensure tracks without explicit track numbers never collide with explicit TRCK numbers
            next_free = 1
            tracks: list[dict] = []
            for is_explicit, _, tr_entry in raw_track_records:
                if not is_explicit:
                    while next_free in explicit_nums:
                        next_free += 1
                    tr_entry["index"] = next_free
                    explicit_nums.add(next_free)
                    next_free += 1
                tracks.append(tr_entry)

            tracks.sort(key=lambda t: (int(t.get("disc") or 1), t["index"], t["title"]))
            album_id = f"local-{hashlib.sha1(real_root.encode('utf-8')).hexdigest()[:16]}"
            if not cover_path:
                cover_path = ensure_cover_svg(album_id, artist, album_title)

            in_bandcamp_dir = "bandcamp" in real_root.lower()
            has_bc_naming = any(
                re.match(r"^.+?\s+-\s+.+?\s+-\s+\d{1,3}\s+", os.path.splitext(f)[0])
                for f in audio_files
            )
            has_bc_comment = any(
                "bandcamp.com" in str(m.get("comment") or "").lower()
                for _, _, _, m in file_metas
            )

            formats = sorted({t.get("format", "") for t in tracks if t.get("format")})
            audio_fmt = " / ".join(formats) if formats else "Local Audio"
            total_dur = round(sum(float(t.get("duration") or 0.0) for t in tracks), 1)

            alb_record: dict = {
                "id": album_id,
                "itemId": "",
                "itemType": "album",
                "title": album_title,
                "artist": artist,
                "url": "",
                "artUrl": "",
                "artPath": cover_path,
                "redownloadUrl": "",
                "purchased": bool(in_bandcamp_dir or has_bc_naming or has_bc_comment),
                "isLocal": True,
                "localPath": root,
                "audioFormat": audio_fmt,
                "totalDuration": total_dur,
                "numTracks": len(tracks),
                "tracks": tracks,
                "fold": fold(f"{artist} {album_title}"),
            }
            if tag_years:
                alb_record["year"] = _most_common_tag(tag_years)
            if tag_genres:
                alb_record["genre"] = _most_common_tag(tag_genres)
            albums_by_dir[real_root] = alb_record

    if cache_dirty[0]:
        try:
            if len(tags_cache) > 25_000:
                keys = list(tags_cache.keys())[-20_000:]
                tags_cache = {k: tags_cache[k] for k in keys}
            write_json(TAGS_CACHE_FILE, tags_cache, mode=0o600)
        except Exception:
            pass

    return list(albums_by_dir.values())


def safe_extract_zip(zip_path: str, dest_dir: str) -> list[str]:
    uid = os.getuid()
    try:
        zst = os.lstat(zip_path)
    except OSError as exc:
        raise BandarchyError(f"cannot stat archive: {exc}")
    if stat.S_ISLNK(zst.st_mode) or not stat.S_ISREG(zst.st_mode) or zst.st_uid != uid:
        raise BandarchyError(f"refusing symlinked, non-regular, or foreign-owned archive: {zip_path}")
    if zst.st_size > MAX_DOWNLOAD_BYTES:
        raise BandarchyError("archive file exceeds maximum size ceiling")

    os.makedirs(dest_dir, mode=0o700, exist_ok=True)
    abs_dest = os.path.abspath(dest_dir)
    cur = abs_dest
    while cur and cur != os.sep:
        st_d = os.lstat(cur)
        if stat.S_ISLNK(st_d.st_mode) or not stat.S_ISDIR(st_d.st_mode) or st_d.st_uid not in (uid, 0):
            raise BandarchyError(f"refusing unsafe destination directory component: {cur}")
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    st_dest = os.lstat(abs_dest)
    if stat.S_ISLNK(st_dest.st_mode) or not stat.S_ISDIR(st_dest.st_mode) or st_dest.st_uid != uid:
        raise BandarchyError(f"refusing unsafe destination directory: {abs_dest}")
    os.chmod(abs_dest, 0o700)
    real_dest = os.path.realpath(abs_dest)

    zflags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        zflags |= os.O_NOFOLLOW
    zfd = os.open(zip_path, zflags)
    try:
        zfst = os.fstat(zfd)
        if (
            not stat.S_ISREG(zfst.st_mode)
            or zfst.st_uid != uid
            or zfst.st_ino != zst.st_ino
            or zfst.st_dev != zst.st_dev
        ):
            os.close(zfd)
            raise BandarchyError(f"refusing modified or untrusted archive: {zip_path}")
        zfile_obj = os.fdopen(zfd, "rb")
    except Exception:
        try:
            os.close(zfd)
        except OSError:
            pass
        raise

    extracted: list[str] = []
    used_basenames: set[str] = set()
    with zfile_obj, zipfile.ZipFile(zfile_obj, "r") as zf:
        infos = zf.infolist()
        if len(infos) > MAX_ARCHIVE_FILES:
            raise BandarchyError("archive exceeds maximum member count ceiling")
        total_uncompressed = sum(info.file_size for info in infos)
        if total_uncompressed > MAX_DOWNLOAD_BYTES:
            raise BandarchyError("archive exceeds maximum uncompressed size ceiling")
        bytes_written = 0
        for info in infos:
            name = info.filename
            if not name or name.endswith("/") or "__MACOSX" in name:
                continue
            mode = (info.external_attr >> 16) & 0o170000
            if mode == stat.S_IFLNK:
                continue
            norm_parts = name.replace("\\", "/").split("/")
            if ".." in norm_parts or name.startswith(("/", "\\")):
                raise BandarchyError(f"refusing unsafe path in archive: {name}")
            base_name = os.path.basename(name)
            if base_name.startswith(".") or base_name.startswith("._"):
                continue
            if base_name in used_basenames:
                sub_prefix = "-".join(
                    re.sub(r"[^a-zA-Z0-9._ -]+", "_", p).strip(" .")
                    for p in norm_parts[:-1]
                    if p
                )
                cand_name = f"{sub_prefix} - {base_name}" if sub_prefix else base_name
                if cand_name in used_basenames:
                    stem, ext = os.path.splitext(cand_name)
                    dup_idx = 2
                    while f"{stem}_{dup_idx}{ext}" in used_basenames:
                        dup_idx += 1
                    cand_name = f"{stem}_{dup_idx}{ext}"
                base_name = cand_name
            used_basenames.add(base_name)
            target_path = os.path.join(real_dest, base_name)
            if os.path.lexists(target_path):
                st_t = os.lstat(target_path)
                if stat.S_ISLNK(st_t.st_mode) or not stat.S_ISREG(st_t.st_mode) or st_t.st_uid != uid:
                    raise BandarchyError(f"refusing symlink or unsafe target in archive destination: {base_name}")
                os.unlink(target_path)
            resolved_target = os.path.realpath(target_path)
            if not resolved_target.startswith(real_dest + os.sep):
                raise BandarchyError(f"refusing unsafe path in archive: {name}")
            out_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
            if hasattr(os, "O_NOFOLLOW"):
                out_flags |= os.O_NOFOLLOW
            with zf.open(info, "r") as src:
                fd = os.open(target_path, out_flags, 0o600)
                try:
                    with os.fdopen(fd, "wb") as dst:
                        while True:
                            chunk = src.read(65536)
                            if not chunk:
                                break
                            bytes_written += len(chunk)
                            if bytes_written > MAX_DOWNLOAD_BYTES:
                                raise BandarchyError("archive stream exceeded maximum uncompressed byte ceiling")
                            dst.write(chunk)
                except Exception:
                    try:
                        os.unlink(target_path)
                    except OSError:
                        pass
                    raise
            extracted.append(target_path)
    return extracted


def find_bandcamp_zips_in_downloads() -> list[dict]:
    dl_dir = os.path.join(HOME, "Downloads")
    if not os.path.isdir(dl_dir):
        return []
    uid = os.getuid()
    found = []
    for fname in sorted(os.listdir(dl_dir)):
        if not fname.lower().endswith(".zip") or fname.startswith("."):
            continue
        stem = os.path.splitext(fname)[0]
        if " - " not in stem:
            continue
        fpath = os.path.join(dl_dir, fname)
        try:
            st = os.lstat(fpath)
            if (
                stat.S_ISLNK(st.st_mode)
                or not stat.S_ISREG(st.st_mode)
                or st.st_uid != uid
                or st.st_size > MAX_DOWNLOAD_BYTES
            ):
                continue
            with zipfile.ZipFile(fpath, "r") as zf:
                names = [n for n in zf.namelist() if not n.startswith("__MACOSX")]
                has_audio = any(n.lower().endswith(AUDIO_EXTENSIONS) for n in names)
                if has_audio:
                    artist, album = stem.split(" - ", 1)
                    found.append({
                        "zipPath": fpath,
                        "artist": bounded_text(artist.strip()),
                        "album": bounded_text(album.strip()),
                        "trackCount": sum(1 for n in names if n.lower().endswith(AUDIO_EXTENSIONS)),
                    })
        except Exception:
            continue
    return found


# --------------------------------------------------------------------------- #
# Unified Collection Builder
# --------------------------------------------------------------------------- #

def build_unified_collection(
    settings: dict,
    on_progress=None,
    fetch_remote: bool = True,
    detect_browser: bool = False,
) -> dict:
    logged_out = bool(settings.get("loggedOut", False))
    if logged_out or not detect_browser:
        browser = {
            "username": "",
            "albums": [],
            "downloads": [],
            "hasBrowserSession": False,
            "identityCookie": "",
        }
        username = settings.get("username") or ""
    else:
        browser = discover_from_browsers()
        username = settings.get("username") or browser.get("username") or ""
        if username and not settings.get("username"):
            settings["username"] = username
            write_json(SETTINGS_FILE, settings)
        auth_data = read_json(AUTH_FILE, {}) or {}
        if browser.get("identityCookie") and not auth_data.get("identity"):
            auth_data["identity"] = browser["identityCookie"]
            write_json(AUTH_FILE, auth_data, mode=0o600)

    api_base = settings.get("apiBase") or "https://bandcamp.com"
    remote_items: list[dict] = []
    network_note = ""

    if on_progress:
        on_progress("discovering", 0, 0)

    def _merge_album_records(primary: dict, secondary: dict) -> dict:
        if not primary.get("url") and secondary.get("url"):
            primary["url"] = secondary["url"]
        if not primary.get("artUrl") and secondary.get("artUrl"):
            primary["artUrl"] = secondary["artUrl"]
        if (not primary.get("artPath") or str(primary.get("artPath", "")).endswith(".svg")) and secondary.get("artPath"):
            primary["artPath"] = secondary["artPath"]
        if not primary.get("redownloadUrl") and secondary.get("redownloadUrl"):
            primary["redownloadUrl"] = secondary["redownloadUrl"]
        if secondary.get("itemType") == "album" and primary.get("itemType") == "track":
            primary["itemType"] = "album"
        if secondary.get("isLocal") and not primary.get("isLocal"):
            primary["isLocal"] = True
            primary["localPath"] = secondary.get("localPath") or ""
            primary["audioFormat"] = secondary.get("audioFormat") or "Local Audio"
        sec_tracks = secondary.get("tracks") or []
        pri_tracks = primary.get("tracks") or []
        if len(sec_tracks) > len(pri_tracks) or (secondary.get("isLocal") and any(t.get("localPath") for t in sec_tracks)):
            pri_by_title = {fold(t.get("title", "")): t for t in pri_tracks}
            merged_tr = []
            for st in sec_tracks:
                pt = pri_by_title.get(fold(st.get("title", "")))
                m_t = dict(st)
                if pt:
                    if pt.get("streamUrl") and not m_t.get("streamUrl"):
                        m_t["streamUrl"] = pt["streamUrl"]
                    if pt.get("duration") and not m_t.get("duration"):
                        m_t["duration"] = pt["duration"]
                merged_tr.append(m_t)
            primary["tracks"] = merged_tr
            primary["numTracks"] = len(merged_tr)
            primary["totalDuration"] = round(sum(float(t.get("duration") or 0.0) for t in merged_tr), 1)
        return primary

    def _album_priority(alb: dict) -> tuple:
        aid = str(alb.get("id") or "")
        return (
            1 if aid.startswith("bc-album-") else (0 if aid.startswith("bc-browser-") else -1),
            1 if alb.get("itemType") == "album" else 0,
            len(alb.get("tracks") or []),
            1 if alb.get("redownloadUrl") else 0,
            1 if (alb.get("artPath") and not str(alb.get("artPath")).endswith(".svg")) else 0,
        )

    raw_remote_items: list[dict] = []
    if fetch_remote and username and not logged_out:
        try:
            raw_remote_items = fetch_fan_collection(username, api_base=api_base)
        except Exception as exc:
            network_note = bounded_text(str(exc), 240)
    elif not fetch_remote and not logged_out:
        existing_store = read_json(INDEX_FILE, None) or {}
        existing_albums = existing_store.get("albums") or []
        bc_album_keys = {
            f"{fold(a.get('artist', ''))}::{fold(a.get('title', ''))}"
            for a in existing_albums
            if str(a.get("id", "")).startswith("bc-album-")
        }
        for prev_alb in existing_albums:
            aid = str(prev_alb.get("id") or "")
            if aid.startswith("local-"):
                continue
            akey = f"{fold(prev_alb.get('artist', ''))}::{fold(prev_alb.get('title', ''))}"
            if aid.startswith("bc-browser-") and akey in bc_album_keys:
                continue
            if prev_alb.get("purchased"):
                copied = dict(prev_alb)
                copied["isLocal"] = False
                copied["localPath"] = ""
                copied["audioFormat"] = "Bandcamp Stream"
                copied["totalDuration"] = round(sum(float(t.get("duration") or 0.0) for t in (copied.get("tracks") or [])), 1)
                raw_remote_items.append(copied)

    remote_by_key: dict[str, dict] = {}
    for item in raw_remote_items:
        akey = f"{fold(item.get('artist', ''))}::{fold(item.get('title', ''))}"
        if akey in remote_by_key:
            existing = remote_by_key[akey]
            if _album_priority(item) > _album_priority(existing):
                remote_by_key[akey] = _merge_album_records(dict(item), existing)
            else:
                remote_by_key[akey] = _merge_album_records(existing, item)
        else:
            remote_by_key[akey] = dict(item)
    remote_items = list(remote_by_key.values())

    seen_urls = {item.get("url"): item for item in remote_items if item.get("url")}
    seen_ids = {item.get("id"): item for item in remote_items if item.get("id")}
    seen_artist_titles = {f"{fold(item.get('artist', ''))}::{fold(item.get('title', ''))}": item for item in remote_items}
    dl_urls = list(browser.get("downloads") or [])
    need_browser_detail_fetch = fetch_remote and len(remote_items) < 15
    for idx, b_item in enumerate(browser.get("albums") or []):
        u = b_item.get("url") or ""
        if not u or u in seen_urls:
            continue
        b_title_pre = b_item.get("title") or ""
        b_artist_pre = b_item.get("artist") or ""
        pre_key = f"{fold(b_artist_pre)}::{fold(b_title_pre)}"
        if b_artist_pre and b_title_pre and pre_key in seen_artist_titles:
            existing = seen_artist_titles[pre_key]
            if b_item.get("itemType") == "album" and existing.get("itemType") == "track":
                existing["url"] = u
                existing["itemType"] = "album"
            continue
        det = None
        if need_browser_detail_fetch:
            try:
                det = fetch_album_details(u, api_base=api_base)
            except Exception:
                det = None
        title = (det or {}).get("title") or b_item.get("title") or "Untitled"
        artist = (det or {}).get("artist") or b_item.get("artist") or "Unknown Artist"
        album_id = (det or {}).get("id") or f"bc-browser-{slugify(artist)}-{slugify(title)}"
        akey = f"{fold(artist)}::{fold(title)}"
        if album_id in seen_ids or akey in seen_artist_titles:
            target = seen_ids.get(album_id) or seen_artist_titles.get(akey)
            if target and b_item.get("itemType") == "album" and target.get("itemType") == "track":
                target["url"] = u
                target["itemType"] = "album"
            continue
        art_url = (det or {}).get("artUrl") or ""
        tracks = (det or {}).get("tracks") or [
            {
                "id": f"{album_id}-t1",
                "title": title,
                "artist": artist,
                "album": title,
                "index": 1,
                "duration": 240.0,
                "streamUrl": "",
                "localPath": "",
                "itemUrl": u,
            }
        ]
        new_rem = {
            "id": album_id,
            "itemId": (det or {}).get("itemId") or "",
            "itemType": b_item.get("itemType") or "album",
            "title": title,
            "artist": artist,
            "url": u,
            "artUrl": art_url,
            "artPath": "",
            "redownloadUrl": dl_urls[idx] if idx < len(dl_urls) else "",
            "purchased": True,
            "isLocal": False,
            "localPath": "",
            "audioFormat": "Bandcamp Stream",
            "totalDuration": round(sum(float(t.get("duration") or 0.0) for t in tracks), 1),
            "numTracks": len(tracks),
            "tracks": tracks,
            "fold": fold(f"{artist} {title}"),
        }
        remote_items.append(new_rem)
        seen_urls[u] = new_rem
        seen_ids[album_id] = new_rem
        seen_artist_titles[akey] = new_rem

    if on_progress:
        on_progress("scanning-local", len(remote_items), 0)
    local_dirs = settings.get("localDirs") or DEFAULT_LOCAL_DIRS
    raw_local_albums = scan_local_directories(local_dirs)

    # Deduplicate local folders that share the exact same (artist, title, audioFormat)
    dedup_local_map: dict[tuple[str, str, str], dict] = {}
    for loc in raw_local_albums:
        lkey = (fold(loc["artist"]), fold(loc["title"]), str(loc.get("audioFormat") or "Local Audio"))
        if lkey not in dedup_local_map or len(loc.get("tracks") or []) > len(dedup_local_map[lkey].get("tracks") or []):
            dedup_local_map[lkey] = loc
    local_albums = list(dedup_local_map.values())

    local_by_key: dict[str, dict] = {}
    local_by_title: dict[str, dict] = {}
    for loc in local_albums:
        k = f"{fold(loc['artist'])}::{fold(loc['title'])}"
        local_by_key[k] = loc
        local_by_title[fold(loc["title"])] = loc

    matched_local_ids: set[str] = set()
    unified: list[dict] = []
    art_to_fetch: list[dict] = []

    for rem in remote_items:
        k = f"{fold(rem['artist'])}::{fold(rem['title'])}"
        loc = local_by_key.get(k) or local_by_title.get(fold(rem["title"]))
        if loc:
            matched_local_ids.add(loc["id"])
            rem["isLocal"] = True
            rem["localPath"] = loc["localPath"]
            rem["audioFormat"] = loc.get("audioFormat") or "Local Audio"
            if loc.get("artPath") and not loc["artPath"].endswith(".svg"):
                rem["artPath"] = loc["artPath"]
            elif not rem.get("artPath"):
                art_to_fetch.append(rem)
            rem_tracks_by_title = {fold(t["title"]): t for t in (rem.get("tracks") or [])}
            merged_tracks = []
            for lt in loc.get("tracks") or []:
                rt = rem_tracks_by_title.get(fold(lt["title"]))
                merged = dict(lt)
                if rt and rt.get("streamUrl"):
                    merged["streamUrl"] = rt["streamUrl"]
                if rt and rt.get("duration") and not merged.get("duration"):
                    merged["duration"] = rt["duration"]
                merged["itemUrl"] = rem.get("url") or ""
                merged_tracks.append(merged)
            if merged_tracks:
                rem["tracks"] = merged_tracks
                rem["numTracks"] = len(merged_tracks)
                rem["totalDuration"] = round(sum(float(t.get("duration") or 0.0) for t in merged_tracks), 1)
        else:
            if not rem.get("artPath"):
                art_to_fetch.append(rem)
        unified.append(rem)

    if art_to_fetch:
        if fetch_remote:
            def _fetch_one_art(item: dict) -> None:
                item["artPath"] = cache_remote_art(
                    item.get("artUrl", ""),
                    item["id"],
                    item["artist"],
                    item["title"],
                )
            with concurrent.futures.ThreadPoolExecutor(max_workers=12) as pool:
                list(pool.map(_fetch_one_art, art_to_fetch))
        else:
            for item in art_to_fetch:
                item["artPath"] = ensure_cover_svg(item["id"], item["artist"], item["title"])

    for loc in local_albums:
        if logged_out or remote_items:
            loc["purchased"] = False
        if loc["id"] not in matched_local_ids:
            unified.append(loc)

    # Final canonical deduplication pass keyed by (fold(artist), fold(title), audioFormat if isLocal else "stream"),
    # always retaining the Bandcamp bc-album-* record as the primary entry.
    final_map: dict[tuple[str, str, str], dict] = {}
    for alb in unified:
        fmt_key = str(alb.get("audioFormat") or "Local Audio") if alb.get("isLocal") else "stream"
        ukey = (fold(alb.get("artist") or ""), fold(alb.get("title") or ""), fmt_key)
        if ukey in final_map:
            existing = final_map[ukey]
            if _album_priority(alb) > _album_priority(existing):
                final_map[ukey] = _merge_album_records(dict(alb), existing)
            else:
                final_map[ukey] = _merge_album_records(existing, alb)
        else:
            final_map[ukey] = alb
    unified = list(final_map.values())

    unified.sort(
        key=lambda a: (
            0 if (a.get("purchased") and a.get("isLocal")) else (1 if a.get("purchased") else 2),
            fold(a.get("artist") or ""),
            fold(a.get("title") or ""),
        )
    )

    if on_progress:
        on_progress("done", len(unified), sum(a.get("numTracks", 0) for a in unified))

    zips = find_bandcamp_zips_in_downloads()
    auth_now = read_json(AUTH_FILE, {}) or {}
    result = {
        "indexedAt": int(time.time()),
        "username": username,
        "loggedOut": logged_out,
        "hasIdentity": bool(auth_now.get("identity")),
        "hasBrowserSession": bool(browser.get("hasBrowserSession", False) or auth_now.get("identity")),
        "networkNote": network_note,
        "albumCount": len(unified),
        "purchasedCount": sum(1 for a in unified if a.get("purchased")),
        "localCount": sum(1 for a in unified if a.get("isLocal")),
        "trackCount": sum(len(a.get("tracks") or []) for a in unified),
        "availableZips": zips,
        "albums": unified[:MAX_COLLECTION_ITEMS],
    }
    write_json(INDEX_FILE, result)
    _refresh_saved_queue_and_history(result["albums"])
    return result


def _refresh_saved_queue_and_history(albums: list[dict]) -> None:
    """Keep saved queue.json and history.json track metadata and artPath synchronised with freshly scanned albums."""
    track_lookup: dict[str, dict] = {}
    for alb in albums:
        aid = alb.get("id") or ""
        a_title = alb.get("title") or ""
        a_artist = alb.get("artist") or ""
        a_art = alb.get("artPath") or ""
        for t in alb.get("tracks") or []:
            info = {
                "id": t.get("id") or "",
                "title": t.get("title") or "",
                "artist": t.get("artist") or a_artist,
                "album": t.get("album") or a_title,
                "albumId": aid,
                "artPath": a_art,
                "duration": t.get("duration") or 0.0,
            }
            if info["id"]:
                track_lookup[info["id"]] = info
            if t.get("localPath"):
                track_lookup[str(t["localPath"])] = info

    if not track_lookup:
        return

    def _patch_entry(item: dict) -> bool:
        if not isinstance(item, dict):
            return False
        ref = (
            track_lookup.get(str(item.get("id") or ""))
            or track_lookup.get(str(item.get("localPath") or ""))
            or track_lookup.get(str(item.get("target") or ""))
        )
        if not ref:
            return False
        changed = False
        for k in ("title", "artist", "album", "albumId", "artPath"):
            if ref.get(k) and item.get(k) != ref[k]:
                item[k] = ref[k]
                changed = True
        if ref.get("duration") and float(ref["duration"]) > 0 and not item.get("duration"):
            item["duration"] = ref["duration"]
            changed = True
        return changed

    try:
        queue = read_json(QUEUE_FILE, None)
        if isinstance(queue, dict) and isinstance(queue.get("tracks"), list):
            q_changed = False
            for qt in queue["tracks"]:
                if _patch_entry(qt):
                    q_changed = True
            src = queue.get("source")
            if isinstance(src, dict) and src.get("albumId"):
                alb_match = next((a for a in albums if a.get("id") == src["albumId"]), None)
                if alb_match and alb_match.get("title") and src.get("title") != alb_match["title"]:
                    src["title"] = alb_match["title"]
                    q_changed = True
            if q_changed:
                write_json(QUEUE_FILE, queue)
    except Exception:
        pass

    try:
        hist = read_json(HISTORY_FILE, None)
        if isinstance(hist, dict):
            h_changed = False
            if isinstance(hist.get("lastPlayedTrack"), dict) and _patch_entry(hist["lastPlayedTrack"]):
                h_changed = True
            if isinstance(hist.get("recentTracks"), list):
                for rt in hist["recentTracks"]:
                    if _patch_entry(rt):
                        h_changed = True
            if h_changed:
                write_json(HISTORY_FILE, hist)
    except Exception:
        pass


def _extract_status_summary(idx: dict, mtime_ns: int = 0, size: int = 0) -> dict:
    albums = idx.get("albums") or []
    return {
        "indexMtimeNs": mtime_ns,
        "indexSize": size,
        "username": idx.get("username") or "",
        "hasBrowserSession": bool(idx.get("hasBrowserSession", False)),
        "networkNote": idx.get("networkNote") or "",
        "albumCount": len(albums),
        "purchasedCount": idx.get("purchasedCount") or 0,
        "localCount": idx.get("localCount") or 0,
        "trackCount": idx.get("trackCount") or 0,
        "indexedAt": idx.get("indexedAt") or 0,
        "availableZips": idx.get("availableZips") or [],
    }


def ensure_index() -> dict:
    idx = read_json(INDEX_FILE, None)
    if isinstance(idx, dict) and isinstance(idx.get("albums"), list) and len(idx["albums"]) > 0:
        return idx
    global concurrent, sqlite3, ssl, urllib, zipfile
    import concurrent.futures as _cf  # noqa: F401
    import sqlite3
    import ssl
    import urllib.error  # noqa: F401
    import urllib.parse  # noqa: F401
    import urllib.request as _ur  # noqa: F401
    import zipfile
    import concurrent
    import urllib
    return build_unified_collection(load_settings(), fetch_remote=False)


def ensure_status_summary() -> dict:
    """Fast-path status metadata reader that caches summary counts keyed by INDEX_FILE mtime/size."""
    try:
        if os.path.exists(INDEX_FILE) and not os.path.islink(INDEX_FILE):
            st = os.stat(INDEX_FILE)
            cached = read_json(STATUS_COUNTS_FILE, None)
            if (
                isinstance(cached, dict)
                and cached.get("indexMtimeNs") == st.st_mtime_ns
                and cached.get("indexSize") == st.st_size
                and cached.get("albumCount", 0) > 0
            ):
                return cached
            idx = ensure_index()
            st = os.stat(INDEX_FILE)
            summary = _extract_status_summary(idx, st.st_mtime_ns, st.st_size)
            write_json(STATUS_COUNTS_FILE, summary)
            return summary
    except Exception:
        pass
    idx = ensure_index()
    summary = _extract_status_summary(idx)
    try:
        if os.path.exists(INDEX_FILE):
            st = os.stat(INDEX_FILE)
            summary["indexMtimeNs"] = st.st_mtime_ns
            summary["indexSize"] = st.st_size
        write_json(STATUS_COUNTS_FILE, summary)
    except Exception:
        pass
    return summary


# --------------------------------------------------------------------------- #
# Playback History & Intelligent / User Playlists Engine
# --------------------------------------------------------------------------- #

def record_history(track: dict, position: float | None = None, playlist_pos: int | None = None) -> None:
    """Record a played track (and its playback position / queue index) in HISTORY_FILE."""
    if not track or not track.get("title"):
        return
    hist = read_json(HISTORY_FILE, {"lastPlayedTrack": None, "recentTracks": []}) or {}
    recent = list(hist.get("recentTracks") or [])
    now_ts = int(time.time())
    track_id = bounded_text(track.get("id") or "")
    last_played = hist.get("lastPlayedTrack") or {}
    eff_pos = bounded_float(
        position
        if position is not None
        else (track.get("position") if track.get("position") is not None else last_played.get("position", 0.0)),
        0.0,
    )
    eff_pl_pos = bounded_int(
        playlist_pos
        if playlist_pos is not None
        else (track.get("playlistPos") if track.get("playlistPos") is not None else last_played.get("playlistPos", 0)),
        0,
    )
    is_same_recent_track = (
        track_id
        and last_played.get("id") == track_id
        and recent
        and recent[0].get("id") == track_id
        and (now_ts - int(last_played.get("playedAt") or 0)) < 30
    )
    if is_same_recent_track and position is None and playlist_pos is None:
        return
    entry = {
        "id": track_id,
        "title": bounded_text(track.get("title") or last_played.get("title") or ""),
        "artist": bounded_text(track.get("artist") or last_played.get("artist") or ""),
        "album": bounded_text(track.get("album") or last_played.get("album") or ""),
        "albumId": bounded_text(track.get("albumId") or last_played.get("albumId") or ""),
        "artPath": bounded_text(track.get("artPath") or last_played.get("artPath") or "", MAX_URL_CHARS),
        "duration": bounded_float(track.get("duration") or last_played.get("duration") or 0.0),
        "position": eff_pos,
        "playlistPos": eff_pl_pos,
        "target": bounded_text(track.get("target") or last_played.get("target") or "", MAX_URL_CHARS),
        "localPath": bounded_text(track.get("localPath") or last_played.get("localPath") or "", MAX_URL_CHARS),
        "streamUrl": bounded_text(track.get("streamUrl") or last_played.get("streamUrl") or "", MAX_URL_CHARS),
        "playSource": bounded_text(track.get("playSource") or last_played.get("playSource") or "local", 32),
        "purchased": bool(track.get("purchased", last_played.get("purchased", False))),
        "isLocal": bool(track.get("isLocal", last_played.get("isLocal", True))),
        "playedAt": int(last_played.get("playedAt") or now_ts) if is_same_recent_track else now_ts,
    }
    if recent and recent[0].get("id") == entry["id"] and entry["id"]:
        recent[0] = entry
    else:
        recent = [r for r in recent if r.get("id") != entry["id"]]
        recent.insert(0, entry)
    recent = recent[:200]
    hist["lastPlayedTrack"] = entry
    hist["recentTracks"] = recent
    write_json(HISTORY_FILE, hist)


def all_indexed_tracks(idx: dict) -> list[dict]:
    out = []
    for a in idx.get("albums") or []:
        for t in a.get("tracks") or []:
            entry = dict(t)
            entry["albumId"] = a.get("id") or ""
            entry["album"] = a.get("title") or t.get("album") or ""
            entry["artist"] = t.get("artist") or a.get("artist") or ""
            entry["artPath"] = a.get("artPath") or ""
            entry["albumUrl"] = a.get("url") or ""
            entry["purchased"] = bool(a.get("purchased", False))
            entry["isLocal"] = bool(a.get("isLocal", False))
            out.append(entry)
    return out


def are_kindred_artists(artist_a: str, artist_b: str) -> bool:
    fa, fb = fold(artist_a), fold(artist_b)
    if not fa or not fb:
        return False
    if fa == fb or fa in fb or fb in fa:
        return True
    for cluster in KINDRED_CLUSTERS:
        if any(c in fa for c in cluster) and any(c in fb for c in cluster):
            return True
    tokens_a = {w for w in fa.split() if len(w) > 3 and w not in ("the", "band", "music")}
    tokens_b = {w for w in fb.split() if len(w) > 3 and w not in ("the", "band", "music")}
    return bool(tokens_a & tokens_b)


def build_intelligent_playlist(
    idx: dict,
    seed_track_id: str = "",
    seed_album_id: str = "",
    preset: str = "radio",
    limit: int = 25,
) -> dict:
    """Build an intelligent playlist based on the last track played (or explicit seed)."""
    tracks = all_indexed_tracks(idx)
    if not tracks:
        return {"seed": None, "preset": preset, "title": "Intelligent Mix", "tracks": []}

    hist = read_json(HISTORY_FILE, {}) or {}
    recent_ids = [r.get("id") for r in (hist.get("recentTracks") or [])[:12] if r.get("id")]

    seed = None
    if seed_track_id:
        seed = next((t for t in tracks if t.get("id") == seed_track_id), None)
    if not seed and seed_album_id:
        seed = next((t for t in tracks if t.get("albumId") == seed_album_id), None)
    if not seed and hist.get("lastPlayedTrack"):
        last_id = hist["lastPlayedTrack"].get("id")
        last_title = fold(hist["lastPlayedTrack"].get("title") or "")
        seed = next(
            (t for t in tracks if (last_id and t.get("id") == last_id) or (last_title and fold(t.get("title")) == last_title)),
            None,
        )
    if not seed:
        # Default to first purchased+local or purchased track
        seed = next((t for t in tracks if t.get("purchased") and t.get("isLocal")), tracks[0])

    seed_artist = seed.get("artist") or ""
    seed_album_id = seed.get("albumId") or ""
    seed_dur = float(seed.get("duration") or 240.0)
    seed_words = {
        w for w in fold(f"{seed.get('title', '')} {seed.get('album', '')}").split()
        if len(w) >= 3 and not w.isdigit()
    }

    scored: list[tuple[float, dict]] = []
    for i, cand in enumerate(tracks):
        if cand.get("id") == seed.get("id"):
            continue
        if preset == "purchased" and not cand.get("purchased"):
            continue

        score = 10.0
        same_artist = fold(cand.get("artist")) == fold(seed_artist)
        kindred = are_kindred_artists(cand.get("artist", ""), seed_artist)
        same_album = cand.get("albumId") == seed_album_id
        cand_dur = float(cand.get("duration") or 240.0)

        # 1. Artist & kindred affinity
        if same_artist:
            score += 42.0 if preset != "purchased" else 28.0
        elif kindred:
            score += 34.0

        if same_album:
            score += 14.0 if preset == "kindred" else 6.0

        # 2. Duration / sonic form similarity
        dur_diff = abs(cand_dur - seed_dur)
        score += max(0.0, 18.0 - (dur_diff / 40.0))

        # 3. Preset-specific shaping
        if preset == "journey":
            # Favour extended / atmospheric / psychedelic suites
            if cand_dur >= 360:
                score += 30.0
            if any(k in fold(cand.get("title", "")) for k in ("phase", "part", "voyage", "sky", "drugged", "communion", "sleep", "live", "improvisation")):
                score += 22.0
        elif preset == "kindred":
            if not (same_artist or kindred):
                score -= 25.0
        elif preset == "purchased":
            if cand.get("purchased"):
                score += 35.0
            if cand.get("isLocal"):
                score += 10.0

        # 4. Lexical / thematic resonance
        cand_words = {w for w in fold(f"{cand.get('title', '')} {cand.get('album', '')}").split() if len(w) >= 3}
        overlap = len(seed_words & cand_words)
        score += min(18.0, overlap * 6.0)

        # 5. Collection quality & freshness
        if cand.get("purchased"):
            score += 12.0
        if cand.get("isLocal"):
            score += 8.0
        if cand.get("id") in recent_ids:
            score -= 16.0

        # Deterministic tie-breaker with slight variety per seed
        tie = ((hash(f"{seed.get('id')}:{cand.get('id')}:{preset}") & 0xFFFF) / 65535.0) * 7.5
        scored.append((score + tie, cand))

    scored.sort(key=lambda pair: pair[0], reverse=True)

    # Sequence tracks with album de-clumping (max 2 consecutive from same album)
    selected = [seed]
    pool = [pair[1] for pair in scored]
    while pool and len(selected) < limit:
        picked_idx = 0
        if len(selected) >= 2 and selected[-1].get("albumId") == selected[-2].get("albumId"):
            last_alb = selected[-1].get("albumId")
            alt = next(( idx_p for idx_p, item in enumerate(pool) if item.get("albumId") != last_alb ), None)
            if alt is not None:
                picked_idx = alt
        selected.append(pool.pop(picked_idx))

    preset_titles = {
        "radio": f"Sonic Radio · After {seed.get('title')}",
        "kindred": f"Kindred Spirits · {seed_artist}",
        "journey": f"Psychedelic Journey · {seed.get('title')}",
        "purchased": f"Purchased Mix · {seed_artist}",
    }
    preset_descs = {
        "radio": f"Intelligent flow seeded from '{seed.get('title')}' by {seed_artist}, blending kindred artists, sonic duration, and deep cuts.",
        "kindred": f"Focused constellation around {seed_artist} and related musical projects in your library.",
        "journey": f"Extended psychedelic and atmospheric suites resonant with '{seed.get('title')}'.",
        "purchased": f"Curated sequence across your Bandcamp purchases anchored by '{seed.get('title')}'.",
    }

    return {
        "seed": seed,
        "preset": preset,
        "title": preset_titles.get(preset) or f"Intelligent Mix · {seed.get('title')}",
        "description": preset_descs.get(preset) or f"Seeded from {seed.get('title')} by {seed_artist}",
        "trackCount": len(selected),
        "tracks": selected,
    }


def load_playlists() -> list[dict]:
    store = read_json(PLAYLISTS_FILE, {"playlists": []}) or {}
    pls = store.get("playlists")
    return list(pls) if isinstance(pls, list) else []


def save_playlists(playlists: list[dict]) -> None:
    write_json(PLAYLISTS_FILE, {"updatedAt": int(time.time()), "playlists": playlists[:500]})


# --------------------------------------------------------------------------- #
# mpv IPC & Playback
# --------------------------------------------------------------------------- #

LEGACY_IPC_SOCKET = os.path.join(os.path.dirname(RUNTIME_DIR), "bandarchy.sock")


def _active_ipc_socket() -> str | None:
    candidates = [IPC_SOCKET]
    if "BANDARCHY_MPV_SOCKET" not in os.environ and LEGACY_IPC_SOCKET != IPC_SOCKET:
        candidates.append(LEGACY_IPC_SOCKET)
    uid = os.getuid()
    for cand in candidates:
        try:
            st = os.lstat(cand)
            if stat.S_ISSOCK(st.st_mode) and st.st_uid == uid:
                return cand
        except OSError:
            continue
    return None


def mpv_request(command: list, timeout: float = 1.5):
    sock_path = _active_ipc_socket()
    if not sock_path:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(sock_path)
            sock.sendall((json.dumps({"command": command, "request_id": 77}) + "\n").encode("utf-8"))
            buffer = b""
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                chunk = sock.recv(min(65536, MAX_IPC_BYTES + 1 - len(buffer)))
                if not chunk:
                    break
                buffer += chunk
                if len(buffer) > MAX_IPC_BYTES:
                    return None
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    if not line.strip():
                        continue
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(msg, dict) and "error" in msg:
                        return msg
    except (OSError, socket.timeout):
        return None
    return None


def mpv_get(prop: str):
    reply = mpv_request(["get_property", prop])
    if reply and reply.get("error") == "success":
        return reply.get("data")
    return None


def mpv_running() -> bool:
    return mpv_get("idle-active") is not None or mpv_get("pid") is not None


def save_playback_resume_state(position_override: float | None = None, mark_stopped: bool | None = None) -> None:
    """Persist current mpv time-pos, playlist-pos, duration, and active track to QUEUE_FILE and HISTORY_FILE."""
    if not mpv_running():
        return
    try:
        pos = mpv_get("playlist-pos")
        raw_t = mpv_get("time-pos")
        dur = bounded_float(mpv_get("duration") or 0.0, 0.0)
        vol = bounded_int(mpv_get("volume") if mpv_get("volume") is not None else 100, 100, 0, 100)
        muted_val = bool(mpv_get("mute"))
        path = mpv_get("path") or ""
        queue = read_json(QUEUE_FILE, {}) or {}
        hist = read_json(HISTORY_FILE, {}) or {}
        last = hist.get("lastPlayedTrack") if isinstance(hist, dict) else None
        if position_override is not None:
            time_pos = bounded_float(position_override, 0.0)
        elif raw_t is not None:
            time_pos = bounded_float(raw_t, 0.0)
        else:
            time_pos = bounded_float(
                (queue.get("position") if isinstance(queue, dict) else None)
                or (last.get("position") if isinstance(last, dict) else None)
                or 0.0,
                0.0,
            )
        tracks = list(queue.get("tracks") or [])
        entry = {}
        matched_idx = bounded_int(pos, 0)
        if path:
            for idx_t, t in enumerate(tracks):
                if t.get("target") == path or (t.get("localPath") and t["localPath"] == path):
                    entry = t
                    if not isinstance(pos, int):
                        matched_idx = idx_t
                    break
        if not entry and isinstance(pos, int) and 0 <= pos < len(tracks):
            entry = tracks[pos]
            matched_idx = pos
        if isinstance(queue, dict) and tracks:
            queue["playlistPos"] = matched_idx
            queue["position"] = round(time_pos, 2)
            queue["stoppedMidTrack"] = bool(mpv_get("pause")) if mark_stopped is None else bool(mark_stopped)
            if dur > 0:
                queue["duration"] = dur
                if 0 <= matched_idx < len(tracks) and isinstance(tracks[matched_idx], dict):
                    tracks[matched_idx]["duration"] = dur
            queue["updatedAt"] = int(time.time())
            write_json(QUEUE_FILE, queue)
        if isinstance(hist, dict):
            hist["volume"] = vol
            hist["muted"] = muted_val
            write_json(HISTORY_FILE, hist)
        if entry and entry.get("title"):
            eff_entry = dict(entry)
            if dur > 0:
                eff_entry["duration"] = dur
            record_history(eff_entry, position=time_pos, playlist_pos=matched_idx)
        elif isinstance(last, dict) and last.get("title"):
            eff_entry = dict(last)
            if dur > 0:
                eff_entry["duration"] = dur
            record_history(eff_entry, position=time_pos, playlist_pos=matched_idx)
    except Exception:
        pass


def mpv_stop(save_state: bool = True) -> None:
    if save_state:
        save_playback_resume_state(mark_stopped=True)
    sock_path = _active_ipc_socket()
    pid = mpv_get("pid")
    mpv_request(["quit"])
    for _ in range(10):
        if not _active_ipc_socket() and not mpv_running():
            break
        time.sleep(0.05)
    if isinstance(pid, int) and pid > 1:
        try:
            os.kill(pid, 0)
            import signal
            os.kill(pid, signal.SIGTERM)
            for _ in range(10):
                try:
                    os.kill(pid, 0)
                    time.sleep(0.05)
                except OSError:
                    break
        except OSError:
            pass
    for cand in {IPC_SOCKET, sock_path} - {None}:
        try:
            st = os.lstat(cand)
            if stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid():
                os.unlink(cand)
        except OSError:
            pass


def mpv_launch(
    playlist_path: str,
    shuffle: bool = False,
    start_index: int = 0,
    loop: bool = False,
    start_position: float = 0.0,
) -> None:
    mpv_stop(save_state=False)
    ensure_private_dir(os.path.dirname(IPC_SOCKET))
    mpv_bin = resolve_bin("mpv", required=True)
    hist = read_json(HISTORY_FILE, {}) or {}
    saved_vol = bounded_int(hist.get("volume", 100) if isinstance(hist, dict) else 100, 100, 0, 100)
    saved_muted = bool(hist.get("muted", False)) if isinstance(hist, dict) else False
    args = [
        mpv_bin,
        "--no-config",
        "--no-ytdl",
        "--no-load-scripts",
        "--no-video",
        "--ao=pipewire,pulse,alsa,null",
        "--audio-display=no",
        "--audio-client-name=Bandarchy",
        "--gapless-audio=yes",
        "--no-terminal",
        "--idle=no",
        "--force-window=no",
        f"--input-ipc-server={IPC_SOCKET}",
        f"--playlist={os.path.abspath(playlist_path)}",
        f"--volume={saved_vol}",
        f"--mute={'yes' if saved_muted else 'no'}",
        "--cache=yes",
        "--demuxer-max-bytes=64MiB",
        "--replaygain=track",
    ]
    if shuffle:
        args.append("--shuffle")
    if start_index > 0:
        args.append(f"--playlist-start={start_index}")
    if loop:
        args.append("--loop-playlist=inf")
    if start_position > 0.25:
        args.append(f"--start=+{start_position:.2f}")
    args.append("--")
    subprocess.Popen(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    for _ in range(40):
        if os.path.exists(IPC_SOCKET):
            try:
                os.chmod(IPC_SOCKET, 0o600)
            except OSError:
                pass
            if mpv_running():
                break
        time.sleep(0.05)
    if start_position > 0.25 and mpv_running():
        for _ in range(16):
            cur_t = mpv_get("time-pos")
            if cur_t is not None:
                if float(cur_t) < start_position - 1.0:
                    mpv_request(["seek", float(start_position), "absolute"])
                mpv_request(["set_property", "start", "none"])
                break
            time.sleep(0.04)
        else:
            mpv_request(["set_property", "start", "none"])
            mpv_request(["seek", float(start_position), "absolute"])



def sanitise_m3u_target(target: str) -> str:
    """Validate and sanitise a playlist entry before writing to playlist.m3u (CRIT-6)."""
    cleaned = re.sub(r"[\r\n\x00]+", "", str(target or "")).strip()
    if not cleaned:
        raise BandarchyError("refusing empty playlist target")
    if cleaned.startswith("#") or cleaned.startswith("-"):
        raise BandarchyError(f"refusing unsafe playlist directive or flag target: {cleaned[:40]}")
    if "://" in cleaned or cleaned.lower().startswith(("http:", "https:")):
        validate_remote_url(cleaned)
        return cleaned
    real_path = os.path.realpath(cleaned)
    if not os.path.isabs(cleaned) or os.path.islink(cleaned) or not os.path.isfile(real_path):
        raise BandarchyError(f"refusing non-regular local audio path: {cleaned}")
    if not real_path.lower().endswith(AUDIO_EXTENSIONS):
        raise BandarchyError(f"refusing unsupported local audio extension: {cleaned}")
    return real_path


def _resolve_direct_stream_targets(playable: list[dict], api_base: str = "https://bandcamp.com") -> list[dict]:
    """Resolve Bandcamp stream_redirect or album/track page URLs to direct bcbits.com MP3 URLs
    so mpv can stream without hitting Bandcamp SNI resets."""
    to_resolve = [
        entry for entry in playable
        if entry.get("playSource") == "stream"
        and str(entry.get("target") or "").startswith("https://")
        and "bcbits.com" not in str(entry.get("target") or "")
    ]
    if not to_resolve:
        return playable

    page_details_cache: dict[str, dict | None] = {}
    for entry in to_resolve:
        tgt = str(entry.get("target") or "")
        if "stream_redirect" not in tgt and ("/album/" in tgt or "/track/" in tgt):
            if tgt not in page_details_cache:
                page_details_cache[tgt] = fetch_album_details(tgt, api_base=api_base)
            det = page_details_cache.get(tgt)
            if det and det.get("tracks"):
                det_tracks = det["tracks"]
                matched = next(
                    (dt for dt in det_tracks if fold(dt.get("title")) == fold(entry.get("title")) and dt.get("streamUrl")),
                    None,
                )
                if not matched:
                    idx_1 = max(0, int(entry.get("index") or 1) - 1)
                    if idx_1 < len(det_tracks) and det_tracks[idx_1].get("streamUrl"):
                        matched = det_tracks[idx_1]
                    elif det_tracks[0].get("streamUrl"):
                        matched = det_tracks[0]
                if matched and matched.get("streamUrl"):
                    entry["streamUrl"] = matched["streamUrl"]
                    entry["target"] = matched["streamUrl"]

    def _resolve_one(entry: dict) -> None:
        tgt = str(entry.get("target") or "")
        if "stream_redirect" in tgt and "bandcamp.com" in tgt:
            entry["target"] = resolve_stream_redirect(tgt)

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(_resolve_one, to_resolve))
    return playable


def resolve_playable_tracks(album: dict, mode: str = "auto", api_base: str = "https://bandcamp.com") -> list[dict]:
    tracks = list(album.get("tracks") or [])
    need_remote = (mode == "stream") or not album.get("isLocal") or all(not t.get("localPath") for t in tracks)
    if need_remote and album.get("url"):
        if len(tracks) <= 1 or any(not t.get("streamUrl") for t in tracks):
            det = fetch_album_details(album["url"], api_base=api_base)
            if det and det.get("tracks"):
                tracks = det["tracks"]

    playable: list[dict] = []
    for idx, t in enumerate(tracks, start=1):
        target = ""
        play_source = "local"
        if mode == "stream":
            target = t.get("streamUrl") or t.get("itemUrl") or album.get("url") or t.get("localPath") or ""
            play_source = "stream" if not (target and os.path.exists(str(target))) else "local"
        else:
            if t.get("localPath") and os.path.exists(str(t["localPath"])):
                target = t["localPath"]
                play_source = "local"
            else:
                target = t.get("streamUrl") or t.get("itemUrl") or album.get("url") or ""
                play_source = "stream"
        if not target:
            continue
        entry = dict(t)
        entry["target"] = target
        entry["playSource"] = play_source
        entry["albumId"] = album.get("id") or t.get("albumId") or ""
        entry["album"] = album.get("title") or t.get("album") or ""
        entry["artist"] = t.get("artist") or album.get("artist") or ""
        entry["artPath"] = album.get("artPath") or t.get("artPath") or ""
        entry["purchased"] = bool(album.get("purchased", t.get("purchased", False)))
        entry["isLocal"] = bool(album.get("isLocal", t.get("isLocal", play_source == "local")))
        entry["index"] = t.get("index") or idx
        playable.append(entry)
    return _resolve_direct_stream_targets(playable, api_base=api_base)


def resolve_track_list(raw_tracks: list[dict], idx: dict, mode: str = "auto", api_base: str = "https://bandcamp.com") -> list[dict]:
    albums_by_id = {a.get("id"): a for a in (idx.get("albums") or []) if a.get("id")}
    playable: list[dict] = []
    for i, t in enumerate(raw_tracks, start=1):
        alb = albums_by_id.get(t.get("albumId") or "") or {}
        target = ""
        play_source = "local"
        lpath = t.get("localPath") or ""
        if mode != "stream" and lpath and os.path.exists(str(lpath)):
            target = lpath
            play_source = "local"
        else:
            target = t.get("streamUrl") or t.get("itemUrl") or alb.get("url") or lpath or ""
            play_source = "local" if (target and os.path.exists(str(target))) else "stream"
        if not target:
            continue
        entry = dict(t)
        entry["target"] = target
        entry["playSource"] = play_source
        entry["albumId"] = t.get("albumId") or alb.get("id") or ""
        entry["album"] = t.get("album") or alb.get("title") or ""
        entry["artist"] = t.get("artist") or alb.get("artist") or ""
        entry["artPath"] = t.get("artPath") or alb.get("artPath") or ""
        entry["index"] = i
        playable.append(entry)
    return _resolve_direct_stream_targets(playable, api_base=api_base)


def start_queue(
    tracks: list[dict],
    source: dict,
    shuffle: bool = False,
    start_index: int = 0,
    loop: bool = False,
    start_position: float = 0.0,
    emit_output: bool = True,
) -> dict:
    if not tracks:
        die("no playable tracks found for that selection")
    lines = ["#EXTM3U"]
    valid_tracks: list[dict] = []
    for t in tracks:
        safe_target = sanitise_m3u_target(str(t.get("target") or ""))
        secs = int(t.get("duration") or 0)
        label = re.sub(r"[\r\n\x00]+", " ", f"{t.get('artist', '')} - {t.get('title', '')}").strip(" -")
        lines.append(f"#EXTINF:{secs},{label}")
        lines.append(safe_target)
        tc = dict(t)
        tc["target"] = safe_target
        valid_tracks.append(tc)
    atomic_write(PLAYLIST_M3U_FILE, ("\n".join(lines) + "\n").encode("utf-8"), 0o600)
    actual_idx = min(max(0, start_index), len(valid_tracks) - 1)
    first = valid_tracks[actual_idx]
    eff_start_pos = max(0.0, float(start_position or 0.0))
    dur_first = float(first.get("duration") or 0.0)
    if dur_first > 5.0 and eff_start_pos >= dur_first - 0.5:
        eff_start_pos = 0.0
    write_json(
        QUEUE_FILE,
        {
            "startedAt": int(time.time()),
            "source": source,
            "shuffle": shuffle,
            "playlistPos": actual_idx,
            "position": round(eff_start_pos, 2),
            "duration": dur_first,
            "stoppedMidTrack": False,
            "tracks": valid_tracks,
        },
    )
    record_history(first, position=eff_start_pos, playlist_pos=actual_idx)
    mpv_launch(PLAYLIST_M3U_FILE, shuffle=shuffle, start_index=actual_idx, loop=loop, start_position=eff_start_pos)
    payload = {
        "playing": True,
        "trackIndex": actual_idx,
        "trackCount": len(valid_tracks),
        "position": round(eff_start_pos, 2),
        "source": source,
        "shuffle": shuffle,
        "track": first,
        "artPath": first.get("artPath") or "",
    }
    if emit_output:
        emit(payload)
    return payload


def resume_last_playback(
    start_index_override: int | None = None,
    start_pos_override: float | None = None,
) -> dict | None:
    """Resume the last played queue/track from the saved position when mpv is not running.
    If the album/queue finished playing naturally (EOF), restart from Track 1 (index 0, 0.0s)."""
    global concurrent, ipaddress, ssl, urllib
    import concurrent.futures as _cf  # noqa: F401
    import concurrent
    import ipaddress
    import ssl
    import urllib.error  # noqa: F401
    import urllib.parse  # noqa: F401
    import urllib.request as _ur  # noqa: F401
    import urllib

    queue = read_json(QUEUE_FILE, {}) or {}
    hist = read_json(HISTORY_FILE, {}) or {}
    last = hist.get("lastPlayedTrack") if isinstance(hist, dict) else None
    last = last if isinstance(last, dict) else {}
    loop = bool(hist.get("loopPlaylist", False)) if isinstance(hist, dict) else False
    shuffle = bool(queue.get("shuffle", False)) if isinstance(queue, dict) else False

    saved_idx = bounded_int(queue.get("playlistPos", last.get("playlistPos", 0)), 0)
    q_tracks = list(queue.get("tracks") or []) if isinstance(queue, dict) else []
    if q_tracks and last.get("id"):
        if not (0 <= saved_idx < len(q_tracks) and q_tracks[saved_idx].get("id") == last.get("id")):
            for idx_t, t in enumerate(q_tracks):
                if t.get("id") == last.get("id"):
                    saved_idx = idx_t
                    break

    if start_index_override is not None:
        target_idx = max(0, int(start_index_override))
        target_pos = max(0.0, float(start_pos_override or 0.0))
    else:
        target_idx = saved_idx
        if start_pos_override is not None:
            target_pos = max(0.0, float(start_pos_override))
        else:
            q_pos_val = bounded_float(queue.get("position", 0.0), 0.0)
            l_pos_val = bounded_float(last.get("position", 0.0), 0.0)
            target_pos = l_pos_val if l_pos_val > 0 else q_pos_val
            # If the album/queue finished playing naturally (mpv exited at EOF without an explicit mid-track stop),
            # or if saved state is at the end of the last track, restart the album/queue from Track 1 (index 0, 0.0s).
            has_stopped_flag = isinstance(queue, dict) and ("stoppedMidTrack" in queue)
            explicit_mid_stop = bool(queue.get("stoppedMidTrack")) if has_stopped_flag else (target_pos > 0.05)
            last_dur = max(
                bounded_float(queue.get("duration", 0.0) if isinstance(queue, dict) else 0.0, 0.0),
                bounded_float(last.get("duration", 0.0), 0.0),
                bounded_float((q_tracks[saved_idx].get("duration") if (q_tracks and 0 <= saved_idx < len(q_tracks)) else 0.0), 0.0),
            )
            at_last_track_eof = (
                (not q_tracks or saved_idx >= len(q_tracks) - 1)
                and last_dur > 0.5
                and target_pos >= last_dur - 0.15
            )
            if (not explicit_mid_stop) or at_last_track_eof:
                target_idx = 0
                target_pos = 0.0

    if q_tracks:
        usable_q_tracks: list[dict] = []
        for t in q_tracks:
            cand = str(t.get("target") or t.get("localPath") or t.get("streamUrl") or "")
            if not cand:
                continue
            try:
                safe_t = sanitise_m3u_target(cand)
                tc = dict(t)
                tc["target"] = safe_t
                usable_q_tracks.append(tc)
            except Exception:
                continue
        if usable_q_tracks:
            clamped_idx = min(max(0, target_idx), len(usable_q_tracks) - 1)
            return start_queue(
                usable_q_tracks,
                queue.get("source") or {"type": "resume"},
                shuffle=shuffle,
                start_index=clamped_idx,
                loop=loop,
                start_position=target_pos,
                emit_output=False,
            )

    settings = load_settings()
    api_base = settings.get("apiBase") or "https://bandcamp.com"

    if last.get("title"):
        cand_direct = str(last.get("localPath") or last.get("target") or "")
        if cand_direct and os.path.isfile(cand_direct):
            try:
                safe_t = sanitise_m3u_target(cand_direct)
                tc = dict(last)
                tc["target"] = safe_t
                return start_queue(
                    [tc],
                    {"type": "track", "trackId": tc.get("id") or ""},
                    shuffle=False,
                    start_index=0,
                    loop=loop,
                    start_position=target_pos,
                    emit_output=False,
                )
            except Exception:
                pass

    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    target_album = None
    matched_track_idx = 0
    if last.get("albumId"):
        target_album = next((a for a in albums if a.get("id") == last.get("albumId")), None)
    if not target_album and last.get("id"):
        for a in albums:
            for ti, t in enumerate(a.get("tracks") or []):
                if t.get("id") == last.get("id"):
                    target_album = a
                    matched_track_idx = ti
                    break
            if target_album:
                break
    if not target_album and albums:
        target_album = albums[0]
        target_pos = 0.0

    if target_album:
        resolved = resolve_playable_tracks(target_album, mode="auto", api_base=api_base)
        if resolved:
            if last.get("id"):
                for ti, t in enumerate(resolved):
                    if t.get("id") == last.get("id"):
                        matched_track_idx = ti
                        break
            if start_index_override is not None:
                matched_track_idx = min(max(0, int(start_index_override)), len(resolved) - 1)
            return start_queue(
                resolved,
                {"type": "album", "albumId": target_album.get("id"), "title": target_album.get("title"), "mode": "auto"},
                shuffle=False,
                start_index=matched_track_idx,
                loop=loop,
                start_position=target_pos,
                emit_output=False,
            )
    return None



# --------------------------------------------------------------------------- #
# Downloading Purchased Albums / Tracks for Local Play
# --------------------------------------------------------------------------- #

def publish_download_progress(state: dict) -> None:
    state["updatedAt"] = int(time.time())
    try:
        write_json(DOWNLOAD_PROGRESS_FILE, state, mode=0o600)
    except Exception:
        pass


def _mark_album_downloaded_in_index(album_id: str, dest_dir: str) -> None:
    """Immediately mark a downloaded album as local in INDEX_FILE and attach local file paths."""
    idx = read_json(INDEX_FILE, None)
    if not isinstance(idx, dict) or not isinstance(idx.get("albums"), list):
        return
    audio_files = sorted(
        f for f in os.listdir(dest_dir)
        if not f.startswith(".") and not f.startswith("._") and f.lower().endswith(AUDIO_EXTENSIONS)
    ) if os.path.isdir(dest_dir) else []
    if not audio_files:
        return
    for alb in idx["albums"]:
        if alb.get("id") == album_id:
            alb["isLocal"] = True
            alb["localPath"] = dest_dir
            cov = os.path.join(dest_dir, "cover.jpg")
            if os.path.isfile(cov):
                alb["artPath"] = cov
            tracks = list(alb.get("tracks") or [])
            if len(tracks) == len(audio_files):
                for t, fname in zip(tracks, audio_files):
                    t["localPath"] = os.path.join(dest_dir, fname)
            else:
                new_tracks = []
                for i, fname in enumerate(audio_files, start=1):
                    fpath = os.path.join(dest_dir, fname)
                    t_num, t_title, t_artist = parse_track_filename(
                        fname,
                        alb.get("artist") or "Unknown Artist",
                        alb.get("title") or "Untitled",
                        i,
                    )
                    new_tracks.append({
                        "id": f"local-track-{hashlib.sha1(fpath.encode('utf-8')).hexdigest()[:16]}",
                        "title": t_title,
                        "artist": t_artist,
                        "album": alb.get("title") or "",
                        "index": t_num,
                        "duration": 240.0,
                        "streamUrl": "",
                        "localPath": fpath,
                        "format": os.path.splitext(fname)[1].lstrip(".").upper(),
                    })
                alb["tracks"] = new_tracks
                alb["numTracks"] = len(new_tracks)
            break
    idx["localCount"] = sum(1 for a in idx["albums"] if a.get("isLocal"))
    write_json(INDEX_FILE, idx)


def download_album_to_local(album: dict, preferred_format: str, settings: dict) -> dict:
    global _download_lock_fd
    _download_lock_fd = take_lock(DOWNLOAD_LOCK_FILE)
    if _download_lock_fd is None:
        die("another download is already in progress", code=5)

    artist = bounded_text(album.get("artist") or "Unknown Artist", 120)
    title = bounded_text(album.get("title") or "Untitled Album", 120)
    safe_folder = re.sub(r"[/\\:\*\?\"<>\|]+", "-", f"{artist} - {title}").strip(" .")
    dl_root = os.path.expanduser(settings.get("downloadDir") or DEFAULT_DOWNLOAD_DIR)
    dest_dir = os.path.join(dl_root, safe_folder)
    os.makedirs(dest_dir, mode=0o700, exist_ok=True)

    est_tracks = max(1, int(album.get("numTracks") or len(album.get("tracks") or []) or 1))
    state = {
        "running": True,
        "albumId": album.get("id") or "",
        "title": title,
        "artist": artist,
        "format": preferred_format,
        "trackIndex": 0,
        "trackTotal": est_tracks,
        "trackTitle": "",
        "stage": f"starting (0/{est_tracks})",
        "percent": 2,
        "destDir": dest_dir,
        "startedAt": int(time.time()),
    }
    publish_download_progress(state)

    api_base = settings.get("apiBase") or "https://bandcamp.com"

    for zinfo in find_bandcamp_zips_in_downloads():
        if fold(zinfo["album"]) == fold(title):
            state.update({
                "trackIndex": est_tracks,
                "trackTotal": est_tracks,
                "stage": f"extracting local ZIP ({est_tracks}/{est_tracks})",
                "percent": 60,
            })
            publish_download_progress(state)
            files = safe_extract_zip(zinfo["zipPath"], dest_dir)
            state.update({
                "running": False,
                "trackIndex": len(files) or est_tracks,
                "trackTotal": len(files) or est_tracks,
                "stage": "done",
                "percent": 100,
                "fileCount": len(files),
            })
            publish_download_progress(state)
            _mark_album_downloaded_in_index(album.get("id") or "", dest_dir)
            return {"albumId": album.get("id"), "destDir": dest_dir, "method": "local-zip", "fileCount": len(files)}

    redownload_url = album.get("redownloadUrl") or ""
    if redownload_url:
        try:
            state.update({
                "trackIndex": 1,
                "trackTotal": est_tracks,
                "stage": f"fetching download link (1/{est_tracks})",
                "percent": 10,
            })
            publish_download_progress(state)
            raw = http_request(redownload_url, timeout=12.0)
            if raw[:4] == b"PK\x03\x04":
                tmp_zip = _make_private_temp_file("ba_dl_", ".zip")
                try:
                    safe_write_bytes(tmp_zip, raw, mode=0o600)
                    state.update({
                        "trackIndex": est_tracks,
                        "trackTotal": est_tracks,
                        "stage": f"extracting {est_tracks}/{est_tracks}",
                        "percent": 90,
                    })
                    publish_download_progress(state)
                    files = safe_extract_zip(tmp_zip, dest_dir)
                finally:
                    if os.path.lexists(tmp_zip):
                        try:
                            os.unlink(tmp_zip)
                        except OSError:
                            pass
                final_count = len([f for f in files if f.lower().endswith(AUDIO_EXTENSIONS)]) or len(files) or est_tracks
                state.update({
                    "running": False,
                    "trackIndex": final_count,
                    "trackTotal": final_count,
                    "stage": "done",
                    "percent": 100,
                    "fileCount": len(files),
                })
                publish_download_progress(state)
                _mark_album_downloaded_in_index(album.get("id") or "", dest_dir)
                return {"downloaded": True, "albumId": album.get("id"), "destDir": dest_dir, "method": "redownload", "fileCount": len(files)}
            page = raw.decode("utf-8", errors="replace")
            blob = extract_attr_json(page, "data-blob") or {}
            d_items = blob.get("digital_items") or blob.get("download_items") or []
            archive_url = ""
            if d_items and isinstance(d_items[0], dict):
                dl_map = d_items[0].get("downloads") or {}
                if preferred_format in dl_map and isinstance(dl_map[preferred_format], dict):
                    archive_url = dl_map[preferred_format].get("url") or ""
                if not archive_url:
                    for fmt_key in ("flac", "mp3-320", "mp3-v0", "wav", "vorbis", "aac-hi"):
                        if fmt_key in dl_map and isinstance(dl_map[fmt_key], dict):
                            archive_url = dl_map[fmt_key].get("url") or ""
                            if archive_url:
                                break
            if archive_url:
                state.update({
                    "trackIndex": 1,
                    "trackTotal": est_tracks,
                    "stage": f"downloading 1/{est_tracks}",
                    "percent": 18,
                })
                publish_download_progress(state)

                def _on_archive_chunk(done_b: int, total_b: int) -> None:
                    denom = total_b if total_b > 0 else max(done_b * 2, 15 * 1024 * 1024)
                    frac = min(1.0, done_b / float(denom))
                    pct = min(84, 18 + int(frac * 66))
                    sim_idx = max(1, min(est_tracks, int(round(frac * est_tracks))))
                    state.update({
                        "trackIndex": sim_idx,
                        "trackTotal": est_tracks,
                        "stage": f"downloading {sim_idx}/{est_tracks}",
                        "percent": pct,
                        "bytesDone": done_b,
                        "bytesTotal": total_b,
                    })
                    publish_download_progress(state)

                tmp_dl = _make_private_temp_file("ba_dl_", ".bin")
                try:
                    download_file(
                        archive_url,
                        tmp_dl,
                        timeout=90.0,
                        max_bytes=MAX_DOWNLOAD_BYTES,
                        on_chunk=_on_archive_chunk,
                    )
                    magic = safe_read_bytes(tmp_dl, max_bytes=4) or b""
                    if magic == b"PK\x03\x04":
                        state.update({
                            "trackIndex": est_tracks,
                            "trackTotal": est_tracks,
                            "stage": f"extracting {est_tracks}/{est_tracks}",
                            "percent": 90,
                        })
                        publish_download_progress(state)
                        files = safe_extract_zip(tmp_dl, dest_dir)
                    else:
                        out_file = os.path.join(dest_dir, f"{artist} - {title} - 01 {title}.mp3")
                        os.replace(tmp_dl, out_file)
                        tmp_dl = ""
                        files = [out_file]
                finally:
                    if tmp_dl and os.path.lexists(tmp_dl):
                        try:
                            os.unlink(tmp_dl)
                        except OSError:
                            pass

                final_count = len([f for f in files if f.lower().endswith(AUDIO_EXTENSIONS)]) or len(files) or est_tracks
                state.update({
                    "running": False,
                    "trackIndex": final_count,
                    "trackTotal": final_count,
                    "stage": "done",
                    "percent": 100,
                    "fileCount": len(files),
                })
                publish_download_progress(state)
                _mark_album_downloaded_in_index(album.get("id") or "", dest_dir)
                return {"downloaded": True, "albumId": album.get("id"), "destDir": dest_dir, "method": "redownload", "fileCount": len(files)}
        except Exception as exc:
            log_failure(f"redownload failed for {title}: {exc}")

    item_url = album.get("url") or ""
    tracks = list(album.get("tracks") or [])
    det = None
    if item_url and (len(tracks) <= 1 or any(not t.get("streamUrl") for t in tracks)):
        det = fetch_album_details(item_url, api_base=api_base)
        if det and det.get("tracks"):
            tracks = det["tracks"]

    streamable = [t for t in tracks if t.get("streamUrl")]
    if streamable:
        saved_files = []
        art_url = (det or {}).get("artUrl") or album.get("artUrl") or ""
        if art_url:
            try:
                download_file(art_url, os.path.join(dest_dir, "cover.jpg"), timeout=8.0, max_bytes=MAX_ART_BYTES)
            except Exception:
                pass
        total = len(streamable)
        for idx, t in enumerate(streamable, start=1):
            base_pct = 8 + int(((idx - 1) / max(1, total)) * 88)
            span_pct = max(1, int(88 / max(1, total)))
            t_num = bounded_int(t.get("index") or idx, idx)
            t_title = re.sub(r"[/\\:\*\?\"<>\|]+", "-", t.get("title") or f"Track {t_num}").strip()
            state.update({
                "trackIndex": idx,
                "trackTotal": total,
                "trackTitle": t_title,
                "stage": f"downloading {idx}/{total}",
                "percent": base_pct,
            })
            publish_download_progress(state)
            fname = f"{artist} - {title} - {t_num:02d} {t_title}.mp3"
            out_path = os.path.join(dest_dir, fname)

            direct_url = resolve_stream_redirect(t["streamUrl"])

            def _on_track_chunk(done_b: int, total_b: int, _b=base_pct, _s=span_pct, _i=idx, _t=total, _tt=t_title) -> None:
                denom = total_b if total_b > 0 else max(done_b * 2, 6 * 1024 * 1024)
                frac = min(1.0, done_b / float(denom))
                pct = min(98, _b + int(frac * _s))
                state.update({
                    "trackIndex": _i,
                    "trackTotal": _t,
                    "trackTitle": _tt,
                    "stage": f"downloading {_i}/{_t}",
                    "percent": pct,
                    "bytesDone": done_b,
                    "bytesTotal": total_b,
                })
                publish_download_progress(state)

            download_file(
                direct_url,
                out_path,
                timeout=45.0,
                max_bytes=MAX_DOWNLOAD_BYTES,
                on_chunk=_on_track_chunk,
            )
            saved_files.append(out_path)

        state.update({
            "running": False,
            "trackIndex": total,
            "trackTotal": total,
            "stage": "done",
            "percent": 100,
            "fileCount": len(saved_files),
        })
        publish_download_progress(state)
        _mark_album_downloaded_in_index(album.get("id") or "", dest_dir)
        return {"downloaded": True, "albumId": album.get("id"), "destDir": dest_dir, "method": "stream-rip", "fileCount": len(saved_files)}

    state.update({"running": False, "stage": "error", "error": "could not download album — check network or Bandcamp session"})
    publish_download_progress(state)
    die("could not download album — check your network connection or Bandcamp session in Settings")


# --------------------------------------------------------------------------- #
# CLI Command Handlers
# --------------------------------------------------------------------------- #

def get_playback_state() -> dict:
    """Query running mpv IPC socket and return complete playback state dict (or saved resume state when stopped)."""
    if not mpv_running():
        queue = read_json(QUEUE_FILE, {}) or {}
        tracks = list(queue.get("tracks") or []) if isinstance(queue, dict) else []
        hist = read_json(HISTORY_FILE, {}) or {}
        last = (hist.get("lastPlayedTrack") if isinstance(hist, dict) else None) or {}
        has_stopped_flag = isinstance(queue, dict) and ("stoppedMidTrack" in queue)
        stopped_mid = bool(queue.get("stoppedMidTrack")) if has_stopped_flag else True
        q_pos = bounded_int(queue.get("playlistPos", queue.get("currentIndex", last.get("playlistPos", 0))), 0)
        entry = {}
        if tracks:
            if not stopped_mid:
                q_pos = 0
                entry = tracks[0]
            else:
                if last.get("id") and "playlistPos" not in queue and "currentIndex" not in queue:
                    if 0 <= q_pos < len(tracks) and tracks[q_pos].get("id") == last.get("id"):
                        entry = tracks[q_pos]
                    else:
                        for idx_t, t in enumerate(tracks):
                            if t.get("id") == last.get("id"):
                                entry = t
                                q_pos = idx_t
                                break
                if not entry:
                    if 0 <= q_pos < len(tracks):
                        entry = tracks[q_pos]
                    else:
                        entry = tracks[0]
                        q_pos = 0
        elif isinstance(last, dict) and last.get("title"):
            entry = last
            q_pos = 0 if not stopped_mid else bounded_int(last.get("playlistPos", 0), 0)

        entry_matches_last = bool(
            isinstance(last, dict)
            and (
                (entry.get("id") and last.get("id") == entry.get("id"))
                or (not entry.get("id") and entry.get("title") and last.get("title") == entry.get("title"))
            )
        )
        title = bounded_text(entry.get("title") or (last.get("title") if entry_matches_last else "") or "")
        artist = bounded_text(entry.get("artist") or (last.get("artist") if entry_matches_last else "") or "")
        album = bounded_text(entry.get("album") or (last.get("album") if entry_matches_last else "") or "")
        album_id = entry.get("albumId") or (last.get("albumId") if entry_matches_last else "") or ""
        track_id = entry.get("id") or (last.get("id") if entry_matches_last else "") or ""
        art_path = entry.get("artPath") or (last.get("artPath") if entry_matches_last else "") or ""
        local_cand = str(entry.get("localPath") or entry.get("target") or (last.get("localPath") if entry_matches_last else "") or (last.get("target") if entry_matches_last else "") or "")
        art_probed_idle = bool(entry.get("_artProbed") or (entry_matches_last and isinstance(last, dict) and last.get("_artProbed")))
        if local_cand and os.path.isfile(local_cand) and (
            not title
            or not artist
            or not album
            or (not art_probed_idle and album.endswith(" — Singles"))
            or not art_path
            or (str(art_path).endswith(".svg") and not art_probed_idle)
        ):
            fmeta = read_audio_metadata(local_cand, extract_art=(not art_path or str(art_path).endswith(".svg")))
            if fmeta.get("title") and (not title or re.match(r"^.+?\s+-\s+.+?\s+-\s+\d{1,3}\s+", title)):
                title = bounded_text(fmeta["title"])
            if fmeta.get("artist") and (not artist or artist in ("Local Artist", "Unknown Artist") or album.endswith(" — Singles")):
                artist = bounded_text(fmeta["artist"])
            if fmeta.get("album") and (not album or album.endswith(" — Singles")):
                album = bounded_text(fmeta["album"])
            if fmeta.get("artPath") and os.path.isfile(fmeta["artPath"]) and (not art_path or str(art_path).endswith(".svg")):
                art_path = fmeta["artPath"]
        if (title or artist) and (not art_path or not os.path.exists(art_path)):
            art_path = ensure_cover_svg(album_id or "now", artist or "Bandarchy", album or title or "Music")

        l_pos = bounded_float(last.get("position", 0.0), 0.0) if (isinstance(last, dict) and entry_matches_last) else 0.0
        q_saved_pos = bounded_float(queue.get("savedPosition", queue.get("position", 0.0)), 0.0) if isinstance(queue, dict) else 0.0
        saved_pos = 0.0 if not stopped_mid else (q_saved_pos if q_saved_pos > 0 else l_pos)
        saved_dur = max(
            bounded_float(last.get("duration") if isinstance(last, dict) and last.get("id") == track_id else 0.0, 0.0),
            bounded_float(queue.get("duration") if (isinstance(queue, dict) and stopped_mid) else 0.0, 0.0),
            bounded_float(entry.get("duration") or 0.0, 0.0),
        )
        if saved_dur > 5.0 and saved_pos >= saved_dur - 0.5:
            saved_pos = 0.0

        return {
            "playing": False,
            "paused": False,
            "resumable": bool(title or tracks),
            "title": title,
            "artist": artist,
            "album": album,
            "albumId": album_id,
            "trackId": track_id,
            "playSource": entry.get("playSource") or last.get("playSource") or "local",
            "artPath": art_path,
            "position": saved_pos,
            "duration": saved_dur,
            "volume": bounded_int(hist.get("volume", 100) if isinstance(hist, dict) else 100, 100, 0, 100),
            "muted": bool(hist.get("muted", False)) if isinstance(hist, dict) else False,
            "playlistPos": q_pos,
            "playlistCount": len(tracks),
            "shuffle": bool(queue.get("shuffle")) if isinstance(queue, dict) else False,
            "loop": bool(hist.get("loopPlaylist", False)) if isinstance(hist, dict) else False,
            "queue": [
                {
                    "id": t.get("id") or "",
                    "title": t.get("title") or "",
                    "artist": t.get("artist") or "",
                    "album": t.get("album") or "",
                    "albumId": t.get("albumId") or "",
                    "duration": t.get("duration") or 0,
                    "playSource": t.get("playSource") or "local",
                }
                for t in tracks[:200]
            ],
        }

    pos = mpv_get("playlist-pos")
    path = mpv_get("path") or ""
    queue = read_json(QUEUE_FILE, {}) or {}
    tracks = queue.get("tracks") or []
    entry = {}
    matched_idx = bounded_int(pos, 0)
    if isinstance(pos, int) and 0 <= pos < len(tracks):
        cand_t = tracks[pos]
        if not path or cand_t.get("target") == path or (cand_t.get("localPath") and cand_t["localPath"] == path):
            entry = cand_t
            matched_idx = pos
    if not entry and path:
        for idx_t, t in enumerate(tracks):
            if t.get("target") == path or (t.get("localPath") and t["localPath"] == path):
                entry = t
                matched_idx = idx_t
                break
    if not entry and isinstance(pos, int) and 0 <= pos < len(tracks):
        entry = tracks[pos]
        matched_idx = pos

    meta = mpv_get("metadata") or {}
    meta = {str(k).lower(): v for k, v in meta.items()} if isinstance(meta, dict) else {}

    raw_entry_title = str(entry.get("title") or "")
    raw_entry_artist = str(entry.get("artist") or "")
    raw_entry_album = str(entry.get("album") or "")

    fmeta: dict = {}
    probed_now = False
    local_media_path = path if (path and os.path.isfile(path)) else str(entry.get("localPath") or "")
    if local_media_path and os.path.isfile(local_media_path):
        art_probed = bool(entry.get("_artProbed"))
        need_art = not entry.get("artPath") or (str(entry.get("artPath")).endswith(".svg") and not art_probed)
        need_tags = (
            not raw_entry_title
            or bool(re.match(r"^.+?\s+-\s+.+?\s+-\s+\d{1,3}\s+", raw_entry_title))
            or not raw_entry_artist
            or raw_entry_artist in ("Local Artist", "Unknown Artist")
            or not raw_entry_album
            or (raw_entry_album.endswith(" — Singles") and not art_probed)
        )
        if need_art or need_tags:
            fmeta = read_audio_metadata(local_media_path, extract_art=need_art)
            probed_now = True

    meta_title = str(fmeta.get("title") or meta.get("title") or "")
    meta_artist = str(fmeta.get("artist") or fmeta.get("albumArtist") or meta.get("artist") or meta.get("album_artist") or "")
    meta_album = str(fmeta.get("album") or meta.get("album") or "")

    if meta_title and (not raw_entry_title or re.match(r"^.+?\s+-\s+.+?\s+-\s+\d{1,3}\s+", raw_entry_title)):
        title = bounded_text(meta_title)
    else:
        title = bounded_text(raw_entry_title or meta_title or mpv_get("media-title") or "")

    if meta_artist and (not raw_entry_artist or raw_entry_artist in ("Local Artist", "Unknown Artist") or raw_entry_album.endswith(" — Singles")):
        artist = bounded_text(meta_artist)
    else:
        artist = bounded_text(raw_entry_artist or meta_artist or "")

    if meta_album and (not raw_entry_album or raw_entry_album.endswith(" — Singles")):
        album = bounded_text(meta_album)
    else:
        album = bounded_text(raw_entry_album or meta_album or "")

    art_path = entry.get("artPath") or ""
    if fmeta.get("artPath") and os.path.isfile(fmeta["artPath"]) and (not art_path or str(art_path).endswith(".svg")):
        art_path = fmeta["artPath"]
    if not art_path or not os.path.exists(art_path):
        art_path = ensure_cover_svg(entry.get("albumId") or "now", artist or "Bandarchy", album or title or "Music")

    time_pos = bounded_float(mpv_get("time-pos") or 0.0)
    dur_val = bounded_float(mpv_get("duration") or fmeta.get("duration") or entry.get("duration") or 0.0)

    if entry and entry.get("id"):
        eff_entry = dict(entry)
        eff_entry["title"] = title
        eff_entry["artist"] = artist
        eff_entry["album"] = album
        eff_entry["artPath"] = art_path
        if probed_now or entry.get("_artProbed"):
            eff_entry["_artProbed"] = True
        if dur_val > 0:
            eff_entry["duration"] = dur_val
        record_history(eff_entry, position=time_pos, playlist_pos=matched_idx)

    if isinstance(queue, dict) and tracks:
        prev_q_pos = queue.get("playlistPos")
        prev_q_time = float(queue.get("position") or 0.0)
        entry_meta_updated = False
        if 0 <= matched_idx < len(tracks) and isinstance(tracks[matched_idx], dict):
            q_tr = tracks[matched_idx]
            for k, v in (("title", title), ("artist", artist), ("album", album), ("artPath", art_path)):
                if v and q_tr.get(k) != v:
                    q_tr[k] = v
                    entry_meta_updated = True
            if probed_now and not q_tr.get("_artProbed"):
                q_tr["_artProbed"] = True
                entry_meta_updated = True
        if prev_q_pos != matched_idx or abs(time_pos - prev_q_time) >= 1.5 or entry_meta_updated:
            queue["playlistPos"] = matched_idx
            queue["currentIndex"] = matched_idx
            queue["position"] = round(time_pos, 2)
            queue["stoppedMidTrack"] = bool(mpv_get("pause"))
            if dur_val > 0:
                queue["duration"] = dur_val
                if 0 <= matched_idx < len(tracks) and isinstance(tracks[matched_idx], dict):
                    tracks[matched_idx]["duration"] = dur_val
            write_json(QUEUE_FILE, queue)

    hist_live = read_json(HISTORY_FILE, {}) or {}
    raw_mpv_vol = mpv_get("volume")
    live_vol = bounded_int(
        raw_mpv_vol if raw_mpv_vol is not None else (hist_live.get("volume", 100) if isinstance(hist_live, dict) else 100),
        100,
        0,
        100,
    )
    raw_mpv_mute = mpv_get("mute")
    live_muted = bool(raw_mpv_mute) if raw_mpv_mute is not None else (bool(hist_live.get("muted", False)) if isinstance(hist_live, dict) else False)

    return {
        "playing": True,
        "paused": bool(mpv_get("pause")),
        "resumable": True,
        "title": title,
        "artist": artist,
        "album": album,
        "albumId": entry.get("albumId") or "",
        "trackId": entry.get("id") or "",
        "playSource": entry.get("playSource") or ("local" if os.path.exists(path) else "stream"),
        "artPath": art_path,
        "position": time_pos,
        "duration": dur_val,
        "volume": live_vol,
        "muted": live_muted,
        "playlistPos": matched_idx,
        "playlistCount": bounded_int(mpv_get("playlist-count") or len(tracks), len(tracks)),
        "shuffle": bool(queue.get("shuffle")),
        "loop": mpv_get("loop-playlist") in ("inf", "force", True),
        "queue": [
            {
                "id": t.get("id") or "",
                "title": t.get("title") or "",
                "artist": t.get("artist") or "",
                "album": t.get("album") or "",
                "albumId": t.get("albumId") or "",
                "duration": t.get("duration") or 0,
                "playSource": t.get("playSource") or "local",
            }
            for t in tracks[:200]
        ],
    }


def _visualiser_settings_payload(settings: dict) -> dict:
    top_led = bool(settings.get("top_bar_led", settings.get("topBarLedEnabled", True)))
    l4_enabled = bool(settings.get("layer4Enabled", settings.get("backdropEnabled", True)))
    l4_mode = bounded_int(settings.get("layer4Mode", settings.get("backdropMode")), 0, 0, 15)
    return {
        "top_bar_led": top_led,
        "topBarLedEnabled": top_led,
        "stageMode": settings.get("stageMode") or "visualiser",
        "paletteIndex": bounded_int(settings.get("paletteIndex"), 0, 0, 29),
        "backdropEnabled": l4_enabled,
        "backdropMode": l4_mode,
        "layer1Enabled": bool(settings.get("layer1Enabled", True)),
        "layer1Mode": bounded_int(settings.get("layer1Mode"), 0, 0, 11),
        "layer1EqStyle": bounded_int(settings.get("layer1EqStyle"), 0, 0, 15),
        "layer1EqLayout": bounded_int(settings.get("layer1EqLayout"), 0, 0, 3),
        "layer1EqScale": bounded_float(settings.get("layer1EqScale"), 1.0, 0.15, 2.25),
        "layer1EqSpin": bounded_float(settings.get("layer1EqSpin"), 1.0, -2.5, 2.5),
        "layer1Speed": bounded_float(settings.get("layer1Speed"), 1.0, 0.1, 4.0),
        "layer1Density": bounded_float(settings.get("layer1Density"), 1.0, 0.1, 3.0),
        "layer1Trail": bounded_float(settings.get("layer1Trail"), 0.84, 0.1, 0.98),
        "layer1Dim": bounded_float(settings.get("layer1Dim"), 0.15, 0.0, 0.9),
        "layer2Enabled": bool(settings.get("layer2Enabled", True)),
        "layer2Mode": bounded_int(settings.get("layer2Mode"), 0, 0, 12),
        "layer2Facets": bounded_int(settings.get("layer2Facets"), 8, 1, 24),
        "layer2Complexity": bounded_float(settings.get("layer2Complexity"), 1.0, 0.2, 3.0),
        "layer2Speed": bounded_float(settings.get("layer2Speed"), 1.0, 0.1, 4.0),
        "layer2Reactivity": bounded_float(settings.get("layer2Reactivity"), 1.2, 0.1, 3.5),
        "layer2Zoom": bounded_float(settings.get("layer2Zoom"), 1.0, 0.3, 3.0),
        "layer2Chaos": bounded_float(settings.get("layer2Chaos"), 0.35, 0.0, 2.0),
        "layer3Enabled": bool(settings.get("layer3Enabled", True)),
        "layer3Mode": bounded_int(settings.get("layer3Mode"), 0, 0, 11),
        "layer3Dismantle": bounded_float(settings.get("layer3Dismantle"), 1.15, 0.0, 4.0),
        "layer3Rebuild": bounded_float(settings.get("layer3Rebuild"), 1.0, 0.05, 4.0),
        "layer3Evolution": bounded_float(settings.get("layer3Evolution"), 0.65, 0.0, 3.0),
        "layer3Scale": bounded_float(settings.get("layer3Scale"), 1.0, 0.5, 2.5),
        "layer3AsciiMode": settings.get("layer3AsciiMode") or settings.get("asciiMode") or "braille",
        "layer3TextStyle": bounded_int(settings.get("layer3TextStyle"), 0, 0, 15),
        "layer3ColourMode": bounded_int(settings.get("layer3ColourMode"), 0, 0, 5),
        "layer3CylinderDir": bounded_int(settings.get("layer3CylinderDir"), 0, 0, 5),
        "layer3ShowArtist": bool(settings.get("layer3ShowArtist", True)),
        "layer3ShowTrack": bool(settings.get("layer3ShowTrack", True)),
        "layer3ShowAlbum": bool(settings.get("layer3ShowAlbum", False)),
        "layer3ShowStatements": bool(settings.get("layer3ShowStatements", False)),
        "layer4Enabled": l4_enabled,
        "layer4Mode": l4_mode,
        "layer4DualEnabled": bool(settings.get("layer4DualEnabled", False)),
        "layer4SecondaryMode": bounded_int(settings.get("layer4SecondaryMode"), 1, 0, 15),
        "layer4DualMix": bounded_float(settings.get("layer4DualMix"), 0.45, 0.10, 0.90),
        "layer4WallPattern": bounded_int(settings.get("layer4WallPattern"), 0, 0, 4),
        "layer4Speed": bounded_float(settings.get("layer4Speed", settings.get("backdropSpeed")), 1.0, 0.15, 3.0),
        "layer4Intensity": bounded_float(settings.get("layer4Intensity", settings.get("backdropIntensity")), 0.72, 0.15, 2.0),
        "layer4Twist": bounded_float(settings.get("layer4Twist"), 1.0, 0.10, 3.0),
        "layer4Symmetry": bounded_int(settings.get("layer4Symmetry", settings.get("backdropSymmetry")), 8, 2, 16),
        "layer4Direction": bounded_int(settings.get("layer4Direction", settings.get("backdropDirection")), 1, -1, 1),
        "turntableRpm": bounded_float(settings.get("turntableRpm"), 33.3, 16.0, 78.0),
        "turntableStyle": bounded_int(settings.get("turntableStyle"), 0, 0, 4),
    }


def cmd_status(args) -> None:
    settings = load_settings()
    idx = ensure_status_summary()
    auth = read_json(AUTH_FILE, {}) or {}
    favs = read_json(FAVOURITES_FILE, {"items": []}) or {"items": []}
    pls = load_playlists()
    playback = get_playback_state()
    hist = read_json(HISTORY_FILE, {}) or {}
    sync_prog = dict(read_json(SYNC_PROGRESS_FILE, {}) or {})
    sync_prog["running"] = is_locked(SYNC_LOCK_FILE)
    dl_prog = dict(read_json(DOWNLOAD_PROGRESS_FILE, {}) or {})
    dl_prog["running"] = is_locked(DOWNLOAD_LOCK_FILE)
    logged_out = bool(settings.get("loggedOut", False))
    username = "" if logged_out else (settings.get("username") or idx.get("username") or "")
    has_identity = bool(auth.get("identity")) and not logged_out
    has_browser = bool(idx.get("hasBrowserSession") or has_identity) and not logged_out
    emit({
        "username": username,
        "loggedOut": logged_out,
        "hasIdentity": has_identity,
        "authenticated": bool((has_identity or has_browser or username) and not logged_out),
        "hasBrowserSession": has_browser,
        "downloadDir": settings.get("downloadDir") or DEFAULT_DOWNLOAD_DIR,
        "preferredFormat": settings.get("preferredFormat") or "flac",
        "useAlbumArt": bool(settings.get("useAlbumArt", True)),
        "asciiMode": settings.get("asciiMode") or "braille",
        **_visualiser_settings_payload(settings),
        "albumCount": idx.get("albumCount") or 0,
        "purchasedCount": idx.get("purchasedCount") or 0,
        "localCount": idx.get("localCount") or 0,
        "trackCount": idx.get("trackCount") or 0,
        "playlistCount": len(pls),
        "playlists": pls,
        "lastPlayedTrack": hist.get("lastPlayedTrack"),
        "recentTracks": (hist.get("recentTracks") or [])[:25],
        "indexedAt": idx.get("indexedAt") or 0,
        "favouritesCount": len(favs.get("items") or []),
        "favourites": favs.get("items") or [],
        "availableZips": idx.get("availableZips") or [],
        "playing": playback["playing"],
        "playback": playback,
        "sync": sync_prog,
        "downloading": dl_prog["running"],
        "downloadProgress": dl_prog,
        "download": dl_prog,
        "lastError": dl_prog.get("error") or idx.get("networkNote") or "",
    })


def cmd_collection(args) -> None:
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    scope = (args.scope or "all").lower()
    if scope == "purchased":
        albums = [a for a in albums if a.get("purchased")]
    elif scope == "local":
        albums = [a for a in albums if a.get("isLocal")]
    elif scope == "cloud":
        albums = [a for a in albums if a.get("purchased") and not a.get("isLocal")]

    if args.query:
        q = fold(args.query)
        if q:
            filtered = []
            for a in albums:
                hay = a.get("fold") or fold(f"{a.get('artist', '')} {a.get('title', '')}")
                track_match = any(q in fold(t.get("title") or "") for t in (a.get("tracks") or []))
                if q in hay or track_match:
                    filtered.append(a)
            albums = filtered

    emit({
        "scope": scope,
        "query": args.query or "",
        "count": len(albums),
        "albums": albums,
        "availableZips": idx.get("availableZips") or [],
    })


def cmd_search(args) -> None:
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    scope = (args.scope or "all").lower()
    if scope == "purchased":
        albums = [a for a in albums if a.get("purchased")]
    elif scope == "local":
        albums = [a for a in albums if a.get("isLocal")]
    elif scope == "cloud":
        albums = [a for a in albums if a.get("purchased") and not a.get("isLocal")]

    q = fold(args.query or "")
    matched_albums = []
    matched_tracks = []
    for a in albums:
        a_hay = a.get("fold") or fold(f"{a.get('artist', '')} {a.get('title', '')}")
        album_hit = (not q) or (q in a_hay)
        t_hits = []
        for t in a.get("tracks") or []:
            t_hay = fold(f"{t.get('title', '')} {t.get('artist', '')} {a.get('title', '')}")
            if (not q) or (q in t_hay):
                t_copy = dict(t)
                t_copy["albumId"] = a.get("id")
                t_copy["album"] = a.get("title")
                t_copy["artist"] = t.get("artist") or a.get("artist")
                t_copy["artPath"] = a.get("artPath") or ""
                t_copy["isLocal"] = a.get("isLocal", False)
                t_copy["purchased"] = a.get("purchased", False)
                t_hits.append(t_copy)
        if album_hit or t_hits:
            matched_albums.append(a)
        matched_tracks.extend(t_hits)

    emit({
        "query": args.query or "",
        "scope": scope,
        "albums": matched_albums[: args.limit],
        "tracks": matched_tracks[: args.limit * 2],
    })


def cmd_sync(args) -> None:
    global _sync_lock_fd
    _sync_lock_fd = take_lock(SYNC_LOCK_FILE)
    if _sync_lock_fd is None:
        die("a collection sync is already running", code=5)

    settings = load_settings()
    if args.username:
        settings["username"] = bounded_text(args.username, 64)
        settings["loggedOut"] = False
        write_json(SETTINGS_FILE, settings)
    if args.api_base:
        settings["apiBase"] = bounded_text(args.api_base, 256)

    def report(stage: str, albums_n: int, tracks_n: int) -> None:
        write_json(
            SYNC_PROGRESS_FILE,
            {
                "running": stage != "done",
                "stage": stage,
                "albums": albums_n,
                "tracks": tracks_n,
                "updatedAt": int(time.time()),
            },
        )

    result = build_unified_collection(settings, on_progress=report, fetch_remote=not args.local_only, detect_browser=False)
    emit({
        "synced": True,
        "username": result.get("username"),
        "loggedOut": bool(result.get("loggedOut", False)),
        "hasIdentity": bool(result.get("hasIdentity", False)),
        "hasBrowserSession": bool(result.get("hasBrowserSession", False)),
        "albumCount": result.get("albumCount"),
        "purchasedCount": result.get("purchasedCount"),
        "localCount": result.get("localCount"),
        "trackCount": result.get("trackCount"),
        "networkNote": result.get("networkNote") or "",
        "availableZips": result.get("availableZips") or [],
    })


def cmd_auth(args) -> None:
    settings = load_settings()
    auth = read_json(AUTH_FILE, {}) or {}

    if getattr(args, "open_browser", False):
        target_url = "https://bandcamp.com/login"
        xdg_bin = resolve_bin("xdg-open")
        if xdg_bin:
            try:
                subprocess.Popen(
                    [xdg_bin, "--", target_url],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except Exception:
                pass
        emit({"openedBrowser": True, "url": target_url})
        return

    if getattr(args, "logout", False):
        settings["username"] = ""
        settings["loggedOut"] = True
        write_json(SETTINGS_FILE, settings)
        write_json(AUTH_FILE, {"identity": ""}, mode=0o600)
        res = build_unified_collection(settings, fetch_remote=False, detect_browser=False)
        emit({
            "loggedOut": True,
            "authenticated": False,
            "username": "",
            "hasIdentity": False,
            "hasBrowserSession": False,
            "albumCount": res.get("albumCount", 0),
            "purchasedCount": res.get("purchasedCount", 0),
            "localCount": res.get("localCount", 0),
            **_visualiser_settings_payload(settings),
        })
        return

    if getattr(args, "detect_browser", False):
        settings["loggedOut"] = False
        browser = discover_from_browsers()
        if browser.get("username"):
            settings["username"] = browser["username"]
        write_json(SETTINGS_FILE, settings)
        if browser.get("identityCookie"):
            auth["identity"] = browser["identityCookie"]
            write_json(AUTH_FILE, auth, mode=0o600)

    if args.username is not None:
        uname = bounded_text(args.username, 64)
        settings["username"] = uname
        if uname:
            settings["loggedOut"] = False
        write_json(SETTINGS_FILE, settings)
    if args.identity is not None:
        ident = bounded_text(args.identity, 4096)
        auth["identity"] = ident
        if ident:
            settings["loggedOut"] = False
            write_json(SETTINGS_FILE, settings)
        write_json(AUTH_FILE, auth, mode=0o600)
    if args.download_dir:
        dpath = os.path.expanduser(args.download_dir)
        os.makedirs(dpath, mode=0o700, exist_ok=True)
        settings["downloadDir"] = dpath
        if dpath not in settings.get("localDirs", []):
            settings.setdefault("localDirs", list(DEFAULT_LOCAL_DIRS)).insert(0, dpath)
        write_json(SETTINGS_FILE, settings)
    if args.format:
        settings["preferredFormat"] = bounded_text(args.format, 32)
        write_json(SETTINGS_FILE, settings)
    if args.use_album_art is not None:
        settings["useAlbumArt"] = bool(int(args.use_album_art))
        settings["layer3Enabled"] = bool(int(args.use_album_art))
        write_json(SETTINGS_FILE, settings)
    if args.ascii_mode:
        settings["asciiMode"] = bounded_text(args.ascii_mode, 16)
        settings["layer3AsciiMode"] = bounded_text(args.ascii_mode, 16)
        write_json(SETTINGS_FILE, settings)
    if getattr(args, "stage_mode", None):
        sm = bounded_text(args.stage_mode, 32)
        if sm in ("off", "art", "turntable", "visualiser"):
            settings["stageMode"] = sm
            write_json(SETTINGS_FILE, settings)
    if getattr(args, "top_bar_led", None) is not None:
        raw_led = str(args.top_bar_led).strip().lower()
        led_val = raw_led in ("1", "true", "yes", "on")
        settings["top_bar_led"] = led_val
        settings["topBarLedEnabled"] = led_val
        write_json(SETTINGS_FILE, settings)
        cfg_obj = read_json(CONFIG_FILE, {})
        if not isinstance(cfg_obj, dict):
            cfg_obj = {}
        cfg_obj["top_bar_led"] = led_val
        cfg_obj["topBarLedEnabled"] = led_val
        write_json(CONFIG_FILE, cfg_obj)
    if getattr(args, "set_json", None):
        try:
            updates = json.loads(args.set_json)
            if isinstance(updates, dict):
                allowed_keys = set(_visualiser_settings_payload(settings).keys()) | {"useAlbumArt", "asciiMode", "top_bar_led", "topBarLedEnabled"}
                for k, v in updates.items():
                    if k in allowed_keys:
                        settings[k] = v
                if "top_bar_led" in updates or "topBarLedEnabled" in updates:
                    led_val = bool(updates.get("top_bar_led", updates.get("topBarLedEnabled", True)))
                    settings["top_bar_led"] = led_val
                    settings["topBarLedEnabled"] = led_val
                    cfg_obj = read_json(CONFIG_FILE, {})
                    if not isinstance(cfg_obj, dict):
                        cfg_obj = {}
                    cfg_obj["top_bar_led"] = led_val
                    cfg_obj["topBarLedEnabled"] = led_val
                    write_json(CONFIG_FILE, cfg_obj)
                if "layer3Enabled" in updates:
                    settings["useAlbumArt"] = bool(updates["layer3Enabled"])
                if "layer3AsciiMode" in updates:
                    settings["asciiMode"] = str(updates["layer3AsciiMode"])
                write_json(SETTINGS_FILE, settings)
        except Exception as exc:
            die(f"invalid --set-json payload: {exc}")
    if args.add_url:
        idx = ensure_index()
        albums = list(idx.get("albums") or [])
        u = bounded_text(args.add_url, MAX_URL_CHARS)
        det = fetch_album_details(u, api_base=settings.get("apiBase") or "https://bandcamp.com")
        if det:
            det["purchased"] = True
            det["isLocal"] = False
            det["localPath"] = ""
            det["artPath"] = cache_remote_art(det.get("artUrl", ""), det["id"], det["artist"], det["title"])
            det["fold"] = fold(f"{det['artist']} {det['title']}")
            albums = [a for a in albums if a.get("url") != u and a.get("id") != det["id"]]
            albums.insert(0, det)
            idx["albums"] = albums
            idx["albumCount"] = len(albums)
            idx["purchasedCount"] = sum(1 for a in albums if a.get("purchased"))
            write_json(INDEX_FILE, idx)

    logged_out = bool(settings.get("loggedOut", False))
    emit({
        "username": "" if logged_out else (settings.get("username") or ""),
        "loggedOut": logged_out,
        "hasIdentity": bool(auth.get("identity")) and not logged_out,
        "authenticated": bool((auth.get("identity") or settings.get("username")) and not logged_out),
        "downloadDir": settings.get("downloadDir") or DEFAULT_DOWNLOAD_DIR,
        "preferredFormat": settings.get("preferredFormat") or "flac",
        "useAlbumArt": bool(settings.get("useAlbumArt", True)),
        "asciiMode": settings.get("asciiMode") or "braille",
        **_visualiser_settings_payload(settings),
    })


def cmd_login(args) -> None:
    """Log into Bandcamp via explicit username/cookie, optional browser import (--detect-browser), or browser launch."""
    settings = load_settings()
    auth = read_json(AUTH_FILE, {}) or {}
    if getattr(args, "open_browser", False):
        args.logout = False
        args.detect_browser = False
        cmd_auth(args)
        return
    settings["loggedOut"] = False
    if getattr(args, "username", None):
        settings["username"] = bounded_text(args.username, 64)
    if getattr(args, "identity", None):
        auth["identity"] = bounded_text(args.identity, 4096)
        write_json(AUTH_FILE, auth, mode=0o600)
    want_detect = bool(getattr(args, "detect_browser", False))
    if want_detect:
        browser = discover_from_browsers()
        if browser.get("username") and not getattr(args, "username", None):
            settings["username"] = browser["username"]
        if browser.get("identityCookie") and not getattr(args, "identity", None):
            auth["identity"] = browser["identityCookie"]
            write_json(AUTH_FILE, auth, mode=0o600)
    write_json(SETTINGS_FILE, settings)
    res = build_unified_collection(
        settings,
        fetch_remote=not getattr(args, "no_sync", False),
        detect_browser=want_detect,
    )
    emit({
        "loggedIn": bool(res.get("username") or auth.get("identity")),
        "loggedOut": False,
        "username": res.get("username") or "",
        "hasIdentity": bool(auth.get("identity")),
        "hasBrowserSession": bool(res.get("hasBrowserSession")),
        "albumCount": res.get("albumCount", 0),
        "purchasedCount": res.get("purchasedCount", 0),
        "localCount": res.get("localCount", 0),
        "trackCount": res.get("trackCount", 0),
    })


def cmd_logout(args) -> None:
    """Log out of Bandcamp, clearing saved identity cookies and remote-only purchases from the active index."""
    args.open_browser = False
    args.logout = True
    args.detect_browser = False
    args.username = None
    args.identity = None
    args.download_dir = None
    args.format = None
    args.use_album_art = None
    args.ascii_mode = None
    args.stage_mode = None
    args.set_json = None
    args.add_url = None
    cmd_auth(args)


def cmd_album(args) -> None:
    """Resolve and return the full tracklist for an album (fetching Bandcamp tralbum details if needed)."""
    settings = load_settings()
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    target = next((a for a in albums if a.get("id") == args.id or a.get("url") == args.id), None)
    if not target:
        die(f"album not found: {args.id}")

    tracks = list(target.get("tracks") or [])
    api_base = settings.get("apiBase") or "https://bandcamp.com"
    if not target.get("isLocal") and target.get("url"):
        if len(tracks) <= 1 or any(not t.get("streamUrl") for t in tracks):
            det = fetch_album_details(target["url"], api_base=api_base)
            if det and det.get("tracks"):
                target["tracks"] = det["tracks"]
                target["numTracks"] = len(det["tracks"])
                idx["albums"] = albums
                idx["trackCount"] = sum(len(a.get("tracks") or []) for a in albums)
                write_json(INDEX_FILE, idx)

    emit({
        "album": target,
        "tracks": target.get("tracks") or [],
        "trackCount": len(target.get("tracks") or []),
        "albums": albums,
    })


def cmd_ascii_art(args) -> None:
    """Convert album cover art (via omarchy-transcode-ascii) or text (via omarchy-ascii)
    into a character matrix and extract real Omarchy `/usr/bin/ttfx` screensaver engine
    keyframes for the visualiser.
    """
    settings = load_settings()
    idx = ensure_index()
    albums = list(idx.get("albums") or [])

    use_album_art = bool(settings.get("useAlbumArt", True))
    if args.use_album_art is not None:
        use_album_art = bool(int(args.use_album_art))

    mode = args.mode or settings.get("layer3AsciiMode") or settings.get("asciiMode") or "braille"
    width = bounded_int(args.width, 72, 20, 160)
    height = bounded_int(args.height, 32, 10, 80)
    threshold = bounded_int(args.threshold, 50, 10, 90)
    effect = (getattr(args, "effect", None) or "random").lower()
    if effect not in TTFX_EFFECTS or effect == "random":
        non_random = [e for e in TTFX_EFFECTS if e != "random"]
        effect = secrets.choice(non_random) if non_random else "waves"

    image_path = args.image or ""
    banner_text = args.text or ""
    target_album = None

    if args.album:
        target_album = next((a for a in albums if a.get("id") == args.album or a.get("url") == args.album), None)
        if target_album:
            image_path = image_path or target_album.get("artPath") or ""
            banner_text = banner_text or target_album.get("artist") or target_album.get("title") or ""

    if not image_path and not banner_text:
        pb = get_playback_state()
        if pb.get("playing"):
            image_path = pb.get("artPath") or ""
            banner_text = pb.get("artist") or pb.get("title") or ""
        if not image_path and not banner_text:
            hist = read_json(HISTORY_FILE, {}) or {}
            last = hist.get("lastPlayedTrack") or {}
            image_path = last.get("artPath") or ""
            banner_text = last.get("artist") or last.get("title") or ""

    if not image_path and use_album_art and albums:
        first_art = next((a for a in albums if a.get("artPath") and os.path.isfile(str(a.get("artPath")))), albums[0])
        image_path = first_art.get("artPath") or ""
        banner_text = banner_text or first_art.get("artist") or first_art.get("title") or "BANDARCHY"

    banner_lines = render_omarchy_ascii_banner(banner_text or "BANDARCHY", max_width=min(width, 68))
    art_lines: list[str] = []
    if image_path and os.path.isfile(image_path):
        img_mode = "block" if mode == "block" else "braille"
        art_lines = transcode_image_to_ascii(
            image_path,
            width=width,
            height=height,
            mode=img_mode,
            threshold=threshold,
            invert=bool(args.invert),
        )

    lines: list[str] = []
    source_kind = "omarchy-ascii"
    if use_album_art and art_lines:
        lines = art_lines
        source_kind = "album-art"
    else:
        lines = banner_lines
        source_kind = "omarchy-ascii"

    max_cols = max((len(l) for l in lines), default=0)
    # Write to SCREENSAVER_TXT_FILE so `ttfx -i` can consume it directly
    atomic_write(SCREENSAVER_TXT_FILE, ("\n".join(lines) + "\n").encode("utf-8"), 0o600, fatal=False)

    ttfx_frames = extract_ttfx_frames(
        SCREENSAVER_TXT_FILE,
        width=max(max_cols, width),
        height=max(len(lines), height),
        effect=effect,
        max_frames=28,
    )

    emit({
        "source": source_kind,
        "useAlbumArt": use_album_art,
        "mode": mode,
        "bannerText": banner_text or "BANDARCHY",
        "imagePath": image_path if os.path.isfile(str(image_path)) else "",
        "rows": len(lines),
        "cols": max_cols,
        "lineCount": len(lines),
        "colCount": max_cols,
        "lines": lines,
        "bannerLines": banner_lines,
        "artLines": art_lines,
        "ttfxEffect": effect,
        "ttfxFrameCount": len(ttfx_frames),
        "ttfxFrames": ttfx_frames,
        "text": "\n".join(lines),
        "screensaverFile": SCREENSAVER_TXT_FILE,
    })


def _run_screensaver_tty_loop(self_bin: str, mode_flag: str, use_art_flag: str, effect: str) -> None:
    """Execute the fullscreen ttfx screensaver loop directly in Python without bash -c (CRIT-7)."""
    import select
    import termios
    import tty

    sys.stdout.write("\033]11;rgb:00/00/00\007")
    sys.stdout.flush()

    deadline = time.time() + 2.0
    while time.time() < deadline:
        try:
            sz = os.get_terminal_size()
            if (sz.lines, sz.columns) != (24, 80):
                break
        except OSError:
            break
        time.sleep(0.02)

    stdin_fd = sys.stdin.fileno() if sys.stdin and sys.stdin.isatty() else -1
    old_tty = None
    if stdin_fd >= 0:
        try:
            old_tty = termios.tcgetattr(stdin_fd)
            tty.setcbreak(stdin_fd)
        except Exception:
            old_tty = None

    effect_arg = "--random-effect" if effect == "random" else effect
    ttfx_argv = [
        TTFX_BIN,
        "-i",
        SCREENSAVER_TXT_FILE,
        "--frame-rate",
        "120",
        "--canvas-width",
        "0",
        "--canvas-height",
        "0",
        "--reuse-canvas",
        "--anchor-canvas",
        "c",
        "--anchor-text",
        "c",
        "--no-eol",
        "--no-restore-cursor",
        effect_arg,
    ]
    try:
        while True:
            subprocess.run(
                [self_bin, "ascii-art", "--mode", mode_flag, "--use-album-art", use_art_flag, "--effect", "random"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            child = subprocess.Popen(ttfx_argv)
            while child.poll() is None:
                if stdin_fd >= 0:
                    rlist, _, _ = select.select([stdin_fd], [], [], 0.25)
                    if rlist:
                        try:
                            os.read(stdin_fd, 1)
                        except OSError:
                            pass
                        child.terminate()
                        return
                else:
                    time.sleep(0.25)
    finally:
        if stdin_fd >= 0 and old_tty is not None:
            try:
                termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_tty)
            except Exception:
                pass


def cmd_screensaver(args) -> None:
    """Transcode the active album cover (or Omarchy banner) and launch `ttfx` in a visible fullscreen terminal."""
    settings = load_settings()
    if getattr(args, "use_album_art", None) is None:
        args.use_album_art = "1" if settings.get("useAlbumArt", False) and args.mode in ("braille", "block") else "0"

    effect = (args.effect or "random").lower()
    if effect not in TTFX_EFFECTS:
        effect = "random"
    effect_flag = "--random-effect" if effect == "random" else effect

    if not os.path.isfile(TTFX_BIN):
        die("ttfx is not installed on this system")

    self_bin = os.path.abspath(__file__)
    use_art_flag = "1" if str(args.use_album_art) == "1" else "0"
    mode_flag = args.mode if args.mode in ("braille", "block", "banner") else "banner"

    if getattr(args, "tty_loop", False):
        _run_screensaver_tty_loop(self_bin, mode_flag, use_art_flag, effect)
        return

    with quiet():
        cmd_ascii_art(args)

    ttfx_cmd_str = (
        f"{TTFX_BIN} -i {SCREENSAVER_TXT_FILE} "
        f"--frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas "
        f"--anchor-canvas c --anchor-text c --no-eol --no-restore-cursor {effect_flag}"
    )

    if args.dry_run:
        emit({
            "launched": False,
            "dryRun": True,
            "effect": effect,
            "ttfxCommand": ttfx_cmd_str,
            "screensaverFile": SCREENSAVER_TXT_FILE,
            "ttfxAvailable": os.path.isfile(TTFX_BIN),
        })
        return

    omarchy_dir = os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy"
    if not os.path.isdir(omarchy_dir):
        omarchy_dir = os.path.join(HOME, "omarchy")

    win_class = "org.bandarchy.tte"
    loop_argv = [
        self_bin,
        "screensaver",
        "--tty-loop",
        "--mode",
        mode_flag,
        "--use-album-art",
        use_art_flag,
        "--effect",
        effect,
    ]
    term_cmd = None
    ghostty_bin = resolve_bin("ghostty")
    alacritty_bin = resolve_bin("alacritty")
    foot_bin = resolve_bin("foot")
    kitty_bin = resolve_bin("kitty")

    if ghostty_bin:
        conf = os.path.join(omarchy_dir, "default", "ghostty", "screensaver")
        term_cmd = [ghostty_bin, f"--class={win_class}", "--fullscreen=true", "--font-size=18"]
        if os.path.isfile(conf):
            term_cmd.append(f"--config-file={conf}")
        term_cmd.extend(["-e", *loop_argv])
    elif alacritty_bin:
        conf = os.path.join(omarchy_dir, "default", "alacritty", "screensaver.toml")
        term_cmd = [alacritty_bin, f"--class={win_class}", "-o", 'window.startup_mode="Fullscreen"']
        if os.path.isfile(conf):
            term_cmd.extend(["--config-file", conf])
        term_cmd.extend(["-e", *loop_argv])
    elif foot_bin:
        conf = os.path.join(omarchy_dir, "default", "foot", "screensaver.ini")
        term_cmd = [foot_bin, f"--app-id={win_class}", "--fullscreen"]
        if os.path.isfile(conf):
            term_cmd.append(f"--config={conf}")
        term_cmd.extend(["-e", *loop_argv])
    elif kitty_bin:
        term_cmd = [
            kitty_bin,
            f"--class={win_class}",
            "--start-as=fullscreen",
            "--override",
            "font_size=18",
            "--override",
            "window_padding_width=0",
            "-e",
            *loop_argv,
        ]

    if not term_cmd:
        die("no supported terminal (ghostty, alacritty, foot, kitty) found for ttfx screensaver")

    subprocess.Popen(
        term_cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    emit({
        "launched": True,
        "effect": effect,
        "ttfxCommand": ttfx_cmd_str,
        "screensaverFile": SCREENSAVER_TXT_FILE,
    })


def cmd_smart_playlist(args) -> None:
    """Generate (and optionally play or save) an intelligent playlist based on last track played."""
    settings = load_settings()
    idx = ensure_index()
    smart = build_intelligent_playlist(
        idx,
        seed_track_id=args.seed_track or "",
        seed_album_id=args.seed_album or "",
        preset=args.preset or "radio",
        limit=bounded_int(args.limit, 25, 3, 100),
    )

    saved_playlist = None
    if args.save_as:
        pls = load_playlists()
        new_id = f"pl-{int(time.time())}-{secrets.token_hex(3)}"
        saved_playlist = {
            "id": new_id,
            "title": bounded_text(args.save_as, 120),
            "description": smart.get("description") or "",
            "isSmart": True,
            "preset": smart.get("preset") or "radio",
            "seedTrack": smart.get("seed"),
            "createdAt": int(time.time()),
            "updatedAt": int(time.time()),
            "trackCount": len(smart.get("tracks") or []),
            "tracks": smart.get("tracks") or [],
        }
        pls.insert(0, saved_playlist)
        save_playlists(pls)

    if args.play:
        playable = resolve_track_list(
            smart.get("tracks") or [],
            idx,
            mode="auto",
            api_base=settings.get("apiBase") or "https://bandcamp.com",
        )
        start_idx = bounded_int(getattr(args, "track_index", 0), 0, 0, max(0, len(playable) - 1))
        start_queue(
            playable,
            {
                "type": "smart-playlist",
                "preset": smart.get("preset"),
                "title": smart.get("title"),
                "seedTrackId": (smart.get("seed") or {}).get("id") or "",
            },
            shuffle=False,
            start_index=start_idx,
            loop=bool(args.loop),
        )
        return

    emit({
        **smart,
        "smartPlaylist": smart,
        "savedPlaylist": saved_playlist,
    })


def cmd_playlists(args) -> None:
    """Manage user-created custom playlists."""
    idx = ensure_index()
    pls = load_playlists()
    action = args.action

    if action == "list":
        hist = read_json(HISTORY_FILE, {}) or {}
        emit({
            "playlists": pls,
            "lastPlayedTrack": hist.get("lastPlayedTrack"),
            "recentTracks": (hist.get("recentTracks") or [])[:20],
        })
        return

    if action == "create":
        title = bounded_text(args.title or "New Playlist", 120)
        if not title:
            die("playlist create requires --title")
        initial_tracks: list[dict] = []
        if args.from_smart:
            smart = build_intelligent_playlist(
                idx,
                seed_track_id=args.seed_track or "",
                preset=args.from_smart,
                limit=25,
            )
            initial_tracks = list(smart.get("tracks") or [])
        elif args.album:
            alb = next((a for a in (idx.get("albums") or []) if a.get("id") == args.album), None)
            if alb:
                for t in alb.get("tracks") or []:
                    tc = dict(t)
                    tc["albumId"] = alb.get("id")
                    tc["album"] = alb.get("title")
                    tc["artist"] = t.get("artist") or alb.get("artist")
                    tc["artPath"] = alb.get("artPath") or ""
                    initial_tracks.append(tc)
        elif args.tracks:
            wanted = [tid.strip() for tid in args.tracks.split(",") if tid.strip()]
            by_id = {t["id"]: t for t in all_indexed_tracks(idx)}
            for tid in wanted:
                if tid in by_id:
                    initial_tracks.append(by_id[tid])

        new_pl = {
            "id": f"pl-{int(time.time())}-{secrets.token_hex(3)}",
            "title": title,
            "description": bounded_text(args.description or "", 240),
            "isSmart": bool(args.from_smart),
            "createdAt": int(time.time()),
            "updatedAt": int(time.time()),
            "trackCount": len(initial_tracks),
            "tracks": initial_tracks,
        }
        pls.insert(0, new_pl)
        save_playlists(pls)
        emit({"created": new_pl, "playlists": pls})
        return

    if action == "add":
        if not args.id:
            die("playlists add requires --id <playlist_id>")
        target = next((p for p in pls if p.get("id") == args.id), None)
        if not target:
            die(f"playlist not found: {args.id}")
        to_add: list[dict] = []
        if args.album:
            alb = next((a for a in (idx.get("albums") or []) if a.get("id") == args.album), None)
            if alb:
                for t in alb.get("tracks") or []:
                    tc = dict(t)
                    tc["albumId"] = alb.get("id")
                    tc["album"] = alb.get("title")
                    tc["artist"] = t.get("artist") or alb.get("artist")
                    tc["artPath"] = alb.get("artPath") or ""
                    to_add.append(tc)
        if args.tracks:
            wanted = [tid.strip() for tid in args.tracks.split(",") if tid.strip()]
            by_id = {t["id"]: t for t in all_indexed_tracks(idx)}
            for tid in wanted:
                if tid in by_id:
                    to_add.append(by_id[tid])
        existing_tracks = list(target.get("tracks") or [])
        existing_tracks.extend(to_add)
        target["tracks"] = existing_tracks[:1000]
        target["trackCount"] = len(target["tracks"])
        target["updatedAt"] = int(time.time())
        save_playlists(pls)
        emit({"added": len(to_add), "playlist": target, "playlists": pls})
        return

    if action == "remove-track":
        if not args.id:
            die("playlists remove-track requires --id <playlist_id>")
        target = next((p for p in pls if p.get("id") == args.id), None)
        if not target:
            die(f"playlist not found: {args.id}")
        existing_tracks = list(target.get("tracks") or [])
        if args.index is not None and 0 <= args.index < len(existing_tracks):
            existing_tracks.pop(args.index)
        elif args.track_id:
            existing_tracks = [t for t in existing_tracks if t.get("id") != args.track_id]
        target["tracks"] = existing_tracks
        target["trackCount"] = len(existing_tracks)
        target["updatedAt"] = int(time.time())
        save_playlists(pls)
        emit({"playlist": target, "playlists": pls})
        return

    if action == "rename":
        if not args.id or not args.title:
            die("playlists rename requires --id and --title")
        target = next((p for p in pls if p.get("id") == args.id), None)
        if not target:
            die(f"playlist not found: {args.id}")
        target["title"] = bounded_text(args.title, 120)
        target["updatedAt"] = int(time.time())
        save_playlists(pls)
        emit({"playlist": target, "playlists": pls})
        return

    if action == "delete":
        if not args.id:
            die("playlists delete requires --id")
        pls = [p for p in pls if p.get("id") != args.id]
        save_playlists(pls)
        emit({"deleted": args.id, "playlists": pls})
        return


def cmd_play(args) -> None:
    settings = load_settings()
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    mode = (args.mode or "auto").lower()
    api_base = settings.get("apiBase") or "https://bandcamp.com"

    if args.playlist:
        pls = load_playlists()
        pl = next((p for p in pls if p.get("id") == args.playlist), None)
        if not pl:
            die(f"playlist not found: {args.playlist}")
        tracks = resolve_track_list(pl.get("tracks") or [], idx, mode=mode, api_base=api_base)
        start_idx = max(0, int(args.track_index or 0))
        if args.track_id:
            for i, t in enumerate(tracks):
                if t.get("id") == args.track_id:
                    start_idx = i
                    break
        start_queue(
            tracks,
            {"type": "playlist", "playlistId": pl.get("id"), "title": pl.get("title"), "mode": mode},
            shuffle=bool(args.shuffle),
            start_index=start_idx,
            loop=bool(args.loop),
        )
        return

    target_album = None
    if args.album:
        target_album = next((a for a in albums if a.get("id") == args.album or a.get("url") == args.album), None)
        if not target_album:
            die(f"album not found in collection: {args.album}")
    elif args.track_id:
        for a in albums:
            if any(t.get("id") == args.track_id for t in (a.get("tracks") or [])):
                target_album = a
                break
        if not target_album:
            die(f"track not found in collection: {args.track_id}")

    if target_album:
        tracks = resolve_playable_tracks(target_album, mode=mode, api_base=api_base)
        start_idx = max(0, int(args.track_index or 0))
        if args.track_id:
            for i, t in enumerate(tracks):
                if t.get("id") == args.track_id:
                    start_idx = i
                    break
        start_queue(
            tracks,
            {"type": "album", "albumId": target_album.get("id"), "title": target_album.get("title"), "mode": mode},
            shuffle=bool(args.shuffle),
            start_index=start_idx,
            loop=bool(args.loop),
        )
        return

    if args.scope:
        scope = args.scope.lower()
        pool_albums = albums
        if scope == "purchased":
            pool_albums = [a for a in albums if a.get("purchased")]
        elif scope == "local":
            pool_albums = [a for a in albums if a.get("isLocal")]
        tracks = []
        for a in pool_albums:
            tracks.extend(resolve_playable_tracks(a, mode=mode, api_base=api_base))
        start_queue(
            tracks,
            {"type": "collection", "scope": scope, "mode": mode},
            shuffle=bool(args.shuffle),
            start_index=0,
            loop=bool(args.loop),
        )
        return

    die("play requires --album <id>, --track-id <id>, --playlist <id>, or --scope all|purchased|local")


def cmd_download(args) -> None:
    settings = load_settings()
    idx = ensure_index()
    albums = list(idx.get("albums") or [])
    target = next((a for a in albums if a.get("id") == args.album or a.get("url") == args.album), None)
    if not target:
        die(f"album not found: {args.album}")
    fmt = args.format or settings.get("preferredFormat") or "flac"
    res = download_album_to_local(target, preferred_format=fmt, settings=settings)
    emit(res)


def cmd_import_zip(args) -> None:
    settings = load_settings()
    dl_root = os.path.expanduser(settings.get("downloadDir") or DEFAULT_DOWNLOAD_DIR)
    zips = find_bandcamp_zips_in_downloads()
    if args.zip_path:
        zpath = os.path.expanduser(args.zip_path)
        if not os.path.isfile(zpath):
            die(f"ZIP file not found: {zpath}")
        stem = os.path.splitext(os.path.basename(zpath))[0]
        dest = os.path.join(dl_root, re.sub(r"[/\\:\*\?\"<>\|]+", "-", stem).strip())
        files = safe_extract_zip(zpath, dest)
        res = build_unified_collection(settings, fetch_remote=False, detect_browser=False)
        emit({"imported": 1, "fileCount": len(files), "destDir": dest, "albumCount": res.get("albumCount")})
        return

    imported = 0
    total_files = 0
    for z in zips:
        folder = re.sub(r"[/\\:\*\?\"<>\|]+", "-", f"{z['artist']} - {z['album']}").strip()
        dest = os.path.join(dl_root, folder)
        files = safe_extract_zip(z["zipPath"], dest)
        imported += 1
        total_files += len(files)
    res = build_unified_collection(settings, fetch_remote=False, detect_browser=False)
    emit({"imported": imported, "fileCount": total_files, "albumCount": res.get("albumCount")})


def cmd_favourites(args) -> None:
    store = read_json(FAVOURITES_FILE, {"items": []}) or {"items": []}
    items = list(store.get("items") or [])
    if args.action == "list":
        emit({"items": items})
        return
    if not args.id:
        die("favourites add/remove/toggle requires --id")
    exists = any(i.get("id") == args.id for i in items)
    if args.action == "add" or (args.action == "toggle" and not exists):
        if not exists:
            items.append({"id": args.id, "title": bounded_text(args.title or args.id), "addedAt": int(time.time())})
            write_json(FAVOURITES_FILE, {"items": items})
        emit({"items": items, "favourited": True})
        return
    if args.action == "remove" or (args.action == "toggle" and exists):
        items = [i for i in items if i.get("id") != args.id]
        write_json(FAVOURITES_FILE, {"items": items})
        emit({"items": items, "favourited": False})
        return


def cmd_cmd(args) -> None:
    action = args.action
    if getattr(args, "value", None) is None and getattr(args, "pos_value", None) is not None:
        try:
            args.value = float(str(args.pos_value).rstrip("%"))
        except ValueError:
            pass
    is_running = mpv_running()
    if action == "play-pause":
        if is_running:
            if mpv_get("idle-active") or mpv_get("eof-reached") or mpv_get("playlist-pos") in (None, -1):
                resumed = resume_last_playback(start_index_override=0, start_pos_override=0.0)
                emit({"action": action, "resumed": bool(resumed), **(resumed or {})})
                return
            mpv_request(["cycle", "pause"])
            save_playback_resume_state(mark_stopped=bool(mpv_get("pause")))
        else:
            resumed = resume_last_playback()
            emit({"action": action, "resumed": bool(resumed), **(resumed or {})})
            return
    elif action == "play":
        if is_running:
            if mpv_get("idle-active") or mpv_get("eof-reached") or mpv_get("playlist-pos") in (None, -1):
                resumed = resume_last_playback(start_index_override=0, start_pos_override=0.0)
                emit({"action": action, "resumed": bool(resumed), **(resumed or {})})
                return
            mpv_request(["set_property", "pause", False])
            save_playback_resume_state(mark_stopped=False)
        else:
            resumed = resume_last_playback()
            emit({"action": action, "resumed": bool(resumed), **(resumed or {})})
            return
    elif action == "pause":
        if is_running:
            mpv_request(["set_property", "pause", True])
            save_playback_resume_state(mark_stopped=True)
    elif action == "next":
        if is_running:
            mpv_request(["playlist-next", "force"])
            save_playback_resume_state()
        else:
            queue = read_json(QUEUE_FILE, {}) or {}
            hist = read_json(HISTORY_FILE, {}) or {}
            last = (hist.get("lastPlayedTrack") if isinstance(hist, dict) else None) or {}
            saved_idx = bounded_int(queue.get("playlistPos", last.get("playlistPos", 0)), 0)
            resumed = resume_last_playback(start_index_override=saved_idx + 1, start_pos_override=0.0)
            emit({"action": action, "resumed": bool(resumed), **(resumed or {})})
            return
    elif action == "prev":
        if is_running:
            pos = mpv_get("playlist-pos") or 0
            elapsed = mpv_get("time-pos") or 0
            if pos <= 0 or elapsed > 4:
                mpv_request(["seek", 0, "absolute"])
            else:
                mpv_request(["playlist-prev"])
            save_playback_resume_state()
        else:
            queue = read_json(QUEUE_FILE, {}) or {}
            hist = read_json(HISTORY_FILE, {}) or {}
            last = (hist.get("lastPlayedTrack") if isinstance(hist, dict) else None) or {}
            saved_idx = bounded_int(queue.get("playlistPos", last.get("playlistPos", 0)), 0)
            saved_pos = bounded_float(last.get("position", queue.get("position", 0.0)), 0.0)
            prev_idx = saved_idx if (saved_idx <= 0 or saved_pos > 4.0) else max(0, saved_idx - 1)
            resumed = resume_last_playback(start_index_override=prev_idx, start_pos_override=0.0)
            emit({"action": action, "resumed": bool(resumed), **(resumed or {})})
            return
    elif action == "stop":
        mpv_stop(save_state=True)
    elif action == "volume":
        if args.value is None:
            die("volume requires --value 0-100")
        vol_val = bounded_int(round(float(args.value)), 100, 0, 100)
        hist = read_json(HISTORY_FILE, {}) or {}
        if not isinstance(hist, dict):
            hist = {}
        hist["volume"] = vol_val
        if vol_val > 0 and hist.get("muted"):
            hist["muted"] = False
            if is_running:
                mpv_request(["set_property", "mute", False])
        if is_running:
            mpv_request(["set_property", "volume", vol_val])
        write_json(HISTORY_FILE, hist)
        emit({"action": action, "volume": vol_val, "muted": bool(hist.get("muted", False))})
        return
    elif action == "mute":
        hist = read_json(HISTORY_FILE, {}) or {}
        if not isinstance(hist, dict):
            hist = {}
        if args.value is None:
            cur_m = mpv_get("mute") if is_running else None
            is_muted = bool(cur_m) if cur_m is not None else bool(hist.get("muted", False))
            target_mute = not is_muted
        else:
            target_mute = float(args.value) > 0
        if is_running:
            mpv_request(["set_property", "mute", target_mute])
        hist["muted"] = target_mute
        write_json(HISTORY_FILE, hist)
        emit({
            "action": action,
            "volume": bounded_int(hist.get("volume", 100), 100, 0, 100),
            "muted": target_mute,
        })
        return
    elif action == "seek":
        if args.value is None:
            die("seek requires --value SECONDS")
        sec_val = max(0.0, float(args.value))
        if is_running:
            mpv_request(["seek", sec_val, "absolute"])
            save_playback_resume_state(position_override=sec_val)
        else:
            queue = read_json(QUEUE_FILE, {}) or {}
            if isinstance(queue, dict) and queue.get("tracks"):
                queue["position"] = round(sec_val, 2)
                queue["stoppedMidTrack"] = True
                write_json(QUEUE_FILE, queue)
            hist = read_json(HISTORY_FILE, {}) or {}
            last = hist.get("lastPlayedTrack") if isinstance(hist, dict) else None
            if isinstance(last, dict) and last.get("title"):
                record_history(last, position=sec_val, playlist_pos=bounded_int(last.get("playlistPos", 0), 0))
    elif action == "loop":
        hist = read_json(HISTORY_FILE, {}) or {}
        if args.value is None:
            cur = mpv_get("loop-playlist") if is_running else None
            if cur is None:
                is_looping = bool(hist.get("loopPlaylist", False))
            else:
                is_looping = cur in ("inf", "force", True)
            target_loop = "no" if is_looping else "inf"
        else:
            target_loop = "inf" if args.value > 0 else "no"
        if is_running:
            mpv_request(["set_property", "loop-playlist", target_loop])
        hist["loopPlaylist"] = target_loop == "inf"
        write_json(HISTORY_FILE, hist)
        emit({"action": action, "loop": target_loop == "inf"})
        return
    elif action == "jump":
        if args.value is None:
            die("jump requires --value PLAYLIST_INDEX")
        jump_idx = max(0, int(args.value))
        if is_running:
            mpv_request(["set_property", "playlist-pos", jump_idx])
            save_playback_resume_state()
        else:
            resumed = resume_last_playback(start_index_override=jump_idx, start_pos_override=0.0)
            emit({"action": action, "resumed": bool(resumed), **(resumed or {})})
            return
    else:
        die(f"unknown transport command: {action}")
    emit({"action": action})


def cmd_volume(args) -> None:
    is_running = mpv_running()
    hist = read_json(HISTORY_FILE, {}) or {}
    if not isinstance(hist, dict):
        hist = {}
    raw_cur_vol = mpv_get("volume") if is_running else None
    cur_vol = bounded_int(
        raw_cur_vol if raw_cur_vol is not None else hist.get("volume", 100),
        100,
        0,
        100,
    )
    raw_cur_mute = mpv_get("mute") if is_running else None
    cur_muted = bool(raw_cur_mute) if raw_cur_mute is not None else bool(hist.get("muted", False))

    spec = str(getattr(args, "level", None) or "").strip().lower()
    if not spec:
        emit({"volume": cur_vol, "muted": cur_muted})
        return

    if spec in ("mute", "toggle-mute", "m"):
        new_muted = not cur_muted
        if is_running:
            mpv_request(["set_property", "mute", new_muted])
        hist["volume"] = cur_vol
        hist["muted"] = new_muted
        write_json(HISTORY_FILE, hist)
        emit({"volume": cur_vol, "muted": new_muted})
        return
    if spec == "unmute":
        if is_running:
            mpv_request(["set_property", "mute", False])
        hist["volume"] = cur_vol
        hist["muted"] = False
        write_json(HISTORY_FILE, hist)
        emit({"volume": cur_vol, "muted": False})
        return

    try:
        if spec.startswith("+") or spec.startswith("-"):
            delta = int(round(float(spec)))
            new_vol = bounded_int(cur_vol + delta, cur_vol, 0, 100)
        else:
            new_vol = bounded_int(round(float(spec.rstrip("%"))), cur_vol, 0, 100)
    except Exception:
        die(f"invalid volume argument: {spec} (expected 0..100, +N, -N, or mute)")
        return

    new_muted = False if (new_vol > 0 and cur_muted) else cur_muted
    if is_running:
        mpv_request(["set_property", "volume", new_vol])
        if new_muted != cur_muted:
            mpv_request(["set_property", "mute", new_muted])
    hist["volume"] = new_vol
    hist["muted"] = new_muted
    write_json(HISTORY_FILE, hist)
    emit({"volume": new_vol, "muted": new_muted})



def cmd_now(args) -> None:
    playback = get_playback_state()
    hist = read_json(HISTORY_FILE, {}) or {}
    emit({
        **playback,
        "lastPlayedTrack": hist.get("lastPlayedTrack"),
    })


