def load_settings() -> dict:
    defaults = {
        "username": "",
        "loggedOut": False,
        "downloadDir": DEFAULT_DOWNLOAD_DIR,
        "localDirs": DEFAULT_LOCAL_DIRS,
        "preferredFormat": "flac",
        "autoImportZips": True,
        "top_bar_led": True,
        "topBarLedEnabled": True,
        "bgEnabled": True,
        "bgMode": 0,
        "bgTrail": 0.26,
        "bgSpeed": 1.0,
        "bgDensity": 1.0,
        "vizEnabled": True,
        "useAlbumArt": False,
        "asciiMode": "braille",
        "dismantleMode": 0,
        "dismantleForce": 1.15,
        "rebuildCohesion": 0.65,
        "evolutionRate": 0.55,
        "glyphScale": 1.0,
        "apiBase": os.environ.get("BANDARCHY_API_BASE") or os.environ.get("BANDCAMP_API_BASE") or "https://bandcamp.com",
    }
    cfg_saved = read_json(CONFIG_FILE, {})
    if isinstance(cfg_saved, dict):
        defaults.update({k: v for k, v in cfg_saved.items() if v is not None})
    saved = read_json(SETTINGS_FILE, {})
    if isinstance(saved, dict):
        defaults.update({k: v for k, v in saved.items() if v is not None})
    if "top_bar_led" in saved and "topBarLedEnabled" not in saved:
        defaults["topBarLedEnabled"] = bool(saved["top_bar_led"])
    elif "topBarLedEnabled" in saved and "top_bar_led" not in saved:
        defaults["top_bar_led"] = bool(saved["topBarLedEnabled"])
    elif "top_bar_led" in cfg_saved and "topBarLedEnabled" not in cfg_saved:
        defaults["topBarLedEnabled"] = bool(cfg_saved["top_bar_led"])
    env_base = os.environ.get("BANDARCHY_API_BASE") or os.environ.get("BANDCAMP_API_BASE")
    if env_base:
        defaults["apiBase"] = env_base
    return defaults


_keyring_cache: dict[str, bytes] = {}


def _aes_128_cbc_decrypt_inprocess(ct: bytes, key: bytes, iv: bytes) -> bytes:
    """Decrypt AES-128-CBC ciphertext in-process via ctypes libcrypto.so.3 without exposing keys in argv."""
    if not ct or len(ct) % 16 != 0 or len(key) != 16 or len(iv) != 16:
        return b""
    import ctypes
    libcrypto = None
    for lib_name in ("libcrypto.so.3", "libcrypto.so.1.1", "libcrypto.so"):
        try:
            libcrypto = ctypes.CDLL(lib_name)
            break
        except OSError:
            continue
    if libcrypto is None:
        return b""
    libcrypto.EVP_CIPHER_CTX_new.restype = ctypes.c_void_p
    libcrypto.EVP_CIPHER_CTX_free.argtypes = [ctypes.c_void_p]
    libcrypto.EVP_aes_128_cbc.restype = ctypes.c_void_p
    libcrypto.EVP_DecryptInit_ex.argtypes = [
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_char_p, ctypes.c_char_p
    ]
    libcrypto.EVP_DecryptInit_ex.restype = ctypes.c_int
    libcrypto.EVP_DecryptUpdate.argtypes = [
        ctypes.c_void_p, ctypes.c_char_p, ctypes.POINTER(ctypes.c_int), ctypes.c_char_p, ctypes.c_int
    ]
    libcrypto.EVP_DecryptUpdate.restype = ctypes.c_int
    libcrypto.EVP_DecryptFinal_ex.argtypes = [
        ctypes.c_void_p, ctypes.c_char_p, ctypes.POINTER(ctypes.c_int)
    ]
    libcrypto.EVP_DecryptFinal_ex.restype = ctypes.c_int

    ctx = libcrypto.EVP_CIPHER_CTX_new()
    if not ctx:
        return b""
    try:
        out_buf = ctypes.create_string_buffer(len(ct) + 32)
        out_len = ctypes.c_int(0)
        final_len = ctypes.c_int(0)
        if libcrypto.EVP_DecryptInit_ex(ctx, libcrypto.EVP_aes_128_cbc(), None, key, iv) != 1:
            return b""
        if libcrypto.EVP_DecryptUpdate(ctx, out_buf, ctypes.byref(out_len), ct, len(ct)) != 1:
            return b""
        tail_ptr = ctypes.cast(ctypes.addressof(out_buf) + out_len.value, ctypes.c_char_p)
        if libcrypto.EVP_DecryptFinal_ex(ctx, tail_ptr, ctypes.byref(final_len)) != 1:
            return b""
        return out_buf.raw[: out_len.value + final_len.value]
    finally:
        libcrypto.EVP_CIPHER_CTX_free(ctx)


def decrypt_chromium_cookie_value(enc: bytes, app_name: str = "chrome") -> str:
    """Decrypt Linux Chrome/Chromium/Brave v10/v11 AES-128-CBC SQLite cookie values in-process."""
    if not enc or not isinstance(enc, (bytes, bytearray)):
        return ""
    raw_enc = bytes(enc)
    if not raw_enc.startswith((b"v10", b"v11")):
        try:
            return raw_enc.decode("utf-8")
        except Exception:
            return ""

    pw = b"peanuts"
    if raw_enc.startswith(b"v11"):
        if app_name not in _keyring_cache:
            secret_pw = b""
            secret_tool_bin = resolve_bin("secret-tool")
            if secret_tool_bin:
                for cand_app in (app_name, "chrome", "chromium", "brave"):
                    try:
                        r = subprocess.run(
                            [secret_tool_bin, "lookup", "application", cand_app],
                            capture_output=True,
                            timeout=1.5,
                        )
                        if r.returncode == 0 and r.stdout.strip():
                            secret_pw = r.stdout.strip()
                            break
                    except Exception:
                        continue
            _keyring_cache[app_name] = secret_pw or b"peanuts"
        pw = _keyring_cache[app_name]

    key = hashlib.pbkdf2_hmac("sha1", pw, b"saltysalt", 1, 16)
    iv = b" " * 16
    ct = raw_enc[3:]
    if not ct or len(ct) % 16 != 0:
        return ""
    try:
        pt = _aes_128_cbc_decrypt_inprocess(ct, key, iv)
        if not pt:
            return ""
        # Chromium >= 130 prepends a 32-byte SHA-256 domain digest before the plaintext cookie value
        if len(pt) > 32:
            tail = pt[32:]
            try:
                s = tail.decode("utf-8")
                if s and all(32 <= ord(ch) < 127 or ch == "\t" for ch in s):
                    return s.strip()
            except Exception:
                pass
        s_full = pt.decode("utf-8", errors="ignore").strip()
        return "".join(ch for ch in s_full if 32 <= ord(ch) < 127 or ch == "\t")
    except Exception:
        return ""


def discover_from_browsers() -> dict:
    """Scan local Chrome/Chromium/Brave/Firefox/Zen SQLite history & cookies safely via RUNTIME_DIR temp copy."""
    username = ""
    identity_cookie = ""
    albums_by_url: dict[str, dict] = {}
    download_urls: list[str] = []
    cookie_subdomains: set[str] = set()

    if os.environ.get("BANDARCHY_DISABLE_BROWSER_SCAN") == "1" or os.environ.get("BANDCAMP_DISABLE_BROWSER_SCAN") == "1":
        return {
            "username": "",
            "identityCookie": "",
            "hasBrowserSession": False,
            "albums": [],
            "downloads": [],
            "subdomains": [],
        }

    history_globs = [
        os.path.join(HOME, ".config", "google-chrome", "*", "History"),
        os.path.join(HOME, ".config", "chromium", "*", "History"),
        os.path.join(HOME, ".config", "BraveSoftware", "Brave-Browser", "*", "History"),
    ]

    reserved_paths = {
        "discover", "login", "login_confirmed", "cart", "download", "article",
        "tag", "search", "settings", "fans", "artists", "labels", "about",
        "help", "terms_of_use", "privacy", "copyright", "api", "EmbeddedPlayer",
    }

    for pat in history_globs:
        for db_path in glob.glob(pat):
            if not os.path.isfile(db_path) or os.path.islink(db_path):
                continue
            tmp_path = _make_private_temp_file(prefix="ba_hist_", suffix=".sqlite")
            try:
                raw_db = safe_read_bytes(db_path, max_bytes=128 * 1024 * 1024)
                if not raw_db:
                    continue
                safe_write_bytes(tmp_path, raw_db, mode=0o600, fatal=False)
                conn = sqlite3.connect(tmp_path)
                cur = conn.cursor()
                rows = cur.execute(
                    "SELECT url, title FROM urls WHERE url LIKE '%bandcamp.com%' "
                    "ORDER BY last_visit_time DESC LIMIT 500"
                ).fetchall()
                for raw_url, raw_title in rows:
                    try:
                        parsed = urllib.parse.urlparse(raw_url)
                    except Exception:
                        continue
                    host = (parsed.netloc or "").lower()
                    path = parsed.path or ""

                    if host in ("bandcamp.com", "www.bandcamp.com"):
                        parts = [p for p in path.split("/") if p]
                        if len(parts) >= 1 and parts[0] not in reserved_paths:
                            cand = parts[0].strip()
                            if re.match(r"^[a-zA-Z0-9_-]{2,40}$", cand):
                                if len(parts) >= 2 and parts[1] in ("purchases", "wishlist", "following"):
                                    if not username:
                                        username = cand
                                elif not username and " | Bandcamp" in (raw_title or ""):
                                    username = cand
                        if path == "/download" and parsed.query:
                            if raw_url not in download_urls:
                                download_urls.append(bounded_text(raw_url, MAX_URL_CHARS))

                    elif host.endswith(".bandcamp.com") and host != "daily.bandcamp.com":
                        sub = host[: -len(".bandcamp.com")]
                        m = re.match(r"^/(album|track)/([a-zA-Z0-9_-]+)", path)
                        if m:
                            item_type = m.group(1)
                            slug = m.group(2)
                            clean_url = f"https://{host}/{item_type}/{slug}"
                            title_str = bounded_text(raw_title or "")
                            t_parts = [p.strip() for p in title_str.split("|") if p.strip()]
                            item_title = ""
                            artist_name = ""
                            if len(t_parts) >= 2:
                                item_title = t_parts[0]
                                artist_name = t_parts[1]
                            elif len(t_parts) == 1:
                                item_title = t_parts[0]
                            if not item_title or item_title.lower() in ("music", "merch", "bandcamp"):
                                item_title = slug.replace("-", " ").title()
                            if not artist_name or artist_name.lower() == "bandcamp":
                                artist_name = sub.replace("-", " ").title()

                            existing = albums_by_url.get(clean_url)
                            if not existing or (existing["title"] == slug.replace("-", " ").title() and item_title):
                                albums_by_url[clean_url] = {
                                    "url": clean_url,
                                    "title": item_title,
                                    "artist": artist_name,
                                    "subdomain": sub,
                                    "slug": slug,
                                    "itemType": item_type,
                                }
                conn.close()
            except Exception:
                pass
            finally:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass

    cookie_globs = [
        ("chrome", os.path.join(HOME, ".config", "google-chrome", "*", "Cookies")),
        ("chromium", os.path.join(HOME, ".config", "chromium", "*", "Cookies")),
        ("brave", os.path.join(HOME, ".config", "BraveSoftware", "Brave-Browser", "*", "Cookies")),
    ]
    has_identity_cookie = False
    for app_name, pat in cookie_globs:
        for db_path in glob.glob(pat):
            if not os.path.isfile(db_path) or os.path.islink(db_path):
                continue
            tmp_path = _make_private_temp_file(prefix="ba_cook_", suffix=".sqlite")
            try:
                raw_db = safe_read_bytes(db_path, max_bytes=64 * 1024 * 1024)
                if not raw_db:
                    continue
                safe_write_bytes(tmp_path, raw_db, mode=0o600, fatal=False)
                conn = sqlite3.connect(tmp_path)
                rows = conn.execute(
                    "SELECT host_key, name, value, encrypted_value FROM cookies WHERE host_key LIKE '%bandcamp.com'"
                ).fetchall()
                for host_key, name, val, enc_val in rows:
                    hk = (host_key or "").lstrip(".").lower()
                    if name == "identity" and hk == "bandcamp.com":
                        has_identity_cookie = True
                        if not identity_cookie:
                            dec = (val or "").strip() or decrypt_chromium_cookie_value(enc_val, app_name)
                            if dec:
                                identity_cookie = dec
                    if hk.endswith(".bandcamp.com") and hk != "daily.bandcamp.com":
                        cookie_subdomains.add(hk[: -len(".bandcamp.com")])
                conn.close()
            except Exception:
                pass
            finally:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass

    # Also check Firefox / Zen cookies if present
    moz_globs = [
        os.path.join(HOME, ".mozilla", "firefox", "*", "cookies.sqlite"),
        os.path.join(HOME, ".zen", "*", "cookies.sqlite"),
    ]
    for pat in moz_globs:
        for db_path in glob.glob(pat):
            if not os.path.isfile(db_path) or os.path.islink(db_path):
                continue
            tmp_path = _make_private_temp_file(prefix="ba_moz_", suffix=".sqlite")
            try:
                raw_db = safe_read_bytes(db_path, max_bytes=64 * 1024 * 1024)
                if not raw_db:
                    continue
                safe_write_bytes(tmp_path, raw_db, mode=0o600, fatal=False)
                conn = sqlite3.connect(tmp_path)
                rows = conn.execute(
                    "SELECT host, name, value FROM moz_cookies WHERE host LIKE '%bandcamp.com'"
                ).fetchall()
                for host_key, name, val in rows:
                    hk = (host_key or "").lstrip(".").lower()
                    if name == "identity" and hk == "bandcamp.com" and val:
                        has_identity_cookie = True
                        if not identity_cookie:
                            identity_cookie = str(val).strip()
                conn.close()
            except Exception:
                pass
            finally:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass

    return {
        "username": username,
        "identityCookie": identity_cookie,
        "hasBrowserSession": has_identity_cookie or bool(identity_cookie) or bool(username),
        "albums": list(albums_by_url.values()),
        "downloads": download_urls,
        "subdomains": sorted(cookie_subdomains),
    }


# --------------------------------------------------------------------------- #
# HTTP & Bandcamp Scraping / API Client
# --------------------------------------------------------------------------- #

def _is_bandcamp_cookie_host(host: str) -> bool:
    h = (host or "").lower().strip(".")
    return h in ("bandcamp.com", "127.0.0.1", "localhost", "::1") or h.endswith(".bandcamp.com")


def _is_allowed_remote_host(host: str) -> bool:
    h = (host or "").lower().strip(".")
    return (
        h in ("bandcamp.com", "bcbits.com")
        or h.endswith(".bandcamp.com")
        or h.endswith(".bcbits.com")
    )


def validate_remote_url(url: str) -> urllib.parse.ParseResult:
    """Validate that `url` targets an allowed Bandcamp/bcbits HTTPS endpoint (or localhost test server)."""
    if not url or not isinstance(url, str):
        raise BandarchyError("empty or invalid URL")
    if any(ch in url for ch in ("\r", "\n", "\x00")) or url.startswith("-"):
        raise BandarchyError("refusing URL with control characters or leading hyphen")
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https"):
        raise BandarchyError(f"unsupported URL scheme: {parsed.scheme}")
    host = (parsed.hostname or "").lower()
    if not host:
        raise BandarchyError("missing URL hostname")
    if parsed.scheme == "http":
        if host not in ("127.0.0.1", "localhost", "::1"):
            raise BandarchyError("plain HTTP is only permitted for localhost test servers")
        return parsed
    if not _is_allowed_remote_host(host):
        raise BandarchyError(f"refusing untrusted remote host: {host}")
    return parsed


def _check_resolved_ip_public(ip_str: str) -> None:
    """Reject private, loopback, link-local, or cloud-metadata IP addresses for HTTPS requests."""
    import ipaddress as _ipa
    addr = _ipa.ip_address(ip_str)
    if (
        addr.is_private
        or addr.is_loopback
        or addr.is_link_local
        or addr.is_multicast
        or addr.is_unspecified
        or addr.is_reserved
    ):
        raise BandarchyError(f"refusing private or non-global IP address: {ip_str}")


def build_cookie_header(host: str = "bandcamp.com") -> str:
    """Return Bandcamp session Cookie header strictly for bandcamp.com / *.bandcamp.com."""
    if not _is_bandcamp_cookie_host(host):
        return ""
    settings = load_settings()
    if settings.get("loggedOut"):
        return ""
    auth = read_json(AUTH_FILE, {}) or {}
    parts = []
    if auth.get("identity"):
        val = str(auth["identity"]).strip()
        val = "".join(ch for ch in val if 32 <= ord(ch) < 127 and ch not in ("\r", "\n", ";"))
        if val:
            if val.startswith("identity="):
                parts.append(val)
            else:
                parts.append(f"identity={val}")
    if auth.get("cookies"):
        c_val = "".join(ch for ch in str(auth["cookies"]).strip() if 32 <= ord(ch) < 127 and ch not in ("\r", "\n"))
        if c_val:
            parts.append(c_val)
    return "; ".join(p for p in parts if p)


def _decode_chunked(body_bytes: bytes) -> bytes:
    out = []
    pos = 0
    n = len(body_bytes)
    while pos < n:
        le = body_bytes.find(b"\r\n", pos)
        if le < 0:
            break
        line = body_bytes[pos:le].split(b";", 1)[0].strip()
        if not line:
            pos = le + 2
            continue
        try:
            sz = int(line, 16)
        except ValueError:
            break
        if sz == 0:
            break
        pos = le + 2
        out.append(body_bytes[pos : pos + sz])
        pos += sz + 2
    return b"".join(out)


def _fastly_https_exchange(
    url: str,
    method: str = "GET",
    body_bytes: bytes | None = None,
    cookie_hdr: str = "",
    timeout: float = 8.0,
    max_bytes: int = MAX_HTTP_BYTES,
    headers_only: bool = False,
) -> tuple[int, dict[str, str], bytes]:
    """Perform an HTTPS request to bandcamp.com / *.bandcamp.com / *.bcbits.com over
    Fastly's edge TLS (`server_hostname='f4.bcbits.com'` when *.bandcamp.com SNI is
    reset by middleboxes) with full CA certificate and SSRF IP verification.
    """
    parsed = validate_remote_url(url)
    host = (parsed.hostname or "").lower()
    port = parsed.port or 443
    path = (parsed.path or "/") + (("?" + parsed.query) if parsed.query else "")

    is_bc = host == "bandcamp.com" or host.endswith(".bandcamp.com")
    tls_sni = "f4.bcbits.com" if is_bc else host

    addrs = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM)
    if not addrs:
        raise BandarchyError(f"cannot resolve host: {host}")
    target_ip = addrs[0][4][0]
    _check_resolved_ip_public(target_ip)

    effective_cookie = cookie_hdr if _is_bandcamp_cookie_host(host) else ""

    ctx = ssl.create_default_context()
    with socket.create_connection((target_ip, port), timeout=timeout) as raw_sock:
        with ctx.wrap_socket(raw_sock, server_hostname=tls_sni) as ss:
            req_lines = [
                f"{method} {path} HTTP/1.1",
                f"Host: {host}",
                f"User-Agent: {USER_AGENT}",
                "Accept: text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
                "Accept-Language: en-GB,en;q=0.9",
                "Accept-Encoding: identity",
                "Connection: close",
            ]
            if effective_cookie:
                req_lines.append(f"Cookie: {effective_cookie}")
            if body_bytes is not None:
                req_lines.append("Content-Type: application/json")
                req_lines.append(f"Content-Length: {len(body_bytes)}")
            payload = ("\r\n".join(req_lines) + "\r\n\r\n").encode("utf-8") + (body_bytes or b"")
            ss.sendall(payload)

            chunks: list[bytes] = []
            total = 0
            hdr_found = False
            while True:
                chunk = ss.recv(min(65536, max_bytes + 16384 - total))
                if not chunk:
                    break
                chunks.append(chunk)
                total += len(chunk)
                if headers_only and not hdr_found and b"\r\n\r\n" in b"".join(chunks):
                    break
                if total > max_bytes + 16384:
                    raise BandarchyError(f"HTTP response exceeded maximum size ({max_bytes} bytes)")

    raw_resp = b"".join(chunks)
    sep = raw_resp.find(b"\r\n\r\n")
    if sep < 0:
        raise BandarchyError(f"invalid HTTP response from {host}")
    hdr_block = raw_resp[:sep].decode("iso-8859-1", errors="replace")
    resp_body = raw_resp[sep + 4 :]

    hdr_lines = hdr_block.splitlines()
    status_code = 200
    if hdr_lines:
        parts = hdr_lines[0].split()
        if len(parts) >= 2 and parts[1].isdigit():
            status_code = int(parts[1])

    resp_headers: dict[str, str] = {}
    for line in hdr_lines[1:]:
        if ":" in line:
            k, v = line.split(":", 1)
            resp_headers[k.strip().lower()] = v.strip()

    if not headers_only and "chunked" in resp_headers.get("transfer-encoding", "").lower():
        resp_body = _decode_chunked(resp_body)

    if len(resp_body) > max_bytes:
        raise BandarchyError(f"HTTP response exceeded maximum size ({max_bytes} bytes)")

    return status_code, resp_headers, resp_body


def resolve_stream_redirect(url: str, timeout: float = 6.0) -> str:
    """If `url` is a Bandcamp `stream_redirect` or subdomain track URL, resolve its
    302 Location to the direct `https://t4.bcbits.com/stream/...` audio stream URL so
    mpv can stream directly without hitting SNI resets on `bandcamp.com`.
    """
    if not url or not url.startswith("https://"):
        return url
    try:
        parsed = validate_remote_url(url)
    except BandarchyError:
        return url
    host = (parsed.hostname or "").lower()
    if not (host == "bandcamp.com" or host.endswith(".bandcamp.com")):
        return url
    if "stream_redirect" not in (parsed.path or "") and "/download" not in (parsed.path or ""):
        return url
    try:
        cookie_hdr = build_cookie_header(host)
        status, hdrs, _ = _fastly_https_exchange(
            url,
            method="GET",
            cookie_hdr=cookie_hdr,
            timeout=timeout,
            headers_only=True,
        )
        if status in (301, 302, 303, 307, 308) and hdrs.get("location"):
            loc = hdrs["location"]
            if loc.startswith("//"):
                loc = "https:" + loc
            elif loc.startswith("/"):
                loc = f"https://{host}{loc}"
            validate_remote_url(loc)
            return bounded_text(loc, MAX_URL_CHARS)
    except Exception:
        pass
    return url


def http_request(
    url: str,
    method: str = "GET",
    json_body: dict | None = None,
    timeout: float = 8.0,
    max_bytes: int = MAX_HTTP_BYTES,
    on_chunk=None,
) -> bytes:
    parsed = validate_remote_url(url)
    host = (parsed.hostname or "").lower()
    cookie_hdr = build_cookie_header(host)
    body_bytes = None
    if json_body is not None:
        body_bytes = json.dumps(json_body).encode("utf-8")

    is_bandcamp_https = parsed.scheme == "https" and (
        host == "bandcamp.com" or host.endswith(".bandcamp.com")
    )

    # Use Fastly SNI transport first for live Bandcamp HTTPS hosts to avoid SNI TCP resets
    if is_bandcamp_https:
        cur_url = url
        cur_method = method
        cur_body = body_bytes
        for _ in range(6):
            try:
                p_cur = validate_remote_url(cur_url)
                cur_host = (p_cur.hostname or "").lower()
                status, hdrs, resp_body = _fastly_https_exchange(
                    cur_url,
                    method=cur_method,
                    body_bytes=cur_body,
                    cookie_hdr=build_cookie_header(cur_host),
                    timeout=timeout,
                    max_bytes=max_bytes,
                )
                if status in (301, 302, 303, 307, 308) and hdrs.get("location"):
                    loc = hdrs["location"]
                    if loc.startswith("//"):
                        loc = f"{p_cur.scheme}:{loc}"
                    elif loc.startswith("/"):
                        loc = f"{p_cur.scheme}://{p_cur.netloc}{loc}"
                    p_next = validate_remote_url(loc)
                    cur_url = loc
                    if status in (301, 302, 303):
                        cur_method = "GET"
                        cur_body = None
                    nhost = (p_next.hostname or "").lower()
                    if not (nhost == "bandcamp.com" or nhost.endswith(".bandcamp.com")):
                        url = cur_url
                        parsed = p_next
                        host = nhost
                        cookie_hdr = build_cookie_header(host)
                        method = cur_method
                        body_bytes = cur_body
                        break
                    continue
                if 200 <= status < 400 and resp_body is not None:
                    if on_chunk:
                        try:
                            on_chunk(len(resp_body), len(resp_body))
                        except Exception:
                            pass
                    return resp_body
                break
            except BandarchyError:
                raise
            except Exception:
                break

    if parsed.scheme == "https":
        addrs = socket.getaddrinfo(host, parsed.port or 443, socket.AF_INET, socket.SOCK_STREAM)
        if not addrs:
            raise BandarchyError(f"cannot resolve host: {host}")
        _check_resolved_ip_public(addrs[0][4][0])

    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-GB,en;q=0.9",
    }
    if cookie_hdr and _is_bandcamp_cookie_host(host):
        headers["Cookie"] = cookie_hdr
    if body_bytes is not None:
        headers["Content-Type"] = "application/json"

    class _SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, hdrs, newurl):
            p_new = validate_remote_url(newurl)
            new_host = (p_new.hostname or "").lower()
            if p_new.scheme == "https":
                r_addrs = socket.getaddrinfo(new_host, p_new.port or 443, socket.AF_INET, socket.SOCK_STREAM)
                if not r_addrs:
                    raise BandarchyError(f"cannot resolve redirect host: {new_host}")
                _check_resolved_ip_public(r_addrs[0][4][0])
            new_req = super().redirect_request(req, fp, code, msg, hdrs, newurl)
            if new_req is not None and not _is_bandcamp_cookie_host(new_host):
                new_req.headers.pop("Cookie", None)
                new_req.unredirected_hdrs.pop("Cookie", None)
            return new_req

    opener = urllib.request.build_opener(_SafeRedirectHandler)
    try:
        req = urllib.request.Request(url, data=body_bytes, headers=headers, method=method)
        with opener.open(req, timeout=timeout) as resp:
            content_len = 0
            try:
                content_len = int(resp.headers.get("Content-Length") or 0)
            except Exception:
                content_len = 0
            if content_len > max_bytes:
                raise BandarchyError("HTTP response exceeded maximum size")
            chunks = []
            total = 0
            last_report = 0.0
            while True:
                chunk = resp.read(min(65536, max_bytes + 1 - total))
                if not chunk:
                    break
                chunks.append(chunk)
                total += len(chunk)
                if total > max_bytes:
                    raise BandarchyError("HTTP response exceeded maximum size")
                if on_chunk:
                    now_t = time.monotonic()
                    if now_t - last_report >= 0.15 or (content_len and total >= content_len):
                        last_report = now_t
                        try:
                            on_chunk(total, content_len)
                        except Exception:
                            pass
            return b"".join(chunks)
    except BandarchyError:
        raise
    except urllib.error.HTTPError as err:
        try:
            _ = err.read(65536)
        except Exception:
            pass
        raise BandarchyError(f"HTTP {err.code} from {parsed.netloc}")
    except Exception as urllib_exc:
        raise BandarchyError(f"cannot reach {parsed.netloc}: {urllib_exc}")


def download_file(
    url: str,
    dest_path: str,
    timeout: float = 45.0,
    max_bytes: int = MAX_DOWNLOAD_BYTES,
    on_chunk=None,
) -> str:
    """Stream a remote URL to a private temporary file with strict `max_bytes` ceiling,
    unlinking the temporary file immediately if `total_read > max_bytes`, then atomically
    replacing `dest_path`.
    """
    parsed = validate_remote_url(url)
    host = (parsed.hostname or "").lower()
    if parsed.scheme == "https" and (host == "bandcamp.com" or host.endswith(".bandcamp.com")):
        url = resolve_stream_redirect(url, timeout=min(timeout, 8.0))
        parsed = validate_remote_url(url)
        host = (parsed.hostname or "").lower()

    if parsed.scheme == "https":
        addrs = socket.getaddrinfo(host, parsed.port or 443, socket.AF_INET, socket.SOCK_STREAM)
        if not addrs:
            raise BandarchyError(f"cannot resolve host: {host}")
        _check_resolved_ip_public(addrs[0][4][0])

    cookie_hdr = build_cookie_header(host)
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "*/*",
        "Accept-Language": "en-GB,en;q=0.9",
    }
    if cookie_hdr and _is_bandcamp_cookie_host(host):
        headers["Cookie"] = cookie_hdr

    class _SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, hdrs, newurl):
            p_new = validate_remote_url(newurl)
            new_host = (p_new.hostname or "").lower()
            if p_new.scheme == "https":
                r_addrs = socket.getaddrinfo(new_host, p_new.port or 443, socket.AF_INET, socket.SOCK_STREAM)
                if not r_addrs:
                    raise BandarchyError(f"cannot resolve redirect host: {new_host}")
                _check_resolved_ip_public(r_addrs[0][4][0])
            new_req = super().redirect_request(req, fp, code, msg, hdrs, newurl)
            if new_req is not None and not _is_bandcamp_cookie_host(new_host):
                new_req.headers.pop("Cookie", None)
                new_req.unredirected_hdrs.pop("Cookie", None)
            return new_req

    abs_dest = os.path.abspath(dest_path)
    target_dir = os.path.dirname(abs_dest)
    ensure_private_dir(target_dir)
    if os.path.lexists(abs_dest):
        st_existing = os.lstat(abs_dest)
        if stat.S_ISLNK(st_existing.st_mode) or st_existing.st_uid != os.getuid():
            raise BandarchyError(f"refusing unsafe destination file: {abs_dest}")

    fd, tmp_path = tempfile.mkstemp(
        prefix=f".{os.path.basename(abs_dest)}.",
        suffix=".part",
        dir=target_dir,
    )
    opener = urllib.request.build_opener(_SafeRedirectHandler)
    try:
        os.fchmod(fd, 0o600)
        req = urllib.request.Request(url, headers=headers, method="GET")
        with opener.open(req, timeout=timeout) as resp:
            content_len = 0
            try:
                content_len = int(resp.headers.get("Content-Length") or 0)
            except Exception:
                content_len = 0
            if content_len > max_bytes:
                raise BandarchyError("Download exceeded maximum size")
            total_read = 0
            last_report = 0.0
            while True:
                chunk = resp.read(min(65536, max_bytes + 1 - total_read))
                if not chunk:
                    break
                total_read += len(chunk)
                if total_read > max_bytes:
                    raise BandarchyError("Download exceeded maximum size")
                os.write(fd, chunk)
                if on_chunk:
                    now_t = time.monotonic()
                    if now_t - last_report >= 0.15 or (content_len and total_read >= content_len):
                        last_report = now_t
                        try:
                            on_chunk(total_read, content_len)
                        except Exception:
                            pass
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(tmp_path, abs_dest)
        tmp_path = ""
        return abs_dest
    except Exception as exc:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp_path and os.path.lexists(tmp_path):
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        if isinstance(exc, BandarchyError):
            raise
        raise BandarchyError(f"download failed for {parsed.netloc}: {exc}")


def extract_attr_json(page_html: str, attr_name: str) -> dict | None:
    for quote in ('"', "'"):
        pattern = rf'{re.escape(attr_name)}\s*=\s*{quote}([^{quote}]+){quote}'
        m = re.search(pattern, page_html)
        if m:
            raw = html.unescape(m.group(1))
            try:
                data = json.loads(raw)
                if isinstance(data, dict):
                    return data
            except Exception:
                continue
    return None


def art_url_from_id(art_id, size: int = 10, api_base: str = "https://bandcamp.com") -> str:
    if not art_id:
        return ""
    s = str(art_id).strip()
    if s.startswith(("http://", "https://")):
        return bounded_text(s, MAX_URL_CHARS)
    if not s.isdigit():
        return ""
    if api_base.startswith("http://127.0.0.1") or api_base.startswith("http://localhost"):
        return f"{api_base.rstrip('/')}/img/a{s.zfill(10)}_{size}.jpg"
    return f"https://f4.bcbits.com/img/a{s.zfill(10)}_{size}.jpg"


def fetch_fan_collection(username: str, api_base: str = "https://bandcamp.com") -> list[dict]:
    base = api_base.rstrip("/")
    profile_url = f"{base}/{urllib.parse.quote(username.strip())}" if username else base
    raw = http_request(profile_url, timeout=10.0)
    page = raw.decode("utf-8", errors="replace")
    blob = extract_attr_json(page, "data-blob")
    if not blob:
        return []

    fan_data = blob.get("fan_data") or {}
    fan_id = fan_data.get("fan_id")
    coll_data = blob.get("collection_data") or {}
    redownload_urls = dict(coll_data.get("redownload_urls") or {})
    item_cache = (blob.get("item_cache") or {}).get("collection") or {}
    tracklists = dict((blob.get("tracklists") or {}).get("collection") or {})

    raw_items: list[tuple[str, dict]] = []
    sequence = coll_data.get("sequence") or coll_data.get("small_collection") or list(item_cache.keys())
    seen_keys: set[str] = set()
    for key in sequence:
        item = item_cache.get(str(key))
        if isinstance(item, dict):
            seen_keys.add(str(key))
            raw_items.append((str(key), item))
    for k, item in item_cache.items():
        if str(k) not in seen_keys and isinstance(item, dict):
            seen_keys.add(str(k))
            raw_items.append((str(k), item))

    last_token = coll_data.get("last_token")
    more_available = bool(coll_data.get("more_available") or last_token)

    pages = 0
    while fan_id and last_token and more_available and pages < 35 and len(raw_items) < MAX_COLLECTION_ITEMS:
        pages += 1
        try:
            api_raw = http_request(
                f"{base}/api/fancollection/1/collection_items",
                method="POST",
                json_body={
                    "fan_id": fan_id,
                    "older_than_token": last_token,
                    "count": 100,
                },
                timeout=10.0,
            )
            api_data = json.loads(api_raw.decode("utf-8", errors="replace"))
        except Exception:
            break
        if not isinstance(api_data, dict):
            break
        redownload_urls.update(api_data.get("redownload_urls") or {})
        tracklists.update(api_data.get("tracklists") or {})
        batch = api_data.get("items") or []
        if not batch:
            break
        for b_item in batch:
            if not isinstance(b_item, dict):
                continue
            raw_t = str(b_item.get("item_type") or "a")
            prefix = "p" if raw_t == "package" else ("t" if raw_t in ("track", "t") else "a")
            b_key = f"{prefix}{b_item.get('item_id') or b_item.get('tralbum_id') or ''}"
            raw_items.append((b_key, b_item))
        more_available = bool(api_data.get("more_available"))
        last_token = api_data.get("last_token")

    parsed_by_dedup: dict[str, dict] = {}
    ordered_keys: list[str] = []

    for cache_key, item in raw_items[:MAX_COLLECTION_ITEMS]:
        if not isinstance(item, dict):
            continue
        raw_item_id = str(item.get("item_id") or "")
        tralbum_id = str(item.get("tralbum_id") or raw_item_id or "")
        item_id = raw_item_id or tralbum_id
        raw_type = str(item.get("item_type") or item.get("tralbum_type") or "album").lower()
        tralbum_type = str(item.get("tralbum_type") or "").lower()
        if raw_type in ("a", "album", "package", "p"):
            item_type = "track" if tralbum_type == "t" else "album"
        elif raw_type in ("t", "track"):
            item_type = "track"
        else:
            item_type = "album"

        title = bounded_text(item.get("item_title") or item.get("title") or "Untitled")
        artist = bounded_text(item.get("band_name") or item.get("artist") or "Unknown Artist")
        item_url = bounded_text(item.get("item_url") or "", MAX_URL_CHARS)
        art_id = item.get("item_art_id") or item.get("art_id") or ""
        sale_id = item.get("sale_item_id")
        sale_type = item.get("sale_item_type") or "p"
        dl_url = ""
        if sale_id:
            dl_url = (
                redownload_urls.get(f"{sale_type}{sale_id}")
                or redownload_urls.get(f"p{sale_id}")
                or redownload_urls.get(f"c{sale_id}")
                or ""
            )
        if not dl_url and raw_item_id:
            dl_url = redownload_urls.get(raw_item_id) or redownload_urls.get(f"p{raw_item_id}") or ""
        if not dl_url and item_id:
            dl_url = redownload_urls.get(item_id) or ""

        # Resolve full tracklist from blob/API tracklists map
        tl_entries = (
            tracklists.get(cache_key)
            or tracklists.get(f"p{raw_item_id}")
            or tracklists.get(f"a{tralbum_id}")
            or tracklists.get(f"a{raw_item_id}")
            or tracklists.get(f"t{tralbum_id}")
            or tracklists.get(f"t{raw_item_id}")
            or []
        )

        tracks: list[dict] = []
        if isinstance(tl_entries, list) and tl_entries:
            for idx_t, t_obj in enumerate(tl_entries, start=1):
                if not isinstance(t_obj, dict):
                    continue
                file_map = t_obj.get("file") or {}
                t_stream = ""
                if isinstance(file_map, dict):
                    t_stream = (
                        file_map.get("mp3-v0")
                        or file_map.get("mp3-128")
                        or next(iter(file_map.values()), "")
                    )
                if t_stream and t_stream.startswith("//"):
                    t_stream = "https:" + t_stream
                t_id = str(t_obj.get("id") or t_obj.get("track_id") or f"{item_id}-{idx_t}")
                tracks.append({
                    "id": f"bc-track-{t_id}",
                    "title": bounded_text(t_obj.get("title") or f"Track {idx_t}"),
                    "artist": bounded_text(t_obj.get("artist") or artist),
                    "album": title,
                    "index": bounded_int(t_obj.get("track_number") or idx_t, idx_t),
                    "duration": bounded_float(t_obj.get("duration") or 0.0),
                    "streamUrl": bounded_text(t_stream, MAX_URL_CHARS),
                    "localPath": "",
                    "itemUrl": item_url,
                })

        if not tracks:
            feat_title = bounded_text(item.get("featured_track_title") or "")
            stream_url = bounded_text(item.get("featured_track_url") or "", MAX_URL_CHARS)
            if feat_title or item_url:
                tracks.append({
                    "id": f"bc-track-{item.get('featured_track') or item_id or slugify(title)}-1",
                    "title": feat_title or title,
                    "artist": artist,
                    "album": title,
                    "index": bounded_int(item.get("featured_track_number") or 1, 1),
                    "duration": bounded_float(item.get("featured_track_duration") or 0),
                    "streamUrl": stream_url,
                    "localPath": "",
                    "itemUrl": item_url,
                })

        total_dur = round(sum(float(t.get("duration") or 0.0) for t in tracks), 1)
        album_entry = {
            "id": f"bc-{item_type}-{item_id}" if item_id else f"bc-{slugify(artist)}-{slugify(title)}",
            "itemId": item_id,
            "tralbumId": tralbum_id,
            "itemType": item_type,
            "title": title,
            "artist": artist,
            "url": item_url,
            "artUrl": art_url_from_id(art_id, api_base=api_base),
            "artPath": "",
            "redownloadUrl": bounded_text(dl_url, MAX_URL_CHARS),
            "purchased": True,
            "isLocal": False,
            "localPath": "",
            "audioFormat": "Bandcamp Stream",
            "totalDuration": total_dur,
            "numTracks": max(len(tracks), bounded_int(item.get("num_streamable_tracks") or len(tracks), len(tracks))),
            "tracks": tracks,
            "fold": fold(f"{artist} {title}"),
        }

        dedup_key = f"bc-{item_type}-{raw_item_id or tralbum_id}" if (raw_item_id or tralbum_id) else f"{fold(artist)}::{fold(title)}"
        if dedup_key in parsed_by_dedup:
            existing = parsed_by_dedup[dedup_key]
            if len(tracks) > len(existing.get("tracks") or []):
                existing["tracks"] = tracks
                existing["numTracks"] = max(existing["numTracks"], len(tracks))
                existing["totalDuration"] = total_dur
            if dl_url and not existing.get("redownloadUrl"):
                existing["redownloadUrl"] = bounded_text(dl_url, MAX_URL_CHARS)
            if album_entry["artUrl"] and not existing.get("artUrl"):
                existing["artUrl"] = album_entry["artUrl"]
        else:
            parsed_by_dedup[dedup_key] = album_entry
            ordered_keys.append(dedup_key)

    return [parsed_by_dedup[k] for k in ordered_keys]


def fetch_album_details(item_url: str, api_base: str = "https://bandcamp.com") -> dict | None:
    if not item_url:
        return None
    try:
        raw = http_request(item_url, timeout=8.0)
        page = raw.decode("utf-8", errors="replace")
    except Exception:
        return None

    tralbum = extract_attr_json(page, "data-tralbum")
    if not tralbum:
        return None

    current = tralbum.get("current") or {}
    title = bounded_text(current.get("title") or tralbum.get("album_title") or "Untitled")
    artist = bounded_text(tralbum.get("artist") or current.get("artist") or "Unknown Artist")
    art_id = tralbum.get("art_id") or current.get("art_id") or ""
    item_id = str(current.get("id") or tralbum.get("id") or "")
    item_type = str(tralbum.get("item_type") or "album")

    tracks = []
    for idx, t in enumerate(tralbum.get("trackinfo") or [], start=1):
        if not isinstance(t, dict):
            continue
        file_map = t.get("file") or {}
        stream = ""
        if isinstance(file_map, dict):
            stream = file_map.get("mp3-128") or file_map.get("mp3-v0") or next(iter(file_map.values()), "")
        if stream and stream.startswith("//"):
            stream = "https:" + stream
        t_title = bounded_text(t.get("title") or f"Track {idx}")
        t_link = t.get("title_link") or ""
        if t_link and t_link.startswith("/"):
            parsed_u = urllib.parse.urlparse(item_url)
            t_link = f"{parsed_u.scheme}://{parsed_u.netloc}{t_link}"
        tracks.append({
            "id": f"bc-track-{t.get('track_id') or t.get('id') or idx}",
            "title": t_title,
            "artist": bounded_text(t.get("artist") or artist),
            "album": title,
            "index": bounded_int(t.get("track_num") or idx, idx),
            "duration": bounded_float(t.get("duration") or 0.0),
            "streamUrl": bounded_text(stream, MAX_URL_CHARS),
            "localPath": "",
            "itemUrl": bounded_text(t_link or item_url, MAX_URL_CHARS),
        })

    return {
        "id": f"bc-{item_type}-{item_id}" if item_id else f"bc-{slugify(artist)}-{slugify(title)}",
        "itemId": item_id,
        "itemType": item_type,
        "title": title,
        "artist": artist,
        "url": bounded_text(item_url, MAX_URL_CHARS),
        "artUrl": art_url_from_id(art_id, api_base=api_base),
        "tracks": tracks,
        "numTracks": len(tracks),
    }


# --------------------------------------------------------------------------- #
# Artwork Generation, Caching & Omarchy ASCII Transcoding
# --------------------------------------------------------------------------- #

PsychedelicPalettes = [
    ("#ff007f", "#7928ca", "#00f0ff"),
    ("#00f5d4", "#7b2cbf", "#ff9e00"),
    ("#ffbe0b", "#fb5607", "#ff006e"),
    ("#8338ec", "#3a86ff", "#06d6a0"),
    ("#f72585", "#7209b7", "#4cc9f0"),
]


def ensure_cover_svg(album_id: str, artist: str, title: str) -> str:
    """Create a high-contrast geometric SVG sleeve that both looks great in QML
    and transcodes cleanly into Braille/Block art via omarchy-transcode-ascii.
    """
    ensure_private_dir(ART_DIR)
    digest = hashlib.sha256(f"{album_id}:{artist}:{title}".encode("utf-8")).hexdigest()
    target = os.path.join(ART_DIR, f"v2_{digest[:22]}.svg")
    if os.path.exists(target) and os.path.getsize(target) > 0:
        return target

    pal = PsychedelicPalettes[int(digest[:2], 16) % len(PsychedelicPalettes)]
    petals = 6 + (int(digest[2:4], 16) % 4) * 2
    rings = 3 + (int(digest[4:6], 16) % 3)

    shapes = []
    # High-contrast sacred geometry rays and concentric rings on transparent/dark canvas
    for p in range(petals):
        ang = (p / petals) * 360.0
        shapes.append(
            f'<ellipse cx="250" cy="250" rx="185" ry="52" fill="none" '
            f'stroke="{pal[p % 3]}" stroke-width="14" transform="rotate({ang:.1f} 250 250)"/>'
        )
    for r in range(rings):
        rad = 65 + r * 58
        shapes.append(
            f'<circle cx="250" cy="250" r="{rad}" fill="none" stroke="#ffffff" '
            f'stroke-width="12" stroke-dasharray="{24 + r * 10} {16 + r * 8}"/>'
        )
    svg = f"""<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <circle cx="250" cy="250" r="236" fill="none" stroke="{pal[0]}" stroke-width="16"/>
  {''.join(shapes)}
  <circle cx="250" cy="250" r="38" fill="{pal[2]}"/>
</svg>
"""
    atomic_write(target, svg.encode("utf-8"), 0o600, fatal=False)
    return target


def cache_remote_art(art_url: str, album_id: str, artist: str, title: str) -> str:
    ensure_private_dir(ART_DIR)
    if art_url:
        digest = hashlib.sha256(art_url.encode("utf-8")).hexdigest()[:24]
        ext = ".png" if ".png" in art_url.lower() else ".jpg"
        target = os.path.join(ART_DIR, f"art_{digest}{ext}")
        if os.path.exists(target) and os.path.getsize(target) > 0:
            return target
        try:
            download_file(art_url, target, timeout=5.0, max_bytes=MAX_ART_BYTES)
            if os.path.isfile(target) and os.path.getsize(target) > 64:
                return target
        except Exception:
            pass
    return ensure_cover_svg(album_id, artist, title)


def transcode_image_to_ascii(
    image_path: str,
    width: int = 72,
    height: int = 32,
    mode: str = "braille",
    threshold: int = 50,
    invert: bool = False,
) -> list[str]:
    """Use Omarchy's `omarchy-transcode-ascii` module to convert album cover art
    into screensaver-style Braille or Block Unicode text art.
    """
    ensure_private_dir(ASCII_DIR)
    width = bounded_int(width, 72, 20, 160)
    height = bounded_int(height, 32, 10, 80)
    mode = "block" if mode == "block" else "braille"
    threshold = bounded_int(threshold, 50, 10, 90)

    if not image_path or not os.path.isfile(image_path):
        return []

    abs_image = os.path.abspath(image_path)
    stat_sig = f"{abs_image}:{os.path.getmtime(abs_image):.0f}:{width}:{height}:{mode}:{threshold}:{invert}"
    cache_key = hashlib.sha256(stat_sig.encode("utf-8")).hexdigest()[:24]
    cached_txt = os.path.abspath(os.path.join(ASCII_DIR, f"art_{cache_key}.txt"))

    cached_content = safe_read_text(cached_txt, max_bytes=2 * 1024 * 1024)
    if cached_content:
        return [line.rstrip("\n") for line in cached_content.splitlines()]

    if TRANSCODE_ASCII_BIN and os.path.isfile(TRANSCODE_ASCII_BIN):
        cmd = [
            TRANSCODE_ASCII_BIN,
            abs_image,
            cached_txt,
            "--width",
            str(width),
            "--height",
            str(height),
            "--mode",
            mode,
            "--threshold",
            str(threshold),
        ]
        if invert:
            cmd.append("--invert")
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                out_txt = safe_read_text(cached_txt, max_bytes=2 * 1024 * 1024)
                if out_txt:
                    lines = [line.rstrip("\n") for line in out_txt.splitlines()]
                    if lines:
                        return lines
        except Exception:
            pass
    return []


def _compress_ascii_block(lines: list[str], max_width: int = 68) -> list[str]:
    """Horizontally compress an omarchy-ascii banner block so its width never exceeds
    `max_width`, preserving the first and last letters without left/right clipping.
    """
    lines = [l.rstrip("\r\n") for l in lines if l.strip()]
    if not lines:
        return []
    min_lead = min((len(l) - len(l.lstrip(" ")) for l in lines if l.strip()), default=0)
    if min_lead > 0:
        lines = [l[min_lead:].rstrip() for l in lines]
    w = max((len(l) for l in lines), default=0)
    if w <= max_width:
        return lines

    grid = [list(l.ljust(w)) for l in lines]
    h = len(grid)
    cols = [[grid[r][c] for r in range(h)] for c in range(w)]

    # Pass 1: collapse runs of >1 blank columns down to 1 blank column while wider than max_width
    i = 1
    while i < len(cols) and len(cols) > max_width:
        if all(ch == " " for ch in cols[i]) and all(ch == " " for ch in cols[i - 1]):
            cols.pop(i)
        else:
            i += 1

    # Pass 2: thin 3-in-a-row identical columns to 2, then 2-in-a-row to 1 uniformly
    for require_triple in (True, False):
        while len(cols) > max_width:
            dup_indices = [
                idx
                for idx in range(1, len(cols) - 1)
                if cols[idx] == cols[idx - 1] and (not require_triple or cols[idx] == cols[idx + 1])
            ]
            if not dup_indices:
                break
            cols.pop(dup_indices[len(dup_indices) // 2])

    # Pass 3: uniform column decimation if still wider than max_width
    if len(cols) > max_width:
        cols = [cols[int(round(idx * (len(cols) - 1) / (max_width - 1)))] for idx in range(max_width)]

    return ["".join(cols[c][r] for c in range(len(cols))).rstrip() for r in range(h)]


def _run_omarchy_ascii_raw(text_line: str) -> list[str]:
    if not OMARCHY_ASCII_BIN or not os.path.isfile(OMARCHY_ASCII_BIN):
        return []
    try:
        r = subprocess.run(
            [OMARCHY_ASCII_BIN, "--", text_line],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if r.returncode != 0 or not r.stdout.strip():
            r = subprocess.run(
                [OMARCHY_ASCII_BIN, text_line],
                capture_output=True,
                text=True,
                timeout=5,
            )
        if r.returncode == 0 and r.stdout.strip():
            return [l.rstrip("\r\n") for l in r.stdout.splitlines() if l.strip()]
    except Exception:
        pass
    return []


def render_omarchy_ascii_banner(text: str, max_width: int = 68) -> list[str]:
    """Render text in Omarchy's Delta Corps Priest 1 logo font via `omarchy-ascii`,
    automatically wrapping multi-word titles and compressing columns so long names
    (e.g. 'BASS COMMUNION') fit completely within `max_width` without clipping.
    """
    ensure_private_dir(ASCII_DIR)
    max_width = bounded_int(max_width, 68, 32, 140)
    raw_text = str(text or "BANDARCHY").strip()
    segments = [
        re.sub(r"\s+", " ", re.sub(r"[^a-zA-Z0-9 ]+", " ", seg)).strip().upper()[:48]
        for seg in re.split(r"\s+(?:—|--|-|\|)\s+", raw_text)
    ]
    segments = [s for s in segments if s][:3]
    clean_words = re.sub(r"[^a-zA-Z0-9 ]+", " ", raw_text).strip().upper()
    clean_words = re.sub(r"\s+", " ", clean_words)[:120] or "BANDARCHY"

    cache_sig = " || ".join(segments) if len(segments) >= 2 else clean_words
    cache_key = hashlib.sha256(f"v3:{max_width}:{cache_sig}".encode("utf-8")).hexdigest()[:20]
    cached_txt = os.path.join(ASCII_DIR, f"banner_{cache_key}.txt")
    cached_content = safe_read_text(cached_txt, max_bytes=2 * 1024 * 1024)
    if cached_content:
        return [line.rstrip("\n") for line in cached_content.splitlines()]

    if len(segments) >= 2:
        blocks = []
        for seg in segments:
            b = _compress_ascii_block(_run_omarchy_ascii_raw(seg), max_width=max_width)
            if b:
                blocks.append(b)
        if blocks:
            mw = max((max((len(l) for l in b), default=0) for b in blocks), default=0)
            lines: list[str] = []
            for bi, b in enumerate(blocks):
                if bi > 0:
                    lines.append("")
                bw = max((len(l) for l in b), default=0)
                pad = " " * max(0, (mw - bw) // 2)
                lines.extend(pad + l for l in b)
            atomic_write(cached_txt, ("\n".join(lines) + "\n").encode("utf-8"), 0o600, fatal=False)
            return lines

    raw_single = _run_omarchy_ascii_raw(clean_words)
    if raw_single:
        single_w = max((len(l) for l in raw_single), default=0)
        words = clean_words.split(" ")
        if single_w > max_width and len(words) >= 2:
            # Split words into 2 balanced lines so each line stays crisp and legible
            best_split = 1
            best_diff = 9999
            for sp in range(1, len(words)):
                left_len = len(" ".join(words[:sp]))
                right_len = len(" ".join(words[sp:]))
                diff = abs(left_len - right_len)
                if diff < best_diff:
                    best_diff = diff
                    best_split = sp
            line1_str = " ".join(words[:best_split])
            line2_str = " ".join(words[best_split:])
            b1 = _compress_ascii_block(_run_omarchy_ascii_raw(line1_str), max_width=max_width)
            b2 = _compress_ascii_block(_run_omarchy_ascii_raw(line2_str), max_width=max_width)
            if b1 and b2:
                w1 = max((len(l) for l in b1), default=0)
                w2 = max((len(l) for l in b2), default=0)
                mw = max(w1, w2)
                pad1 = " " * max(0, (mw - w1) // 2)
                pad2 = " " * max(0, (mw - w2) // 2)
                lines = [pad1 + l for l in b1] + [""] + [pad2 + l for l in b2]
            else:
                lines = _compress_ascii_block(raw_single, max_width=max_width)
        else:
            lines = _compress_ascii_block(raw_single, max_width=max_width)

        if lines:
            atomic_write(cached_txt, ("\n".join(lines) + "\n").encode("utf-8"), 0o600, fatal=False)
            return lines

    # Fallback to Omarchy's screensaver.txt or logo.txt
    for candidate in (
        os.path.join(HOME, ".config", "omarchy", "branding", "screensaver.txt"),
        os.path.join(HOME, "omarchy", "logo.txt"),
        "/usr/share/omarchy/logo.txt",
    ):
        cand_txt = safe_read_text(candidate, max_bytes=512 * 1024)
        if cand_txt:
            raw_fb = [l.rstrip("\n") for l in cand_txt.splitlines()]
            return _compress_ascii_block(raw_fb, max_width=max_width) or raw_fb
    return [clean_words]


def extract_ttfx_frames(
    screensaver_txt_path: str,
    width: int = 68,
    height: int = 30,
    effect: str = "waves",
    max_frames: int = 28,
) -> list[list[str]]:
    """Run Omarchy's `/usr/bin/ttfx` screensaver engine in instant headless mode
    (`--frame-rate 0 --no-color --ignore-terminal-dimensions`) on the transcoded
    album cover art (or Omarchy banner) and sample keyframes across the effect
    lifecycle so the QML visualiser manipulates genuine `ttfx` frames as the song plays.
    """
    if not TTFX_BIN or not os.path.isfile(TTFX_BIN) or not os.path.isfile(screensaver_txt_path):
        return []

    effect = (effect or "random").lower()
    if effect not in TTFX_EFFECTS or effect == "random":
        non_random = [e for e in TTFX_EFFECTS if e != "random"]
        effect = secrets.choice(non_random) if non_random else "waves"

    width = bounded_int(width, 68, 20, 140)
    height = bounded_int(height, 30, 10, 70)
    max_frames = bounded_int(max_frames, 28, 6, 64)

    raw_ss = safe_read_bytes(screensaver_txt_path, max_bytes=2 * 1024 * 1024)
    if not raw_ss:
        return []
    txt_hash = hashlib.sha256(raw_ss).hexdigest()[:20]

    ensure_private_dir(ASCII_DIR)
    cache_key = hashlib.sha256(
        f"{txt_hash}:{width}:{height}:{effect}:{max_frames}".encode("utf-8")
    ).hexdigest()[:24]
    cache_path = os.path.join(ASCII_DIR, f"ttfx_{cache_key}.json")

    cached = read_json(cache_path, None)
    if isinstance(cached, list) and cached:
        return cached

    cmd = [
        TTFX_BIN,
        "-i",
        os.path.abspath(screensaver_txt_path),
        "--ignore-terminal-dimensions",
        "--canvas-width",
        str(width),
        "--canvas-height",
        str(height),
        "--frame-rate",
        "0",
        "--no-color",
        "--anchor-canvas",
        "c",
        "--anchor-text",
        "c",
        "--seed",
        "42",
        effect,
    ]
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=4)
        if r.returncode != 0 or not r.stdout:
            return []
        raw_text = r.stdout.decode("utf-8", errors="replace")
        chunks = re.split(r"\x1b\[\d+A", raw_text)
        ansi_re = re.compile(r"\x1b\[[?0-9;]*[a-zA-Z]|\x1b[78]")
        frames: list[list[str]] = []
        for ch in chunks:
            cleaned = ansi_re.sub("", ch)
            flines = [l.rstrip("\r") for l in cleaned.splitlines()[:height]]
            if any(l.strip() for l in flines):
                frames.append(flines)
        if not frames:
            return []
        if len(frames) <= max_frames:
            sampled = frames
        else:
            sampled = [
                frames[min(len(frames) - 1, int(round(i * (len(frames) - 1) / (max_frames - 1))))]
                for i in range(max_frames)
            ]
        write_json(cache_path, sampled, mode=0o600)
        return sampled
    except Exception:
        return []


# --------------------------------------------------------------------------- #
# Local Music & Bandcamp ZIP Scanner
# --------------------------------------------------------------------------- #

def parse_track_filename(filename: str, fallback_artist: str, fallback_album: str, default_idx: int) -> tuple[int, str, str]:
    stem = os.path.splitext(filename)[0].strip()
    m_bc = re.match(r"^(.+?)\s+-\s+(.+?)\s+-\s+(\d{1,3})[\s._-]+(.+)$", stem)
    if m_bc:
        return int(m_bc.group(3)), bounded_text(m_bc.group(4)), bounded_text(m_bc.group(1))

    m_num = re.match(r"^(\d{1,3})(?:\s*[-._]\s*|\s+)(.+)$", stem)
    if m_num:
        return int(m_num.group(1)), bounded_text(m_num.group(2)), fallback_artist

    return default_idx, bounded_text(stem), fallback_artist


def infer_artist_album(folder_path: str, root_dir: str) -> tuple[str, str]:
    rel = os.path.relpath(folder_path, root_dir)
    parts = [p for p in rel.split(os.sep) if p and p != "."]
    leaf = os.path.basename(folder_path)

    sub_stopwords = re.compile(
        r"^(cd\s*\d+|disk\s*\d+|disc\s*\d+|flac|mp3|wav|ogg|extended|youtubedl|deluxe)$",
        re.IGNORECASE,
    )

    suffix_parts: list[str] = []
    idx = len(parts) - 1
    while idx > 0 and sub_stopwords.match(parts[idx].strip()):
        suffix_parts.insert(0, parts[idx].strip())
        idx -= 1

    album_part = parts[idx] if idx >= 0 else leaf
    suffix_str = f" ({' · '.join(suffix_parts)})" if suffix_parts else ""

    if " - " in album_part:
        left, right = album_part.split(" - ", 1)
        left_s, right_s = left.strip(), right.strip()
        if re.match(r"^(19|20)\d{2}$", left_s):
            parent_artist = "Unknown Artist"
            if idx >= 1:
                parent_part = parts[idx - 1]
                parent_artist = parent_part.split(" - ", 1)[0].strip() if " - " in parent_part else parent_part.strip()
            return bounded_text(parent_artist), bounded_text(f"{right_s} ({left_s}){suffix_str}")
        if left_s and right_s:
            if left_s.isupper() and len(left_s) > 4:
                left_s = left_s.title()
            return bounded_text(left_s), bounded_text(f"{right_s}{suffix_str}")

    if "_" in album_part and idx == 0:
        left, right = album_part.split("_", 1)
        right_clean = re.sub(r"\.(wav|flac|mp3|ogg)$", "", right.strip(), flags=re.IGNORECASE)
        if left.strip() and right_clean and left.strip().lower() != "iem":
            return bounded_text(left.strip()), bounded_text(f"{right_clean}{suffix_str}")

    if idx >= 1:
        artist = parts[0]
        if " - " in artist:
            artist = artist.split(" - ", 1)[0].strip()
        artist = re.sub(r"_flac$", "", artist, flags=re.IGNORECASE).replace("_", " ").strip()
        if artist.isupper() and len(artist) > 4:
            artist = artist.title()
        return bounded_text(artist), bounded_text(f"{album_part}{suffix_str}")

    if len(parts) == 1:
        artist = re.sub(r"_flac$", "", parts[0], flags=re.IGNORECASE).replace("_", " ").strip()
        return bounded_text(artist), bounded_text(f"{artist} — Singles{suffix_str}")

    return "Local Artist", bounded_text(f"{leaf}{suffix_str}")


def probe_image_dimensions(path: str) -> tuple[int, int]:
    """Safely probe image dimensions from header bytes via safe_read_bytes."""
    header = safe_read_bytes(path, max_bytes=65536)
    if not header or len(header) < 10:
        return (0, 0)
    if header.startswith(b"\x89PNG\r\n\x1a\n") and len(header) >= 24:
        return (int.from_bytes(header[16:20], "big"), int.from_bytes(header[20:24], "big"))
    if header[:6] in (b"GIF87a", b"GIF89a"):
        return (int.from_bytes(header[6:8], "little"), int.from_bytes(header[8:10], "little"))
    if header.startswith(b"\xff\xd8"):
        pos = 2
        while pos + 9 < len(header):
            if header[pos] != 0xFF:
                pos += 1
                continue
            while pos < len(header) and header[pos] == 0xFF:
                pos += 1
            if pos >= len(header):
                break
            marker = header[pos]
            pos += 1
            if marker in (0xD8, 0xD9) or (0xD0 <= marker <= 0xD7):
                continue
            if pos + 2 > len(header):
                break
            seg_len = int.from_bytes(header[pos : pos + 2], "big")
            if seg_len < 2 or pos + seg_len > len(header):
                break
            if marker in (0xC0, 0xC1, 0xC2, 0xC3) and seg_len >= 7:
                h = int.from_bytes(header[pos + 3 : pos + 5], "big")
                w = int.from_bytes(header[pos + 5 : pos + 7], "big")
                if w > 0 and h > 0:
                    return (w, h)
            pos += seg_len
        return (500, 500)
    if header[:4] == b"RIFF" and header[8:12] == b"WEBP":
        return (500, 500)
    return (0, 0)


def is_valid_media_file(path: str) -> bool:
    """Safely verify a local media or artwork file header via safe_read_bytes(path, max_bytes=64)."""
    header = safe_read_bytes(path, max_bytes=64)
    if not header or len(header) < 4:
        return False
    if header.startswith((b"fLaC", b"RIFF", b"OggS", b"ID3", b"FORM", b"\x89PNG\r\n\x1a\n", b"\xff\xd8", b"<svg", b"<?xml")):
        return True
    if header[0] == 0xFF and (header[1] & 0xE0) == 0xE0:
        return True
    if len(header) >= 8 and header[4:8] == b"ftyp":
        return True
    return False


