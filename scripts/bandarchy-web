function drawMiniMeter(bands) {
  const c = document.getElementById('miniMeter');
  if (!c || !bands) return;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#04060a';
  ctx.fillRect(0, 0, c.width, c.height);
  const n = 24;
  const bw = c.width / n;
  for (let i = 0; i < n; i++) {
    const v = Math.min(1.0, (bands[i * 2] || 0) / 850.0);
    const bh = Math.max(1, v * (c.height - 2));
    ctx.fillStyle = v > 0.7 ? '#38bdf8' : '#6ee7b7';
    ctx.fillRect(i * bw + 1, c.height - bh, Math.max(1, bw - 1.5), bh);
  }
}

function toggleKey(k) { setPatch({[k]: !cfg[k]}); }
function setNum(k, v) { setPatch({[k]: Number(v)}); }

async function pollControllerState() {
  try {
    const res = await fetch('/api/state');
    const data = await res.json();
    cfg = data.config || cfg;
    if (data.photo) photoInfo = data.photo;
    if (data.statementCollections) statementCollections = data.statementCollections;
    if (data.trackCollections) trackCollections = data.trackCollections;
    if (data.artBranches) artBranches = data.artBranches;
    const tKey = JSON.stringify({tracks: cfg.externalTracks, idx: cfg.externalTrackIndex, col: cfg.trackCollectionId, br: cfg.externalArtBranch});
    if (tKey !== lastTracksKey) {
      lastTracksKey = tKey;
      tracks = cfg.externalTracks || tracks;
      renderTrackEditor();
    }
    const mode = data.audioSourceMode || 'laptop';
    const isSynth = (mode === 'synth');
    setActiveById('srcLaptopBtn', !isSynth);
    setActiveById('srcSynthBtn', isSynth);
    const udpBadge = document.getElementById('udpSenderBadge');
    if (udpBadge) {
      const pin = data.pinnedSender || 'auto';
      const act = data.activeSender || '';
      if (isSynth) {
        udpBadge.textContent = '🤖 Synth Active';
      } else if (data.laptopStreamActive && act) {
        udpBadge.textContent = `📡 UDP Live: ${act}${pin !== 'auto' ? ' (Pinned)' : ''}`;
      } else {
        udpBadge.textContent = `📡 UDP Silent (${pin === 'auto' ? 'Auto' : pin})`;
      }
    }
    if (data.bands) drawMiniMeter(data.bands);
    syncUi();
  } catch (e) {}
}

async function init() {
  const res = await fetch('/api/state');
  const data = await res.json();
  cfg = data.config || {};
  if (data.photo) photoInfo = data.photo;
  if (data.statementCollections) statementCollections = data.statementCollections;
  if (data.trackCollections) trackCollections = data.trackCollections;
  if (data.artBranches) artBranches = data.artBranches;
  tracks = cfg.externalTracks || [];
  syncUi();
  renderTrackEditor();
  if (data.bands) drawMiniMeter(data.bands);
  setInterval(pollControllerState, 350);
}
init();
