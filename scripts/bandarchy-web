async function setPatch(patch) {
  Object.assign(cfg, patch);
  syncUi();
  const res = await fetch('/api/state', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(patch)
  });
  const data = await res.json();
  cfg = data.config || cfg;
  if (patch.externalTracks || patch.externalTrackIndex !== undefined) {
    tracks = cfg.externalTracks || tracks;
    renderTrackEditor();
  }
  syncUi();
}

async function triggerAction(name, arg) {
  const res = await fetch('/api/action', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({name, arg})
  });
  setTimeout(pollControllerState, 100);
}

