def scan_external_art_branches():
    """Return discovered subfolders and root image files under ~/Pictures/bandarchy/external_art/."""
    branches = []
    if not EXT_ART_DIR.is_dir():
        return branches
    exts = {".jpg", ".jpeg", ".png", ".webp"}
    try:
        for entry in sorted(EXT_ART_DIR.iterdir(), key=lambda p: p.name.lower()):
            if entry.name.startswith("."):
                continue
            if entry.is_dir():
                imgs = [
                    str(f)
                    for f in sorted(entry.rglob("*"), key=lambda p: str(p).lower())
                    if f.is_file() and f.suffix.lower() in exts
                ]
                branches.append({"id": entry.name, "label": f"📁 {entry.name} ({len(imgs)})", "count": len(imgs), "images": imgs})
            elif entry.is_file() and entry.suffix.lower() in exts:
                branches.append({"id": entry.name, "label": f"🖼 {entry.name[:28]}", "count": 1, "images": [str(entry)]})
    except Exception:
        pass
    return branches


def resolve_external_art_images(art_spec: str) -> tuple[str, list[str]]:
    """Resolve a track's 4th-column art spec (subfolder like 'studio', relative file, or absolute path) to (primary_path, image_list)."""
    exts = {".jpg", ".jpeg", ".png", ".webp"}
    raw = str(art_spec or "").strip()
    if raw:
        cand_abs = Path(os.path.expanduser(raw))
        if cand_abs.is_Absolute() if hasattr(cand_abs, "is_Absolute") else cand_abs.is_absolute():
            if cand_abs.is_file() and cand_abs.suffix.lower() in exts:
                return str(cand_abs), [str(cand_abs)]
            if cand_abs.is_dir():
                imgs = [str(f) for f in sorted(cand_abs.rglob("*")) if f.is_file() and f.suffix.lower() in exts]
                if imgs:
                    return imgs[0], imgs
        cand_rel = EXT_ART_DIR / raw
        if cand_rel.is_file() and cand_rel.suffix.lower() in exts:
            return str(cand_rel), [str(cand_rel)]
        if cand_rel.is_dir():
            imgs = [str(f) for f in sorted(cand_rel.rglob("*")) if f.is_file() and f.suffix.lower() in exts]
            if imgs:
                return imgs[0], imgs
    # Fallback: all images inside ~/Pictures/bandarchy/external_art/
    if EXT_ART_DIR.is_dir():
        imgs = [str(f) for f in sorted(EXT_ART_DIR.rglob("*")) if f.is_file() and f.suffix.lower() in exts]
        if imgs:
            return imgs[0], imgs
    return "", []


def pick_random_statement(stmts: list[str], current: str = "") -> str:
    pool = [s for s in (stmts or DEFAULT_STATEMENTS) if s]
    if not pool:
        return "WE ARE THE FREQUENCIES"
    cands = [s for s in pool if s != current]
    return random.choice(cands if cands else pool)


def load_statements() -> list[str]:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not STATEMENTS_PATH.exists():
        save_statements(DEFAULT_STATEMENTS)
        return list(DEFAULT_STATEMENTS)
    out = []
    try:
        for raw in STATEMENTS_PATH.read_text(encoding="utf-8").splitlines():
            s = raw.strip()
            if not s or s.startswith("#"):
                continue
            out.append(s[:160])
    except Exception:
        pass
    return out or list(DEFAULT_STATEMENTS)


def save_statements(items) -> list[str]:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    clean = []
    lines = ["# Bandarchy — 6: Typography Statements & Words Collection (~/.config/bandarchy/statements.txt)"]
    if isinstance(items, str):
        items = items.splitlines()
    for raw in (items or []):
        s = str(raw or "").strip()
        if not s or s.startswith("#"):
            continue
        clean.append(s[:160])
        lines.append(s[:160])
    if not clean:
        clean = list(DEFAULT_STATEMENTS)
        lines.extend(clean)
    STATEMENTS_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return clean


def load_statement_collections() -> list[dict]:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    custom_cols = []
    if STATEMENT_COLLECTIONS_PATH.exists():
        try:
            data = json.loads(STATEMENT_COLLECTIONS_PATH.read_text(encoding="utf-8"))
            if isinstance(data, list):
                custom_cols = [c for c in data if isinstance(c, dict) and c.get("id") and c.get("statements")]
        except Exception:
            pass
    by_id = {c["id"]: dict(c) for c in BUILTIN_STATEMENT_COLLECTIONS}
    for c in custom_cols:
        by_id[str(c["id"])] = {
            "id": str(c["id"]),
            "name": str(c.get("name") or c["id"]),
            "statements": [str(s).strip() for s in c.get("statements", []) if str(s).strip()],
        }
    return list(by_id.values())


def save_statement_collection(col_id: str, name: str, statements: list[str]) -> list[dict]:
    cols = load_statement_collections()
    clean_stmts = [str(s).strip() for s in statements if str(s).strip() and not str(s).strip().startswith("#")]
    if not clean_stmts:
        return cols
    updated = False
    for c in cols:
        if c["id"] == col_id:
            c["name"] = name or c["name"]
            c["statements"] = clean_stmts
            updated = True
            break
    if not updated:
        cols.append({"id": col_id, "name": name or col_id, "statements": clean_stmts})
    STATEMENT_COLLECTIONS_PATH.write_text(json.dumps(cols, indent=2), encoding="utf-8")
    return cols


def load_track_collections() -> list[dict]:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    custom_cols = []
    if TRACK_COLLECTIONS_PATH.exists():
        try:
            data = json.loads(TRACK_COLLECTIONS_PATH.read_text(encoding="utf-8"))
            if isinstance(data, list):
                custom_cols = [c for c in data if isinstance(c, dict) and c.get("id") and c.get("tracks")]
        except Exception:
            pass
    by_id = {c["id"]: dict(c) for c in BUILTIN_TRACK_COLLECTIONS}
    for c in custom_cols:
        by_id[str(c["id"])] = {
            "id": str(c["id"]),
            "name": str(c.get("name") or c["id"]),
            "tracks": c.get("tracks") or [],
        }
    return list(by_id.values())


def save_track_collection(col_id: str, name: str, tracks: list[dict]) -> list[dict]:
    cols = load_track_collections()
    updated = False
    for c in cols:
        if c["id"] == col_id:
            c["name"] = name or c["name"]
            c["tracks"] = tracks
            updated = True
            break
    if not updated:
        cols.append({"id": col_id, "name": name or col_id, "tracks": tracks})
    TRACK_COLLECTIONS_PATH.write_text(json.dumps(cols, indent=2), encoding="utf-8")
    return cols


def load_external_tracks():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not EXT_TRACKS_PATH.exists():
        save_external_tracks(DEFAULT_EXT_TRACKS)
        return list(DEFAULT_EXT_TRACKS)
    rows = []
    try:
        for raw in EXT_TRACKS_PATH.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in line.split("|")]
            rows.append({
                "artist": parts[0] if len(parts) > 0 else "",
                "track": parts[1] if len(parts) > 1 else "",
                "album": parts[2] if len(parts) > 2 else "",
                "art": parts[3] if len(parts) > 3 else "",
            })
    except Exception:
        pass
    return rows or list(DEFAULT_EXT_TRACKS)


def save_external_tracks(tracks):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = ["# Bandarchy External Track Metadata (Artist | Track | Album | Optional Image/Folder Path)"]
    clean = []
    for item in tracks:
        if not isinstance(item, dict):
            continue
        ar = str(item.get("artist", "")).replace("|", "/").strip()
        tr = str(item.get("track", "")).replace("|", "/").strip()
        al = str(item.get("album", "")).replace("|", "/").strip()
        ap = str(item.get("art", "") or item.get("artPath", "")).replace("|", "/").strip()
        if not (ar or tr or al):
            continue
        clean.append({"artist": ar, "track": tr, "album": al, "art": ap})
        lines.append(f"{ar} | {tr} | {al} | {ap}" if ap else f"{ar} | {tr} | {al}")
    EXT_TRACKS_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return clean


QUALITY_RES_MAP = {0: 384, 1: 480, 2: 640, 3: 800, 4: 1024, 5: 1280}
QUALITY_DETAIL_MAP = {0: 0.75, 1: 0.90, 2: 1.00, 3: 1.00, 4: 1.15, 5: 1.25}


def apply_active_track_and_art(cfg: dict):
    tracks = cfg.get("externalTracks") or []
    if tracks:
        idx = int(cfg.get("externalTrackIndex", 0) or 0) % len(tracks)
        cfg["externalTrackIndex"] = idx
        active = tracks[idx]
        cfg["trackArtist"] = active.get("artist") or cfg.get("trackArtist", "")
        cfg["trackTitle"] = active.get("track") or cfg.get("trackTitle", "")
        cfg["trackAlbum"] = active.get("album") or cfg.get("trackAlbum", "")
        art_spec = active.get("art") or cfg.get("externalArtBranch", "studio")
    else:
        art_spec = cfg.get("externalArtBranch", "studio")
    primary_img, imgs = resolve_external_art_images(art_spec)
    cfg["externalArtBranch"] = str(art_spec or "")
    cfg["externalArtImages"] = imgs
    if imgs:
        eidx = int(cfg.get("externalArtIndex", 0) or 0) % len(imgs)
        cfg["externalArtIndex"] = eidx
        cfg["artPath"] = imgs[eidx]
    else:
        cfg["artPath"] = primary_img


def load_state():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    cfg = dict(DEFAULT_CONFIG)
    if CONFIG_PATH.exists():
        try:
            disk = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
            if isinstance(disk, dict):
                was_legacy = int(disk.get("version", 0) or 0) < 3
                for k, v in disk.items():
                    if k in cfg:
                        cfg[k] = v
                if was_legacy:
                    cfg["version"] = 3
                    cfg["renderQuality"] = 3
                    cfg["renderResW"] = 800
                    cfg["geometryDetail"] = 1.00
                    cfg["targetFps"] = 60
        except Exception:
            pass
    cfg["version"] = 3
    if "paletteIndex" in cfg and cfg.get("palette") != cfg.get("paletteIndex"):
        cfg["palette"] = int(cfg.get("paletteIndex", 0) or 0)
    cfg["paletteIndex"] = int(cfg.get("palette", 0) or 0)
    rq = int(cfg.get("renderQuality", 3) or 3)
    if int(cfg.get("renderResW", 0) or 0) < 320:
        cfg["renderResW"] = QUALITY_RES_MAP.get(rq, 800)
    stmts = load_statements()
    cfg["statements"] = stmts
    if not cfg.get("statementText") or cfg["statementText"] not in stmts:
        cfg["statementText"] = pick_random_statement(stmts)
    tracks = load_external_tracks()
    cfg["externalTracks"] = tracks
    apply_active_track_and_art(cfg)
    cfg["updatedAt"] = time.time()
    return cfg


LIVE_STATE = load_state()


def persist_state():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    disk = {}
    if CONFIG_PATH.exists():
        try:
            disk = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
            if not isinstance(disk, dict):
                disk = {}
        except Exception:
            disk = {}
    skip_keys = {"externalTracks", "statements", "externalArtImages"}
    for k, v in LIVE_STATE.items():
        if k not in skip_keys:
            disk[k] = v
    CONFIG_PATH.write_text(json.dumps(disk, indent=2), encoding="utf-8")


_BPI_MOD = None


def _get_bpi_module():
    global _BPI_MOD
    if _BPI_MOD is not None:
        return _BPI_MOD
    for cand in (
        PHOTO_BASE_DIR / "bandarchy_photo_import.py",
        REPO_DIR / "share" / "photo_engine" / "bandarchy_photo_import.py",
        SCRIPT_DIR / "bandarchy_photo_import.py",
    ):
        if cand.is_file():
            sdir = str(cand.parent)
            if sdir not in sys.path:
                sys.path.insert(0, sdir)
            try:
                import bandarchy_photo_import as bpi
                _BPI_MOD = bpi
                return bpi
            except Exception:
                pass
    return None


def refresh_photo_library():
    bpi = _get_bpi_module()
    if not bpi or not (PHOTO_BASE_DIR / "processed").is_dir():
        return
    try:
        parsed = bpi.rebuild_manifests(str(PHOTO_BASE_DIR))
        if not isinstance(parsed, dict):
            return
        cats_dict = parsed.get("categories") or parsed.get("categories_summary") or {}
        tot_imp = int(parsed.get("total_imported_sources", 0) or 0)
        tot_proc = int(parsed.get("total_processed_outputs", 0) or 0)
        counts = {"all": tot_imp}
        for k, v in cats_dict.items():
            if isinstance(v, dict):
                counts[str(k)] = int(v.get("imported_count", 0) or 0)
        disc = parsed.get("discovered_categories") or sorted(cats_dict.keys())
        cats = ["all"] + [str(c) for c in disc if str(c) != "all"]
        with STATE_LOCK:
            PHOTO_STATE["categories"] = cats
            PHOTO_STATE["categoryCounts"] = counts
            PHOTO_STATE["totalOriginals"] = tot_imp
            PHOTO_STATE["totalProcessed"] = tot_proc
            PHOTO_STATE["seq"] += 1
    except Exception:
        pass


def pick_photo_from_library(category: str = None, stem: str = None, step_history: int = 0, touch_updated_at: bool = True):
    bpi = _get_bpi_module()
    if not bpi or not (PHOTO_BASE_DIR / "processed").is_dir():
        return
    with STATE_LOCK:
        cat = str(category or PHOTO_STATE.get("activeCategory") or LIVE_STATE.get("photoActiveCategory") or "all")
        hist = PHOTO_STATE["history"]
        hidx = PHOTO_STATE["historyIdx"]
        exclude_stem = PHOTO_STATE.get("activeStem") or None

    if step_history != 0 and hist:
        new_idx = hidx + step_history
        if 0 <= new_idx < len(hist):
            cat, stem = hist[new_idx]
            with STATE_LOCK:
                PHOTO_STATE["historyIdx"] = new_idx
            step_history = 0  # use exact stem from history

    try:
        res = bpi.pick_category_photo(
            str(PHOTO_BASE_DIR),
            category=cat,
            stem=stem if stem else None,
            exclude_stem=exclude_stem if not stem else None,
        )
        if not isinstance(res, dict) or not res.get("ok"):
            return
        picked_stem = str(res.get("source_stem") or res.get("sourceStem") or "")
        picked_cat = cat
        with STATE_LOCK:
            PHOTO_STATE["activeCategory"] = picked_cat
            LIVE_STATE["photoActiveCategory"] = picked_cat
            PHOTO_STATE["activeStem"] = picked_stem
            PHOTO_STATE["variants"] = res.get("variants") or {}
            PHOTO_STATE["sameEffectPeers"] = res.get("sameEffectPeers") or {}
            PHOTO_STATE["sameEffectByVariant"] = res.get("sameEffectByVariant") or {}
            PHOTO_STATE["randomPoolPeers"] = res.get("randomPoolPeers") or {}
            if not stem and picked_stem:
                PHOTO_STATE["history"] = hist[: max(0, hidx + 1)] + [(picked_cat, picked_stem)]
                if len(PHOTO_STATE["history"]) > 40:
                    PHOTO_STATE["history"] = PHOTO_STATE["history"][-40:]
                PHOTO_STATE["historyIdx"] = len(PHOTO_STATE["history"]) - 1
            PHOTO_STATE["seq"] += 1
            if touch_updated_at:
                LIVE_STATE["updatedAt"] = time.time()
    except Exception:
        pass


def get_cached_art_lines(seed_text: str, image_path: str = ""):
    cache_key = f"{seed_text}::{image_path}"
    if ART_CACHE["seed"] == cache_key and ART_CACHE["lines"]:
        return ART_CACHE["lines"]
    h = hashlib.sha256((seed_text or "bandarchy").encode("utf-8")).digest()
    h1, h2 = h[0], h[1]
    lines = []
    cells = []
    clusters = []
    for k in range(8):
        ang = (k / 8.0) * math.pi * 2.0 + (h1 / 255.0) * math.pi
        r = int(127 + 115 * math.sin(ang))
        g = int(127 + 115 * math.sin(ang + 2.094))
        b = int(127 + 115 * math.sin(ang + 4.188))
        clusters.append({"r": r, "g": g, "b": b, "hex": f"#{r:02x}{g:02x}{b:02x}"})

    rows, cols = 14, 24
    for r in range(rows):
        ny = (r / max(1, rows - 1)) * 2.0 - 1.0
        row_str = []
        for c in range(cols):
            nx = (c / max(1, cols - 1)) * 2.0 - 1.0
            dist = math.sqrt(nx * nx + ny * ny)
            ang = math.atan2(ny, nx)
            wave = 0.5 + 0.5 * math.sin(dist * 5.0 - (h2 / 255.0) * 6.0 + math.cos(ang * 3.0))
            cid = int(wave * 7.99) % 8
            cl = clusters[cid]
            sal = max(0.15, min(1.0, 1.15 - dist * 0.65))
            edge = max(0.1, min(1.0, abs(math.cos(dist * 6.0)) * 0.85))
            z_dep = max(-1.0, min(1.0, (0.6 - dist) * 1.2))
            ch = chr(0x2800 + ((0xFF if sal > 0.45 else 0xDB) & 0xFF))
            row_str.append(f"\x1b[38;2;{cl['r']};{cl['g']};{cl['b']}m{ch}")
            cells.append({
                "r": cl["r"], "g": cl["g"], "b": cl["b"],
                "hex": cl["hex"],
                "clusterId": cid,
                "luma": round(0.299 * cl["r"] / 255 + 0.587 * cl["g"] / 255 + 0.114 * cl["b"] / 255, 3),
                "salience": round(sal, 3),
                "edgeMag": round(edge, 3),
                "tangentRad": round((ang + math.pi * 0.5) % math.pi, 3),
                "zDepth": round(z_dep, 3),
                "normX": round(-nx * 0.7, 3),
                "normY": round(-ny * 0.7, 3),
                "dogVal": round(edge - 0.35, 3),
                "contourLvl": int(wave * 7),
                "thermal": round(wave - 0.5, 3),
                "brailleMask": 255,
            })
        lines.append("".join(row_str) + "\x1b[0m")

    model = {"cols": cols, "rows": rows, "clusters": clusters, "cells": cells, "imagePath": image_path or ""}
    lines.append("#ARTMODEL:" + json.dumps(model, separators=(",", ":")))
    ART_CACHE["seed"] = cache_key
    ART_CACHE["lines"] = lines
    return lines


def get_active_audio_bands(now: float, playing: bool):
    mode = LIVE_AUDIO.get("source", "laptop")
    if mode == "synth":
        return synthesise_audio_bands(now, playing), False

    senders = LIVE_AUDIO.get("senders") or {}
    pinned = LIVE_AUDIO.get("pinnedSender", "auto")
    cur_active = LIVE_AUDIO.get("activeSender", "")

    chosen_ip = ""
    if pinned != "auto" and pinned in senders:
        if (now - senders[pinned]["lastReceivedAt"]) < 0.30:
            chosen_ip = pinned
    else:
        # Sticky lock: stay locked to cur_active while it is actively transmitting (< 1.0s gap)
        if cur_active and cur_active in senders and (now - senders[cur_active]["lastReceivedAt"]) < 1.0:
            if (now - senders[cur_active]["lastReceivedAt"]) < 0.30:
                chosen_ip = cur_active
        else:
            # Pick the most recent / highest-energy active sender (< 0.30s)
            fresh = [
                (ip, info)
                for ip, info in senders.items()
                if (now - info["lastReceivedAt"]) < 0.30
            ]
            if fresh:
                fresh.sort(key=lambda item: (item[1].get("peak", 0), item[1]["lastReceivedAt"]), reverse=True)
                chosen_ip = fresh[0][0]
                LIVE_AUDIO["activeSender"] = chosen_ip

    if playing and chosen_ip and chosen_ip in senders:
        LIVE_AUDIO["activeSender"] = chosen_ip
        return senders[chosen_ip]["bands"], True
    return [0] * 64, False


def udp_cava_listener(port: int = 8766):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 65536)
    sock.bind(("0.0.0.0", port))
    while True:
        try:
            sock.setblocking(True)
            data, addr = sock.recvfrom(4096)
            latest_by_ip = {addr[0]: data}
            # Drain any newer UDP packets queued in the kernel socket buffer per sender IP
            sock.setblocking(False)
            while True:
                try:
                    newer, naddr = sock.recvfrom(4096)
                    if newer:
                        latest_by_ip[naddr[0]] = newer
                except BlockingIOError:
                    break
            now = time.time()
            for sender_ip, pkt in latest_by_ip.items():
                line = pkt.decode("ascii", errors="ignore").strip()
                if not line:
                    continue
                parts = [p for p in line.split(";") if p]
                if len(parts) >= 16:
                    vals = [int(float(x)) for x in parts[:64]]
                    if len(vals) < 64:
                        vals.extend([0] * (64 - len(vals)))
                    peak = max(vals)
                    if peak >= 10:
                        LIVE_AUDIO["senders"][sender_ip] = {
                            "bands": vals,
                            "lastReceivedAt": now,
                            "peak": peak,
                        }
                        LIVE_AUDIO["bands"] = vals
                        LIVE_AUDIO["lastReceivedAt"] = now
        except Exception:
            pass


def synthesise_audio_bands(t: float, playing: bool):
    if not playing:
        return [0] * 64
    kick = max(0.0, math.sin(t * math.pi * 2.1)) ** 6
    snare = max(0.0, math.sin(t * math.pi * 1.05 + 1.57)) ** 8
    bands = []
    for i in range(64):
        norm = i / 63.0
        sub = kick * max(0.0, 1.0 - norm * 3.2) * 780.0
        mid = (0.45 + 0.55 * math.sin(t * 3.4 + i * 0.24)) * math.exp(-((norm - 0.38) ** 2) * 14.0) * 560.0
        high = (snare * 0.65 + 0.35 * abs(math.sin(t * 7.8 + i * 0.6))) * math.exp(-((norm - 0.78) ** 2) * 18.0) * 480.0
        bands.append(int(max(12.0, min(1000.0, sub + mid + high))))
    return bands


