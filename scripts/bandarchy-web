<script>
const COLLECTIVE_PRESET_NAMES = [
  "Geiss Plasma MilkDrop & Battlezone",
  "Cthugha Plasma Flame Tunnel",
  "Minter VLM Curved Morphing Tube",
  "Infinite Julia Fractal Zoom",
  "Braille Cover Art Shatter & MilkDrop",
  "Neon Song Words TTE Lotus Dome",
  "Pure Battlezone LED Equaliser (L1 Only)",
  "Classic Matrix Digital Rain Waterfall"
];

let cfg = {};
let tracks = [];
let trackCollections = [];
let statementCollections = [];
let artBranches = [];
let photoInfo = {};
let lastCatsKey = '';
let lastStmtsKey = '';
let lastTracksKey = '';
let builtGrids = false;

function openTab(idx, btn) {
  document.querySelectorAll('.tab-pane').forEach((el, i) => el.classList.toggle('active', i === idx));
  document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
  btn.classList.add('active');
}

function buildStaticGrids() {
  if (builtGrids) return;
  builtGrids = true;

  const mkPills = (containerId, arr, idPrefix, onClickFn) => {
    const g = document.getElementById(containerId);
    if (!g || !arr) return;
    arr.forEach((item, i) => {
      const b = document.createElement('button');
      b.id = idPrefix + '_' + i;
      const label = (typeof item === 'object' && item !== null) ? (item.name || item.code || String(i+1)) : String(item);
      b.textContent = label.startsWith('#') || /^\d+[\.:\/]/.test(label) ? label : `${i+1}. ${label}`;
      b.onclick = () => onClickFn(i, item);
      g.appendChild(b);
    });
  };

  mkPills('collectivePresetsGrid', COLLECTIVE_PRESET_NAMES, 'cpres', i => triggerAction('applyPreset', i));
  mkPills('trackArcGrid', TRACK_ARC_MODES, 'tarc', i => setPatch({trackArcMode: i}));
  mkPills('palRandModesGrid', PALETTE_RANDOM_MODES, 'prm', i => setPatch({paletteRandomMode: i}));
  mkPills('palCollectionsGrid', PALETTE_COLLECTIONS, 'pcol', i => setPatch({paletteCollectionIndex: i, paletteRandomMode: 1}));
  mkPills('palettesGrid', PALETTE_NAMES, 'pal', i => setPatch({palette: i, paletteIndex: i}));

  mkPills('l1ModesGrid', ALL_LAYER1_MODES, 'l1m', i => setPatch({layer1Mode: i, layer1Enabled: true, layer1FieldEnabled: true}));
  mkPills('photoPoolGrid', PhotoMotion.PHOTO_POOL_MODES, 'ppool', i => setPatch({photoPoolMode: i, layer1Enabled: true, layer1FieldEnabled: true, layer1Mode: 11}));
  mkPills('photoMotionGrid', PhotoMotion.PHOTO_MOTION_MODES, 'pmot', i => setPatch({photoMotionMode: i, layer1Enabled: true, layer1FieldEnabled: true, layer1Mode: 11}));

  const vg = document.getElementById('photoVariantsGrid');
  if (vg && PhotoMotion.STAGE1_EFFECT_IDS) {
    const bAuto = document.createElement('button');
    bAuto.id = 'pvar_-1';
    bAuto.textContent = '🔄 Auto-Strobe All 17';
    bAuto.onclick = () => setPatch({photoPinnedVariant: -1, layer1Enabled: true, layer1FieldEnabled: true, layer1Mode: 11});
    vg.appendChild(bAuto);
    PhotoMotion.STAGE1_EFFECT_IDS.forEach((effId, i) => {
      const b = document.createElement('button');
      b.id = 'pvar_' + i;
      b.textContent = `V${i < 9 ? '0' + (i + 1) : (i + 1)}: ${effId.replace(/^\d+_/, '').replace(/_/g, ' ')}`;
      b.onclick = () => setPatch({photoPinnedVariant: cfg.photoPinnedVariant === i ? -1 : i, layer1Enabled: true, layer1FieldEnabled: true, layer1Mode: 11});
      vg.appendChild(b);
    });
  }

  mkPills('l1EqGrid', ALL_LAYER1_EQ_STYLES, 'l1eq', i => setPatch({layer1EqStyle: i, layer1Enabled: true, layer1EqEnabled: true}));
  mkPills('l1EqLayoutGrid', LAYER1_EQ_LAYOUTS, 'l1eql', i => setPatch({layer1EqLayout: i}));
  mkPills('l1EqBandOrderGrid', LAYER1_EQ_BAND_ORDERS, 'l1eqb', i => setPatch({layer1EqBandOrder: i}));
  mkPills('l1EqDampingGrid', LAYER1_EQ_DAMPING, 'l1eqd', i => setPatch({layer1EqDamping: i}));

  mkPills('l1ShapesGrid', LAYER1_SHAPE_STYLES, 'l1sh', i => setPatch({layer1ShapeStyle: i, layer1Enabled: true, layer1ShapesEnabled: true}));

  mkPills('l2ModesGrid', ALL_MODE_NAMES, 'l2m', i => setPatch({visualMode: i, layer2Enabled: true, layer2VizEnabled: true}));
  mkPills('symmetryGrid', SYMMETRY_OPTIONS.map(n => `${n}-Fold`), 'sym', i => setPatch({symmetryIndex: i}));

  mkPills('l4ModesGrid', LAYER4_MODES, 'l4m', i => setPatch({layer4Mode: i, backdropMode: i, layer4Enabled: true, backdropEnabled: true}));
  mkPills('l4SecModesGrid', LAYER4_MODES, 'l4sm', i => setPatch({layer4SecondaryMode: i, layer4DualEnabled: true}));
  mkPills('l4WallGrid', LAYER4_WALL_PATTERNS, 'l4w', i => setPatch({layer4WallPattern: i}));

  mkPills('l3RandModesGrid', LAYER3_RANDOM_MODES, 'l3rm', i => setPatch({layer3RandomMode: i, layer3AutoRandomise: i > 0}));
  mkPills('l3ModesGrid', LAYER3_MODES, 'l3m', i => setPatch({layer3Mode: i, layer3Enabled: true}));
  mkPills('l3CylGrid', LAYER3_CYLINDER_DIRS, 'l3cyl', i => setPatch({layer3CylinderDir: i}));
  mkPills('l3FontsGrid', LAYER3_FONT_PRESETS, 'l3fnt', i => setPatch({layer3FontPreset: i}));
  mkPills('l3ColourGrid', LAYER3_COLOUR_MODES, 'l3col', i => setPatch({layer3ColourMode: i}));
}

function renderPhotoLibrary() {
  const badge = document.getElementById('photoStatusBadge');
  if (badge) {
    const tot = photoInfo.totalOriginals || 0;
    const proc = photoInfo.totalProcessed || 0;
    const cat = photoInfo.activeCategory || cfg.photoActiveCategory || 'all';
    const stem = photoInfo.activeStem || 'None';
    badge.textContent = tot > 0
      ? `📷 Active: ${stem}  ·  Category: ${cat}  ·  Library: ${tot} sources (${proc} darkroom variants)`
      : `📷 No processed photos found in ~/Pictures/bandarchy/processed`;
  }
  const cg = document.getElementById('photoCategoriesGrid');
  if (!cg) return;
  const cats = photoInfo.categories || ['all'];
  const counts = photoInfo.categoryCounts || {};
  const catsKey = JSON.stringify({cats, counts});
  if (catsKey !== lastCatsKey) {
    lastCatsKey = catsKey;
    cg.innerHTML = '';
    cats.forEach(c => {
      const b = document.createElement('button');
      b.id = 'pcat_' + c;
      const cnt = counts[c] !== undefined ? ` (${counts[c]})` : '';
      b.textContent = `${c}${cnt}`;
      b.onclick = () => triggerAction('photoCatSelect', c);
      cg.appendChild(b);
    });
  }
  const activeCat = photoInfo.activeCategory || cfg.photoActiveCategory || 'all';
  cats.forEach(c => setActiveById('pcat_' + c, c === activeCat));

  const topCatSel = document.getElementById('topPhotoCatSelect');
  if (topCatSel) {
    if (topCatSel.dataset.catsKey !== catsKey) {
      topCatSel.dataset.catsKey = catsKey;
      topCatSel.innerHTML = '';
      cats.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c;
        const cnt = counts[c] !== undefined ? ` (${counts[c]})` : '';
        opt.textContent = `Category: ${c}${cnt}`;
        topCatSel.appendChild(opt);
      });
    }
    topCatSel.value = activeCat;
  }
  setActiveById('top_photo_mode_btn', Boolean(cfg.layer1Enabled && cfg.layer1FieldEnabled && cfg.layer1Mode === 11));
  setActiveById('top_photo_autorand_btn', Boolean(cfg.photoAutoMotionEvents));

  const pinned = cfg.photoPinnedVariant !== undefined ? Number(cfg.photoPinnedVariant) : -1;
  setActiveById('pvar_-1', pinned === -1);
  if (PhotoMotion.STAGE1_EFFECT_IDS) {
    for (let i = 0; i < PhotoMotion.STAGE1_EFFECT_IDS.length; i++) {
      setActiveById('pvar_' + i, pinned === i);
    }
  }
}

function renderStatementsAndCollections() {
  const colGrid = document.getElementById('stmtCollectionsGrid');
  if (colGrid) {
    colGrid.innerHTML = '';
    statementCollections.forEach(col => {
      const b = document.createElement('button');
      const cnt = (col.statements || []).length;
      b.textContent = `${col.name} (${cnt})`;
      if (cfg.statementCollectionId === col.id) b.classList.add('active');
      b.onclick = () => triggerAction('selectStatementCollection', col.id);
      colGrid.appendChild(b);
    });
  }
  const stmts = cfg.statements || [];
  const pillsGrid = document.getElementById('statementsPillsGrid');
  if (pillsGrid) {
    pillsGrid.innerHTML = '';
    stmts.forEach((s, idx) => {
      const b = document.createElement('button');
      b.textContent = s;
      if (cfg.statementText === s) b.classList.add('active');
      b.onclick = () => setPatch({statementText: s, layer3ShowStatements: true, useAlbumArt: false, layer3Enabled: true});
      pillsGrid.appendChild(b);
    });
  }
  const ta = document.getElementById('statementsBulkTextarea');
  const stmtsKey = stmts.join('\n');
  if (ta && document.activeElement !== ta && stmtsKey !== lastStmtsKey) {
    lastStmtsKey = stmtsKey;
    ta.value = stmtsKey;
  }

  const topStmtColSel = document.getElementById('topStmtColSelect');
  if (topStmtColSel) {
    topStmtColSel.innerHTML = '';
    statementCollections.forEach(col => {
      const opt = document.createElement('option');
      opt.value = col.id;
      opt.textContent = `${col.name} (${(col.statements || []).length})`;
      topStmtColSel.appendChild(opt);
    });
    if (cfg.statementCollectionId) topStmtColSel.value = cfg.statementCollectionId;
  }
  const topStmtSel = document.getElementById('topStmtSelect');
  if (topStmtSel) {
    topStmtSel.innerHTML = '';
    stmts.forEach(s => {
      const opt = document.createElement('option');
      opt.value = s;
      opt.textContent = s;
      topStmtSel.appendChild(opt);
    });
    if (cfg.statementText) topStmtSel.value = cfg.statementText;
  }
  setActiveById('top_stmt_mode_btn', Boolean(cfg.layer3Enabled && !cfg.useAlbumArt && cfg.layer3ShowStatements));
}

async function saveStatementsBulk() {
  const ta = document.getElementById('statementsBulkTextarea');
  if (!ta) return;
  const lines = ta.value.split('\n').map(s => s.trim()).filter(s => s && !s.startsWith('#'));
  const randStmt = lines.length ? lines[Math.floor(Math.random() * lines.length)] : cfg.statementText;
  await setPatch({statements: lines, statementText: randStmt});
}

async function saveNewStatementCollection() {
  const ta = document.getElementById('statementsBulkTextarea');
  const nameIn = document.getElementById('newStmtColName');
  if (!ta || !nameIn) return;
  const name = nameIn.value.trim() || 'Custom Statements';
  const lines = ta.value.split('\n').map(s => s.trim()).filter(s => s && !s.startsWith('#'));
  await triggerAction('saveStatementCollection', {name, statements: lines});
  nameIn.value = '';
}

function renderL3Styles() {
  const g = document.getElementById('l3StylesGrid');
  const styles = cfg.useAlbumArt ? LAYER3_ART_STYLES : LAYER3_TEXT_STYLES;
  document.getElementById('l3StylesLabel').textContent = cfg.useAlbumArt
    ? `Art Pixel / Block / Halftone / Chromatic Style (${styles.length}):`
    : `Psychedelic / Techno / Dance / ASCII Text Style (${styles.length}):`;
  g.innerHTML = '';
  styles.forEach((name, i) => {
    const b = document.createElement('button');
    b.textContent = `#${i+1}: ${name}`;
    if (cfg.layer3TextStyle === i) b.classList.add('active');
    b.onclick = () => setPatch({layer3TextStyle: i, layer3Enabled: true});
    g.appendChild(b);
  });
}

function renderTrackEditor() {
  // Render Track Collections in both Tab 6 and Tab 7
  ['trackCollectionsGrid', 'tab6TrackCollectionsGrid'].forEach(gid => {
    const cg = document.getElementById(gid);
    if (!cg) return;
    cg.innerHTML = '';
    trackCollections.forEach(col => {
      const b = document.createElement('button');
      const cnt = (col.tracks || []).length;
      b.textContent = `${col.name} (${cnt})`;
      if (cfg.trackCollectionId === col.id) b.classList.add('active');
      b.onclick = () => triggerAction('selectTrackCollection', col.id);
      cg.appendChild(b);
    });
  });

  // Render Active Track Pills in both Tab 6 and Tab 7
  ['activeTracksPills', 'tab6TracksPillsGrid'].forEach(gid => {
    const pills = document.getElementById(gid);
    if (!pills) return;
    pills.innerHTML = '';
    tracks.forEach((t, i) => {
      const b = document.createElement('button');
      const artTag = t.art ? ` [${t.art}]` : '';
      b.textContent = `#${i+1}: ${t.artist} — ${t.track} (${t.album})${artTag}`;
      if (cfg.externalTrackIndex === i) b.classList.add('active');
      b.onclick = () => setPatch({externalTrackIndex: i});
      pills.appendChild(b);
    });
  });

  // Render External Art Branches in both Tab 6 and Tab 7
  ['artBranchesGrid', 'tab6ArtBranchesGrid'].forEach(gid => {
    const ag = document.getElementById(gid);
    if (!ag) return;
    ag.innerHTML = '';
    artBranches.forEach(br => {
      const b = document.createElement('button');
      b.textContent = br.label;
      if (cfg.externalArtBranch === br.id) b.classList.add('active');
      b.onclick = () => triggerAction('selectArtBranch', br.id);
      ag.appendChild(b);
    });
  });

  const topTColSel = document.getElementById('topTrackColSelect');
  if (topTColSel) {
    topTColSel.innerHTML = '';
    trackCollections.forEach(col => {
      const opt = document.createElement('option');
      opt.value = col.id;
      opt.textContent = `${col.name} (${(col.tracks || []).length})`;
      topTColSel.appendChild(opt);
    });
    if (cfg.trackCollectionId) topTColSel.value = cfg.trackCollectionId;
  }
  const topTSel = document.getElementById('topTrackSelect');
  if (topTSel) {
    topTSel.innerHTML = '';
    tracks.forEach((t, i) => {
      const opt = document.createElement('option');
      opt.value = String(i);
      opt.textContent = `#${i+1}: ${t.artist} — ${t.track}`;
      topTSel.appendChild(opt);
    });
    topTSel.value = String(cfg.externalTrackIndex || 0);
  }
  const topArtSel = document.getElementById('topArtBranchSelect');
  if (topArtSel) {
    topArtSel.innerHTML = '';
    artBranches.forEach(br => {
      const opt = document.createElement('option');
      opt.value = br.id;
      opt.textContent = br.label;
      topArtSel.appendChild(opt);
    });
    if (cfg.externalArtBranch) topArtSel.value = cfg.externalArtBranch;
  }

  const rows = document.getElementById('trackEditorRows');
  if (!rows) return;
  rows.innerHTML = '';
  tracks.forEach((t, i) => {
    const div = document.createElement('div');
    div.className = 'track-row';
    div.innerHTML = `
      <input type="text" placeholder="Artist" value="${(t.artist||'').replace(/"/g,'&quot;')}" onchange="tracks[${i}].artist=this.value">
      <input type="text" placeholder="Track" value="${(t.track||'').replace(/"/g,'&quot;')}" onchange="tracks[${i}].track=this.value">
      <input type="text" placeholder="Album" value="${(t.album||'').replace(/"/g,'&quot;')}" onchange="tracks[${i}].album=this.value">
      <input type="text" placeholder="Subfolder/File in external_art (e.g. studio)" value="${(t.art||'').replace(/"/g,'&quot;')}" onchange="tracks[${i}].art=this.value">
      <button onclick="tracks.splice(${i},1); renderTrackEditor()">✕</button>
    `;
    rows.appendChild(div);
  });
}

