document.getElementById('micBtn').onclick = async () => {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
    const ac = new (window.AudioContext || window.webkitAudioContext)();
    const src = ac.createMediaStreamSource(stream);
    localAnalyser = ac.createAnalyser();
    localAnalyser.fftSize = 256;
    localAnalyser.smoothingTimeConstant = 0.65;
    localFreqData = new Uint8Array(localAnalyser.frequencyBinCount);
    src.connect(localAnalyser);
    document.getElementById('micBtn').textContent = '🎙 Mic Active';
  } catch (err) {
    alert('Microphone access error: ' + err.message);
  }
};

function loadVariantDict(dictObj) {
  const out = {};
  if (!dictObj || typeof dictObj !== 'object') return out;
  for (const [k, rawPath] of Object.entries(dictObj)) {
    const url = toHttpUrl(String(rawPath || ''));
    if (!url) continue;
    const img = getOrLoadImg(url);
    if (img) out[k] = url;
  }
  return out;
}

function syncPhotoState(forceFromServer = false) {
  photoState.categories = serverPhoto.categories || PhotoMotion.DEFAULT_PHOTO_CATEGORIES;
  photoState.categoryCounts = serverPhoto.categoryCounts || {};
  photoState.activeCategory = serverPhoto.activeCategory || serverCfg.photoActiveCategory || 'all';
  const srvMode = Number(serverCfg.photoMotionMode) || 0;
  if (forceFromServer || srvMode !== lastServerPhotoMode) {
    photoState.motionMode = srvMode;
    lastServerPhotoMode = srvMode;
    photoState.photoMotionActivity = Number(serverCfg.photoMotionActivity ?? 1.0);
    photoState.photoXyzTilt = Number(serverCfg.photoXyzTilt ?? 0.85);
    photoState.photoZoomPunch = Number(serverCfg.photoZoomPunch ?? 1.05);
    photoState.photoPaletteBloom = Number(serverCfg.photoPaletteBloom ?? 1.10);
    photoState.photoWarpIntensity = Number(serverCfg.photoWarpIntensity ?? 0.90);
    photoState.photoStrobeSpeed = Number(serverCfg.photoStrobeSpeed ?? 0.90);
  }
  photoState.poolMode = Number(serverCfg.photoPoolMode) || 0;
  photoState.photoPlaneShearEnabled = Boolean(serverCfg.photoPlaneShearEnabled);
  photoState.photoPlaneShear = Number(serverCfg.photoPlaneShear ?? 0.65);
  photoState.autoMotionEvents = Boolean(serverCfg.photoAutoMotionEvents);
  photoState.randomiseMotionControls = Boolean(serverCfg.photoRandomiseMotionControls ?? true);
  photoState.photoEffectChangeIntervalSec = Number(serverCfg.photoEffectChangeIntervalSec ?? 12);
  photoState.autoMotionMinDwellSec = photoState.photoEffectChangeIntervalSec;
  photoState.pinnedStage1EffectIndex = Number(serverCfg.photoPinnedVariant ?? -1);
  photoState.photoOpacity = Number(serverCfg.photoOpacity ?? 0.92);
  photoState.photoFadeDuration = Number(serverCfg.photoFadeDuration ?? 0.65);
  photoState.photoBlackOpacity = Number(serverCfg.photoBlackOpacity ?? 0.92);
  photoState.photoMidOpacity = Number(serverCfg.photoMidOpacity ?? 0.78);
  photoState.photoWhiteOpacity = Number(serverCfg.photoWhiteOpacity ?? 0.94);
  photoState.photoColourSnatchOpacity = Number(serverCfg.photoColourSnatchOpacity ?? 1.0);
}

function renderPhotoStageToCanvas(ctx2d, w, h, engState) {
  syncPhotoState(false);
  const activeVars = serverPhoto.variants || {};
  const effIds = PhotoMotion.STAGE1_EFFECT_IDS;
  const pinnedIdx = (photoState.pinnedStage1EffectIndex >= 0 && photoState.pinnedStage1EffectIndex < effIds.length)
    ? photoState.pinnedStage1EffectIndex
    : ((Math.floor(Number(photoState.primaryVariantIndex) || 0) % effIds.length + effIds.length) % effIds.length);
  const activeEffId = effIds[pinnedIdx] || effIds[0];

  let loadedMap = {};
  let poolMaps = null;
  if (photoState.poolMode === 1) {
    const rawByVar = serverPhoto.sameEffectByVariant || {};
    const targetSameMap = rawByVar[activeEffId] || serverPhoto.sameEffectPeers || activeVars;
    const loadedSame = loadVariantDict(targetSameMap);
    loadedMap = loadedSame;
    poolMaps = { sameEffectPeers: loadedSame, sameEffectByVariant: { [activeEffId]: loadedSame }, randomPoolPeers: {} };
  } else if (photoState.poolMode === 2) {
    const loadedRand = loadVariantDict(serverPhoto.randomPoolPeers || activeVars);
    loadedMap = loadedRand;
    poolMaps = { sameEffectPeers: {}, sameEffectByVariant: {}, randomPoolPeers: loadedRand };
  } else {
    loadedMap = loadVariantDict(activeVars);
  }
  const prevLoadedMap = loadVariantDict(prevVariants);
  if (Object.keys(loadedMap).length === 0 && Object.keys(prevLoadedMap).length > 0) {
    loadedMap = prevLoadedMap;
  }
  const audioTel = {
    bass: engState ? (engState.bassSmooth || 0.0) : 0.0,
    mid: engState ? (engState.midSmooth || 0.0) : 0.0,
    high: engState ? (engState.highSmooth || 0.0) : 0.0,
    beat: engState ? (engState.beatPulse || 0.0) : 0.0,
    spectrum: serverBands || []
  };
  PhotoMotion.renderPhotoMotionLayer(
    ctx2d, w, h, photoState, loadedMap,
    Number(serverCfg.palette ?? serverCfg.paletteIndex ?? 0),
    theme, audioTel, prevLoadedMap, poolMaps
  );
}

async function fetchFullState() {
  if (fetchingFull) return;
  fetchingFull = true;
  try {
    const res = await fetch('/api/state');
    const data = await res.json();
    const prevResW = serverCfg.renderResW;
    serverCfg = data.config || {};
    syncPhotoState(true);
    if (serverCfg.renderResW !== prevResW) resize();
    if (data.photo) {
      if (data.photo.seq !== lastPhotoSeq && serverPhoto.variants) {
        prevVariants = serverPhoto.variants;
      }
      serverPhoto = data.photo;
      lastPhotoSeq = Number(data.photo.seq ?? lastPhotoSeq);
      loadVariantDict(serverPhoto.variants || {});
    }
    if (data.bands) serverBands = data.bands;
    artLines = data.artLines || [];
    if (serverCfg.artPath) getOrLoadImg(serverCfg.artPath);
    lastUpdatedAt = Number(serverCfg.updatedAt ?? lastUpdatedAt);
    lastActionSeq = Number(data.actionSeq ?? lastActionSeq);
    lastStageSeq = Number(data.stageSeq ?? lastStageSeq);
    const modeTag = (serverCfg.layer1Enabled && serverCfg.layer1FieldEnabled && Number(serverCfg.layer1Mode) === 11)
      ? `📷 ${serverPhoto.activeCategory || 'all'} · FX #${(Number(photoState.motionMode)||0)+1}`
      : `${serverCfg.trackArtist || ''} — ${serverCfg.trackTitle || ''}`;
    statusTxt.textContent = modeTag;
  } catch (e) {
    statusTxt.textContent = 'Reconnecting…';
  } finally {
    fetchingFull = false;
  }
}

async function pollFast() {
  try {
    const res = await fetch('/api/fast');
    const d = await res.json();
    if (d.bands && d.bands.length) serverBands = d.bands;
    if (
      d.updatedAt !== lastUpdatedAt ||
      d.photoSeq !== lastPhotoSeq ||
      d.actionSeq !== lastActionSeq ||
      d.stageSeq !== lastStageSeq
    ) {
      fetchFullState();
    }
  } catch (e) {}
}

fetchFullState();
setInterval(pollFast, 55);

let lastTs = performance.now();
function animate(now) {
  const dt = Math.min(0.05, Math.max(0.005, (now - lastTs) / 1000.0));
  lastTs = now;

  let activeBands = serverBands;
  if (localAnalyser && localFreqData) {
    localAnalyser.getByteFrequencyData(localFreqData);
    activeBands = new Array(64);
    for (let i = 0; i < 64; i++) {
      activeBands[i] = Math.round((localFreqData[i] / 255.0) * 1000);
    }
  }

  if (serverCfg.layer1Enabled && serverCfg.layer1FieldEnabled && Number(serverCfg.layer1Mode) === 11) {
    syncPhotoState(false);
    const stepInfo = PhotoMotion.stepPhotoMotionState(photoState, dt, {
      bass: engineState.bassSmooth || 0.0,
      mid: engineState.midSmooth || 0.0,
      high: engineState.highSmooth || 0.0,
      beat: engineState.beatPulse || 0.0,
      spectrum: activeBands
    });
    if (stepInfo && stepInfo.autoMotionEventTriggered) {
      serverCfg.photoMotionMode = photoState.motionMode;
      lastServerPhotoMode = photoState.motionMode;
      fetch('/api/action', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          name: 'photoPick',
          arg: {
            category: photoState.activeCategory || 'all',
            photoMotionMode: photoState.motionMode,
            photoMotionActivity: photoState.photoMotionActivity,
            photoXyzTilt: photoState.photoXyzTilt,
            photoZoomPunch: photoState.photoZoomPunch,
            photoPaletteBloom: photoState.photoPaletteBloom,
            photoWarpIntensity: photoState.photoWarpIntensity,
            photoStrobeSpeed: photoState.photoStrobeSpeed
          }
        })
      }).catch(() => {});
    }
  }

  const artUrl = serverCfg.artPath ? toHttpUrl(serverCfg.artPath) : '';
  const loadedArt = artUrl ? getOrLoadImg(artUrl) : null;
  const visMode = Number(serverCfg.visualMode ?? serverCfg.layer2Mode ?? 0);
  const rawCfg = Object.assign({}, serverCfg, {
    gpuShaderEnabled: false,
    gpuL1Active: false,
    palette: Number(serverCfg.palette ?? serverCfg.paletteIndex ?? 0),
    paletteIndex: Number(serverCfg.palette ?? serverCfg.paletteIndex ?? 0),
    visualMode: visMode,
    layer2Mode: visMode,
    mode: visMode,
    artLines: artLines,
    asciiLines: artLines,
    artImageUrl: loadedArt ? artUrl : '',
    photoMotionRenderCallback: renderPhotoStageToCanvas
  });
  const normCfg = normaliseConfig(rawCfg, visMode, artLines);
  normCfg.gpuShaderEnabled = false;
  normCfg.gpuL1Active = false;
  normCfg.photoMotionRenderCallback = renderPhotoStageToCanvas;
  stepState(engineState, activeBands, Boolean(normCfg.playing ?? true), normCfg, dt);
  renderFrame(
    ctx,
    canvas.width,
    canvas.height,
    engineState,
    visMode,
    theme,
    artLines,
    normCfg.useAlbumArt ? 'art' : 'words',
    [],
    normCfg,
    canvas
  );
  requestAnimationFrame(animate);
}
requestAnimationFrame(animate);
</script>
</body>
</html>
"""


class BandarchyWebHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def _send_bytes(self, data: bytes, content_type: str, status: int = 200, cache_control: str = "no-store"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", cache_control)
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path in ("/", "/control"):
            self._send_bytes(HTML_CONTROL.encode("utf-8"), "text/html; charset=utf-8")
            return
        if path == "/stage":
            self._send_bytes(HTML_STAGE.encode("utf-8"), "text/html; charset=utf-8")
            return
        if path == "/api/file":
            qs = urllib.parse.parse_qs(parsed.query)
            req_path = (qs.get("path") or [""])[0].strip()
            if req_path.startswith("file://"):
                req_path = req_path[7:]
            if req_path:
                p = Path(os.path.expanduser(req_path)).resolve()
                allowed_roots = [
                    (Path.home() / "Pictures" / "bandarchy").resolve(),
                    CONFIG_DIR.resolve(),
                    REPO_DIR.resolve(),
                ]
                if any(str(p).startswith(str(r)) for r in allowed_roots):
                    if p.is_dir():
                        imgs = sorted(
                            [f for f in p.iterdir() if f.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp")]
                        )
                        p = imgs[0] if imgs else p
                    if p.is_file() and p.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp", ".gif"):
                        mime, _ = mimetypes.guess_type(str(p))
                        self._send_bytes(
                            p.read_bytes(),
                            mime or "image/png",
                            cache_control="public, max-age=86400",
                        )
                        return
            self._send_bytes(b"Not Found", "text/plain", status=404)
            return
        if path == "/PsychedelicEngine.js":
            js_path = REPO_DIR / "PsychedelicEngine.js"
            src = js_path.read_text(encoding="utf-8")
            src = src.replace(".pragma library", "// .pragma library (browser mode)")
            src = src.replace('.import "PhotoMotionEngine.js" as PhotoMotion', "// PhotoMotion loaded globally")
            self._send_bytes(src.encode("utf-8"), "application/javascript; charset=utf-8")
            return
        if path == "/PhotoMotionEngine.js":
            js_path = REPO_DIR / "PhotoMotionEngine.js"
            src = js_path.read_text(encoding="utf-8")
            src = src.replace(".pragma library", "// .pragma library (browser mode)")
            src += "\nwindow.PhotoMotion = this;\n"
            self._send_bytes(src.encode("utf-8"), "application/javascript; charset=utf-8")
            return
        if path == "/api/fast":
            now = time.time()
            with STATE_LOCK:
                playing = bool(LIVE_STATE.get("playing", True))
                upd = float(LIVE_STATE.get("updatedAt", 0.0))
                act_seq = ACTION_STATE["seq"]
                stage_seq = ACTION_STATE["stageSeq"]
                photo_seq = PHOTO_STATE["seq"]
            bands, is_live = get_active_audio_bands(now, playing)
            payload = {
                "bands": bands,
                "audioActive": is_live,
                "playing": playing,
                "sourceMode": LIVE_AUDIO.get("source", "laptop"),
                "updatedAt": upd,
                "actionSeq": act_seq,
                "stageSeq": stage_seq,
                "photoSeq": photo_seq,
            }
            self._send_bytes(json.dumps(payload, separators=(",", ":")).encode("utf-8"), "application/json")
            return
        if path == "/api/state":
            now = time.time()
            with STATE_LOCK:
                cfg = dict(LIVE_STATE)
                act_seq = ACTION_STATE["seq"]
                stage_seq = ACTION_STATE["stageSeq"]
                act_name = ACTION_STATE["name"]
                act_arg = ACTION_STATE["arg"]
                photo_snapshot = {
                    "seq": PHOTO_STATE["seq"],
                    "categories": PHOTO_STATE["categories"],
                    "categoryCounts": PHOTO_STATE["categoryCounts"],
                    "totalOriginals": PHOTO_STATE["totalOriginals"],
                    "totalProcessed": PHOTO_STATE["totalProcessed"],
                    "activeCategory": PHOTO_STATE["activeCategory"],
                    "activeStem": PHOTO_STATE["activeStem"],
                    "variants": PHOTO_STATE["variants"],
                    "sameEffectPeers": PHOTO_STATE["sameEffectPeers"],
                    "sameEffectByVariant": PHOTO_STATE["sameEffectByVariant"],
                    "randomPoolPeers": PHOTO_STATE["randomPoolPeers"],
                }
            seed = f"{cfg.get('trackArtist','')}|{cfg.get('trackTitle','')}|{cfg.get('trackAlbum','')}"
            art_lines = get_cached_art_lines(seed, str(cfg.get("artPath") or ""))
            bands, is_live = get_active_audio_bands(now, bool(cfg.get("playing", True)))
            payload = {
                "config": cfg,
                "photo": photo_snapshot,
                "statementCollections": load_statement_collections(),
                "trackCollections": load_track_collections(),
                "artBranches": scan_external_art_branches(),
                "bands": bands,
                "laptopStreamActive": is_live,
                "audioSourceMode": LIVE_AUDIO.get("source", "laptop"),
                "pinnedSender": LIVE_AUDIO.get("pinnedSender", "auto"),
                "activeSender": LIVE_AUDIO.get("activeSender", ""),
                "knownSenders": sorted((LIVE_AUDIO.get("senders") or {}).keys()),
                "artSeed": f"{seed}::{cfg.get('artPath','')}",
                "artLines": art_lines,
                "actionSeq": act_seq,
                "stageSeq": stage_seq,
                "actionName": act_name,
                "actionArg": act_arg,
            }
            self._send_bytes(json.dumps(payload).encode("utf-8"), "application/json; charset=utf-8")
            return

        self._send_bytes(b"Not Found", "text/plain", status=404)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(length) if length > 0 else b"{}"
        try:
            data = json.loads(body.decode("utf-8"))
        except Exception:
            data = {}

        if self.path == "/api/action":
            act_name = str(data.get("name", ""))
            arg = data.get("arg")
            if act_name == "setAudioSource":
                req_mode = str(arg or "laptop")
                LIVE_AUDIO["source"] = req_mode if req_mode in ("auto", "laptop", "synth") else "laptop"
                self._send_bytes(json.dumps({"ok": True, "audioSourceMode": LIVE_AUDIO["source"]}).encode("utf-8"), "application/json")
                return
            if act_name == "cycleAudioSender":
                known = ["auto"] + sorted((LIVE_AUDIO.get("senders") or {}).keys())
                cur = LIVE_AUDIO.get("pinnedSender", "auto")
                LIVE_AUDIO["pinnedSender"] = known[(known.index(cur) + 1) % len(known)] if cur in known else "auto"
                self._send_bytes(json.dumps({"ok": True, "pinnedSender": LIVE_AUDIO["pinnedSender"]}).encode("utf-8"), "application/json")
                return
            if act_name == "photoRefresh":
                refresh_photo_library()
                pick_photo_from_library()
                self._send_bytes(json.dumps({"ok": True, "photoSeq": PHOTO_STATE["seq"]}).encode("utf-8"), "application/json")
                return
            if act_name == "photoNext":
                with STATE_LOCK:
                    LIVE_STATE["layer1Enabled"] = True
                    LIVE_STATE["layer1FieldEnabled"] = True
                    LIVE_STATE["layer1Mode"] = 11
                pick_photo_from_library(step_history=0)
                self._send_bytes(json.dumps({"ok": True, "photoSeq": PHOTO_STATE["seq"]}).encode("utf-8"), "application/json")
                return
            if act_name == "photoPrev":
                with STATE_LOCK:
                    LIVE_STATE["layer1Enabled"] = True
                    LIVE_STATE["layer1FieldEnabled"] = True
                    LIVE_STATE["layer1Mode"] = 11
                pick_photo_from_library(step_history=-1)
                self._send_bytes(json.dumps({"ok": True, "photoSeq": PHOTO_STATE["seq"]}).encode("utf-8"), "application/json")
                return
            if act_name == "photoCatSelect":
                cat = str(arg or "all")
                with STATE_LOCK:
                    LIVE_STATE["layer1Enabled"] = True
                    LIVE_STATE["layer1FieldEnabled"] = True
                    LIVE_STATE["layer1Mode"] = 11
                    LIVE_STATE["photoActiveCategory"] = cat
                    PHOTO_STATE["activeCategory"] = cat
                pick_photo_from_library(category=cat)
                self._send_bytes(json.dumps({"ok": True, "photoSeq": PHOTO_STATE["seq"]}).encode("utf-8"), "application/json")
                return
            if act_name == "photoCatStep":
                delta = int(arg or 1)
                cats = PHOTO_STATE.get("categories") or ["all"]
                cur_cat = PHOTO_STATE.get("activeCategory") or "all"
                idx = (cats.index(cur_cat) + delta) % len(cats) if cur_cat in cats else 0
                next_cat = cats[idx]
                with STATE_LOCK:
                    LIVE_STATE["layer1Enabled"] = True
                    LIVE_STATE["layer1FieldEnabled"] = True
                    LIVE_STATE["layer1Mode"] = 11
                    LIVE_STATE["photoActiveCategory"] = next_cat
                    PHOTO_STATE["activeCategory"] = next_cat
                pick_photo_from_library(category=next_cat)
                self._send_bytes(json.dumps({"ok": True, "photoSeq": PHOTO_STATE["seq"]}).encode("utf-8"), "application/json")
                return
            if act_name == "photoPick":
                req_cat = arg.get("category") if isinstance(arg, dict) else None
                req_stem = arg.get("stem") if isinstance(arg, dict) else None
                if isinstance(arg, dict):
                    with STATE_LOCK:
                        for mk in (
                            "photoMotionMode", "photoMotionActivity", "photoXyzTilt",
                            "photoZoomPunch", "photoPaletteBloom", "photoWarpIntensity",
                            "photoStrobeSpeed", "photoPlaneShearEnabled", "photoPlaneShear",
                        ):
                            if mk in arg and arg[mk] is not None:
                                LIVE_STATE[mk] = arg[mk]
                        ACTION_STATE["stageSeq"] += 1
                        persist_state()
                pick_photo_from_library(category=req_cat, stem=req_stem, touch_updated_at=False)
                self._send_bytes(json.dumps({"ok": True, "photoSeq": PHOTO_STATE["seq"]}).encode("utf-8"), "application/json")
                return
            if act_name == "photoRandFx":
                with STATE_LOCK:
                    LIVE_STATE["layer1Enabled"] = True
                    LIVE_STATE["layer1FieldEnabled"] = True
                    LIVE_STATE["layer1Mode"] = 11
                    cur_m = int(LIVE_STATE.get("photoMotionMode", 0) or 0)
                    LIVE_STATE["photoMotionMode"] = (cur_m + random.randint(1, 24)) % 25
                    LIVE_STATE["photoMotionActivity"] = round(random.uniform(0.75, 1.85), 2)
                    LIVE_STATE["photoXyzTilt"] = round(random.uniform(0.55, 1.95), 2)
                    LIVE_STATE["photoZoomPunch"] = round(random.uniform(0.85, 1.85), 2)
                    LIVE_STATE["photoWarpIntensity"] = round(random.uniform(0.55, 1.85), 2)
                    LIVE_STATE["photoStrobeSpeed"] = round(random.uniform(0.55, 1.85), 2)
                    LIVE_STATE["photoPaletteBloom"] = round(random.uniform(0.80, 1.85), 2)
                    ACTION_STATE["seq"] += 1
                    ACTION_STATE["name"] = "photoRandFx"
                    ACTION_STATE["arg"] = None
                    persist_state()
                pick_photo_from_library(touch_updated_at=True)
                self._send_bytes(json.dumps({"ok": True, "photoSeq": PHOTO_STATE["seq"], "photoMotionMode": LIVE_STATE["photoMotionMode"]}).encode("utf-8"), "application/json")
                return
            if act_name == "nextStatement":
                with STATE_LOCK:
                    stmts = LIVE_STATE.get("statements") or DEFAULT_STATEMENTS
                    cur_s = LIVE_STATE.get("statementText") or ""
                    LIVE_STATE["statementText"] = pick_random_statement(stmts, cur_s)
                    LIVE_STATE["layer3ShowStatements"] = True
                    LIVE_STATE["useAlbumArt"] = False
                    LIVE_STATE["layer3Enabled"] = True
                    LIVE_STATE["updatedAt"] = time.time()
                    persist_state()
                self._send_bytes(b'{"ok":true}', "application/json")
                return
            if act_name == "selectStatementCollection":
                col_id = str(arg or "rave_demoscene")
                cols = load_statement_collections()
                chosen = next((c for c in cols if c["id"] == col_id), None)
                if chosen:
                    with STATE_LOCK:
                        stmts = save_statements(chosen["statements"])
                        LIVE_STATE["statementCollectionId"] = col_id
                        LIVE_STATE["statements"] = stmts
                        LIVE_STATE["statementText"] = pick_random_statement(stmts, LIVE_STATE.get("statementText", ""))
                        LIVE_STATE["layer3ShowStatements"] = True
                        LIVE_STATE["useAlbumArt"] = False
                        LIVE_STATE["layer3Enabled"] = True
                        LIVE_STATE["updatedAt"] = time.time()
                        persist_state()
                self._send_bytes(b'{"ok":true}', "application/json")
                return
            if act_name == "saveStatementCollection":
                if isinstance(arg, dict):
                    name = str(arg.get("name") or "Custom Statements").strip()
                    col_id = "col_" + "".join(ch if ch.isalnum() else "_" for ch in name.lower()).strip("_")[:24]
                    stmts = save_statements(arg.get("statements") or [])
                    save_statement_collection(col_id, name, stmts)
                    with STATE_LOCK:
                        LIVE_STATE["statementCollectionId"] = col_id
                        LIVE_STATE["statements"] = stmts
                        LIVE_STATE["statementText"] = pick_random_statement(stmts, LIVE_STATE.get("statementText", ""))
                        LIVE_STATE["layer3ShowStatements"] = True
                        LIVE_STATE["useAlbumArt"] = False
                        LIVE_STATE["layer3Enabled"] = True
                        LIVE_STATE["updatedAt"] = time.time()
                        persist_state()
                self._send_bytes(b'{"ok":true}', "application/json")
                return
            if act_name == "selectTrackCollection":
                col_id = str(arg or "studio_maya")
                cols = load_track_collections()
                chosen = next((c for c in cols if c["id"] == col_id), None)
                if chosen:
                    with STATE_LOCK:
                        saved = save_external_tracks(chosen["tracks"])
                        LIVE_STATE["trackCollectionId"] = col_id
                        LIVE_STATE["externalTracks"] = saved
                        LIVE_STATE["externalTrackIndex"] = 0
                        apply_active_track_and_art(LIVE_STATE)
                        LIVE_STATE["updatedAt"] = time.time()
                        persist_state()
                self._send_bytes(b'{"ok":true}', "application/json")
                return
            if act_name == "saveTrackCollection":
                if isinstance(arg, dict):
                    name = str(arg.get("name") or "Custom Tracks").strip()
                    col_id = "tcol_" + "".join(ch if ch.isalnum() else "_" for ch in name.lower()).strip("_")[:24]
                    saved = save_external_tracks(arg.get("tracks") or [])
                    save_track_collection(col_id, name, saved)
                    with STATE_LOCK:
                        LIVE_STATE["trackCollectionId"] = col_id
                        LIVE_STATE["externalTracks"] = saved
                        LIVE_STATE["externalTrackIndex"] = 0
                        apply_active_track_and_art(LIVE_STATE)
                        LIVE_STATE["updatedAt"] = time.time()
                        persist_state()
                self._send_bytes(b'{"ok":true}', "application/json")
                return
            if act_name == "selectArtBranch":
                branch = str(arg or "studio")
                with STATE_LOCK:
                    LIVE_STATE["externalArtBranch"] = branch
                    LIVE_STATE["externalArtIndex"] = 0
                    tracks_list = LIVE_STATE.get("externalTracks") or []
                    t_idx = int(LIVE_STATE.get("externalTrackIndex", 0) or 0)
                    if 0 <= t_idx < len(tracks_list):
                        tracks_list[t_idx]["art"] = branch
                        save_external_tracks(tracks_list)
                    apply_active_track_and_art(LIVE_STATE)
                    LIVE_STATE["updatedAt"] = time.time()
                    persist_state()
                self._send_bytes(b'{"ok":true}', "application/json")
                return
            if act_name == "stepExtArt":
                delta = int(arg or 1)
                with STATE_LOCK:
                    imgs = LIVE_STATE.get("externalArtImages") or []
                    if imgs:
                        eidx = (int(LIVE_STATE.get("externalArtIndex", 0) or 0) + delta) % len(imgs)
                        LIVE_STATE["externalArtIndex"] = eidx
                        LIVE_STATE["artPath"] = imgs[eidx]
                        LIVE_STATE["updatedAt"] = time.time()
                        persist_state()
                self._send_bytes(b'{"ok":true}', "application/json")
                return
            with STATE_LOCK:
                if act_name in ("randomiseAll", "randL1"):
                    if int(LIVE_STATE.get("layer1Mode", 0) or 0) == 11 and act_name == "randL1":
                        LIVE_STATE["photoMotionMode"] = (int(LIVE_STATE.get("photoMotionMode", 0) or 0) + random.randint(1, 24)) % 25
                    else:
                        cand_l1 = [m for m in range(32) if m != 11 and m != int(LIVE_STATE.get("layer1Mode", 0) or 0)]
                        LIVE_STATE["layer1Mode"] = random.choice(cand_l1)
                    LIVE_STATE["layer1Enabled"] = True
                    LIVE_STATE["layer1FieldEnabled"] = True
                    LIVE_STATE["layer1Density"] = round(random.uniform(0.55, 1.95), 2)
                    LIVE_STATE["layer1Speed"] = round(random.uniform(0.60, 1.85), 2)
                if act_name in ("randomiseAll", "randEq"):
                    LIVE_STATE["layer1Enabled"] = True
                    LIVE_STATE["layer1EqEnabled"] = True
                    LIVE_STATE["layer1EqStyle"] = (int(LIVE_STATE.get("layer1EqStyle", 0) or 0) + random.randint(1, 27)) % 28
                    LIVE_STATE["layer1EqLayout"] = random.randint(0, 3)
                if act_name in ("randomiseAll", "randVectors"):
                    LIVE_STATE["layer1Enabled"] = True
                    LIVE_STATE["layer1ShapesEnabled"] = True
                    LIVE_STATE["layer1ShapeStyle"] = (int(LIVE_STATE.get("layer1ShapeStyle", 0) or 0) + random.randint(1, 17)) % 18
                if act_name in ("randomiseAll", "randL2"):
                    LIVE_STATE["layer2Enabled"] = True
                    LIVE_STATE["layer2VizEnabled"] = True
                    LIVE_STATE["visualMode"] = (int(LIVE_STATE.get("visualMode", 0) or 0) + random.randint(1, 12)) % 13
                    LIVE_STATE["symmetryFolds"] = random.choice([3, 4, 5, 6, 8, 10, 12])
                    LIVE_STATE["layer2Complexity"] = round(random.uniform(0.75, 1.75), 2)
                    LIVE_STATE["layer2Speed"] = round(random.uniform(0.65, 1.85), 2)
                if act_name in ("randomiseAll", "randL4"):
                    LIVE_STATE["layer4Enabled"] = True
                    LIVE_STATE["backdropEnabled"] = True
                    LIVE_STATE["layer4Mode"] = (int(LIVE_STATE.get("layer4Mode", 0) or 0) + random.randint(1, 9)) % 10
                    LIVE_STATE["backdropMode"] = LIVE_STATE["layer4Mode"]
                    LIVE_STATE["layer4WallPattern"] = random.randint(0, 10)
                    LIVE_STATE["layer4Twist"] = round(random.uniform(-2.0, 2.0), 2)
                if act_name in ("randomiseAll", "randL3"):
                    LIVE_STATE["layer3Enabled"] = True
                    LIVE_STATE["layer3Mode"] = (int(LIVE_STATE.get("layer3Mode", 0) or 0) + random.randint(1, 11)) % 12
                    LIVE_STATE["layer3TextStyle"] = (int(LIVE_STATE.get("layer3TextStyle", 0) or 0) + random.randint(1, 21)) % 22
                    LIVE_STATE["layer3Dismantle"] = round(random.uniform(0.35, 1.85), 2)
                    stmts = LIVE_STATE.get("statements") or DEFAULT_STATEMENTS
                    LIVE_STATE["statementText"] = pick_random_statement(stmts, LIVE_STATE.get("statementText", ""))
                if act_name == "randomiseAll":
                    pal = (int(LIVE_STATE.get("palette", 0) or 0) + random.randint(1, 53)) % 54
                    LIVE_STATE["palette"] = pal
                    LIVE_STATE["paletteIndex"] = pal
                if act_name == "toggleAllRand":
                    next_on = not bool(LIVE_STATE.get("layer1AutoRandomise"))
                    LIVE_STATE["layer1AutoRandomise"] = next_on
                    LIVE_STATE["layerEqAutoRandomise"] = next_on
                    LIVE_STATE["layerVectorsAutoRandomise"] = next_on
                    LIVE_STATE["layer2AutoRandomise"] = next_on
                    LIVE_STATE["layer4AutoRandomise"] = next_on
                    LIVE_STATE["layer3AutoRandomise"] = next_on
                    LIVE_STATE["layer3RandomMode"] = 2 if next_on else 0
                    LIVE_STATE["photoAutoMotionEvents"] = next_on
                ACTION_STATE["seq"] += 1
                ACTION_STATE["stageSeq"] += 1
                ACTION_STATE["name"] = act_name
                ACTION_STATE["arg"] = arg
                LIVE_STATE["updatedAt"] = time.time()
                persist_state()
            self._send_bytes(json.dumps({"ok": True, "seq": ACTION_STATE["seq"]}).encode("utf-8"), "application/json")
            return

        if self.path == "/api/from-stage":
            # Sync autonomous randomiser changes back from HeadlessStage.qml without overwriting quality/FPS
            protected_keys = {
                "externalTracks", "statements", "externalArtImages",
                "version", "renderQuality", "renderResW",
                "geometryDetail", "targetFps", "gpuShaderEnabled", "antialiasingEnabled",
            }
            with STATE_LOCK:
                if isinstance(data, dict):
                    for k, v in data.items():
                        if k not in protected_keys and k in DEFAULT_CONFIG:
                            LIVE_STATE[k] = v
                    if "paletteIndex" in data:
                        LIVE_STATE["palette"] = int(data["paletteIndex"] or 0)
                        LIVE_STATE["paletteIndex"] = int(data["paletteIndex"] or 0)
                    LIVE_STATE["version"] = 3
                    ACTION_STATE["stageSeq"] += 1
                    persist_state()
            self._send_bytes(b'{"ok":true}', "application/json")
            return

        if self.path == "/api/state":
            with STATE_LOCK:
                if isinstance(data, dict):
                    if "externalTracks" in data and isinstance(data["externalTracks"], list):
                        LIVE_STATE["externalTracks"] = save_external_tracks(data["externalTracks"])
                    if "statements" in data and isinstance(data["statements"], list):
                        LIVE_STATE["statements"] = save_statements(data["statements"])
                    for k, v in data.items():
                        if k not in ("externalTracks", "statements") and k in DEFAULT_CONFIG:
                            LIVE_STATE[k] = v
                    if data.get("layer3ShowStatements") is True and "statementText" not in data:
                        stmts = LIVE_STATE.get("statements") or DEFAULT_STATEMENTS
                        LIVE_STATE["statementText"] = pick_random_statement(stmts, LIVE_STATE.get("statementText", ""))
                    if "palette" in data and "paletteIndex" not in data:
                        LIVE_STATE["paletteIndex"] = int(data["palette"] or 0)
                    elif "paletteIndex" in data and "palette" not in data:
                        LIVE_STATE["palette"] = int(data["paletteIndex"] or 0)
                    if "renderQuality" in data and "renderResW" not in data:
                        rq = int(data["renderQuality"] or 0)
                        LIVE_STATE["renderResW"] = QUALITY_RES_MAP.get(rq, 800)
                        if "geometryDetail" not in data:
                            LIVE_STATE["geometryDetail"] = QUALITY_DETAIL_MAP.get(rq, 1.00)
                    LIVE_STATE["version"] = 3
                    if "externalTrackIndex" in data or "externalTracks" in data or "externalArtBranch" in data:
                        apply_active_track_and_art(LIVE_STATE)
                    LIVE_STATE["updatedAt"] = time.time()
                    persist_state()
                cfg = dict(LIVE_STATE)
            self._send_bytes(json.dumps({"ok": True, "config": cfg}).encode("utf-8"), "application/json; charset=utf-8")
            return

        self._send_bytes(b"Not Found", "text/plain", status=404)


class ThreadedHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    parser = argparse.ArgumentParser(description="Bandarchy 6-Layer Web Studio Controller")
    parser.add_argument("--host", default="0.0.0.0", help="Bind address (default: 0.0.0.0)")
    parser.add_argument("--port", type=int, default=8765, help="Bind port (default: 8765)")
    parser.add_argument("--udp-port", type=int, default=8766, help="UDP port for live Cava FFT stream (default: 8766)")
    args = parser.parse_args()

    refresh_photo_library()
    pick_photo_from_library(category=LIVE_STATE.get("photoActiveCategory", "all"))

    t = threading.Thread(target=udp_cava_listener, args=(args.udp_port,), daemon=True)
    t.start()

    srv = ThreadedHTTPServer((args.host, args.port), BandarchyWebHandler)
    print(f"Bandarchy 6-Layer Studio Controller running on http://{args.host}:{args.port}/ (UDP FFT on :{args.udp_port})")
    srv.serve_forever()


if __name__ == "__main__":
    main()
