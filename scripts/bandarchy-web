let serverCfg = {};
let serverPhoto = {};
let prevVariants = {};
let serverBands = new Array(64).fill(0);
let artLines = [];
let lastUpdatedAt = -1;
let lastPhotoSeq = -1;
let lastActionSeq = -1;
let lastStageSeq = -1;
let lastServerPhotoMode = -1;
let localAnalyser = null;
let localFreqData = null;
let fetchingFull = false;

const imgCache = new Map();
function toHttpUrl(pathOrUrl) {
  if (!pathOrUrl || typeof pathOrUrl !== 'string') return '';
  let s = pathOrUrl.trim();
  if (!s) return '';
  if (s.startsWith('/api/file?') || s.startsWith('http://') || s.startsWith('https://')) return s;
  if (s.startsWith('file://')) s = s.slice(7);
  return '/api/file?path=' + encodeURIComponent(s);
}

function getOrLoadImg(pathOrUrl) {
  const url = toHttpUrl(pathOrUrl);
  if (!url) return null;
  let entry = imgCache.get(url);
  if (!entry) {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    entry = { img, loaded: false, failed: false, url };
    img.onload = () => { entry.loaded = true; };
    img.onerror = () => { entry.failed = true; };
    img.src = url;
    imgCache.set(url, entry);
    if (imgCache.size > 160) {
      const firstKey = imgCache.keys().next().value;
      imgCache.delete(firstKey);
    }
  }
  return entry.loaded ? entry.img : null;
}

const origDrawImage = ctx.drawImage.bind(ctx);
ctx.drawImage = function(imgOrUrl, ...args) {
  if (typeof imgOrUrl === 'string') {
    const img = getOrLoadImg(imgOrUrl);
    if (img && img.complete && img.naturalWidth > 0) {
      return origDrawImage(img, ...args);
    }
    return;
  }
  if (imgOrUrl) {
    return origDrawImage(imgOrUrl, ...args);
  }
};

function resize() {
  const targetW = Number(serverCfg.renderResW) || 960;
  const aspect = window.innerHeight / Math.max(1, window.innerWidth);
  canvas.width = Math.max(384, Math.min(1920, Math.round(targetW)));
  canvas.height = Math.max(216, Math.round(canvas.width * aspect));
}
window.addEventListener('resize', resize);
resize();

